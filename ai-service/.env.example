# Настройки AI-сервиса — единственный список переменных с пояснениями. Его читают обе
# установки: docker compose берёт его как .env (cp .env.example .env), а install.sh
# собирает из него /etc/rtm-ai.env для службы systemd. Код (app/config.py) знает те же
# имена и те же значения по умолчанию; новая переменная появляется здесь и там, больше нигде.
# Ни одно из этих значений не знает ни lsFusion, ни телефон: модель меняется здесь.

# ============ модель ============
# Выбор по умолчанию — qwen2.5 3B в 4-битной квантизации: ~2 ГБ памяти, сносно понимает
# русский и умеет отвечать строгим JSON, на обычном сервере без GPU отвечает за секунды.
#   слабее машина  -> qwen2.5:1.5b-instruct-q4_K_M (хуже с русским, отвечает быстрее)
#   нужно качество -> qwen2.5:7b-instruct-q4_K_M (памяти ~5 ГБ, ответ в разы дольше)
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# Адрес OpenAI-совместимого /v1/chat/completions: так говорят Ollama, llama.cpp server,
# vLLM и LM Studio — сменить движок значит сменить эту строку. В Docker её задаёт
# docker-compose.yml (контейнер llm), здесь она не читается; для службы systemd
# install.sh подставляет порт ollama; значение ниже — для запуска uvicorn руками.
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Ключ API. Ollama его не проверяет, но заголовок ждут все OpenAI-совместимые клиенты;
# настоящий ключ нужен только движку, который его требует.
LLM_API_KEY=local

# Потолок ожидания модели, секунды. За ним человеку отвечают «не успела», а не держат экран.
LLM_TIMEOUT=60

# Окно контекста (токенов) и потолок ответа. Больше — дольше считается на CPU, а без
# потолка prompt раздувается до размера, на котором маленькая модель перестаёт видеть сам
# запрос. LLM_NUM_CTX уходит и движку (OLLAMA_CONTEXT_LENGTH), и сервису.
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=512

# Ноль, а не «немного творчества»: задача — разбор фразы, а не сочинение.
LLM_TEMPERATURE=0

# Сколько ollama держит веса в памяти между запросами (OLLAMA_KEEP_ALIVE): иначе каждая
# постановка задачи платит несколько секунд за чтение модели с диска.
LLM_KEEP_ALIVE=30m

# ============ сколько кандидатов уходит в prompt ============
# lsFusion присылает отобранных по делу кандидатов (рядом, названо, есть роль), сервис
# оставляет самых похожих на текст запроса. HISTORY — сколько прошлых шагов диалога
# показывать модели.
CONTEXT_MAX_OBJECTS=12
CONTEXT_MAX_PERFORMERS=12
CONTEXT_MAX_TEMPLATES=10
CONTEXT_MAX_HISTORY=6

# ============ где слушать ============
# Порт сервиса — на него ходит lsFusion. Порт ollama — только для отладки
# (curl localhost:11434/api/tags) и в обеих установках только на localhost: телефон к
# модели не ходит и ходить не должен.
AI_PORT=8010
LLM_PORT=11434
# Адрес сервиса: у службы systemd — куда слушает uvicorn, в Docker — интерфейс хоста, на
# котором публикуется порт. По умолчанию только localhost: единственный, кому нужен сервис,
# — сервер lsFusion рядом. lsFusion на другой машине — 0.0.0.0, обязательно с AI_API_KEY
# (иначе сервис не стартует и пишет в журнал, почему) и с портом, закрытым файрволом до её
# адреса.
AI_BIND=127.0.0.1

# ============ доступ ============
# Ключ, который lsFusion шлёт в заголовке Authorization: Bearer. Задан — все ручки, кроме
# /health, без него отвечают 401. Тот же ключ вводится в lsFusion: «Настройка → Настройки →
# AI → Ключ AI-сервиса». install.sh генерирует его при установке; для Docker — придумать
# самому, например: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'.
# Пусто — без проверки; допустимо только с AI_BIND=127.0.0.1 (так стенды переживают
# обновление).
AI_API_KEY=

# ============ журнал ============
# DEBUG заодно открывает /docs и /openapi.json: вне отладки описание ручек наружу не отдаётся.
LOG_LEVEL=INFO
# 1 — писать prompt в журнал. Там фамилии исполнителей и адреса объектов: включать только
# на время разбора инцидента и выключать обратно; полный разбор запроса и так хранит
# lsFusion — в журнале AI-запросов, под своей настройкой и своими правами доступа.
LOG_PROMPT=0

# ============ журнал хода генерации кода ============
# Генерация кода проверки гипотезы пишет свой ход файлом на каждое обращение: начало
# формулировки гипотезы, рассуждения модели, вызовы инструментов. Папка — относительно
# рабочей папки сервиса; пусто — не писать. В Docker папку не менять: на неё смонтирован
# volume (docker-compose.yml), и в другой папке журнал пропадёт вместе с контейнером.
CODEGEN_LOG_DIR=logs/codegen
# Сколько дней хранится файл хода: те, что старше, удаляются при старте очередной
# генерации. Режима «хранить вечно» нет: ноль и меньше — то же, что пусто, 14 дней.
CODEGEN_LOG_KEEP_DAYS=14

# ============ генерация кода проверки гипотез ============
# Отдельный путь от черновиков задач: код по исходникам ERP пишет агент (ходить по
# исходникам ему дают инструменты встроенного MCP-сервера платформы). Какой поток
# основным — CODEGEN_PROVIDER:
#   claude    — агент claude cli (подписка Claude; учётка у самого cli)
#   zai       — GLM кодинг-плана Z.AI по его Anthropic-совместимому API (нужен ZAI_API_KEY)
#   fallback  — claude, а при его сбое (cli, таймаут, нет кода) — Z.AI
# Эти значения — по умолчанию: lsFusion присылает поток и параметры Z.AI с каждым
# запросом из «Настроек AI» (Настройка → Настройки → AI), и они перекрывают окружение.
CODEGEN_PROVIDER=claude

# --- общий для обоих потоков: MCP платформы и журнал хода ---
# Встроенный MCP-сервер работающей сборки: агент читает исходники из classpath, поэтому
# «репозиторий против развёрнутого» не расходится в принципе.
LSF_MCP_URL=http://127.0.0.1:8082/mcp
# 'логин:пароль' для Basic; пусто — анонимный доступ. У admin с пустым паролем двоеточие
# обязательно: LSF_MCP_AUTH=admin:
LSF_MCP_AUTH=
# Ход генерации по шагам (что агент читал, что думал) — файлом на каждое обращение
CODEGEN_LOG_DIR=logs/codegen
# Агент ходит по исходникам десятками вызовов: минуты — норма. Потолки общего времени
# и числа ходов-обращений к модели.
CODEGEN_TIMEOUT=900
CODEGEN_MAX_TURNS=60

# --- поток claude ---
# Путь до cli: на Windows лежит в профиле пользователя, в контейнере — в /usr/local/bin.
CLAUDE_CLI=claude
# Пусто — модель по умолчанию у самого cli: она меняется чаще, чем этот файл.
CLAUDE_MODEL=

# --- поток Z.AI ---
# Ключ API кодинг-плана Z.AI (личный кабинет z.ai). Пусто — поток недоступен: при
# CODEGEN_PROVIDER=zai ручка вернёт errorCode=noKey, fallback просто не привлечётся.
ZAI_API_KEY=
# Anthropic-совместимый endpoint и модель; ответ тратит токены и на рассуждение, поэтому
# бюджет ответа — с запасом на thinking и код.
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=GLM-5.3
ZAI_MAX_TOKENS=16384
