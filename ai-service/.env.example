# Скопировать в .env рядом с docker-compose.yml и поправить под свою машину.
# Ни одно из этих значений не знает ни lsFusion, ни телефон: модель меняется здесь.

# --- модель ---
# Выбор по умолчанию — qwen2.5 3B в 4-битной квантизации: ~2 ГБ памяти, сносно понимает
# русский и умеет отвечать строгим JSON, на обычном сервере без GPU отвечает за секунды.
#   слабее машина  -> qwen2.5:1.5b-instruct-q4_K_M
#   нужно качество -> qwen2.5:7b-instruct-q4_K_M (памяти ~5 ГБ, ответ в разы дольше)
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# Потолок ожидания модели, секунды. За ним человеку отвечают «не успела», а не держат экран.
LLM_TIMEOUT=60

# Размер контекста (токенов). Больше — дольше считается на CPU.
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0

# Сколько кандидатов каждого справочника попадает в prompt.
CONTEXT_MAX_OBJECTS=12
CONTEXT_MAX_PERFORMERS=12
CONTEXT_MAX_TEMPLATES=10

# --- порты ---
AI_PORT=8010
LLM_PORT=11434

# --- журнал ---
LOG_LEVEL=INFO
# 1 — писать prompt в журнал контейнера. Там фамилии и адреса: включать только на время
# разбора инцидента.
LOG_PROMPT=0
