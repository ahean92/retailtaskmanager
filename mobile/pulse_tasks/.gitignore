# Dart/Flutter tooling
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Android/iOS build outputs & local config (the platform source IS tracked so the
# project is buildable as-is — only generated/secret bits are ignored here; the
# flutter-generated android/.gitignore and ios/.gitignore cover the rest).
android/local.properties
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
ios/Pods/
ios/.symlinks/
**/Flutter/ephemeral/

# Конфигурация Firebase заказчика (#36720). Не секреты в строгом смысле — они уезжают
# внутри APK, — но принадлежат установке, а не продукту: свой проект Firebase заводит
# каждый заказчик, и закоммиченный файл увёл бы чужие устройства в чужой проект.
# Приватный ключ сервисного аккаунта, которым сервер ходит в FCM, здесь не упомянут
# намеренно: он живёт не в клиенте, а настройкой в бэк-офисе.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
