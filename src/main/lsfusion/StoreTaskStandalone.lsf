MODULE StoreTaskStandalone;

REQUIRE StoreTaskLib, Authentication, ObjectDimensionValue, ScorecardDemo;

NAMESPACE StoreTask;

// The smallest host that turns the shared artifact into a working application on its
// own. Its whole job is to answer the one question the subsystem deliberately refuses
// to answer for itself: who can author, be assigned and execute a task.
//
// Here that is simply a logged-in user. An ERP host answers it differently — see
// storeTasks/erp/StoreTaskPerformerErp, which anchors on Assignee so that a task can
// also be given to a team.
EXTEND CLASS CustomUser : TaskPerformer;

id (CustomUser u) += login(u);
name (CustomUser u) += Authentication.name(u);
archived (CustomUser u) += isLocked(u);
email (CustomUser u) += Authentication.email(u);
in (CustomUser p, User u) += p AS CustomUser = u AS CustomUser;

performer (CustomUser u) += u;

// Where an inspected asset is. An ERP host resolves this through the store the asset sits
// in (erp/CheckAssetLocation); a standalone host has no notion of a store, so the address
// is the asset's own attribute — plain text, typed in wherever the objects are maintained.
// Without it every task in the mobile client shows an empty address.
assetAddress 'Адрес' = DATA ISTRING[250] (CheckAsset) IN base CHARWIDTH 30;
addressAsset (CheckAsset a) += assetAddress(a);

// Coordinates likewise: no store to inherit them from, so they are the asset's own data.
assetLatitude 'Широта' = DATA DOUBLE (CheckAsset);
assetLongitude 'Долгота' = DATA DOUBLE (CheckAsset);
latitudeAsset (CheckAsset a) += assetLatitude(a);
longitudeAsset (CheckAsset a) += assetLongitude(a);

EXTEND FORM checkAssets
    PROPERTIES(a) assetAddress, assetLatitude, assetLongitude
;
