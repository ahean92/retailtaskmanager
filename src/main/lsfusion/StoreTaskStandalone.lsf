MODULE StoreTaskStandalone;

// ExternalApp (#36840) сюда намеренно НЕ подключён: этот хост — живой образец сборки
// без модуля внешних приложений (секции на телефоне нет, и ничего не ломается).
// Хост, которому запуск приложений нужен, дописывает REQUIRE ExternalApp у себя —
// как StoreTaskMite в mite_public.
//
// ObjectDimensionValue и SubjectStock — тоже опции хоста, а не часть StoreTaskLib: это
// DATA-реализации разрезов объекта и остатков по каналу 'item'. Хост с собственным
// источником (регион магазина из ERP, настоящие остатки) их не берёт и реализует
// абстракции сам; у этого хоста источника нет, и он берёт обе. ScorecardDemo —
// единственный генератор, которому не нужен ERP: standalone и есть демо-стенд, остальное
// демо — в demo/StoreTaskDemoLib для ERP-хоста.
// Также TaskPerformer — TaskPerformer/hasIn/performer; CheckObject — ownAddress/parent;
// CheckAsset — CheckAsset/checkAssets; ObjectRole — person/active; RefValue — available
// (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskLib, Authentication, ObjectDimensionValue, ScorecardDemo, SubjectStock, TaskPerformer, CheckObject, CheckAsset, ObjectRole, RefValue;

NAMESPACE StoreTask;

// The smallest host that turns the shared artifact into a working application on its
// own. Its whole job is to answer the one question the subsystem deliberately refuses
// to answer for itself: who can author, be assigned and execute a task.
//
// Here that is simply a logged-in user. An ERP host answers it differently — see
// storeTasks/erp/StoreTaskPerformerErp, which anchors on Assignee so that a task can
// also be given to a team.
EXTEND CLASS CustomUser : TaskPerformer;

id (CustomUser u) += login(u);
name (CustomUser u) += Authentication.name(u);
archived (CustomUser u) += isLocked(u);
email (CustomUser u) += Authentication.email(u);
in (CustomUser p, User u) += p AS CustomUser = u AS CustomUser;

performer (CustomUser u) += u;

// Канал 'employee' на этом хосте (#36841): «сотрудники этого магазина» — та же связь,
// что привязка исполнителя к объекту, то есть роли на объекте (ObjectRole). Человек
// доступен, если роль на объекте назначена ему самому или подразделению, в которое он
// входит (hasIn — транзитивно по иерархии #36835). Штатного расписания у standalone-хоста
// нет — роли и есть его оргструктура. Фильтр — подсказка, не запрет (дизайн, раздел 12.5):
// не нашли здесь — apiRowSubjects отдаёт весь канал или ищет по all=1.
staffOn (CustomUser u, CheckObject o) =
    GROUP SUM 1 IF hasIn(person(o, ObjectRole r), u) AND active(r);
available (CustomUser u, CheckObject o) += TRUE IF staffOn(u, o);

// Пользовательское дерево объектов. У ERP-хоста структуру отдаёт сам ERP («железка
// стоит в магазине», erp/CheckAssetLocation); у этого хоста внешнего источника нет, и
// дерево заводится руками: «Магазин №4» с координатами, внутри него «Касса №4» без
// координат, внутри неё «Сканер». Глубина любая — цикл платформа не пропустит сама
// (RECURSION с политикой CYCLES NO ставит констрейнт за нас).
parentObject 'Внутри объекта' = DATA CheckObject (CheckAsset) INDEXED;
nameParentObject 'Внутри объекта' (CheckAsset a) = name(parentObject(a)) CHARWIDTH 25;
parent (CheckAsset a) += parentObject(a);

CONSTRAINT DROPPED(CheckObject o IS CheckObject) AND PREV(parentObject(CheckAsset a) = o)
    MESSAGE 'Нельзя удалить объект, внутри которого заведены другие объекты';

// Адрес и координаты — собственные данные объекта, вводятся руками. Заполняются ТОЛЬКО
// у расположения (магазин, склад, РЦ): касса и сканер получают и адрес, и расстояние от
// того расположения, внутри которого стоят, — этим и занимается ядро (CheckObject.site).
// Без адреса задача в мобильном клиенте показывалась бы с пустым адресом.
assetAddress 'Адрес' = DATA ISTRING[250] (CheckAsset) IN base CHARWIDTH 30;
assetLatitude 'Широта' = DATA DOUBLE (CheckAsset);
assetLongitude 'Долгота' = DATA DOUBLE (CheckAsset);
ownAddress (CheckAsset a) += assetAddress(a);
ownLatitude (CheckAsset a) += assetLatitude(a);
ownLongitude (CheckAsset a) += assetLongitude(a);

EXTEND FORM checkAssets
    PROPERTIES(a) nameParentObject, assetAddress, assetLatitude, assetLongitude
;
