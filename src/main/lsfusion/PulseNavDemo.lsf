MODULE PulseNavDemo;

REQUIRE StoreTaskLib;

NAMESPACE StoreTask;

// ===== Тестовая обвязка навигатора =====
// Лента корневых разделов, чтобы проверить верхнюю панель (PulseRoot) на реальном
// количестве вкладок: в проекте их всего две, и переполнение, перенос и обрезка
// длинных названий на такой ленте не воспроизводятся.
//
// Модуль подключён только к StoreTaskStandalone — дев-хосту. В StoreTaskLib он не
// входит намеренно: это jar, который подключают два хоста, и тестовые разделы в
// чужом меню — не то, за чем к библиотеке обращаются. Убирается двумя движениями:
// строка в REQUIRE у StoreTaskStandalone и этот файл.
//
// Корневая папка обязана назвать WINDOW для своих детей — иначе
// CheckNavigatorElementsTask роняет старт («must specify a WINDOW for its
// children»); сама папка при этом попадает в окно root, то есть в верхнюю ленту.
// Пункты внутри — существующие формы под другими именами: заводить ради теста
// настоящие формы незачем, а пустой раздел не даёт посмотреть на рельс.
//
// Написано без метакода намеренно: разделы правятся и выбрасываются поштучно, и
// читать их глазами проще, чем разворачивать в голове шаблон.

NAVIGATOR {
    NEW FOLDER demoPurchase 'Закупки' WINDOW toolbar IMAGE 'fa-solid fa-cart-shopping' {
        NEW FORM demoPurchaseOrders 'Заказы поставщикам' = tasks;
        NEW FORM demoPurchaseSuppliers 'Поставщики' = taskUnits;
    }
    NEW FOLDER demoStock 'Склад' WINDOW toolbar IMAGE 'fa-solid fa-warehouse' {
        NEW FORM demoStockBalance 'Остатки' = checkAssets;
        NEW FORM demoStockMoves 'Перемещения' = tasks;
    }
    NEW FOLDER demoSales 'Продажи' WINDOW toolbar IMAGE 'fa-solid fa-hand-holding-dollar' {
        NEW FORM demoSalesOrders 'Заказы покупателей' = tasks;
        NEW FORM demoSalesCustomers 'Покупатели' = taskUnits;
    }
    NEW FOLDER demoRetail 'Розничная торговля' WINDOW toolbar IMAGE 'fa-solid fa-shop' {
        NEW FORM demoRetailReceipts 'Чеки' = tasks;
        NEW FORM demoRetailShifts 'Смены' = templates;
    }
    NEW FOLDER demoFinance 'Финансы' WINDOW toolbar IMAGE 'fa-solid fa-piggy-bank' {
        NEW FORM demoFinancePayments 'Платежи' = tasks;
        NEW FORM demoFinanceAccounts 'Счета' = templates;
    }
    NEW FOLDER demoPrices 'Цены' WINDOW toolbar IMAGE 'fa-solid fa-tag' {
        NEW FORM demoPricesLists 'Прайс-листы' = templates;
        NEW FORM demoPricesChanges 'Изменения цен' = tasks;
    }
    NEW FOLDER demoEquipment 'Оборудование' WINDOW toolbar IMAGE 'fa-solid fa-server' {
        NEW FORM demoEquipmentUnits 'Единицы оборудования' = checkAssets;
        NEW FORM demoEquipmentService 'Обслуживание' = tasks;
    }
    NEW FOLDER demoTransport 'Транспорт' WINDOW toolbar IMAGE 'fa-solid fa-truck-fast' {
        NEW FORM demoTransportRoutes 'Маршруты' = tasks;
        NEW FORM demoTransportVehicles 'Транспортные средства' = checkAssets;
    }
    NEW FOLDER demoDocs 'Документы' WINDOW toolbar IMAGE 'fa-solid fa-file-lines' {
        NEW FORM demoDocsIncoming 'Входящие' = tasks;
        NEW FORM demoDocsArchive 'Архив' = templates;
    }
    NEW FOLDER demoProduction 'Производство' WINDOW toolbar IMAGE 'fa-solid fa-industry' {
        NEW FORM demoProductionOrders 'Производственные задания' = tasks;
        NEW FORM demoProductionSpecs 'Спецификации' = templates;
    }
    NEW FOLDER demoWms 'WMS' WINDOW toolbar IMAGE 'fa-solid fa-boxes-packing' {
        NEW FORM demoWmsCells 'Ячейки' = checkAssets;
        NEW FORM demoWmsPicking 'Отборы' = tasks;
    }
    NEW FOLDER demoWeb 'Веб-витрина' WINDOW toolbar IMAGE 'fa-solid fa-globe' {
        NEW FORM demoWebCatalog 'Каталог' = templates;
        NEW FORM demoWebOrders 'Заказы с сайта' = tasks;
    }
}
