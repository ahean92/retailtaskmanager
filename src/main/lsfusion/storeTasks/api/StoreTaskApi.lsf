MODULE StoreTaskApi;

// Ручки задач телефона: профиль за токеном, объекты рядом, словарь статусов и смена
// статуса. Список задач — TaskListApi, создание — TaskCreateApi, взятие — TaskTakeApi.
// ApiCommon — конвенции ручек (гварды, отказы, requireMoveStatus); GeoPolicy — geoRequired
// в apiCurrentUser (#37342); GeoLog — logGeo; CheckObject — каталог объектов, расстояния,
// catalogVersion; StoreTaskCore — taskByAnyId и статус задачи; StoreTaskStatus — TaskStatus;
// TaskPerformer — currentPerformer; Authentication — currentUserLogin; StoreTaskRefusal —
// refuse: отказ по существу кодом 422 вместо 500.
// Перечислено явно, транзитивному REQUIRE не доверять.
REQUIRE ApiCommon, GeoPolicy, GeoLog, CheckObject, StoreTaskCore, StoreTaskStatus, TaskPerformer,
        Authentication, StoreTaskRefusal;

NAMESPACE StoreTask;

// ===== Simple HTTP JSON API for the mobile (Flutter) client. =====
// Follows the project convention: @@api actions with EXPORT JSON (read) and
// reverse-lookup writes (see TaskAPI / CategoryAPI). Served on the web port, e.g.
//   GET  /exec/StoreTask.apiCurrentUser                         -> {login,name,id,geoRequired,catalogVersion}
//   GET  /exec/StoreTask.apiNearbyObjects?lat=53.9&lon=27.56    -> [{id,name,distance[,far]},...]
//   GET  /exec/StoreTask.apiStatuses                            -> [{id,name,...}]
//   POST /exec/StoreTask.apiSetStatus  body {"id":"<taskId>","statusId":"done"} -> {}
// Конвенции, общие для всех модулей ручек — как адресуются аргументы, почему гвард
// идёт первым и чем отвечает отказ, — описаны в ApiCommon.

// --- профиль исполнителя за токеном: кто вошёл в приложение ---
// Аутентификация — дело платформы (Bearer/Basic); эта ручка отвечает на прикладной
// вопрос. Учётка, не связанная с исполнителем, получает явный отказ, а не пустой
// объект: приложение сразу говорит «учётная запись не является исполнителем» вместо
// показа пустых списков. Отказ — общий (ApiCommon), признак geoRequired — из GeoPolicy.
apiCurrentUser () {
    IF currentPerformer() THEN
        EXPORT JSON FROM
            login = currentUserLogin(),
            name = name(currentPerformer()),
            id = id(currentPerformer()),
            geoRequired = geoRequired(),
            // версия каталога объектов (#37047): телефон сверяет её с той, под которой
            // качал каталог (HomeApi.apiObjects), и перекачивает только при расхождении.
            // Здесь, где телефон уже читает, что ему велел сервер (geoRequired): профиль
            // — ответ в одну строку, его можно спрашивать на каждой синхронизации
            catalogVersion = catalogVersion();
    ELSE
        denyNotPerformer();
} @@api;

// --- objects near a point, nearest first ---
// The device sends where it is; the server answers which objects are within
// nearbyRadius() of it. A list, not a single answer, and deliberately so: two shops in
// one shopping centre are metres apart and no automatic rule tells them apart, so the
// app offers the list and takes the first entry as the default.
//
// Distance is measured in PostgreSQL (CheckObject.distance), so the catalogue is filtered
// and ordered before it leaves the database — the reason to prefer this over shipping the
// whole of it and letting the phone sort it.
//
// The guard is currentPerformer(), not assignedTo(): this answers "where am I", which
// is not a question about anybody's tasks. It still has to be a performer — the object
// catalogue with its coordinates is the store network, not public data.
//
// When nothing is in radius the answer is not empty: it carries the single nearest
// object there is, marked `far`. Three situations look alike from a phone that only ever
// sees `[]` — "рядом ничего нет", "ближайший в двенадцати километрах" and "объектам не
// проставили координаты" — and they are three different things for the person to do about
// them. Only the server can tell them apart, so it says which. `distance` is therefore
// uncapped, exactly as in apiTasks.
//
// It is the *exception* that is flagged, not the rule, and that is load-bearing: lsFusion
// does not export NULL, so a flag can only ever be read as "present or not", and an older
// server — one that answers with objects inside the radius and nothing else — sends no
// flag at all. Marking the near ones would make every object from such a server look far
// and would hide the whole task list; marking the far one makes "no flag" mean "near",
// which is exactly what that older server was saying.
//
// Measured on the 7.0 server, because two kinds of nothing look alike from the outside
// and are not: omitted or empty coordinates answer an empty body with content-type
// application/null (the same effect that keeps apiTasks parameterless), and an
// unparseable number is HTTP 500 before this action runs at all. A client must not read
// "no body" as "no objects" — with coordinates in hand, `[]` is the answer, and it says
// that not one object in the catalogue has coordinates of its own.
apiNearbyObjects (DOUBLE lat, DOUBLE lon) {
    // до проверки на исполнителя: чужое обращение к каталогу объектов — как раз то,
    // что стоит видеть в журнале, а после RETURN ниже записывать было бы уже некому
    logGeo(r'nearbyObjects', lat, lon, NULL);

    IF NOT currentPerformer() THEN { denyNotPerformer(); RETURN; }
    // Ближайший-вообще — в LOCAL до экспорта: агрегат по всему каталогу внутри WHERE
    // платформа встраивала в SQL основного запроса под OR — и полный каталог с формулой
    // расстояния оставался частью каждого его выполнения. Тем же приёмом, что picked
    // в apiTasks и apiHome (там он же лечил TOO LONG QUERY).
    LOCAL nearest = CheckObject ();
    nearest() <- nearestObjectAnywhere(lat, lon);
    EXPORT JSON FROM
        id = id(CheckObject o),
        name = name(o),
        address = address(o),
        latitude = latitude(o),
        longitude = longitude(o),
        distance = distance(o, lat, lon),
        far = (TRUE IF NOT nearbyDistance(o, lat, lon))
        // id(o) — такой же гвард, как WHERE id(t) в apiTasks, и по той же причине:
        // ответ этой ручки телефон возвращает СЮДА ЖЕ как objectId, а объект без
        // бизнес-ключа назвать нечем. Пойманный на приёмке #36837 случай: объект с
        // координатами, но без кода («Склад (демо)»), оказывался ближайшим, телефон
        // выбирал его как «где я стою» — и ни одна задача с ним не совпадала, так
        // что человек на объекте видел весь свой список только для чтения.
        // isSite(o) — второй гвард того же рода: выбрать «где я стою» можно только
        // расположение. Вложенный объект (касса, сканер) показывает координаты своего
        // магазина, поэтому без него список ближайших забился бы оборудованием,
        // стоящим ровно на том же расстоянии, что и сам магазин.
        // NOT archived — закрытый магазин «где я стою» не предлагается (как в nearestObject).
        WHERE id(o) AND isSite(o) AND NOT archived(o) AND (nearbyDistance(o, lat, lon) OR o = nearest())
        ORDER distance(o, lat, lon), o;
} @@api;

// --- task status dictionary (drives the status picker in the app) ---
apiStatuses () {
    IF callerLocked() THEN { denyLocked(); RETURN; } // #37179
    EXPORT JSON FROM
        id = id(TaskStatus s),
        name = name(s),
        closed = closed(s),
        sortingOrder = sortingOrder(s)
        WHERE id(s);
} @@api;

// --- change a task status (write-back for the offline outbox) ---
apiSetStatus (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aStatusId = STRING[20]();
    IMPORT JSON FROM body AS FILE TO() aId = id, aStatusId = statusId;
    // Гвард доступа первым (requireMoveStatus, ApiCommon): статусом двигает назначенный или
    // автор, наблюдатель — нет; несуществующий id проваливается так же, как чужой, — перебор
    // не раскрывает, какие задачи есть. Он же закрывает пустой id. Какой именно переход
    // можно, решают правила смены статуса при APPLY (StoreTaskWorkflow и констрейнты статуса)
    // — те же, по которым apiTasks отдаёт nextStatuses, — и отказ уходит их текстом.
    requireMoveStatus(aId());
    // required-гвард с константной строкой: throwException('...: ' + NULL) — молчаливый
    // no-op, и без него запрос без statusId записывал бы status <- NULL (см. apiCreateTask)
    IF NOT aStatusId() THEN
        refuse('statusId required');
    IF NOT taskByAnyId(aId()) THEN
        refuse('Task not found: ' + aId());
    IF NOT taskStatus(aStatusId()) THEN
        refuse('Status not found: ' + aStatusId());

    NEWSESSION NESTED (aId, aStatusId) {
        status(taskByAnyId(aId())) <- taskStatus(aStatusId());
        APPLY;
        IF canceled() THEN
            refuse(applyMessage());
    }
} @@api;
