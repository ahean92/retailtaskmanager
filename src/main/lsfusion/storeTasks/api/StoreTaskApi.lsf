MODULE StoreTaskApi;

// FormTask — за template(Task) и лукап шаблона по коду в apiCreateTask;
// SimpleExecution — за requirePhoto(Task) там же (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskStatus, StoreTaskType, Security, GeoLog, FormTask,
        SimpleExecution;

NAMESPACE StoreTask;

// ===== Simple HTTP JSON API for the mobile (Flutter) client. =====
// Follows the project convention: @@api actions with EXPORT JSON (read) and
// reverse-lookup writes (see TaskAPI / CategoryAPI). Served on the web port, e.g.
//   GET  /exec/StoreTask.apiCurrentUser                         -> {login,name,id,geoRequired}
//   GET  /exec/StoreTask.apiTasks?lat=53.9&lon=27.56[&objectId=b24] -> [{id,objectId,distance,...}]
//   GET  /exec/StoreTask.apiNearbyObjects?lat=53.9&lon=27.56    -> [{id,name,distance[,far]},...]
//   GET  /exec/StoreTask.apiStatuses                            -> [{id,name,...}]
//   POST /exec/StoreTask.apiSetStatus  body {"id":"<taskId>","statusId":"done"} -> {}
//   POST /exec/StoreTask.apiCreateTask body {"clientId":"<uuid>","typeId":"form",...} -> {}
// Mutations take their arguments as a JSON object in the request BODY (single FILE
// parameter unpacked with IMPORT JSON ... TO()), not as query parameters — see the
// header of StoreTaskChecklistApi for the rationale and the NESTED-locals pattern.
// Authentication is HTTP Basic (the client logs in as an employee). NB: @@api does
// NOT restrict WHICH user calls an action — any authenticated account can hit any of
// these; per-user restriction happens only inside, by checking/filtering on
// currentUser() (see apiTasks). Keep that in mind when adding the next endpoint.

// --- who is behind the token: the executor profile for the mobile client ---
// Authentication itself is the platform's job (Bearer token / Basic); this action only
// answers the application-level question. A user whose account is not linked to a
// TaskPerformer gets an explicit error instead of an empty object, so the app can say
// "учётная запись не является исполнителем" right away instead of showing empty lists.
// The error is a deliberate 403 + compact JSON (statusHttpTo), NOT throwException: an
// uncaught exception comes back as HTTP 500 with a full Java stack in the body, which
// a phone can neither parse nor show.
//
// geoRequired is decided here, server-side: geolocation is mandatory unless one of the
// user's roles has the "разрешить работу без геолокации" setting (freezers and basements
// give no GPS fix — without the role escape hatch the first such case is a field
// incident). The default direction is deliberate: the flag is PRESENT (true) in the
// common case and absent only when a role explicitly allows working without geo, so a
// client that treats absence as "not required" fails open only where it was permitted.
@addRoleApplicationSetting(allowWorkWithoutGeo, 'Разрешить работу без геолокации', BOOLEAN);

// any of the user's roles is enough — same has() pattern as the АРМ role matrices
allowWorkWithoutGeo () = GROUP SUM 1 IF allowWorkWithoutGeo(UserRole r) AND has(currentUser(), r);
geoRequired () = NOT allowWorkWithoutGeo();

apiCurrentUser () {
    IF currentPerformer() THEN
        EXPORT JSON FROM
            login = currentUserLogin(),
            name = name(currentPerformer()),
            id = id(currentPerformer()),
            geoRequired = geoRequired();
    ELSE {
        statusHttpTo() <- 403;
        EXPORT JSON FROM
            error = 'notPerformer',
            message = 'Учётная запись не является исполнителем: ' + currentUserLogin();
    }
} @@api;

// --- list open tasks assigned to the calling user, narrowed by where they are ---
// The assignee filter comes from the session: the same assignedTo(Task, User) predicate
// as the desktop 'Назначенные мне' filter, so tasks assigned to somebody else never reach
// the device at all. `assigneeId` stays exported for the client's local filter.
//
// `objectId` is the addressable half of `object`: the name is what a human reads, the id
// is what a filter can be built on — "tasks of the shop I am standing in" is not
// expressible over a display name. The object's coordinates and `distance` ride along so
// a cached list stays sortable by distance on a device that has lost the network.
//
// What geolocation narrows is decided by geoRequired() — the same flag apiCurrentUser
// hands the client, so "this performer works by location" is stated once, server-side.
// A role that allows working without geo gets everything assigned to them and the
// coordinates are only decoration; everyone else gets one object's worth: the one they
// picked out of apiNearbyObjects, or the nearest when they picked nothing.
//
// Copying the parameters into LOCALs before the export is load-bearing, not style.
// Measured on this 7.0 server: a NULL *action parameter* referenced anywhere in an EXPORT
// — one value column is enough, it need not be in the WHERE — makes the whole export come
// back as a zero-byte body with content-type application/null. A NULL LOCAL does not.
// That is the real shape of the quirk that used to keep this action parameterless: not
// "parameters are unreliable", but "a NULL parameter poisons the export it appears in".
apiTasks (DOUBLE lat, DOUBLE lon, ISTRING[30] objectId) {
    // первой строкой и от сырых параметров: в журнал должно попасть то, что пришло,
    // включая пустые координаты — именно этот случай потом и разбирают
    logGeo(r'tasks', lat, lon, objectId);

    LOCAL aLat = DOUBLE();
    LOCAL aLon = DOUBLE();
    LOCAL aObject = ISTRING[30]();
    aLat() <- lat;
    aLon() <- lon;
    aObject() <- objectId;

    EXPORT JSON FROM
        id = id(Task t),
        // offline-created tasks: the phone matches this against the UUID it minted
        // and collapses its local row with the server one (#36714). NULL for
        // back-office tasks — lsFusion does not export NULL, so the key is absent.
        clientId = clientId(t),
        name = name(t),
        object = nameObject(t),
        objectId = id(checkObject(t)),
        objectLatitude = latitude(checkObject(t)),
        objectLongitude = longitude(checkObject(t)),
        // uncapped on purpose, unlike the scope test below: a task beyond the radius is
        // still worth sorting by how far away it is
        distance = distance(checkObject(t), aLat(), aLon()),
        address = addressObject(t),
        type = nameType(t),
        typeId = id(type(t)),
        status = nameStatus(t),
        statusId = id(status(t)),
        priority = namePriority(t),
        assignedTo = nameAssignedTo(t),
        assigneeId = idAssignedTo(t),
        deadline = deadline(t),
        progress = progress(t),
        subtitle = mobileSubtitle(t)
        WHERE id(t) AND opened(t) AND assignedTo(t, currentUser())
              AND (NOT geoRequired() OR checkObject(t) = chosenObject(aObject(), aLat(), aLon()));
} @@api;

// --- objects near a point, nearest first ---
// The device sends where it is; the server answers which objects are within
// nearbyRadius() of it. A list, not a single answer, and deliberately so: two shops in
// one shopping centre are metres apart and no automatic rule tells them apart, so the
// app offers the list and takes the first entry as the default.
//
// Distance is measured in PostgreSQL (CheckObject.distance), so the catalogue is filtered
// and ordered before it leaves the database — the reason to prefer this over shipping the
// whole of it and letting the phone sort it.
//
// The guard is currentPerformer(), not assignedTo(): this answers "where am I", which
// is not a question about anybody's tasks. It still has to be a performer — the object
// catalogue with its coordinates is the store network, not public data.
//
// When nothing is in radius the answer is not empty: it carries the single nearest
// object there is, marked `far`. Three situations look alike from a phone that only ever
// sees `[]` — "рядом ничего нет", "ближайший в двенадцати километрах" and "объектам не
// проставили координаты" — and they are three different things for the person to do about
// them. Only the server can tell them apart, so it says which. `distance` is therefore
// uncapped, exactly as in apiTasks.
//
// It is the *exception* that is flagged, not the rule, and that is load-bearing: lsFusion
// does not export NULL, so a flag can only ever be read as "present or not", and an older
// server — one that answers with objects inside the radius and nothing else — sends no
// flag at all. Marking the near ones would make every object from such a server look far
// and would hide the whole task list; marking the far one makes "no flag" mean "near",
// which is exactly what that older server was saying.
//
// Measured on the 7.0 server, because two kinds of nothing look alike from the outside
// and are not: omitted or empty coordinates answer an empty body with content-type
// application/null (the same effect that keeps apiTasks parameterless), and an
// unparseable number is HTTP 500 before this action runs at all. A client must not read
// "no body" as "no objects" — with coordinates in hand, `[]` is the answer, and it says
// that not one object in the catalogue has coordinates of its own.
apiNearbyObjects (DOUBLE lat, DOUBLE lon) {
    // до проверки на исполнителя: чужое обращение к каталогу объектов — как раз то,
    // что стоит видеть в журнале, а после RETURN ниже записывать было бы уже некому
    logGeo(r'nearbyObjects', lat, lon, NULL);

    IF NOT currentPerformer() THEN {
        statusHttpTo() <- 403;
        EXPORT JSON FROM
            error = 'notPerformer',
            message = 'Учётная запись не является исполнителем: ' + currentUserLogin();
        RETURN;
    }
    EXPORT JSON FROM
        id = id(CheckObject o),
        name = name(o),
        address = address(o),
        latitude = latitude(o),
        longitude = longitude(o),
        distance = distance(o, lat, lon),
        far = (TRUE IF NOT nearbyDistance(o, lat, lon))
        WHERE nearbyDistance(o, lat, lon) OR o = nearestObjectAnywhere(lat, lon)
        ORDER distance(o, lat, lon), o;
} @@api;

// --- task status dictionary (drives the status picker in the app) ---
apiStatuses () {
    EXPORT JSON FROM
        id = id(TaskStatus s),
        name = name(s),
        closed = closed(s),
        sortingOrder = sortingOrder(s)
        WHERE id(s);
} @@api;

// --- change a task status (write-back for the offline outbox) ---
apiSetStatus (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aStatusId = STRING[20]();
    IMPORT JSON FROM body AS FILE TO() aId = id, aStatusId = statusId;
    // guard first, same rule as FillApi: only the assignee may drive the status,
    // and a nonexistent id fails the same way, so probing does not reveal ids
    IF NOT assignedTo(taskByAnyId(aId()), currentUser()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT taskByAnyId(aId()) THEN
        throwException('Task not found: ' + aId());
    IF NOT taskStatus(aStatusId()) THEN
        throwException('Status not found: ' + aStatusId());

    NEWSESSION NESTED (aId, aStatusId) {
        status(taskByAnyId(aId())) <- taskStatus(aStatusId());
        APPLY;
        IF canceled() THEN
            throwException(applyMessage());
    }
} @@api;

// --- create a task minted on the phone (offline outbox, #36714) ---
// The client generates clientId (a UUID) when the task is born — possibly days ago and
// without a network — and retries this POST until an answer gets through. The retry
// check runs BEFORE the dictionary guards on purpose: a repeat of an already-created
// task must answer 200 even if a dictionary changed under it, otherwise the outbox
// jams forever. typeId is mandatory: defaultTaskType() is NULL as soon as there is
// more than one type, and a task without a type dies on the status constraint anyway.
//
// What the events fill in by themselves (StoreTaskCore) and the handle must NOT touch:
// author — the SET event takes currentPerformer(); status — the SETCHANGED(type) event
// takes the type's first status. start is special: its event is written in the
// computed form, so the explicit assignment below overrides it — but only when the
// phone actually sent a date. An unconditional `start(t) <- aCreated()` with a NULL
// date would ALSO override it and leave the task with no start date at all.
// «Template on a non-template type» is caught by the FormTask constraint after APPLY,
// through canceled()/applyMessage() — same way every other handle reports one.
// #36716 добавил: requirePhoto (флаг «фото выполнения обязательно» на задачу), photo
// (base64-фото от автора → файл задачи) и признак «внеплановая» для задач с бланком.
apiCreateTask (FILE body) {
    LOCAL aClientId = STRING[36]();
    LOCAL aTypeId = STRING[20]();
    LOCAL aObjectId = ISTRING[30]();
    LOCAL aName = ISTRING[250]();
    LOCAL aTemplateId = STRING[30]();
    LOCAL aAssigneeId = ISTRING[100]();
    LOCAL aCreated = DATE();
    LOCAL aDeadline = DATE();
    LOCAL aPriorityId = STRING[20]();
    LOCAL aDescription = ISTRING[500]();
    LOCAL aRequirePhoto = BOOLEAN();
    LOCAL aPhoto = TEXT();
    IMPORT JSON FROM body AS FILE TO() aClientId = clientId, aTypeId = typeId,
        aObjectId = objectId, aName = name, aTemplateId = templateId,
        aAssigneeId = assigneeId, aCreated = created, aDeadline = deadline,
        aPriorityId = priorityId, aDescription = description,
        aRequirePhoto = requirePhoto, aPhoto = photo;

    IF NOT currentPerformer() THEN
        throwException('Not a performer: ' + currentUserLogin());
    IF NOT aClientId() THEN
        throwException('clientId required');
    IF taskByClientId(aClientId()) THEN RETURN;    // idempotent retry: 200, no body
    // The required-guards with CONSTANT messages are load-bearing, not pedantry:
    // throwException with a NULL message is a silent no-op ('X not found: ' + NULL is
    // NULL), so without them an absent typeId/objectId sailed past its not-found guard
    // and created a typeless task — seen live on the demo stand, 2026-08-14.
    IF NOT aTypeId() THEN
        throwException('typeId required');
    IF NOT taskType(aTypeId()) THEN
        throwException('Type not found: ' + aTypeId());
    IF NOT aName() THEN
        throwException('name required');
    IF NOT aObjectId() THEN
        throwException('objectId required');
    IF NOT checkObject(aObjectId()) THEN
        throwException('Object not found: ' + aObjectId());
    IF aTemplateId() AND NOT template(aTemplateId()) THEN
        throwException('Template not found: ' + aTemplateId());
    IF aAssigneeId() AND NOT taskPerformer(aAssigneeId()) THEN
        throwException('Performer not found: ' + aAssigneeId());
    IF aPriorityId() AND NOT taskPriority(aPriorityId()) THEN
        throwException('Priority not found: ' + aPriorityId());

    NEWSESSION NESTED (aClientId, aTypeId, aObjectId, aName, aTemplateId,
                       aAssigneeId, aCreated, aDeadline, aPriorityId, aDescription,
                       aRequirePhoto, aPhoto) {
        NEW t = Task {
            clientId(t) <- aClientId();
            type(t) <- taskType(aTypeId());
            checkObject(t) <- checkObject(aObjectId());
            name(t) <- aName();
            IF aTemplateId() THEN template(t) <- template(aTemplateId());
            assignedTo(t) <- OVERRIDE taskPerformer(aAssigneeId()), currentPerformer();
            IF aCreated() THEN start(t) <- aCreated();
            deadline(t) <- aDeadline();
            IF aPriorityId() THEN priority(t) <- taskPriority(aPriorityId());
            IF aDescription() THEN description(t) <- RICHTEXT(aDescription());
            // требование фото выполнения приезжает данными пресета (#36716), не константой:
            // «позвонить поставщику» и «убрать витрину» — разные поручения
            requirePhoto(t) <- aRequirePhoto();
            // задача с бланком, рождённая этой ручкой, — внеплановая проверка: плановые
            // создаёт график (#36710) и бэк-офис
            IF usesTemplate(taskType(aTypeId())) THEN unplanned(t) <- TRUE;
            // фото от автора («вот бардак на витрине») — файлом задачи, тем же способом,
            // каким SimpleExecution.onFinish зеркалит фото выполнения
            IF aPhoto() AND aPhoto() != '' THEN {
                NEW tf = TaskFile {
                    task(tf) <- t;
                    file(tf) <- decode(aPhoto(), 'base64');
                    name(tf) <- 'Фото к задаче';
                    extension(tf) <- 'jpg';
                }
            }
        }
        // two perfectly simultaneous FIRST posts of one UUID can both pass the retry
        // check under read committed; SERIALIZABLE turns the loser into an error, and
        // the loser's retry lands on the idempotent RETURN above
        APPLY SERIALIZABLE;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;
