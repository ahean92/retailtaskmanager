MODULE FillApi;

REQUIRE Filling, FormTask, FieldType, FillOption, Resolution, Column, FillRow, ColumnCalc,
        RefValue, StoreTaskApi, Image;

NAMESPACE StoreTask;

// ===== Generic HTTP JSON API for the unified fillable engine (Filling). =====
// One template renderer on the client drives every form/checklist task. Fields are
// addressed by their stable `code` (not positionally). Mutations take a JSON body
// (single FILE param unpacked with IMPORT JSON ... TO()); reads keep an `id` query
// parameter. Read and mutation are SEPARATE actions (EXPORT after APPLY comes back
// empty on this server — see [[feedback_eval_apply]]). EVERY handle must start with
// the canTouch guard below — @@api itself lets any authenticated user in (see the
// StoreTaskApi header). A task id in any handle is either the server ST number or the
// client's offline UUID — every resolve goes through taskByAnyId (#36714).

// active (unfinished-or-latest) filling of a task
fillingTask (Task t) = GROUP LAST Filling f ORDER dateTime(f), f BY task(f);
fillingByTask (STRING[50] id) = fillingTask(taskByAnyId(id));

// Текст ответа для «прошлого значения» (#36718). Само понятие прошлой проверки —
// prevFilling — живёт в Filling.lsf (#36778): при мерже двух задач их локальное
// объявление заменено общим, чтобы «что считать прошлым» не расходилось между
// подсказкой на пункте и экраном просмотра.
boolString (Filling e, Field f) = CASE WHEN boolValue(e, f) = TTRUE THEN 'Да' WHEN boolValue(e, f) = TFALSE THEN 'Нет';
valueString (Filling e, Field f) = CASE
    WHEN typeCode(f) = 'boolean' THEN boolString(e, f)
    WHEN typeCode(f) = 'scale' THEN name(optionValue(e, f))
    WHEN typeCode(f) = 'choice' THEN name(optionValue(e, f))
    WHEN typeCode(f) = 'number' THEN STRING[20](numberValue(e, f))
    WHEN typeCode(f) = 'score' THEN STRING[20](numberValue(e, f))
    WHEN typeCode(f) = 'date' THEN STRING[20](dateValue(e, f))
    WHEN typeCode(f) = 'text' THEN textValue(e, f)
    WHEN typeCode(f) = 'longtext' THEN textValue(e, f)
    WHEN typeCode(f) = 'scan' THEN textValue(e, f);

// ===== Прошлая проверка — просмотр только для чтения (#36778) =====
// Одна адресация на все читающие ручки: по задаче (текущее заполнение), по задаче с
// prev (прошлая проверка относительно её бланка — prevFilling, см. Filling.lsf) или
// по объекту (последняя завершённая, шаблон любой — решение 2026-08-19). Просмотр
// прошлой проверки — это чтение ЧУЖОГО заполнения, поэтому гвард остаётся на точке
// входа: своей задаче (canTouch) либо, для объектного входа, на профиле исполнителя
// — как apiNearbyObjects: список объектов у клиента и так весь каталог (apiHome),
// скрывать историю от исполнителя не от кого.
requestedFilling (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) =
    CASE WHEN objectId THEN lastFinishedFilling(checkObject(objectId))
         WHEN prev THEN prevFilling(fillingByTask(id))
         ELSE fillingByTask(id);
// the field being answered, resolved from committed template data
answerField (STRING[50] id, STRING[50] fieldCode) = field(template(fillingByTask(id)), fieldCode);
resolutionByCode (STRING[30] c) = GROUP MAX Resolution r IF code(r) = c;
answerColumn (STRING[50] id, STRING[50] fieldCode, STRING[50] colCode) = column(answerField(id, fieldCode), colCode);
answerRow (STRING[50] id, STRING[36] rowKey) = row(fillingByTask(id), rowKey);

// --- access guard: the task must be assigned to the calling user ---
// The same assignedTo(Task, User) predicate as apiTasks, so the surface stays
// consistent: a task the list does not return can be neither read nor written by
// id. The guard runs FIRST in every handle — a nonexistent id fails it the same
// way as somebody else's, so probing does not reveal which ids exist. Reads
// answer 403 + compact JSON (an uncaught exception is HTTP 500 with a Java stack
// — see apiCurrentUser); mutations throwException like their neighbouring checks.
canTouch (STRING[50] id) = assignedTo(taskByAnyId(id), currentUser());

denyTask (STRING[50] id) {
    statusHttpTo() <- 403;
    EXPORT JSON FROM error = 'forbidden',
        message = 'Задача не назначена на текущего пользователя: ' + id;
}

// Гвард и отказ читающих ручек в трёх режимах адресации (#36778): задачные режимы —
// прежний canTouch, объектный — профиль исполнителя (см. requestedFilling).
canRead (STRING[50] id, ISTRING[30] objectId) =
    IF objectId THEN (TRUE IF currentPerformer()) ELSE canTouch(id);

denyRead (STRING[50] id, ISTRING[30] objectId) {
    IF objectId THEN denyNotPerformer();
    ELSE denyTask(id);
}

// Общая преамбула читающих ручек, ровно один раз: параметры переписаны в локали
// (NULL-параметр экшена, попавший в EXPORT, отдаёт пустое тело — см. apiTasks, а
// здесь NULL — норма для двух из трёх режимов), гвард отработал, заполнение
// найдено. Гвард — вещь, которую нельзя забыть в седьмой ручке, поэтому он живёт
// здесь, а не в шести копиях; ручка после вызова смотрит readDenied и читает
// readFilling.
readDenied = DATA LOCAL BOOLEAN ();
readFilling = DATA LOCAL Filling ();
resolveRead (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    LOCAL aId = STRING[50]();
    LOCAL aPrev = STRING[10]();
    LOCAL aObjectId = ISTRING[30]();
    aId() <- id;
    aPrev() <- prev;
    aObjectId() <- objectId;
    IF NOT canRead(aId(), aObjectId()) THEN {
        denyRead(aId(), aObjectId());
        readDenied() <- TRUE;
        RETURN;
    }
    readFilling() <- requestedFilling(aId(), aPrev(), aObjectId());
}

// --- ensure a Filling exists for the task ---
// «Ensure» означает «создать, только если заполнения нет вовсе». Завершённое — не
// повод заводить второе: fillingTask — это GROUP LAST, и пустой дубль перекрыл бы
// собой готовое заполнение во всех чтениях, а startExecution откатил бы статус
// задачи в работу. Мобильный клиент зовёт эту ручку при каждом открытии бланка,
// включая просмотр завершённой проверки (#36716, ревью).
//
// lat/lon/at (#36838) — где и когда, ПО ЧАСАМ УСТРОЙСТВА, человек открыл бланк:
// клиент снимает их в момент действия и возит в очереди вместе с самим стартом,
// поэтому дожим офлайн-смены не подменяет место работы местом появления сети.
// Пишутся туда же, где создаётся выполнение, — и только там: ручку зовут при каждом
// открытии бланка, и запись вне этой ветки затирала бы первую точку последней.
// Старый клиент полей не шлёт — NULL поверх NULL внутри той же ветки безвреден.
apiStartExecution (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aLat = DOUBLE();
    LOCAL aLon = DOUBLE();
    LOCAL aAt = DATETIME();
    IMPORT JSON FROM body AS FILE TO() aId = id, aLat = lat, aLon = lon, aAt = at;
    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT taskByAnyId(aId()) THEN
        throwException('Task not found: ' + aId());
    IF NOT fillingByTask(aId()) THEN
        NEWSESSION NESTED (aId, aLat, aLon, aAt) {
            startExecution(taskByAnyId(aId()));
            startedAt(taskByAnyId(aId())) <- aAt();
            startedLatitude(taskByAnyId(aId())) <- aLat();
            startedLongitude(taskByAnyId(aId())) <- aLon();
            APPLY;
            IF canceled() THEN throwException(applyMessage());
        }
} @@api;

// --- filling header (single JSON object) ---
// Читающие ручки принимают одну тройку адресации (id[, prev][, objectId]) — см.
// resolveRead; старый клиент шлёт только id и получает прежний ответ.
apiExecutionInfo (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    resolveRead(id, prev, objectId);
    IF readDenied() THEN RETURN;
    EXPORT JSON FROM
        object = nameObject(readFilling()),
        template = nameTemplate(readFilling()),
        state = nameState(readFilling()),
        finished = finished(readFilling()),
        // дата и автор проверки — шапка просмотра (#36778): «в прошлый раз» без даты
        // бесполезно, вчера это было или полгода назад — разные выводы
        date = dateTime(readFilling()),
        executor = nameExecutor(readFilling()),
        remarks = countNonconformity(readFilling()),
        hasScored = (TRUE IF hasScored(readFilling())),
        percent = percent(readFilling()),
        verdict = nameVerdict(readFilling()),
        passed = passed(readFilling()),
        threshold = threshold(readFilling()),
        resolution = nameResolution(readFilling()),
        resolutionRequired = resolutionRequired(template(readFilling())),
        missingEvidence = missingEvidence(readFilling()),
        missingRequired = missingRequired(readFilling()),
        answered = answeredCount(readFilling()),
        total = totalFields(readFilling()),
        // итог прошлой проверки для шапки текущего бланка: «прошлая проверка 12.07 —
        // 78 %, 3 замечания». Отсутствие prevDate = по этому объекту и шаблону
        // завершённых проверок ещё не было — клиент не рисует ни строку, ни вход.
        prevDate = dateTime(prevFilling(readFilling())),
        prevPercent = percent(prevFilling(readFilling())),
        prevRemarks = countNonconformity(prevFilling(readFilling()));
} @@api;

// --- fields with the current values (flat; client groups by section) ---
apiExecutionFields (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    resolveRead(id, prev, objectId);
    IF readDenied() THEN RETURN;
    EXPORT JSON FROM
        sectionIndex = sectionIndex(Field it),
        section = nameSection(it),
        fieldIndex = index(it),
        code = code(it),
        name = name(it),
        hint = hint(it),
        type = typeCode(it),
        unit = unit(it),
        minNorm = minNorm(it),
        maxNorm = maxNorm(it),
        step = step(it),
        required = required(it),
        requirePhoto = requirePhoto(it),
        requireComment = requireComment(it),
        critical = critical(it),
        weight = weight(it),
        optionCode = code(optionValue(readFilling(), it)),
        number = numberValue(readFilling(), it),
        text = textValue(readFilling(), it),
        bool = boolValue(readFilling(), it),
        date = dateValue(readFilling(), it),
        comment = comment(readFilling(), it),
        hasPhoto = (TRUE IF countPhoto(readFilling(), it)),
        photoCount = countPhoto(readFilling(), it),
        // фактические индексы снимков («1,3»): после удаления индексы не уплотняются,
        // и «от 1 до photoCount» промахнулся бы мимо снимков за дырой
        photoIndexes = photoIndexes(readFilling(), it),
        nonconformity = nonconformity(readFilling(), it),
        needsEvidence = needsEvidence(readFilling(), it),
        itemScore = itemScore(readFilling(), it),
        itemMax = itemMax(readFilling(), it),
        // Прошлое значение текстом (#36718) выключено при мерже с #36778, 19.08.2026.
        // Это ручка МОБИЛЬНОГО бланка, а #36778 («Почему на плитке нет значения»)
        // строит защиту конструкцией: прошлого ответа рядом с вводом нет даже в
        // данных — иначе любая будущая версия клиента выведет его на плитку одной
        // строкой, и проверка снова начнёт списывать сама себя. Прошлое смотрят
        // экраном просмотра (эти же ручки с prev=1) — там значение целиком, с
        // комментарием и фото. valueString выше оставлен: он нужен будущей
        // десктопной подписи #36718, где бланк заполняют не стоя у витрины.
        // prevValue = valueString(prevFilling(readFilling()), it),
        // указатель на плитке (#36778): только факт «в прошлый раз здесь было
        // замечание», без значения — прошлое значение рядом с вводом притягивает
        // ответ, поэтому оно живёт исключительно на экране просмотра
        prevNonconformity = (TRUE IF nonconformity(prevFilling(readFilling()), it))
        WHERE template(it) = template(readFilling());
} @@api;

// --- options for scale/choice fields (keyed by field code) ---
apiExecutionOptions (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    resolveRead(id, prev, objectId);
    IF readDenied() THEN RETURN;
    EXPORT JSON FROM
        fieldCode = code(Field it),
        code = code(Option o),
        name = name(o),
        score = score(o),
        nonconformity = nonconformity(o),
        notApplicable = notApplicable(o)
        WHERE template(it) = template(readFilling()) AND optionSet(o) = optionSet(it);
} @@api;

// --- columns of the template's table fields (keyed by field code) ---
apiExecutionColumns (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    resolveRead(id, prev, objectId);
    IF readDenied() THEN RETURN;
    EXPORT JSON FROM
        fieldCode = code(tableField(Column c)),
        colCode = code(c),
        name = name(c),
        type = typeCode(c),
        unit = unit(c),
        minNorm = minNorm(c),
        maxNorm = maxNorm(c),
        readonly = readonly(c),
        compareTo = compareTo(c),
        calcKind = calcKind(c),
        operandA = operandA(c),
        operandB = operandB(c),
        constA = constA(c),
        constB = constB(c),
        totalMode = totalMode(c),
        total = columnTotal(readFilling(), c),
        colIndex = index(c)
        WHERE template(c) = template(readFilling());
} @@api;

// --- table rows with their cell values (one JSON object per row×column cell) ---
apiExecutionRows (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    resolveRead(id, prev, objectId);
    IF readDenied() THEN RETURN;
    EXPORT JSON FROM
        fieldCode = code(tableField(FillRow r)),
        rowIndex = index(r),
        rowKey = rowKey(r),
        subjectId = subjectId(r),
        subject = name(r),
        colCode = code(Column c),
        number = cellNumber(r, c),
        value = cellValue(r, c),
        text = cellText(r, c),
        optionCode = code(cellOption(r, c))
        WHERE filling(r) = readFilling() AND tableField(c) = tableField(r);
} @@api;

apiSetCell (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aKey = STRING[36]();
    LOCAL aCol = STRING[50]();
    LOCAL aNumber = NUMERIC[14,3]();
    LOCAL aText = ISTRING[250]();
    LOCAL aOpt = STRING[30]();
    IMPORT JSON FROM body AS FILE TO()
        aId = id, aField = field, aKey = rowKey, aCol = col,
        aNumber = number, aText = text, aOpt = optCode;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    IF NOT answerField(aId(), aField()) THEN throwException('Field not found');
    IF NOT answerColumn(aId(), aField(), aCol()) THEN throwException('Column not found');
    IF NOT answerRow(aId(), aKey()) AND NOT allowManual(answerField(aId(), aField())) THEN
        throwException('Row not found');
    NEWSESSION NESTED (aId, aField, aKey, aCol, aNumber, aText, aOpt) {
        IF NOT answerRow(aId(), aKey()) THEN
            NEW r = FillRow {
                filling(r) <- fillingByTask(aId());
                tableField(r) <- answerField(aId(), aField());
                rowKey(r) <- aKey();
            }
        FOR FillRow r = answerRow(aId(), aKey()) AND Column c = answerColumn(aId(), aField(), aCol()) DO {
            IF type(c) = FieldType.number THEN cellNumber(r, c) <- aNumber();
            IF type(c) = FieldType.text OR type(c) = FieldType.scan THEN cellText(r, c) <- (aText() IF aText() != '');
            IF type(c) = FieldType.scale OR type(c) = FieldType.choice THEN cellOption(r, c) <- option(optionSet(c), aOpt());
        }
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

apiAddRow (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aKey = STRING[36]();
    LOCAL aSubjectId = ISTRING[50]();
    LOCAL aSubjectName = ISTRING[150]();
    IMPORT JSON FROM body AS FILE TO()
        aId = id, aField = field, aKey = rowKey, aSubjectId = subjectId, aSubjectName = subjectName;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    IF NOT answerField(aId(), aField()) THEN throwException('Field not found');
    IF NOT allowManual(answerField(aId(), aField())) THEN throwException('Manual rows not allowed');
    NEWSESSION NESTED (aId, aField, aKey, aSubjectId, aSubjectName) {
        IF NOT answerRow(aId(), aKey()) THEN
            NEW r = FillRow {
                filling(r) <- fillingByTask(aId());
                tableField(r) <- answerField(aId(), aField());
                rowKey(r) <- aKey();
                subject(r) <- refValue(subjectKind(answerField(aId(), aField())), aSubjectId());
                subjectName(r) <- OVERRIDE (aSubjectName() IF aSubjectName() != ''),
                                           name(refValue(subjectKind(answerField(aId(), aField())), aSubjectId()));
            }
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

apiDeleteRow (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aKey = STRING[36]();
    IMPORT JSON FROM body AS FILE TO() aId = id, aKey = rowKey;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    NEWSESSION NESTED (aId, aKey) {
        DELETE answerRow(aId(), aKey());
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

apiRowSubjects (STRING[50] id, STRING[50] field, ISTRING[100] query) {
    IF NOT canTouch(id) THEN { denyTask(id); RETURN; }
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aQuery = ISTRING[100]();
    aId() <- id;
    aField() <- field;
    aQuery() <- query;
    EXPORT JSON FROM
        subjectId = id(RefValue v),
        name = name(v),
        kind = kind(v)
        WHERE kind(v) = subjectKind(answerField(aId(), aField()))
          AND (NOT aQuery() OR isSubstring(name(v), aQuery()));
} @@api;

// --- set one field value (dispatched by the field's type) ---
apiSetField (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aOpt = STRING[30]();
    LOCAL aNumber = NUMERIC[14,4]();
    LOCAL aText = ISTRING[500]();
    LOCAL aBool = TBOOLEAN();
    LOCAL aDate = DATE();
    LOCAL aComment = ISTRING[500]();
    IMPORT JSON FROM body AS FILE TO()
        aId = id, aField = field, aOpt = optCode, aNumber = number,
        aText = text, aBool = bool, aDate = date, aComment = comment;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    IF NOT answerField(aId(), aField()) THEN throwException('Field not found');
    NEWSESSION NESTED (aId, aField, aOpt, aNumber, aText, aBool, aDate, aComment) {
        FOR Filling e = fillingByTask(aId()) AND Field f = answerField(aId(), aField()) DO {
            IF type(f) = FieldType.scale OR type(f) = FieldType.choice THEN
                optionValue(e, f) <- option(optionSet(f), aOpt());
            // score shares the numeric slot with number — it is a different way of
            // earning points, not a different way of storing them
            IF type(f) = FieldType.number OR type(f) = FieldType.score THEN
                numberValue(e, f) <- aNumber();
            IF type(f) = FieldType.boolean THEN boolValue(e, f) <- aBool();
            IF type(f) = FieldType.text OR type(f) = FieldType.longtext OR type(f) = FieldType.scan THEN
                textValue(e, f) <- (aText() IF aText() != '');
            IF type(f) = FieldType.date THEN dateValue(e, f) <- aDate();
            comment(e, f) <- (aComment() IF aComment() != '');
        }
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

// --- append a photo to a field (0..N per field) ---
// An empty `photo` clears them all — that is how the client cancels the whole set; a single
// shot is removed by index through apiDeleteFieldPhoto below.
apiSetFieldPhoto (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aPhoto = TEXT();
    IMPORT JSON FROM body AS FILE TO() aId = id, aField = field, aPhoto = photo;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    IF NOT answerField(aId(), aField()) THEN throwException('Field not found');
    NEWSESSION NESTED (aId, aField, aPhoto) {
        IF aPhoto() = '' THEN
            photo(fillingByTask(aId()), answerField(aId(), aField()), INTEGER i) <- NULL;
        ELSE
            photo(fillingByTask(aId()), answerField(aId(), aField()),
                  (OVERRIDE lastPhotoIndex(fillingByTask(aId()), answerField(aId(), aField())), 0) + 1) <-
                IMAGEFILE(decode(aPhoto(), 'base64'));
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

// --- read one photo back: full size or a thumbnail (#36778) ---
// Ровно та «отдельная фича», ради которой чтение раньше не выставлялось: показать
// снимки, сделанные на ДРУГОМ устройстве, — просмотр прошлой проверки и завершённого
// бланка. Адресация та же тройка, что у читающих ручек, плюс поле и индекс снимка.
// thumb отдаёт миниатюру (длинная сторона 256): просмотр в поле не должен качать
// мегабайты по мобильной сети; полный размер клиент просит по явному тапу.
// Ответ — сырые байты jpg (exportFile), не base64 в JSON: треть трафика экономится
// ровно там, где он дороже всего.
apiFieldPhoto (STRING[50] id, STRING[50] field, INTEGER index, STRING[10] thumb,
               STRING[10] prev, ISTRING[30] objectId) {
    resolveRead(id, prev, objectId);
    IF readDenied() THEN RETURN;
    LOCAL aField = STRING[50]();
    LOCAL aThumb = STRING[10]();
    aField() <- field;
    aThumb() <- thumb;
    // одна выборка снимка на всю ручку: проверка, ресайз и обе ветки отдачи обязаны
    // говорить об одном и том же фото
    LOCAL ph = IMAGEFILE ();
    ph() <- photo(readFilling(), field(template(readFilling()), aField()), index);
    IF NOT ph() THEN {
        statusHttpTo() <- 404;
        EXPORT JSON FROM error = 'notFound',
            message = 'Фото не найдено: ' + (OVERRIDE aField(), '?');
        RETURN;
    }
    IF aThumb() THEN {
        // Миниатюра — оптимизация, а не обязательство: снимок, который ImageIO не
        // смог прочесть (битый файл, экзотика), едет оригиналом, а не валит запрос
        // в 500 (поймано на демо-стенде: сид #36716 держит PNG с кривым zlib).
        TRY resizeImageMaxSize(ph(), 256);
        // ASSIGN не приводит IMAGEFILE к FILE неявно — каст обязателен
        exportFile() <- FILE(OVERRIDE resizedImage(), ph());
    } ELSE
        exportFile() <- FILE(ph());
} @@api;

// --- remove one photo by its index; the remaining ones keep their indices ---
apiDeleteFieldPhoto (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aIndex = INTEGER();
    IMPORT JSON FROM body AS FILE TO() aId = id, aField = field, aIndex = index;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    IF NOT answerField(aId(), aField()) THEN throwException('Field not found');
    NEWSESSION NESTED (aId, aField, aIndex) {
        photo(fillingByTask(aId()), answerField(aId(), aField()), aIndex()) <- NULL;
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

// --- set the outcome ---
apiSetResolution (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aRes = STRING[30]();
    IMPORT JSON FROM body AS FILE TO() aId = id, aRes = resolution;

    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    NEWSESSION NESTED (aId, aRes) {
        resolution(fillingByTask(aId())) <- resolutionByCode(aRes());
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;

// --- finish (validates required/evidence/resolution via constraints, closes the task) ---
// lat/lon/at (#36838) — где и когда, по часам устройства, человек нажал «Завершить»
// (см. apiStartExecution). Гвард NOT finished — та же запись-однажды, что у старта:
// точка завершения принадлежит ПЕРВОМУ завершению, а ручку могут позвать повторно —
// ретрай очереди, у которого доехал finish, но потерялся ответ. Отсутствие координат
// завершение не блокирует: пусто — тоже факт. Пишутся до finish() и уезжают его же
// APPLY; отказ валидации откатывает сессию целиком — точки без завершения не будет.
apiFinishExecution (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aLat = DOUBLE();
    LOCAL aLon = DOUBLE();
    LOCAL aAt = DATETIME();
    IMPORT JSON FROM body AS FILE TO() aId = id, aLat = lat, aLon = lon, aAt = at;
    IF NOT canTouch(aId()) THEN
        throwException('Task not assigned to current user: ' + aId());
    IF NOT fillingByTask(aId()) THEN throwException('Filling not found');
    NEWSESSION NESTED (aId, aLat, aLon, aAt) {
        IF NOT finished(fillingByTask(aId())) THEN {
            finishedAt(taskByAnyId(aId())) <- aAt();
            finishedLatitude(taskByAnyId(aId())) <- aLat();
            finishedLongitude(taskByAnyId(aId())) <- aLon();
        }
        finish(fillingByTask(aId()));
        APPLY;
        IF canceled() THEN throwException(applyMessage());
    }
} @@api;
