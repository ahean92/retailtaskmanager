MODULE HomeApi;

// HomeScreen — блоки, показатели и новости главной (сама модель); CheckObject — объекты
// в выдаче, разрез показателей, радиус главной (homeDistance), места (isSite, isPlace,
// placeOf); StoreTaskCore —
// opened/participant/checkObject в отборе объектов главной (#37047); TaskPerformer —
// currentPerformer в гварде apiObjects; StoreTaskRights — allowMetricImport, право импорта
// показателей; Authentication — currentUser()/currentUserLogin();
// Time — отметка времени показателя; ApiCommon — конвенции ручек и denyNotPerformer;
// StoreTaskTakeover — holds (мои задачи на сегодня); CheckObjectAccess — available, какие
// объекты исполнителю можно выбирать.
// Перечислено явно, транзитивному REQUIRE не доверять.
// StoreTaskRefusal — refuse: отказ по существу кодом 422 вместо 500
REQUIRE HomeScreen, CheckObject, StoreTaskCore, TaskPerformer, Authentication, Time, ApiCommon,
        StoreTaskRights, StoreTaskTakeover, CheckObjectAccess, StoreTaskRefusal;

NAMESPACE StoreTask;

// ===== Главная страница мобильного клиента и приём показателей извне. =====
//   GET  /exec/StoreTask.apiHome[?lat=&lon=&objectId=&scope=self] -> {objects:[...], blocks:[{metrics,news},...]}
//        у показателя и его разреза time — когда значение прислала внешняя система (dataTime)
//   GET  /exec/StoreTask.apiObjects   -> [{id,name,address,latitude,longitude},...]
//   POST /exec/StoreTask.apiSetMetric body {"code":"sales","object":"SOS-101","value":42}
// Ручки живут отдельно от модели (HomeScreen): настройка главной — это формы и
// справочники администратора, а это — поверхность для телефона и внешней системы.

// --- какие объекты нужны главной этого человека здесь и сейчас (#37047) ---
// В радиусе главной от присланных координат — плюс места его открытых задач. Второе
// слагаемое обязательно: человек, уехавший из магазина, иначе потерял бы из выбора магазин
// задачи, которую ему там делать. Участие — то же participant, что отбирает apiTasks:
// список задач и выбор объекта на главной обязаны говорить об одних и тех же объектах.
//
// И там и там — места (CheckObject.isPlace), а не всё, что стоит внутри них. Радиус меряет
// координаты, а у кассы и весов координаты магазина, поэтому без гварда isSite в радиус
// попадало всё оборудование магазина; задача на весах по той же причине приносит в выбор
// магазин, а не весы. Разрез показателей по кассе смысла не имеет, а выбор на главной — это
// «чьи числа смотреть».
//
// Радиус — только среди объектов, которые исполнителю можно выбирать (CheckObjectAccess:
// «Доступ к объектам»); места своих задач — без этого условия, по той же причине, по какой
// они здесь вообще: задачу на чужом объекте человеку всё равно делать.
homeObject (CheckObject o, DOUBLE lat, DOUBLE lon) = TRUE IF
    (homeDistance(o, lat, lon) AND isSite(o) AND available[TaskPerformer, CheckObject](currentPerformer(), o))
    OR (GROUP SUM 1 IF opened(Task t) AND participant(t, currentUser()) AND placeOf(checkObject(t)) = o);

// Одним ответом, а не ручкой на блок: клиент рисует главную целиком, и собирать её из
// нескольких запросов значило бы уметь пережить сбой любого из них на полпути.
// Пустые вложенные массивы в ответ не попадают — клиент считает их отсутствие пустотой.
// Новости отдаются по возрастанию даты: DESC во вложенном JSON FROM не отрабатывает
// (проверено), поэтому ленту разворачивает клиент.
//
// Объекты и разрез показателей по ним — не весь каталог, а отбор homeObject плюс объект,
// который человек выбрал сам (objectId): выбранный из каталога объект вне радиуса и без
// задач иначе никогда не получил бы своих чисел в разрезе (#37047). На сети в сотни
// объектов весь каталог был единицами килобайт, и телефону было всё равно; на сети в
// три тысячи объектов ответ весил 400 КБ, уезжал при каждом возврате на главную и был
// девятью десятыми всего трафика клиента, а показатели в разрезе объекта считались по
// всем трём тысячам на каждый показатель. Полный каталог телефон докачивает фоном
// (apiObjects) и держит у себя — выбор объекта на главной остаётся мгновенным и офлайн,
// а числа выбранного объекта приезжают следующим apiHome.
//
// Без координат и без scope — выдача целиком: так телефон зовёт ручку, пока каталога у
// него в базе ещё нет. Клиент, у которого каталог уже в базе, просит без координат scope=self: объекты — места его открытых задач и выбранный
// objectId, как с координатами, только без радиуса. Телефон без точки (подвал, отказ в
// разрешении, холодный старт) — обычный случай, и полный разрез по сети в три тысячи мест
// весил 740 КБ на каждый возврат на главную против единиц килобайт и считался на секунду
// дольше. Параметры переписываются в LOCAL до экспорта — NULL-параметр действия в EXPORT
// обнуляет весь ответ (ApiCommon).
// Гео-журнал не пишется: он отвечает на «почему список задач пуст», а состав главной
// на список не влияет.
//
// Отбор объектов тоже считается в LOCAL до экспорта, а не выражением внутри него. Внутри
// JSON FROM homeObject (радиус, участие в задачах, дерево мест) подставлялся в запрос
// дважды — в objects и в разрез показателей, — а разрез размножается по веткам
// необязательных полей показателя. На стенде «Соседей» при 16 блоках и 28 показателях
// текст SQL дорос до 6 МБ, и сервер отказывал TOO LONG QUERY всем пользователям, с
// координатами и без, — главная не открывалась ни у кого, даже когда лишние блоки
// выключены. Посчитанный заранее отбор — одна временная таблица, и размер запроса больше
// не зависит от того, сколько показателей настроено.
//
// Объекты — только исполнителю: каталог мест с адресами — данные сети, apiObjects их
// не-исполнителю не отдаёт, и главная не должна отдавать их в обход, ни целиком, ни
// перебором координат и objectId. Блоки и новости при этом остаются: интеграционная или
// служебная учётка получает главную без выбора объекта, а не отказ. Архивные объекты не
// предлагаются никому; весь каталог и выбранный objectId — в пределах «Доступа к объектам».
apiHome (DOUBLE lat, DOUBLE lon, ISTRING[30] objectId, STRING[10] scope) {
    IF callerLocked() THEN { denyLocked(); RETURN; } // #37179
    LOCAL aLat = DOUBLE ();
    LOCAL aLon = DOUBLE ();
    LOCAL aObject = CheckObject ();
    LOCAL whole = BOOLEAN ();
    LOCAL picked = BOOLEAN (CheckObject);
    aLat() <- lat;
    aLon() <- lon;
    aObject() <- checkObject(objectId);
    IF NOT (lat AND lon) AND NOT (scope = 'self') THEN whole() <- TRUE;
    picked(CheckObject o) <- TRUE WHERE id(o) AND currentPerformer() AND NOT archived(o)
        AND ((((whole() AND isPlace(o)) OR o = aObject()) AND available[TaskPerformer, CheckObject](currentPerformer(), o))
             OR homeObject(o, aLat(), aLon()));

    // Значения показателей — тоже до экспорта, по сети и в разрезе. value и previous — CASE по
    // всем показателям всех модулей (calcValue), и внутри JSON FROM он подставлялся в каждую
    // ветку необязательных полей каждого блока: на данных стенда с разрезом по месту текст SQL
    // дорос до 10 МБ, и TOO LONG QUERY отказывал главной у всех. Отдельное присваивание —
    // один CASE на запрос.
    LOCAL shown = BOOLEAN (HomeMetric);
    LOCAL netValue = NUMERIC[18,4] (HomeMetric);
    LOCAL netPrevious = NUMERIC[18,4] (HomeMetric);
    LOCAL objValue = NUMERIC[18,4] (HomeMetric, CheckObject);
    LOCAL objPrevious = NUMERIC[18,4] (HomeMetric, CheckObject);
    shown(HomeMetric m) <- TRUE WHERE active(m) AND visible(block(m));
    netValue(HomeMetric m) <- value(m) WHERE shown(m);
    netPrevious(HomeMetric m) <- previous(m) WHERE shown(m);
    objValue(HomeMetric m, CheckObject o) <- value(m, o) WHERE shown(m) AND byObject(block(m)) AND picked(o);
    objPrevious(HomeMetric m, CheckObject o) <- previous(m, o) WHERE shown(m) AND byObject(block(m)) AND picked(o);

    EXPORT JSON FROM
        objects = (JSON FROM
            id = id(CheckObject o),
            name = name(o),
            address = address(o)
            WHERE picked(o)
            ORDER name(o), o),
        blocks = (JSON FROM
            code = code(HomeBlock b),
            type = code(type(b)),
            view = code(view(b)),
            byObject = byObject(b),
            title = title(b),
            subtitle = subtitle(b),
            icon = icon(b),
            body = body(b),
            metrics = (JSON FROM
                code = code(HomeMetric m),
                name = name(m),
                value = netValue(m),
                previous = netPrevious(m),
                target = target(m),
                unit = unit(m),
                color = color(m),
                // Переход — только у плиток «своих» задач (mineOnly): список телефона — это
                // задачи самого человека, и сетевая плитка супервайзера («Просрочено 12»)
                // открывала бы его собственные просрочки. Без filter плитка на телефоне не
                // нажимается; сетевой список на телефоне — отдельная работа. Веб переходит
                // по своему фильтру (HomeDashboard) и этим не затронут.
                filter = (codeTaskFilter(m) IF mineOnly(m)),
                trend = codeTrend(m),
                inverse = inverse(m),
                time = dataTime(m),
                // Разрез — по тем же объектам, что и objects, и без условия непустоты:
                // дырку в values клиент не отличает от «данных нет» и подставляет
                // сетевую цифру, а разрез по объекту на то и разрез, чтобы в нём был
                // каждый объект из objects.
                values = (JSON FROM
                    object = id(CheckObject po),
                    value = objValue(m, po),
                    previous = objPrevious(m, po),
                    target = target(m, po),
                    time = dataTime(m, po)
                    WHERE byObject(b) AND picked(po)
                    ORDER name(po), po)
                WHERE block(m) = b AND shown(m)
                ORDER metricOrder(m), m),
            news = (JSON FROM
                date = date(HomeNews n),
                title = title(n),
                body = body(n)
                WHERE block(n) = b AND active(n)
                ORDER date(n), n)
            WHERE visible(b)
            ORDER blockOrder(b), b),
        // «Сегодня сделано N из M» (#37411, стр. 2) — полоса дня над списком задач.
        // Пара чисел считается сервером: закрытые задачи из выдачи телефона исчезают,
        // и клиенту её не собрать. M — задачи со сроком сегодня, которые человек держит
        // (взял или назначенные лично на него, StoreTaskTakeover.holds); N — сделанные из
        // них. Сданная на приёмку — сделана: работа сдана, решение за принимающим, и
        // возврат на доработку снова делает её несделанной. Поэтому не mine и не
        // dueTodayTask — оба сданную исключают, и сдача уменьшала бы M вместо того, чтобы
        // прибавить к N. Отменённая не входит ни в одно число: снятая задача — не работа.
        // OVERRIDE 0 держит ноль в ответе тем же приёмом, что dueToday в apiTasks: пустой
        // GROUP SUM — NULL, и ключ бы пропадал
        todayDone = (OVERRIDE (GROUP SUM 1 IF holds(Task t, currentPerformer()) AND deadline(t) = currentDate()
                                             AND NOT canceledTask(t) AND (closed(t) OR onAcceptance(t))), 0),
        todayTotal = (OVERRIDE (GROUP SUM 1 IF holds(Task t, currentPerformer()) AND deadline(t) = currentDate()
                                              AND NOT canceledTask(t)), 0);
} @@api;

// --- полный каталог объектов для фоновой докачки на телефон (#37047) ---
// Ключ, название, адрес и координаты — то, чем телефон предлагает выбор объекта на
// главной без сети. Отдельной ручкой, а не внутри apiHome: главная зовётся при каждом
// возврате на экран, а каталог меняется редко, и телефон тянет его только при смене
// catalogVersion (apiCurrentUser). Гвард — исполнитель, как у apiNearbyObjects: каталог
// с координатами — это сеть магазинов, а не публичные данные.
//
// В каталоге только места (isPlace), по той же причине, что в homeObject: из него телефон
// строит выбор объекта на главной, и полный каталог приносил туда все кассы и весы сети
// (2846 строк вместо 321 магазина у Соседей). Правка отбора поднимает catalogRule —
// иначе кэш по старому правилу жил бы на телефонах.
//
// Без архивных (закрытый магазин не предлагается как «где я») и в пределах «Доступа к
// объектам» (CheckObjectAccess.available): заведующей — её магазины, а не вся сеть.
apiObjects () {
    IF NOT currentPerformer() THEN { denyNotPerformer(); RETURN; }
    EXPORT JSON FROM
        id = id(CheckObject o),
        name = name(o),
        address = address(o),
        latitude = latitude(o),
        longitude = longitude(o)
        WHERE id(o) AND isPlace(o) AND NOT archived(o)
            AND available[TaskPerformer, CheckObject](currentPerformer(), o)
        ORDER name(o), o;
} @@api;

// Приём показателя извне. Показатель адресуется своим кодом, объект — своим: внешней
// системе не нужно знать внутренние идентификаторы. Без `object` значение считается
// сетевым, с ним — записывается в разрез этого объекта. `previous` присылать не нужно:
// старое значение сдвигается само, поле есть только для загрузки истории задним числом.
//
// `value` обязательно: присылка без него стёрла бы текущее число, а оно само уехало бы в
// «Пред. значение». `target` — нет: интеграция, которая шлёт только факт, план не трогает,
// иначе «Шкала выполнения» пропадала бы при первой же штатной присылке. Сбросить план
// отсюда нельзя — IMPORT JSON не отличает `null` от отсутствия поля; это делает форма.
//
// Ручку может дёрнуть любая аутентифицированная учётка (@@api не различает — см. шапку
// ApiCommon), а перезаписывать показатели должна только интеграционная: право
// выдаётся её роли явной настройкой — тот же приём, что allowWorkWithoutGeo.
apiSetMetric (FILE payload) {
    requireUnlocked(); // #37179: заблокированная интеграционная учётка — тоже отказ
    IF NOT allowMetricImport() THEN
        refuse('Metric import is not permitted for user: ' + currentUserLogin());
    LOCAL aCode = STRING[30]();
    LOCAL aObject = ISTRING[30]();
    LOCAL aValue = NUMERIC[18,4]();
    LOCAL aTarget = NUMERIC[18,4]();
    LOCAL aPrevious = NUMERIC[18,4]();
    IMPORT JSON FROM payload AS FILE TO() aCode = code, aObject = object,
        aValue = value, aTarget = target, aPrevious = previous;
    // required-гварды с константным текстом: 'Metric not found: ' + NULL молча не бросает
    IF NOT aCode() THEN
        refuse('code required');
    IF NOT aValue() THEN
        refuse('value required');
    IF NOT homeMetric(aCode()) THEN
        refuse('Metric not found: ' + aCode());
    IF aObject() AND NOT checkObject(aObject()) THEN
        refuse('Object not found: ' + aObject());

    NEWSESSION NESTED (aCode, aObject, aValue, aTarget, aPrevious) {
        IF aObject() THEN {
            dataValue(homeMetric(aCode()), checkObject(aObject())) <- aValue();
            IF aTarget() THEN
                target(homeMetric(aCode()), checkObject(aObject())) <- aTarget();
            IF aPrevious() THEN
                dataPrevious(homeMetric(aCode()), checkObject(aObject())) <- aPrevious();
            // время — своего уровня: присылка по магазину сетевое число свежим не делает
            dataTime(homeMetric(aCode()), checkObject(aObject())) <- currentDateTime();
        } ELSE {
            dataValue(homeMetric(aCode())) <- aValue();
            IF aTarget() THEN
                target(homeMetric(aCode())) <- aTarget();
            IF aPrevious() THEN
                dataPrevious(homeMetric(aCode())) <- aPrevious();
            dataTime(homeMetric(aCode())) <- currentDateTime();
        }
        APPLY;
        IF canceled() THEN
            refuse(applyMessage());
    }
} @@api;
