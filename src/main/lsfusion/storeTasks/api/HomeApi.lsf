MODULE HomeApi;

// HomeScreen — блоки, показатели и новости главной (сама модель); CheckObject — объекты
// в выдаче, разрез показателей, радиус главной (homeDistance); StoreTaskCore —
// opened/participant/checkObject в отборе объектов главной (#37047); TaskPerformer —
// currentPerformer в гварде apiObjects; Security — @addRoleApplicationSetting и
// UserRole/has для права импорта; Authentication — currentUser()/currentUserLogin();
// Time — отметка времени показателя; ApiCommon — конвенции ручек и denyNotPerformer.
// Перечислено явно, транзитивному REQUIRE не доверять.
REQUIRE HomeScreen, CheckObject, StoreTaskCore, TaskPerformer, Security, Authentication, Time, ApiCommon;

NAMESPACE StoreTask;

// ===== Главная страница мобильного клиента и приём показателей извне. =====
//   GET  /exec/StoreTask.apiHome[?lat=&lon=&objectId=] -> {objects:[...], blocks:[{metrics,news},...]}
//   GET  /exec/StoreTask.apiObjects   -> [{id,name,address,latitude,longitude},...]
//   POST /exec/StoreTask.apiSetMetric body {"code":"sales","object":"SOS-101","value":42}
// Ручки живут отдельно от модели (HomeScreen): настройка главной — это формы и
// справочники администратора, а это — поверхность для телефона и внешней системы.

// --- какие объекты нужны главной этого человека здесь и сейчас (#37047) ---
// В радиусе главной от присланных координат — плюс объекты его открытых задач. Второе
// слагаемое обязательно: человек, уехавший из магазина, иначе потерял бы из выбора объект
// задачи, которую ему там делать. Участие — то же participant, что отбирает apiTasks:
// список задач и выбор объекта на главной обязаны говорить об одних и тех же объектах.
homeObject (CheckObject o, DOUBLE lat, DOUBLE lon) = TRUE IF homeDistance(o, lat, lon)
    OR (GROUP SUM 1 IF opened(Task t) AND participant(t, currentUser()) AND checkObject(t) = o);

// Одним ответом, а не ручкой на блок: клиент рисует главную целиком, и собирать её из
// нескольких запросов значило бы уметь пережить сбой любого из них на полпути.
// Пустые вложенные массивы в ответ не попадают — клиент считает их отсутствие пустотой.
// Новости отдаются по возрастанию даты: DESC во вложенном JSON FROM не отрабатывает
// (проверено), поэтому ленту разворачивает клиент.
//
// Объекты и разрез показателей по ним — не весь каталог, а отбор homeObject плюс объект,
// который человек выбрал сам (objectId): выбранный из каталога объект вне радиуса и без
// задач иначе никогда не получил бы своих чисел в разрезе (#37047). На сети в сотни
// объектов весь каталог был единицами килобайт, и телефону было всё равно; на сети в
// три тысячи объектов ответ весил 400 КБ, уезжал при каждом возврате на главную и был
// девятью десятыми всего трафика клиента, а показатели в разрезе объекта считались по
// всем трём тысячам на каждый показатель. Полный каталог телефон докачивает фоном
// (apiObjects) и держит у себя — выбор объекта на главной остаётся мгновенным и офлайн,
// а числа выбранного объекта приезжают следующим apiHome.
//
// Без координат — прежняя выдача целиком: хост с небольшим каталогом и клиент прежней
// версии, зовущий ручку без параметров, ничего не замечают. Параметры переписываются в
// LOCAL до экспорта — NULL-параметр действия в EXPORT обнуляет весь ответ (ApiCommon).
// Гео-журнал не пишется: он отвечает на «почему список задач пуст», а состав главной
// на список не влияет.
apiHome (DOUBLE lat, DOUBLE lon, ISTRING[30] objectId) {
    LOCAL aLat = DOUBLE ();
    LOCAL aLon = DOUBLE ();
    LOCAL aObject = CheckObject ();
    LOCAL whole = BOOLEAN ();
    aLat() <- lat;
    aLon() <- lon;
    aObject() <- checkObject(objectId);
    IF NOT (lat AND lon) THEN whole() <- TRUE;

    EXPORT JSON FROM
        objects = (JSON FROM
            id = id(CheckObject o),
            name = name(o),
            address = address(o)
            WHERE id(o) AND (whole() OR homeObject(o, aLat(), aLon()) OR o = aObject())
            ORDER name(o), o),
        blocks = (JSON FROM
            code = code(HomeBlock b),
            type = code(type(b)),
            view = code(view(b)),
            byObject = byObject(b),
            title = title(b),
            subtitle = subtitle(b),
            icon = icon(b),
            body = body(b),
            metrics = (JSON FROM
                code = code(HomeMetric m),
                name = name(m),
                value = value(m),
                previous = previous(m),
                target = target(m),
                unit = unit(m),
                color = color(m),
                filter = codeTaskFilter(m),
                trend = codeTrend(m),
                inverse = inverse(m),
                // Разрез — по тем же объектам, что и objects, и без условия непустоты:
                // дырку в values клиент не отличает от «данных нет» и подставляет
                // сетевую цифру, а разрез по объекту на то и разрез, чтобы в нём был
                // каждый объект из objects.
                values = (JSON FROM
                    object = id(CheckObject po),
                    value = value(m, po),
                    previous = previous(m, po),
                    target = target(m, po)
                    WHERE byObject(b) AND id(po) AND (whole() OR homeObject(po, aLat(), aLon()) OR po = aObject())
                    ORDER name(po), po)
                WHERE block(m) = b AND active(m)
                ORDER metricOrder(m), m),
            news = (JSON FROM
                date = date(HomeNews n),
                title = title(n),
                body = body(n)
                WHERE block(n) = b AND active(n)
                ORDER date(n), n)
            WHERE visible(b)
            ORDER blockOrder(b), b);
} @@api;

// --- полный каталог объектов для фоновой докачки на телефон (#37047) ---
// Ключ, название, адрес и координаты — то, чем телефон предлагает выбор объекта на
// главной без сети. Отдельной ручкой, а не внутри apiHome: главная зовётся при каждом
// возврате на экран, а каталог меняется редко, и телефон тянет его только при смене
// catalogVersion (apiCurrentUser). Гвард — исполнитель, как у apiNearbyObjects: каталог
// с координатами — это сеть магазинов, а не публичные данные.
apiObjects () {
    IF NOT currentPerformer() THEN { denyNotPerformer(); RETURN; }
    EXPORT JSON FROM
        id = id(CheckObject o),
        name = name(o),
        address = address(o),
        latitude = latitude(o),
        longitude = longitude(o)
        WHERE id(o)
        ORDER name(o), o;
} @@api;

// Приём показателя извне. Показатель адресуется своим кодом, объект — своим: внешней
// системе не нужно знать внутренние идентификаторы. Без `object` значение считается
// сетевым, с ним — записывается в разрез этого объекта. `previous` присылать не нужно:
// старое значение сдвигается само, поле есть только для загрузки истории задним числом.
//
// Ручку может дёрнуть любая аутентифицированная учётка (@@api не различает — см. шапку
// ApiCommon), а перезаписывать показатели должна только интеграционная: право
// выдаётся её роли явной настройкой — тот же приём, что allowWorkWithoutGeo.
@addRoleApplicationSetting(allowMetricImport, 'Разрешить импорт показателей извне (apiSetMetric)', BOOLEAN);
allowMetricImport () = GROUP SUM 1 IF allowMetricImport(UserRole r) AND has(currentUser(), r);

apiSetMetric (FILE payload) {
    IF NOT allowMetricImport() THEN
        throwException('Metric import is not permitted for user: ' + currentUserLogin());
    LOCAL aCode = STRING[30]();
    LOCAL aObject = ISTRING[30]();
    LOCAL aValue = NUMERIC[18,4]();
    LOCAL aTarget = NUMERIC[18,4]();
    LOCAL aPrevious = NUMERIC[18,4]();
    IMPORT JSON FROM payload AS FILE TO() aCode = code, aObject = object,
        aValue = value, aTarget = target, aPrevious = previous;
    IF NOT homeMetric(aCode()) THEN
        throwException('Metric not found: ' + aCode());
    IF aObject() AND NOT checkObject(aObject()) THEN
        throwException('Object not found: ' + aObject());

    NEWSESSION NESTED (aCode, aObject, aValue, aTarget, aPrevious) {
        IF aObject() THEN {
            dataValue(homeMetric(aCode()), checkObject(aObject())) <- aValue();
            target(homeMetric(aCode()), checkObject(aObject())) <- aTarget();
            IF aPrevious() THEN
                dataPrevious(homeMetric(aCode()), checkObject(aObject())) <- aPrevious();
        } ELSE {
            dataValue(homeMetric(aCode())) <- aValue();
            target(homeMetric(aCode())) <- aTarget();
            IF aPrevious() THEN
                dataPrevious(homeMetric(aCode())) <- aPrevious();
        }
        dataTime(homeMetric(aCode())) <- currentDateTime();
        APPLY;
        IF canceled() THEN
            throwException(applyMessage());
    }
} @@api;
