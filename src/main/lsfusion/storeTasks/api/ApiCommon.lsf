MODULE ApiCommon;

// StoreTaskCore — Task, taskByAnyId, assignedTo (гвард доступа к задаче); TaskPerformer —
// currentPerformer; Security — @addRoleApplicationSetting и UserRole/has; Authentication —
// currentUser/currentUserLogin; Image — resizeImageMaxSize/resizedImage (миниатюра при
// отдаче снимка). Перечислено явно, транзитивному REQUIRE не доверять.
REQUIRE StoreTaskCore, TaskPerformer, Security, Authentication, Image;

NAMESPACE StoreTask;

// ===== Конвенции ручек мобильного API — отдельно от самих ручек. =====
// Здесь живёт то, что обязано быть ОДНИМ на все @@api-модули: кто звонит, что ему можно
// трогать, каким отказом отвечать и как отдавать картинку. Модуль ручек (StoreTaskApi,
// FillApi, SimpleApi, TaskCommentApi, …) требует этот, а не соседний модуль ручек:
// иначе каждая новая ручка тянет за собой десяток чужих.
//
// Конвенции, общие для всех ручек:
//   * аутентификация — HTTP Basic (клиент входит учётной записью сотрудника);
//   * @@api НЕ ограничивает, КТО зовёт действие: любая аутентифицированная учётка
//     достучится до любой ручки, и «своё ли это» решается только внутри — гвардом на
//     currentUser()/currentPerformer(). Гвард идёт ПЕРВЫМ в каждой ручке;
//   * чтение — EXPORT JSON, мутация — reverse-lookup запись; читающая и пишущая ручки
//     всегда РАЗНЫЕ действия (EXPORT после APPLY на этом сервере отдаёт пустое тело);
//   * мутация принимает аргументы JSON-объектом в ТЕЛЕ запроса (один параметр FILE,
//     IMPORT JSON ... TO()), чтение — параметрами запроса;
//   * NULL-параметр действия, упомянутый в EXPORT, отдаёт пустое тело с content-type
//     application/null — поэтому параметры переписывают в LOCAL перед экспортом;
//   * throwException('...: ' + NULL) — молчаливый no-op, поэтому required-гвард всегда
//     с КОНСТАНТНЫМ сообщением и до первого «not found: ' + параметр».
//
// Отказ — один код и одно тело на ситуацию:
//   учётка не исполнитель   403 {"error":"notPerformer","message":…}  denyNotPerformer()
//   задача не назначена     403 {"error":"forbidden",  "message":…}  denyTask/requireTouch
//   не участник задачи      403 {"error":"forbidden",  "message":…}  denyParticipant/requireParticipant
//   нечего отдать           404 {"error":"notFound",   "message":…}
// Читающая ручка отдаёт тело и возвращается сама: RETURN внутри вызванного действия
// прерывает только его, поэтому «отказать и выйти» пишется в самой ручке. Мутация
// отказывается исключением: частичного ответа у неё нет, и прервать её должен сам
// отказ, — смысл при этом тот же, что у тела 403 соседнего чтения.
//
// --- почему хвост мутации не свёрнут (решение 2026-09-03) ---
// APPLY и разбор отказа под ним написаны руками в каждой мутации — все двадцать с
// лишним раз, — и это решение, а не недосмотр.
//   * Метакодом не свернуть в принципе: аргумент метакода по грамматике платформы —
//     идентификатор, тип или литерал; блок операторов туда не передать, а без тела
//     обёртки NEWSESSION генерировать нечего.
//   * Обёртка-действие «применить и бросить» технически возможна и сократила бы две
//     строки до одной, но спрятала бы APPLY внутрь вызова — ровно ту форму, на которой
//     этот код уже обжёгся: вложенный APPLY гасил canceled(), и отказ применения
//     доезжал до телефона как успех (#36872, см. SimpleApi.apiFinishSimple и
//     FillApi.apiFinishExecution). Здесь дороже видеть, ГДЕ применяется сессия, чем
//     сэкономить строку; к тому же применений два вида — APPLY и APPLY SERIALIZABLE,
//     и у второго гвард гонки обязан жить внутри самого блока.
// Опасность у повторения одна — забыть вторую строку, и цена ей известна: телефон
// показывает «выполнено» по задаче, которая осталась открытой. Поэтому правило простое
// и без исключений: APPLY в ручке всегда идёт в паре с разбором отказа. Там, где пары
// нет намеренно (журнальная запись в GeoLog: она не должна ронять ручку, ради которой
// её пишут), причина написана на самой строке APPLY.

// --- кто звонит: исполнитель и режим геолокации ---
// geoRequired решается на сервере: геолокация обязательна, если ни одна роль
// пользователя не разрешает работать без неё (морозильники и подвалы не дают фикса GPS —
// без этой лазейки первый же такой случай становится инцидентом в поле). Направление
// признака выбрано сознательно: флаг ПРИСУТСТВУЕТ (true) в обычном случае и отсутствует
// только там, где роль явно разрешила, — клиент, читающий отсутствие как «не требуется»,
// ошибается лишь там, где это и было позволено.
@addRoleApplicationSetting(allowWorkWithoutGeo, 'Разрешить работу без геолокации', BOOLEAN);

// достаточно любой из ролей пользователя — тот же приём has(), что у ролевых матриц АРМ
allowWorkWithoutGeo () = GROUP SUM 1 IF allowWorkWithoutGeo(UserRole r) AND has(currentUser(), r);
geoRequired () = NOT allowWorkWithoutGeo();

// Отказ «учётка не исполнитель» — 403 с компактным JSON, не throwException: телефону
// нечего делать с Java-стеком (непойманное исключение — это HTTP 500 с полным стеком в
// теле, его нельзя ни разобрать, ни показать человеку).
denyNotPerformer () {
    statusHttpTo() <- 403;
    EXPORT JSON FROM error = 'notPerformer',
        message = 'Учётная запись не является исполнителем: ' + currentUserLogin();
}

// --- гвард доступа к задаче: она должна быть назначена вызывающему ---
// Тот же предикат assignedTo(Task, User), что и в apiTasks, поэтому поверхность
// согласована: задачу, которой нет в списке, нельзя ни прочитать, ни записать по id.
// Несуществующий id проваливает гвард так же, как чужой, — перебор не раскрывает,
// какие задачи существуют. Чтения отвечают 403 + компактный JSON, мутации — исключением,
// как соседние с ними проверки.
canTouch (STRING[50] id) = assignedTo(taskByAnyId(id), currentUser());

denyTask (STRING[50] id) {
    statusHttpTo() <- 403;
    EXPORT JSON FROM error = 'forbidden',
        message = 'Задача не назначена на текущего пользователя: ' + id;
}

// Второе правило доступа — участник задачи: назначенный ИЛИ автор (StoreTaskCore).
// По нему ходят переписка и файлы задачи: приложить фотографию к своей же задаче автор
// вправе, не будучи её исполнителем, а вести по ней работу (бланк, статус, взятие) —
// нет. Оба правила живут рядом, чтобы разница была видна, а не разъезжалась по модулям.
denyParticipant (STRING[50] id) {
    statusHttpTo() <- 403;
    EXPORT JSON FROM error = 'forbidden',
        message = 'Нет доступа к задаче: ' + id;
}

requireParticipant (STRING[50] id) {
    IF NOT id THEN throwException('id required');
    IF NOT participant(taskByAnyId(id), currentUser()) THEN
        throwException('No access to task: ' + id);
}

// Гвард мутации, одной строкой на ручку. Раньше это были две строки в каждой из
// шестнадцати: пустой id молча проходил насквозь (throwException с NULL-сообщением
// ничего не делает) и добирался до следующей проверки уже как «нет заполнения».
// Required-гвард здесь — с константным сообщением, поэтому забыть его больше негде.
requireTouch (STRING[50] id) {
    IF NOT id THEN throwException('id required');
    IF NOT canTouch(id) THEN throwException('Task not assigned to current user: ' + id);
}

// --- отдать картинку: полный размер или миниатюра ---
// Одна отдача на все ручки со снимками (поле бланка, простое выполнение, файл задачи):
// ответ — сырые байты, не base64 в JSON, — треть трафика экономится там, где он дороже
// всего. thumb (любое непустое значение) отдаёт миниатюру с длинной стороной 256: лента
// с пятью вложениями не должна качать мегабайты по мобильной сети, полный размер клиент
// просит по явному тапу.
//
// Принимает FILE, а не IMAGEFILE, и оригинал отдаёт как есть: у файла задачи может не
// быть ничего общего с картинкой (акт в pdf), а IMAGEFILE — статический формат, он
// подменяет расширение по сигнатуре байтов на jpg/png/bmp. Пропустить оригинал через
// него значило бы отдать pdf под видом jpg.
//
// Миниатюра — оптимизация, а не обязательство: снимок, который ImageIO не смог прочесть
// (битый файл, экзотика, да и просто не картинка), едет оригиналом, а не валит запрос в
// 500 (поймано на демо-стенде: сид #36716 держит PNG с кривым zlib). resizedImage() —
// LOCAL самой платформы, и он переживает неудачный TRY, поэтому чистится перед каждым
// ресайзом: иначе вторая картинка в одном запросе отдалась бы первой.
serveImage (FILE content, STRING[10] thumb) {
    resizedImage() <- NULL;
    IF thumb THEN {
        TRY resizeImageMaxSize(IMAGEFILE(content), 256);
    }
    // ASSIGN не приводит IMAGEFILE к FILE неявно — каст обязателен
    exportFile() <- OVERRIDE FILE(resizedImage()), content;
}
