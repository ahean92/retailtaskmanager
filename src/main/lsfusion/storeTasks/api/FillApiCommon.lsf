MODULE FillApiCommon;

// ApiCommon — гварды доступа (canTouch/requireTouch) и отказы (denyTask/denyNotPerformer);
// Filling — Filling, template(Filling), prevFilling, lastFinishedFilling; Execution —
// task/dateTime/executor/finished (Filling : Execution); FillRow — row(filling, rowKey);
// Field — field(template, code); Column — column(field, code); Resolution — Resolution/code;
// StoreTaskCore — Task, taskByAnyId; CheckObject — checkObject(id); TaskPerformer —
// currentPerformer, id/name(TaskPerformer) — гварды исполнителя ниже (#37349);
// StoreTaskAccess — taskVisible (объектный вход чтения); StoreTaskTextUtils — dateTimeText
// в отказе «кто заполняет» (#37349) (транзитивному REQUIRE не доверять)
REQUIRE ApiCommon, Filling, Execution, FillRow, Field, Column, Resolution, StoreTaskCore, CheckObject,
        TaskPerformer, StoreTaskAccess, StoreTaskTextUtils;

NAMESPACE StoreTask;

// ===== Общее у ручек бланка (Filling): адресация и гварды. =====
// Сами ручки — в трёх модулях рядом: FillReadApi (шапка, поля, варианты, колонки, строки,
// снимок — чтение в трёх режимах адресации), FillWriteApi (старт, значения полей, снимки,
// строки таблицы, исход, завершение) и RowSubjectsApi (кандидаты справочника для поля).
// Здесь то, что обязано быть одним на все: активное заполнение задачи (fillingByTask),
// поле/колонка/строка по коду (answerField/answerColumn/answerRow), гварды пишущих ручек
// (requireFilling — доступ и существование; requireFillWrite — ещё незавершённость и
// исполнительство, #37349) и преамбула читающих (resolveRead). Модуль ручек требует этот
// модуль, а не соседний модуль ручек.
//
// One template renderer on the client drives every form/checklist task. Fields are
// addressed by their stable `code` (not positionally). Mutations take a JSON body
// (single FILE param unpacked with IMPORT JSON ... TO()); reads keep an `id` query
// parameter. Read and mutation are SEPARATE actions (EXPORT after APPLY comes back
// empty on this server — see [[feedback_eval_apply]]). EVERY handle must start with
// the canTouch guard (ApiCommon) — @@api itself lets any authenticated user in (see the
// ApiCommon header). A task id in any handle is either the server ST number or the
// client's offline UUID — every resolve goes through taskByAnyId (#36714).

// active (unfinished-or-latest) filling of a task
// MATERIALIZED: читается каждой ручкой бланка — и читающей (resolveRead), и каждой
// пишущей (requireFilling, answerField/answerColumn/answerRow) — по несколько раз за
// запрос, а меняется один раз, при создании заполнения. Тот же профиль, что у
// prevFilling/lastFinishedFilling (Filling), которые уже материализованы.
fillingTask (Task t) = GROUP LAST Filling f ORDER dateTime(f), f BY task(f) MATERIALIZED;
fillingByTask (STRING[50] id) = fillingTask(taskByAnyId(id));

// ===== Прошлая проверка — просмотр только для чтения (#36778) =====
// Одна адресация на все читающие ручки: по задаче (текущее заполнение), по задаче с
// prev (прошлая проверка относительно её бланка — prevFilling, см. Filling.lsf) или
// по объекту (последняя завершённая, шаблон любой — решение 2026-08-19). Просмотр
// прошлой проверки — это чтение ЧУЖОГО заполнения: знать объект — не то же, что видеть
// результаты его проверок (#36839), поэтому прошлая проверка по задаче, которая человеку
// не видна, для prev-режима считается отсутствующей, а объектный вход отказывает 403.
requestedFilling (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) =
    CASE WHEN objectId THEN lastFinishedFilling(checkObject(objectId))
         WHEN prev THEN (prevFilling(fillingByTask(id)) IF taskVisible(task(prevFilling(fillingByTask(id)))))
         ELSE fillingByTask(id);
// the field being answered, resolved from committed template data
answerField (STRING[50] id, STRING[50] fieldCode) = field(template(fillingByTask(id)), fieldCode);
resolutionByCode (STRING[30] c) = GROUP MAX Resolution r IF code(r) = c;
answerColumn (STRING[50] id, STRING[50] fieldCode, STRING[50] colCode) = column(answerField(id, fieldCode), colCode);
answerRow (STRING[50] id, STRING[36] rowKey) = row(fillingByTask(id), rowKey);

// Гвард доступа к задаче (canTouch/requireTouch) и его отказ (denyTask) живут в
// ApiCommon (#36872): по ним ходят и ручки простого выполнения, и переписка, а «кому
// можно трогать задачу» обязано иметь ровно одно определение на все ручки.

// Гвард пишущих ручек бланка: доступ к задаче И существование заполнения. Вместе, а не
// порознь: ни одна из восьми ручек не пишет в бланк, не проверив обоих, — раздельными
// проверками это была одна и та же пара строк, переписанная восемь раз.
requireFilling (STRING[50] id) {
    requireTouch(id);
    IF NOT fillingByTask(id) THEN throwException('Filling not found');
}

// ===== Пишет в бланк его исполнитель, и только пока бланк не завершён (#37349). =====
// Две дыры одной природы. Ответы в завершённое заполнение переписывали ответы под
// зафиксированным итогом (#37172) — акт и итог расходились с бланком. А в бланк задачи
// на подразделение мог писать каждый в нём: requireTouch транзитивен по назначению,
// executor выполнения ставился при создании и ни с чем не сверялся — последний по
// времени отправки молча затирал ответы соседа, исполнитель в акте оставался тот, кто
// нажал «Начать». Оба гварда — здесь, рядом с requireFilling: они нужны всем пишущим
// ручкам бланка и никому кроме них.
//
// Гварды в ручках, а не ограничения на данные: recordResult пишет в заполнение при самом
// завершении, значения хоста — в его строки, и ограничение било бы по этим проходам — в
// возврате #36779 «только чтение» колонок отвергали ровно по этой причине.

// Завершённое не меняется — тем же текстом, что у простого выполнения (SimpleApi).
requireUnfinished (STRING[50] id) {
    IF finished(fillingByTask(id)) THEN throwException('Execution already finished');
}

// Пишет executor выполнения; пустой executor (заполнение заведено регламентом или eval,
// без человека) гардом пропускается — отказывать некому, а чинить такие данные —
// отдельная задача.
filledByOther (STRING[50] id) =
    executor(fillingByTask(id)) AND NOT executor(fillingByTask(id)) = currentPerformer();

// Отказ — 409 с именем и временем начала, тот же приём, что «первый выигрывает» у взятия
// (#36835, apiTakeTask): второй узнаёт, КТО держит бланк и с какого времени, а не безликое
// «нельзя». message человекочитаем — экран «Не отправлено» телефона показывает его как есть
// (ApiClient.humanError), код error остаётся клиенту. Смена владельца — действием
// «Передать заполнение» у супервайзера (Filling.lsf), не молча и не обходом. Флаг, а не
// исключение: у мутации нет частичного ответа, но и прервать её может только собственный
// RETURN — сама по себе пара statusHttpTo+EXPORT из вызванного действия ручку не
// останавливает (тот же приём, что readDenied у resolveRead).
fillDenied = DATA LOCAL BOOLEAN ();
denyFilledBy (STRING[50] id) {
    statusHttpTo() <- 409;
    EXPORT JSON FROM
        error = 'filledBy',
        filledById = id(executor(fillingByTask(id))),
        filledBy = name(executor(fillingByTask(id))),
        filledAt = dateTime(fillingByTask(id)),
        message = 'Бланк заполняет ' + name(executor(fillingByTask(id)))
                  + ', начало ' + dateTimeText(dateTime(fillingByTask(id)));
}
requireOwnFilling (STRING[50] id) {
    IF filledByOther(id) THEN {
        denyFilledBy(id);
        fillDenied() <- TRUE;
    }
}

// Гвард пишущих ручек тела бланка — requireFilling плюс обе проверки выше, одним
// вызовом: раздельными строками это была бы одна и та же тройка в семи ручках. Тело —
// всё, кроме завершения: повторное apiFinishExecution по уже завершённому —
// идемпотентный ретрай очереди, а не запись, гварда завершённости оно не получает
// (исполнительство проверяет и оно).
requireFillWrite (STRING[50] id) {
    requireFilling(id);
    requireUnfinished(id);
    requireOwnFilling(id);
}

// Гвард и отказ читающих ручек в трёх режимах адресации (#36778): задачные режимы —
// canView (исполнитель, а с #37157 и принимающий — ApiCommon), объектный — видимость задачи
// найденной проверки (taskVisible), а без проверки на объекте — любой исполнитель (см. requestedFilling).
canRead (STRING[50] id, ISTRING[30] objectId) =
    IF objectId THEN (TRUE IF currentPerformer() AND (NOT requestedFilling(id, NULL, objectId)
                                                       OR taskVisible(task(requestedFilling(id, NULL, objectId)))))
    ELSE canView(id);

denyRead (STRING[50] id, ISTRING[30] objectId) {
    CASE
        WHEN NOT objectId THEN denyTask(id);
        WHEN NOT currentPerformer() THEN denyNotPerformer();
        WHEN callerLocked() THEN denyLocked();
        ELSE {
            statusHttpTo() <- 403;
            EXPORT JSON FROM error = 'forbidden',
                message = 'Нет доступа к результатам проверки объекта: ' + objectId;
        }
}

// Общая преамбула читающих ручек, ровно один раз: параметры переписаны в локали
// (NULL-параметр экшена, попавший в EXPORT, отдаёт пустое тело — см. apiTasks, а
// здесь NULL — норма для двух из трёх режимов), гвард отработал, заполнение
// найдено. Гвард — вещь, которую нельзя забыть в седьмой ручке, поэтому он живёт
// здесь, а не в шести копиях; ручка после вызова смотрит readDenied и читает
// readFilling.
readDenied = DATA LOCAL BOOLEAN ();
readFilling = DATA LOCAL Filling ();
readByTask = DATA LOCAL BOOLEAN ();
resolveRead (STRING[50] id, STRING[10] prev, ISTRING[30] objectId) {
    LOCAL aId = STRING[50]();
    LOCAL aPrev = STRING[10]();
    LOCAL aObjectId = ISTRING[30]();
    aId() <- id;
    aPrev() <- prev;
    aObjectId() <- objectId;
    IF NOT canRead(aId(), aObjectId()) THEN {
        denyRead(aId(), aObjectId());
        readDenied() <- TRUE;
        RETURN;
    }
    readFilling() <- requestedFilling(aId(), aPrev(), aObjectId());
    readByTask() <- TRUE IF NOT aObjectId() AND NOT aPrev();
}
