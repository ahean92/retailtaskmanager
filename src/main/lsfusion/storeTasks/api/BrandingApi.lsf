MODULE BrandingApi;

// Branding — сами настройки бренда. ApiCommon здесь не нужен: у ручки нет гварда, она
// намеренно без аутентификации (см. ниже).
REQUIRE Branding;

NAMESPACE StoreTask;

// ===== Оформление приложения для мобильного клиента. =====
//   GET /exec/StoreTask.apiBrand -> {name,tagline,logo,primary,...}

// @@noauth on purpose (decision 2026-08-05): the client asks for this the moment the
// server address is entered, before anyone has logged in. The trade-off is accepted
// knowingly — it exposes the customer's name and palette to whoever knows the address.
apiBrand () {
    EXPORT JSON FROM
        name = brandName(),
        tagline = brandTagline(),
        logo = brandLogo(),
        primary = brandPrimary(),
        primaryDark = brandPrimaryDark(),
        accent = brandAccent(),
        ok = brandOk(),
        warn = brandWarn();
} @@noauth;
