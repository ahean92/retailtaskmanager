MODULE FillWriteApi;

// FillApiCommon — requireFilling, fillingByTask, answerField/answerColumn/answerRow,
// resolutionByCode; ApiCommon — requireTouch; Filling — значения полей, снимки, resolution;
// FillRow — FillRow, filling/tableField/rowKey/subject/subjectName, ячейки; Field —
// allowManual/refKind/subjectKind/optionSet/type; Column — type/optionSet(Column); ColumnCalc —
// calcKind; FieldType —
// FieldType.*; FillOption — option(optionSet, code); RefValue — refValue(kind, id);
// Execution — doStart/finishExecution, restartable, startRefusal, гео-штампы; StoreTaskCore —
// taskByAnyId, opened;
// Utils — decode, regexPatternMatch, left/right; Time — toDateFormat, sum(DATE, INTEGER),
// extractDay (транзитивному REQUIRE не доверять)
// StoreTaskRefusal — refuse: отказ по существу кодом 422 вместо 500
REQUIRE FillApiCommon, ApiCommon, Filling, FillRow, Field, Column, ColumnCalc, FieldType, FillOption,
        RefValue, Execution, StoreTaskCore, Utils, Time, StoreTaskRefusal;

NAMESPACE StoreTask;

// ===== Пишущие ручки бланка: старт, значения полей, снимки, строки таблицы, исход, =====
// ===== завершение. =====
// Каждая начинается с гварда из FillApiCommon: пишущие тело — requireFillWrite (доступ,
// существование, незавершённость и исполнительство, #37349), завершение — requireFilling
// с проверкой исполнителя (его повтор по завершённому — ретрай очереди, не запись);
// исключение — apiStartExecution, которая заполнение и создаёт. Мутация
// принимает JSON в теле, пишет во вложенной сессии со списком локалей, а APPLY всегда идёт
// в паре с разбором отказа (ApiCommon, «почему хвост мутации не свёрнут»).

// --- ensure a Filling exists for the task ---
// «Ensure» означает «создать, только если заполнения нет вовсе». Завершённое — не
// повод заводить второе: fillingTask — это GROUP LAST, и пустой дубль перекрыл бы
// собой готовое заполнение во всех чтениях, а startExecution откатил бы статус
// задачи в работу. Мобильный клиент зовёт эту ручку при каждом открытии бланка,
// включая просмотр завершённой проверки (#36716, ревью).
//
// lat/lon/at (#36838) — где и когда, ПО ЧАСАМ УСТРОЙСТВА, человек открыл бланк:
// клиент снимает их в момент действия и возит в очереди вместе с самим стартом,
// поэтому дожим офлайн-смены не подменяет место работы местом появления сети.
// Пишутся туда же, где создаётся выполнение, — и только там: ручку зовут при каждом
// открытии бланка, и запись вне этой ветки затирала бы первую точку последней.
// Без точки (нет разрешения, подвал) полей нет — NULL поверх NULL внутри той же ветки
// безвреден.
//
// Вторая ветка создания — перевыполнение после возврата с приёмки (#37157,
// Execution.restartable): прежний завершённый бланк остаётся документом, новый заводится
// поверх; fillingTask — GROUP LAST, и все чтения переезжают на него сами.
//
// Закрытая задача — успешный ответ без записи, как у apiTakeTask: старт из офлайн-очереди,
// доехавший после отмены, не возвращает задачу в работу и не застревает в очереди отказом.
// Само создание — Execution.doStart: условие «выполнения нет» проверяется там, внутри
// транзакции; здесь оно только решает, спрашивать ли отказ вне объекта.
apiStartExecution (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aLat = DOUBLE();
    LOCAL aLon = DOUBLE();
    LOCAL aAt = DATETIME();
    IMPORT JSON FROM body AS FILE TO() aId = id, aLat = lat, aLon = lon, aAt = at;
    requireTouch(aId());
    IF NOT opened(taskByAnyId(aId())) THEN RETURN;
    IF NOT fillingByTask(aId()) OR restartable(taskByAnyId(aId())) THEN {
        // Отказ вне объекта (#37342, Execution.startRefusal) — только здесь, в ветке
        // создания, и до записи: повторному старту при открытии бланка отказывать не в
        // чем, а отказ не должен оставить ни выполнения, ни штампов. Без точки — не отказ
        // (подвал), а признак startedNoGeo на задаче; завершение не отказывает никогда.
        IF startRefusal(taskByAnyId(aId()), aLat(), aLon()) THEN
            refuse(startRefusal(taskByAnyId(aId()), aLat(), aLon()));
        doStart(taskByAnyId(aId()), aLat(), aLon(), aAt());
    }
} @@api;

// Ячейка-дата принимает дату ключом date, как значение поля-даты (apiSetField), либо
// строкой ГГГГ-ММ-ДД в text: офлайн-очередь телефона держит значения ячеек в двух колонках,
// числе и тексте, и дата едет текстом без миграции его локальной базы. Пустой text —
// очистка, как у текстовой ячейки.
//
// Текст разбирается в дату отдельным шагом и только у колонки-даты (приём readRouteDate,
// RouteApi): внутри FOR ниже разбор выполнялся и для колонок других типов, и «Полка 3»
// или штрихкод в текстовой ячейке давали 500 с ошибкой to_date из PostgreSQL (и на 6.2,
// и на master). Неверная дата — отказ словами, а не текст ошибки базы.
//
// Выбор и «да/нет» (решение 12.11): вариант — кодом в optCode либо в text, «да/нет» — в bool
// либо числом 1/0 в number. Второй путь — для офлайн-очереди телефона, где у ячейки только
// число и текст. Неизвестный код варианта — отказ: молча записанное «пусто» стёрло бы ответ.
// Тип колонки, которую ячейка не хранит, — отказ словами, а не 200 без записи (1.20).
// Текст длиннее ячейки (250) — тоже отказ: раньше он молча обрезался (10.14).
apiSetCell (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aKey = STRING[36]();
    LOCAL aCol = STRING[50]();
    LOCAL aNumber = NUMERIC[14,4]();
    LOCAL aText = TEXT();
    LOCAL aOpt = STRING[30]();
    LOCAL aDate = DATE();
    LOCAL aBool = TBOOLEAN();
    IMPORT JSON FROM body AS FILE TO()
        aId = id, aField = field, aKey = rowKey, aCol = col,
        aNumber = number, aText = text, aOpt = optCode, aDate = date, aBool = bool;

    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    IF NOT answerField(aId(), aField()) THEN refuse('Field not found');
    IF NOT answerColumn(aId(), aField(), aCol()) THEN refuse('Column not found');
    FOR Column c = answerColumn(aId(), aField(), aCol()) DO {
        IF readonly(c) OR calcKind(c) THEN refuse('Column is read-only');
        // шкала — прежний вид колонки-варианта: новые не заводятся, старые пишутся как выбор
        IF NOT (cellType(c) OR type(c) = FieldType.scale) THEN
            refuse('Ячейку такого типа заполнить нельзя: ' + nameType(c));
        IF length(aText()) > 250 THEN
            refuse('Текст ячейки длиннее 250 символов');
        IF hasOptions(c) AND NOT aOpt() AND aText() != '' THEN aOpt() <- STRING[30](aText());
        IF hasOptions(c) AND aOpt() != '' AND NOT option(optionSet(c), aOpt()) THEN
            refuse('Нет такого варианта: ' + aOpt());
    }
    IF NOT answerRow(aId(), aKey()) AND NOT allowManual(answerField(aId(), aField())) THEN
        refuse('Row not found');
    IF type(answerColumn(aId(), aField(), aCol())) = FieldType.date AND NOT aDate() AND aText() != '' THEN {
        IF NOT regexPatternMatch(aText(), r'^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$') THEN
            refuse('Дата не распознана, нужен формат ГГГГ-ММ-ДД: ' + aText());
        aDate() <- sum(toDateFormat(left(aText(), 8) + r'01', r'YYYY-MM-DD'), INTEGER(right(aText(), 2)) - 1);
        IF NOT extractDay(aDate()) = INTEGER(right(aText(), 2)) THEN
            refuse('Такой даты нет: ' + aText());
    }
    NEWSESSION NESTED (aId, aField, aKey, aCol, aNumber, aText, aOpt, aDate, aBool) {
        IF NOT answerRow(aId(), aKey()) THEN
            NEW r = FillRow {
                filling(r) <- fillingByTask(aId());
                tableField(r) <- answerField(aId(), aField());
                rowKey(r) <- aKey();
            }
        FOR FillRow r = answerRow(aId(), aKey()) AND Column c = answerColumn(aId(), aField(), aCol()) DO {
            IF type(c) = FieldType.number THEN cellNumber(r, c) <- aNumber();
            IF type(c) = FieldType.text OR type(c) = FieldType.scan THEN cellText(r, c) <- (ISTRING[250](aText()) IF aText() != '');
            IF type(c) = FieldType.scale OR type(c) = FieldType.choice THEN cellOption(r, c) <- option(optionSet(c), aOpt());
            IF type(c) = FieldType.date THEN cellDate(r, c) <- aDate();
            IF type(c) = FieldType.boolean THEN
                cellBool(r, c) <- OVERRIDE aBool(), (TTRUE IF aNumber() = 1 OR aText() = 'true'),
                                           (TFALSE IF aNumber() = 0 OR aText() = 'false');
        }
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

// code (#37192) — отсканированный штрихкод или набранный код, по которому позицию внесли:
// хранится в строке как есть, и у позиции без ссылки на справочник тоже. Что предмет по
// нему найден, решает телефон (apiRowSubjects ищет по коду и штрихкоду) — сюда приходит
// уже subjectId; строка без него остаётся свободной, как её и внесли.
apiAddRow (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aKey = STRING[36]();
    LOCAL aSubjectId = ISTRING[50]();
    LOCAL aSubjectName = ISTRING[150]();
    LOCAL aCode = ISTRING[50]();
    IMPORT JSON FROM body AS FILE TO()
        aId = id, aField = field, aKey = rowKey, aSubjectId = subjectId, aSubjectName = subjectName,
        aCode = code;

    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    IF NOT answerField(aId(), aField()) THEN refuse('Field not found');
    IF NOT allowManual(answerField(aId(), aField())) THEN refuse('Manual rows not allowed');
    NEWSESSION NESTED (aId, aField, aKey, aSubjectId, aSubjectName, aCode) {
        IF NOT answerRow(aId(), aKey()) THEN
            NEW r = FillRow {
                filling(r) <- fillingByTask(aId());
                tableField(r) <- answerField(aId(), aField());
                rowKey(r) <- aKey();
                subject(r) <- refValue(subjectKind(answerField(aId(), aField())), aSubjectId());
                subjectName(r) <- OVERRIDE (aSubjectName() IF aSubjectName() != ''),
                                           name(refValue(subjectKind(answerField(aId(), aField())), aSubjectId()));
                subjectCode(r) <- (aCode() IF aCode() != '');
            }
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

apiDeleteRow (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aKey = STRING[36]();
    IMPORT JSON FROM body AS FILE TO() aId = id, aKey = rowKey;

    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    NEWSESSION NESTED (aId, aKey) {
        DELETE answerRow(aId(), aKey());
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

// --- set one field value (dispatched by the field's type) ---
apiSetField (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aOpt = STRING[30]();
    LOCAL aNumber = NUMERIC[14,4]();
    LOCAL aText = TEXT();
    LOCAL aBool = TBOOLEAN();
    LOCAL aDate = DATE();
    LOCAL aComment = TEXT();
    LOCAL aRefId = ISTRING[50]();
    LOCAL aRefName = ISTRING[150]();
    IMPORT JSON FROM body AS FILE TO()
        aId = id, aField = field, aOpt = optCode, aNumber = number,
        aText = text, aBool = bool, aDate = date, aComment = comment,
        aRefId = refId, aRefName = refName;

    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    IF NOT answerField(aId(), aField()) THEN refuse('Field not found');
    // Предел длины — словами, а не тихим усечением (10.14): текст и комментарий хранятся по
    // 500 символов, и раньше хвост молча пропадал. «Макс. длина» поля (3.6) — тем же отказом.
    IF length(aText()) > 500 THEN refuse('Текст длиннее 500 символов');
    IF length(aComment()) > 500 THEN refuse('Комментарий длиннее 500 символов');
    FOR Field f = answerField(aId(), aField()) AND maxLen(f) AND length(aText()) > maxLen(f) DO
        refuse('Ответ длиннее ' + STRING(maxLen(f)) + ' символов: так задано в поле («Макс. длина»)');
    NEWSESSION NESTED (aId, aField, aOpt, aNumber, aText, aBool, aDate, aComment, aRefId, aRefName) {
        FOR Filling e = fillingByTask(aId()) AND Field f = answerField(aId(), aField()) DO {
            IF type(f) = FieldType.scale OR type(f) = FieldType.choice THEN
                optionValue(e, f) <- option(optionSet(f), aOpt());
            // score shares the numeric slot with number — it is a different way of
            // earning points, not a different way of storing them
            IF type(f) = FieldType.number OR type(f) = FieldType.score THEN
                numberValue(e, f) <- aNumber();
            IF type(f) = FieldType.boolean THEN boolValue(e, f) <- aBool();
            IF type(f) = FieldType.text OR type(f) = FieldType.longtext OR type(f) = FieldType.scan THEN
                textValue(e, f) <- (ISTRING[500](aText()) IF aText() != '');
            IF type(f) = FieldType.date THEN dateValue(e, f) <- aDate();
            // поле-ссылка (#36841): ссылка резолвится по каналу поля, снимок — текст
            // клиента на момент выбора, при его отсутствии — текущее имя ссылки (после
            // присваивания refValue(e, f) уже новое). Кандидат, не найденный по id
            // (справочник успел смениться, пока телефон был офлайн), не роняет очередь:
            // ссылки нет, снимок остаётся — как внесистемная строка таблицы. Пустые
            // refId и refName очищают оба слота.
            IF type(f) = FieldType.objectref THEN {
                refValue(e, f) <- refValue(refKind(f), aRefId() IF aRefId() != '');
                refName(e, f) <- OVERRIDE (aRefName() IF aRefName() != ''), name(refValue(e, f));
            }
            comment(e, f) <- (ISTRING[500](aComment()) IF aComment() != '');
        }
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

// --- append a photo to a field (0..N per field) ---
// An empty `photo` clears them all — that is how the client cancels the whole set; a single
// shot is removed by index through apiDeleteFieldPhoto below.
//
// clientId (#37348) — ключ идемпотентности снимка: очередь телефона ретраит отправку,
// чей ответ потерялся в дороге, и повтор известного ключа — тот же 200 без тела, а не
// второй кадр в акте. Проверка повтора идёт ДО гвардов (тот же приём, что
// apiAddTaskFile): ретрай уже принятого снимка не должен джемить очередь, даже если
// задачу успели закрыть. Без ключа снимок пишется без проверки повтора.
// APPLY SERIALIZABLE: два одновременных ПЕРВЫХ поста одного ключа оба проходят
// проверку повтора под read committed; уникальность GROUP AGGR валит проигравшего, а
// его ретрай попадает на идемпотентный RETURN выше.
apiSetFieldPhoto (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aClientId = STRING[36]();
    LOCAL aPhoto = TEXT();
    LOCAL aIndex = INTEGER();
    IMPORT JSON FROM body AS FILE TO() aId = id, aField = field, aClientId = clientId, aPhoto = photo;

    IF aClientId() AND photoByClientId(fillingByTask(aId()), answerField(aId(), aField()), aClientId()) THEN RETURN;
    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    IF NOT answerField(aId(), aField()) THEN refuse('Field not found');
    requirePhotoSize(aPhoto());
    NEWSESSION NESTED (aId, aField, aClientId, aPhoto, aIndex) {
        IF aPhoto() = '' THEN {
            // ключ стирается вместе со снимком — правило «ключ есть ⟺ снимок есть»
            photo(fillingByTask(aId()), answerField(aId(), aField()), INTEGER i) <- NULL;
            clientId(fillingByTask(aId()), answerField(aId(), aField()), INTEGER i) <- NULL;
        } ELSE {
            // индекс считается один раз: после записи photo он был бы уже «максимум + 2»
            aIndex() <- (OVERRIDE lastPhotoIndex(fillingByTask(aId()), answerField(aId(), aField())), 0) + 1;
            photo(fillingByTask(aId()), answerField(aId(), aField()), aIndex()) <-
                IMAGEFILE(decode(aPhoto(), 'base64'));
            clientId(fillingByTask(aId()), answerField(aId(), aField()), aIndex()) <- aClientId();
        }
        APPLY SERIALIZABLE;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

// --- remove one photo by its index; the remaining ones keep their indices ---
apiDeleteFieldPhoto (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aField = STRING[50]();
    LOCAL aIndex = INTEGER();
    IMPORT JSON FROM body AS FILE TO() aId = id, aField = field, aIndex = index;

    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    IF NOT answerField(aId(), aField()) THEN refuse('Field not found');
    NEWSESSION NESTED (aId, aField, aIndex) {
        photo(fillingByTask(aId()), answerField(aId(), aField()), aIndex()) <- NULL;
        // ключ — вместе со снимком: освободившийся индекс не «помнит» старого ключа,
        // и новый кадр на его место записывается обычным порядком
        clientId(fillingByTask(aId()), answerField(aId(), aField()), aIndex()) <- NULL;
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

// --- set the outcome ---
// Гварды те же, что у тела (#37349), включая завершённость: исход входит в итог акта
// (resultSummary), и смена его после завершения расходилась бы с зафиксированным.
apiSetResolution (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aRes = STRING[30]();
    IMPORT JSON FROM body AS FILE TO() aId = id, aRes = resolution;

    requireFillWrite(aId());
    IF fillDenied() THEN RETURN;
    NEWSESSION NESTED (aId, aRes) {
        resolution(fillingByTask(aId())) <- resolutionByCode(aRes());
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;

// --- finish (validates required/evidence/resolution via constraints, closes the task) ---
// lat/lon/at (#36838) — где и когда, по часам устройства, человек нажал «Завершить»
// (см. apiStartExecution). Гвард NOT finished — та же запись-однажды, что у старта:
// точка завершения принадлежит ПЕРВОМУ завершению, а ручку могут позвать повторно —
// ретрай очереди, у которого доехал finish, но потерялся ответ. Отсутствие координат
// завершение не блокирует: пусто — тоже факт. Пишутся до finish() и уезжают его же
// APPLY; отказ валидации откатывает сессию целиком — точки без завершения не будет.
// Исполнителя ручка проверяет (#37349, requireOwnFilling): завершить бланк за того,
// кто его заполняет, — та же запись чужой работы; повтор самим исполнителем по уже
// завершённому остаётся 200-noop ниже.
apiFinishExecution (FILE body) {
    LOCAL aId = STRING[50]();
    LOCAL aLat = DOUBLE();
    LOCAL aLon = DOUBLE();
    LOCAL aAt = DATETIME();
    IMPORT JSON FROM body AS FILE TO() aId = id, aLat = lat, aLon = lon, aAt = at;
    requireFilling(aId());
    requireOwnFilling(aId());
    IF fillDenied() THEN RETURN;
    NEWSESSION NESTED (aId, aLat, aLon, aAt) {
        IF NOT finished(fillingByTask(aId())) THEN {
            finishedAt(taskByAnyId(aId())) <- aAt();
            finishedLatitude(taskByAnyId(aId())) <- aLat();
            finishedLongitude(taskByAnyId(aId())) <- aLon();
        }
        // finishExecution, а не finish: тот применяет сам, и его вложенный APPLY гасил
        // canceled() — отказ применения доезжал до телефона как успех (#36872,
        // Execution.lsf)
        finishExecution(fillingByTask(aId()));
        APPLY;
        IF canceled() THEN refuse(applyMessage());
    }
} @@api;
