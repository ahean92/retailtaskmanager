MODULE StoreTaskLib;

// Host-independent half of the subsystem — everything that needs nothing but the
// platform. This is what a standalone host requires; an ERP host goes through the
// StoreTask aggregator instead, which adds the erp/ bridges on top of this.
//
// One unified fillable engine drives every task kind: a template's fields (scale/
// number/text/…) are answered into a Filling. A checklist is simply a task type
// whose template has scored fields.
REQUIRE StoreTaskSettings,
        // task framework
        CheckObject, ObjectCategory, ObjectRole,
        // подразделения как исполнители (#36835): справочник с иерархией для хоста,
        // у которого своей оргструктуры нет
        TaskUnit,
        StoreTaskStatus, StoreTaskType, StoreTaskPriority, StoreTaskTag,
        StoreTaskCore, StoreTaskInitial, Execution,
        // unified fillable-task engine (template -> fields[/columns] -> filling[/rows])
        FieldType, Resolution, CheckAsset, CheckCategory, FillOption, Template, VerdictScale, Field, Column,
        Filling, FillRow, FillingHeader, FormTask, ChecklistTask,
        // scoring mechanics — one module per rule, plugged into Field.maxScore / Filling.score;
        // a new way of turning an answer into points is a new module here, not a core edit
        ScoreByNorm, ScoreByOption, ScoreByValue, ScoreByFlag,
        // generic fillable API
        FillApi, StoreTaskPrint,
        NonconformityReport, ScorecardReport,
        // other task types (recount runs on the engine via a table field; pricing still line-item;
        // corrective is a follow-up task with its own photo-confirmation execution — replaces
        // the standalone CorrectiveAction class and integrates via onFinish + succeeded hooks;
        // issue is a plain instruction on that same photo-confirmation execution)
        Recount, PriceCheck, Corrective, Issue,
        // оформление мобильного клиента (бренд: название/цвета/логотип для приложения)
        Branding,
        // главная страница мобильного клиента — блоки, настраиваемые по ролям
        HomeScreen, HomeDashboard, SupervisorMetrics,
        // пресеты создания задач в поле + предзагрузка шаблонов и исполнителей
        QuickAction,
        // HTTP JSON API for the mobile (Flutter) client (тянет за собой GeoLog —
        // журнал координат, который эти ручки пишут)
        StoreTaskApi,
        // авто-создание задач по графику (правило = шаблон + категория + период + назначение)
        StoreTaskSchedule,
        // уведомления (#36717): ядро+журнал, события заполнений/корректирующих, API ленты
        StoreTaskNotification, NotificationFill, NotificationApi,
        // реестр устройств для пуша и ручки регистрации (#36720)
        PushDevice, DeviceApi,
        // внешние каналы (#36720): общий диспетчер доставок (матрица событие × канал,
        // регламент отправки) и первый канал — пуш через FCM
        NotificationDelivery, PushFcm, NotificationEmail;

NAMESPACE StoreTask;
