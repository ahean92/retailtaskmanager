MODULE Inspection;

REQUIRE Execution, ChecklistTask, ChecklistItem, Scale;

NAMESPACE StoreTask;

// A checklist inspection — the execution of a checklist-type task.
CLASS Inspection 'Проверка' : Execution;

checklist = DATA Checklist (Inspection);
nameChecklist 'Чек-лист' (Inspection i) = name(checklist(i));

// type-specific execution creation, dispatched by task type
startExecution(Task t) + {
    IF isChecklistTask(t) AND checklist(t) THEN {
        NEW i = Inspection {
            task(i) <- t;
            checklist(i) <- checklist(t);
        }
        status(t) <- taskStatus('in progress');
    }
}

// --- answers: one response per (inspection, checklist item) ---
answerOption = DATA ScaleOption (Inspection, ChecklistItem);
nameAnswerOption 'Ответ' (Inspection i, ChecklistItem it) = name(answerOption(i, it));
answerValue 'Значение' = DATA NUMERIC[14,4] (Inspection, ChecklistItem);
answerComment 'Комментарий' = DATA ISTRING[500] (Inspection, ChecklistItem) CHARWIDTH 25;
answerPhoto 'Фото' = DATA IMAGEFILE (Inspection, ChecklistItem);

CONSTRAINT answerOption(Inspection i, ChecklistItem it) AND NOT scale(answerOption(i, it)) = scale(it)
    CHECKED BY answerOption[Inspection, ChecklistItem]
    MESSAGE 'Выбранный вариант не относится к шкале пункта';

answered (Inspection i, ChecklistItem it) = answerOption(i, it) OR answerValue(i, it);
notApplicable (Inspection i, ChecklistItem it) = notApplicable(answerOption(i, it));
inNorm (Inspection i, ChecklistItem it) = answerValue(i, it) >= minNorm(scale(it)) AND answerValue(i, it) <= maxNorm(scale(it));
nonconformity (Inspection i, ChecklistItem it) = nonconformity(answerOption(i, it));

// --- required evidence on a non-conformity ---
needsPhoto (Inspection i, ChecklistItem it) = nonconformity(i, it) AND requirePhoto(it) AND NOT answerPhoto(i, it);
needsComment (Inspection i, ChecklistItem it) = nonconformity(i, it) AND requireComment(it) AND NOT answerComment(i, it);
needsEvidence 'Нужно свидетельство' (Inspection i, ChecklistItem it) = needsPhoto(i, it) OR needsComment(i, it);
missingEvidence (Inspection i) = GROUP SUM 1 IF needsEvidence(i, ChecklistItem it);

CONSTRAINT SETCHANGED(state(Inspection i)) AND finished(i) AND missingEvidence(i)
    MESSAGE 'Перед завершением проверки заполните обязательное фото/комментарий по каждому несоответствию';

// --- scoring ---
itemScore 'Балл' (Inspection i, ChecklistItem it) =
    IF answered(i, it) AND NOT notApplicable(i, it) THEN
        (IF numeric(scale(it))
            THEN (IF inNorm(i, it) THEN weight(it) ELSE 0)
            ELSE score(answerOption(i, it)) * weight(it));

itemMax (Inspection i, ChecklistItem it) =
    IF answered(i, it) AND NOT notApplicable(i, it) THEN
        (IF numeric(scale(it)) THEN weight(it) ELSE maxScore(scale(it)) * weight(it));

totalScore (Inspection i) = GROUP SUM itemScore(i, ChecklistItem it);
totalMax (Inspection i) = GROUP SUM itemMax(i, ChecklistItem it);
percent 'Оценка, %' (Inspection i) = NUMERIC[6,2](100 * totalScore(i) / totalMax(i));

countCriticalFail (Inspection i) = GROUP SUM 1 IF critical(ChecklistItem it) AND nonconformity(i, it);
threshold (Inspection i) = passThreshold(checklist(i));
passed 'Пройдено' (Inspection i) = i IS Inspection AND NOT countCriticalFail(i)
    AND (NOT threshold(i) OR percent(i) >= threshold(i));
nameVerdict 'Вердикт' (Inspection i) = IF passed(i) THEN 'Пройдено' ELSE 'Не пройдено';

percentString (Inspection i) = STRING[10](percent(i)) + '%';
resultSummary (Inspection i) += CONCAT ' — ', percentString(i), nameVerdict(i);

// section attributes for grouping items on the fill form
nameSection 'Раздел' (ChecklistItem it) = name(section(it));
sectionIndex 'Разд.' (ChecklistItem it) = index(section(it));

FORM inspection 'Проверка'
    OBJECTS i = Inspection PANEL
    PROPERTIES(i) nameObject READONLY, nameChecklist READONLY,
                  dateTime READONLY, nameExecutor READONLY,
                  percent READONLY, nameVerdict READONLY, nameState READONLY
    PROPERTIES(i) finish

    OBJECTS it = ChecklistItem
    PROPERTIES(it) READONLY sectionIndex, nameSection, index, name, nameScale
    PROPERTIES nameAnswerOption(i, it), answerValue(i, it), answerComment(i, it),
               answerPhoto(i, it), needsEvidence(i, it) READONLY,
               itemScore(i, it) READONLY
    FILTERS checklist(it) = checklist(i)
    ORDERS sectionIndex(it), index(it)

    EDIT Inspection OBJECT i
;

DESIGN inspection {
    OBJECTS {
        NEW header {
            horizontal = TRUE;
            alignment = STRETCH;
            NEW info {
                fill = 1;
                MOVE PROPERTY(nameObject(i));
                MOVE PROPERTY(nameChecklist(i));
                NEW infoLine {
                    horizontal = TRUE;
                    MOVE PROPERTY(nameExecutor(i));
                    MOVE PROPERTY(dateTime(i));
                    MOVE PROPERTY(nameState(i));
                }
            }
            NEW score {
                MOVE PROPERTY(percent(i)) { fontSize = 22; }
                MOVE PROPERTY(nameVerdict(i));
                MOVE PROPERTY(finish(i));
            }
        }
        MOVE BOX(it) { caption = 'Пункты'; fill = 1; }
    }
}

// open the inspection fill form from the task's executions grid
EXTEND FORM task
    PROPERTIES(e) NEWSESSION EDIT
;
