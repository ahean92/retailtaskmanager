MODULE ChecklistItem;

REQUIRE ChecklistSection, Scale;

NAMESPACE StoreTask;

// A single check point inside a section, answered against a rating scale.
CLASS ChecklistItem 'Пункт';

section = DATA ChecklistSection (ChecklistItem) NONULL DELETE;
checklist 'Чек-лист' (ChecklistItem i) = checklist(section(i));
index '№' (ChecklistItem i) = PARTITION SUM 1 ORDER i BY section(i) CHARWIDTH 4;

name 'Требование' = DATA ISTRING[250] (ChecklistItem) IN id CHARWIDTH 40;
hint 'Норма / подсказка' = DATA ISTRING[500] (ChecklistItem) CHARWIDTH 30;
weight 'Вес' = DATA NUMERIC[8,2] (ChecklistItem);
critical 'Критичный' = DATA BOOLEAN (ChecklistItem);
requirePhoto 'Фото при несоответствии' = DATA BOOLEAN (ChecklistItem);
requireComment 'Комментарий при несоответствии' = DATA BOOLEAN (ChecklistItem);

scale = DATA Scale (ChecklistItem);
nameScale 'Шкала' (ChecklistItem i) = name(scale(i));

WHEN LOCAL SET(ChecklistItem i IS ChecklistItem) AND NOT CHANGED(weight(i)) DO weight(i) <- 1;

countItem 'Пунктов' (ChecklistSection s) = GROUP SUM 1 IF section(ChecklistItem i) = s;

// --- constructor: sections and their items on the checklist edit form ---
EXTEND FORM checklist
    OBJECTS sec = ChecklistSection
    PROPERTIES(sec) index READONLY, name, weight, countItem
    PROPERTIES(sec) NEW, DELETE
    FILTERS checklist(sec) = c
    ORDERS index(sec)

    OBJECTS it = ChecklistItem
    PROPERTIES(it) index READONLY, name, nameScale, weight,
                   critical, requirePhoto, requireComment, hint
    PROPERTIES(it) NEW, DELETE
    FILTERS section(it) = sec
    ORDERS index(it)
;

DESIGN checklist {
    structure {
        horizontal = TRUE;
        MOVE BOX(sec) { caption = 'Разделы'; fill = 1; }
        MOVE BOX(it) { caption = 'Пункты'; fill = 2; }
    }
}
