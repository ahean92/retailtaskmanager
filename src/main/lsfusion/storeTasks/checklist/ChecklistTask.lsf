MODULE ChecklistTask;

REQUIRE StoreTaskCore, Checklist;

NAMESPACE StoreTask;

// The checklist task type is a code-level plugin instance (not free user data),
// so it is seeded here and referenced by id.
loadDefaultData () + {
    IF NOT taskType('checklist') THEN
        NEW t = TaskType {
            name(t) <- 'Проверка по чек-листу';
            id(t) <- 'checklist';
        }
}

checklistTaskType () = taskType('checklist');
isChecklistTask (Task t) = type(t) = checklistTaskType();

// payload: which checklist template a checklist-type task uses
checklist = DATA Checklist (Task);
nameChecklist 'Чек-лист' (Task t) = name(checklist(t));

CONSTRAINT checklist(Task t) AND NOT isChecklistTask(t)
    MESSAGE 'Чек-лист можно задать только для задачи типа «Проверка по чек-листу»';

EXTEND FORM task
    PROPERTIES(t) nameChecklist SHOWIF isChecklistTask(t)
;

DESIGN task {
    object {
        MOVE PROPERTY(nameChecklist(t));
    }
}
