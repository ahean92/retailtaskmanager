MODULE StoreTaskAccess;

// Authentication — currentUser; StoreTaskForms — форма tasks, которую модуль расширяет
// (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskForms, Security, Authentication;

NAMESPACE StoreTask;

@addRoleApplicationSetting(seeAllTasks, 'Видеть все задачи', BOOLEAN);
@addRoleApplicationSetting(assignExecutor, 'Назначать исполнителя', BOOLEAN);
@addRoleApplicationSetting(closeForeignTask, 'Закрывать чужую задачу', BOOLEAN);
@addRoleApplicationSetting(editTemplates, 'Править шаблоны и справочники', BOOLEAN);
@addRoleApplicationSetting(editSettings, 'Править настройки', BOOLEAN);
@addRoleApplicationSetting(seeCoordinates, 'Видеть журнал координат', BOOLEAN);

canSeeAllTasks () = GROUP SUM 1 IF seeAllTasks(UserRole r) AND has(currentUser(), r);
canAssign () = GROUP SUM 1 IF assignExecutor(UserRole r) AND has(currentUser(), r);
canCloseForeign () = GROUP SUM 1 IF closeForeignTask(UserRole r) AND has(currentUser(), r);
// То же право по произвольному пользователю: приёмка (StoreTaskAcceptance) считает им «ждёт моего
// решения» в фильтре списка, на плитке главной и в выдаче телефона — там пользователь стоит
// параметром, как в mine(Task, User), и вариант без параметра выше не подставить
canCloseForeign (User u) = GROUP SUM 1 IF closeForeignTask(UserRole r) AND has(u, r);
canEditTemplates () = GROUP SUM 1 IF editTemplates(UserRole r) AND has(currentUser(), r);
canEditSettings () = GROUP SUM 1 IF editSettings(UserRole r) AND has(currentUser(), r);
canSeeCoordinates () = GROUP SUM 1 IF seeCoordinates(UserRole r) AND has(currentUser(), r);

visibleTask = ABSTRACT BOOLEAN (Task);
visibleTask (Task t) += participant(t, currentUser());

taskVisible 'Видна мне' (Task t) = TRUE IF isSystemAdmin() OR canSeeAllTasks() OR visibleTask(t);

EXTEND FORM tasks
    FILTERS taskVisible(t)
;

// Кнопка «Провести» (StoreTaskCore.proceedTask, #36987) — закрытой задаче, которую событие
// закрытия не провело: статус стал закрытым правкой справочника (закрытые до выката помечает
// старт сервера). Не всякому, кто видит карточку: нажатие — рассылка и корректирующие, то
// есть то же, что закрыть чужую задачу, и право то же.
EXTEND FORM task
    PROPERTIES(t) proceedTask SHOWIF closed(t) AND NOT proceeded(t)
                                     AND (isSystemAdmin() OR canCloseForeign())
;

DESIGN task {
    // в ряд действий, где «Взять»/«Начать» (объявлен в StoreTaskForms); PulseForm потом
    // уводит весь ряд в строку действий под названием
    object {
        MOVE PROPERTY(proceedTask(t)) { flex = 0; }
    }
}

loadDefaultData () + {
    IF NOT userRoleSID('executor') THEN
        NEW r = UserRole { sid(r) <- 'executor'; name(r) <- 'Исполнитель'; }
    IF NOT userRoleSID('supervisor') THEN
        NEW r = UserRole { sid(r) <- 'supervisor'; name(r) <- 'Супервайзер'; }
    FOR UserRole r = userRoleSID('supervisor') DO {
        assignExecutor(r) <- TRUE;
        closeForeignTask(r) <- TRUE;
        seeCoordinates(r) <- TRUE;
    }
    FOR UserRole r = systemAdminRole() DO {
        seeAllTasks(r) <- TRUE;
        assignExecutor(r) <- TRUE;
        closeForeignTask(r) <- TRUE;
        editTemplates(r) <- TRUE;
        editSettings(r) <- TRUE;
        seeCoordinates(r) <- TRUE;
    }
}
