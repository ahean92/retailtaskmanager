MODULE StoreTaskAccess;

// StoreTaskCore — Task, participant/assignedTo/author/closed/proceedTask; StoreTaskRights — права
// по ролям, признак человека и systemAdminRole; TaskPerformer — inAll/currentPerformer; Security —
// UserRole, userRoleSID; Authentication — currentUser; StoreTaskForms — формы tasks и task, которые
// модуль расширяет, и canDownload(TaskFile); StoreTaskSettings — seedRequiredData и папки навигатора; DefaultData —
// loadDefaultData; SystemEvents — onStarted (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskRights, TaskPerformer, StoreTaskForms, Security, Authentication, StoreTaskSettings, DefaultData,
        SystemEvents;

NAMESPACE StoreTask;

visibleTask = ABSTRACT CASE BOOLEAN (Task);
visibleTask (Task t) += WHEN participant(t, currentUser()) THEN TRUE;

taskVisible 'Видна мне' (Task t) = TRUE IF canSeeAllTasks() OR visibleTask(t);

canDownload(TaskFile f) += taskVisible(task(f)) OR user(f) = currentUser();

closeAllowed (Task t) = assignedTo(t, currentUser()) OR canCloseForeign();
statusAllowed (Task t) = closeAllowed(t) OR inAll(author(t), currentUser());

CONSTRAINT CHANGED(assignedTo(Task t)) AND PREV(assignedTo(t)) AND (assignedTo(t) OR PREV(assignedTo(t)) IS TaskPerformer) AND t IS Task AND byPerson() AND NOT canAssign()
    MESSAGE 'Назначать исполнителя может роль с правом «Назначать исполнителя»';

CONSTRAINT CHANGED(author(Task t)) AND PREV(author(t)) AND (author(t) OR PREV(author(t)) IS TaskPerformer) AND t IS Task AND byPerson() AND NOT canAssign()
    MESSAGE 'Менять автора задачи может роль с правом «Назначать исполнителя»';

CONSTRAINT DROPPED(Task t IS Task) AND byPerson() AND NOT canCloseForeign()
    MESSAGE 'Удалить задачу может роль с правом «Закрывать чужую задачу»';

newTask (Task t) = t IS Task AND NOT PREV(t IS Task);

openTask 'Открыть' (Task t) {
    IF NOT taskVisible(t) THEN {
        MESSAGE 'Нет доступа к задаче';
        RETURN;
    }
    SHOW task OBJECTS t = t DOCKED NEWSESSION;
}

edit (Task t) + {
    IF newTask(t) THEN SHOW task OBJECTS t = t DOCKED;
    ELSE openTask(t);
}

assignedLocked (Task t) += t IS Task AND NOT canAssign();

EXTEND FORM tasks
    FILTERS taskVisible(t)
;

// Кнопка «Провести» (StoreTaskCore.proceedTask, #36987) — закрытой задаче, которую событие
// закрытия не провело: статус стал закрытым правкой справочника (закрытые до выката помечает
// старт сервера). Не всякому, кто видит карточку: нажатие — рассылка и корректирующие, то
// есть то же, что закрыть чужую задачу, и право то же.
EXTEND FORM task
    PROPERTIES(t) proceedTask SHOWIF closed(t) AND NOT proceeded(t)
                                     AND canCloseForeign()
    EVENTS ON INIT {
        IF newTask(t) AND NOT assignedTo(t) AND NOT canAssign() THEN
            assignedTo(t) <- currentPerformer();
        IF t IS Task AND NOT newTask(t) AND NOT taskVisible(t) THEN
            throwException('Нет доступа к задаче');
    }
;

DESIGN task {
    // в ряд действий, где «Взять»/«Начать» (объявлен в StoreTaskForms); PulseForm потом
    // уводит весь ряд в строку действий под названием
    object {
        MOVE PROPERTY(proceedTask(t)) { flex = 0; }
    }
}

grantSupervisorRights (UserRole r) {
    assignExecutor(r) <- TRUE;
    closeForeignTask(r) <- TRUE;
    seeCoordinates(r) <- TRUE;
    createTaskBatch(r) <- TRUE;
}

grantAdminRights (UserRole r) {
    seeAllTasks(r) <- TRUE;
    assignExecutor(r) <- TRUE;
    closeForeignTask(r) <- TRUE;
    createTaskBatch(r) <- TRUE;
    editTemplates(r) <- TRUE;
    editSettings(r) <- TRUE;
    seeCoordinates(r) <- TRUE;
}

seedRequiredData () + {
    IF NOT userRoleSID('executor') THEN
        NEW r = UserRole { sid(r) <- 'executor'; name(r) <- 'Исполнитель'; }
    IF NOT userRoleSID('supervisor') THEN
        NEW r = UserRole {
            sid(r) <- 'supervisor';
            name(r) <- 'Супервайзер';
            grantSupervisorRights(r);
        }
}

grantDefaultRights () {
    FOR UserRole r = userRoleSID('supervisor') DO
        grantSupervisorRights(r);
    FOR UserRole r = systemAdminRole() DO
        grantAdminRights(r);
}

loadDefaultData () + {
    grantDefaultRights();
}

rightsGrantedOnStart = DATA BOOLEAN ();

onStarted () + {
    IF NOT rightsGrantedOnStart() THEN {
        grantDefaultRights();
        rightsGrantedOnStart() <- TRUE;
    }
}

NAVIGATOR {
    catalogs SHOWIF canEditCatalogs();
    settings SHOWIF canEditOptions();
}
