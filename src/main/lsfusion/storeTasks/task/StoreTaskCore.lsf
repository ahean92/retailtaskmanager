MODULE StoreTaskCore;

REQUIRE StoreTaskSettings, TaskPerformer,
        StoreTaskNumerator, StoreTaskObjectUtils, StoreTaskDocUtils,
        StoreTaskFileUtils, StoreTaskCommentUtils,
        StoreTaskType, StoreTaskStatus, StoreTaskPriority, StoreTaskTag,
        CheckObject;

NAMESPACE StoreTask;

// Store task (work order): inspect/handle a CheckObject. Copied from the MyCompany
// template task and adapted — target object made abstract, execution hook added.
CLASS Task 'Задача';

readonly = ABSTRACT CASE BOOLEAN (Task);

@defineTaskID(task, 'Управление персоналом', 'ST', 6);

// Client-side key for offline creation (#36714): the phone mints a UUID when the task
// is born and keeps addressing it by that UUID forever — the ST number is a display
// attribute, not a key the client depends on. GROUP AGGR declares uniqueness, and
// uniqueness is idempotency: a retried POST of the same UUID cannot create a second task.
clientId 'Ключ клиента' = DATA STRING[36] (Task) INDEXED;
taskByClientId = GROUP AGGR Task t BY clientId(t);
// one resolver for both kinds of address. The ST number wins, but the formats never
// overlap anyway: a UUID is exactly 36 chars, an ST id is shorter.
taskByAnyId (STRING[50] s) = OVERRIDE task(s), taskByClientId(STRING[36](s));

@defineTaskPropertyObject(task);

name '{Name}' = DATA ISTRING (Task) CHARWIDTH 30 IN id;
@defineTaskPropertyValue(task, name, '{Name}');
propertyLongTask (STRING p) += p = '{Name}';

idName '{Name}' (Task t) = CONCAT ' ', '#' + id(t), name(t);

prefixName = ABSTRACT VALUE ISTRING (Task);

fullName (Task t) = CONCAT ' - ', prefixName(t), name(t);

// short per-type hint under the task name in the mobile app's task list
// (StoreTaskApi.apiTasks -> subtitle); each type plugs its own, NULL is fine
mobileSubtitle 'Детали' = ABSTRACT VALUE ISTRING[100] (Task);

// --- inspection object (abstract target) ---
checkObject = DATA CheckObject (Task);
nameObject 'Объект' (Task t) = name(checkObject(t));
addressObject 'Адрес' (Task t) = address(checkObject(t));
@defineTaskPropertyValue(task, checkObject, 'Объект', nameObject);

author 'Автор' = DATA TaskPerformer (Task);
idAuthor 'Автор' (Task t) = id(author(t));
nameAuthor 'Автор' (Task t) = name(author(t));
WHEN LOCAL SET(Task t IS Task) AND NOT author(t) AND currentPerformer() DO author(t) <- currentPerformer();
@defineTaskPropertyValue(task, author, 'Автор', nameAuthor);

assignedTo 'Назначена на' = DATA TaskPerformer (Task);
idAssignedTo 'Назначена на' (Task t) = id(assignedTo(t));
nameAssignedTo 'Назначена на' (Task t) = name(assignedTo(t));
@defineTaskPropertyValue(task, assignedTo, 'Назначена на', nameAssignedTo);

assignedTo (Task t, User u) = in(assignedTo(t), u) MATERIALIZED;

start 'Дата начала' = DATA DATE (Task);
@defineTaskPropertyValue(task, start, 'Дата начала');
start(Task t) <- currentDate() WHEN SET(t IS Task);

deadline 'Срок' = DATA DATE (Task);
@defineTaskPropertyValue(task, deadline, 'Срок');

progress 'Готово, %' = DATA INTEGER (Task);
@defineTaskPropertyValue(task, progress, 'Готово, %');

description 'Описание' = DATA RICHTEXT (Task) CHARWIDTH 20;

status 'Статус' = DATA TaskStatus (Task);
nameStatus 'Статус' (Task t) = name(status(t)) IN id;
@defineTaskPropertyValue(task, status, 'Статус', nameStatus);

closed 'Закрыта' (Task t) = closed(status(t));
opened 'Открыта' (Task t) = t IS Task AND NOT closed(t);

type 'Тип' = DATA TaskType (Task);
nameType 'Тип' (Task t) = name(type(t)) IN id;
@defineTaskPropertyValue(task, type, 'Тип', nameType);

WHEN LOCAL SET(Task t IS Task) AND NOT CHANGED(type(t)) DO type(t) <- defaultTaskType();

WHEN LOCAL SETCHANGED(type(Task l)) AND NOT allow(type(l), status(l)) DO
    status(l) <- firstTaskStatus(type(l));

CONSTRAINT SETCHANGED(status(Task l)) AND type(l) AND NOT allow(type(l), status(l))
    CHECKED BY status[Task]
    MESSAGE 'Статус недопустим для выбранного типа';

// Создана на месте, вне графика проверок (#36716). Ставится мобильной ручкой
// apiCreateTask задачам с бланком; плановые рождаются графиком (#36710) и бэк-офисом.
// Пока ни на что не влияет — заведён сразу, потому что задним числом его к уже
// проведённым проверкам не приделать; считать ли такие проверки в отчётах наравне
// с плановыми — открытый вопрос к заказчику.
unplanned 'Внеплановая' = DATA BOOLEAN (Task);

priority 'Приоритет' = DATA TaskPriority (Task);
namePriority 'Приоритет' (Task t) = name(priority(t));
idColorPriority (Task t) = idColor(priority(t));
rgbColorPriority (Task t) = rgbColor(priority(t));
@defineTaskPropertyValue(task, priority, 'Приоритет', namePriority);

in 'Вкл.' = DATA BOOLEAN (Task, TaskTag);
tags 'Теги' (Task t) = GROUP CONCAT name(TaskTag tg) IF in(t, tg), ', ' ORDER name(tg), tg;
@defineTaskPropertyValue(task, tags, 'Теги');

onCreate ABSTRACT LIST (Task);

// each task type implements execution creation for its kind (guarded by type id)
startExecution ABSTRACT LIST (Task);

// save the task, then create its execution in an isolated session
beginExecution 'Начать' (Task t) {
    APPLY;
    IF canceled() THEN RETURN;
    NEWSESSION { startExecution(t); APPLY; }
}

FORM task 'Задача'
    OBJECTS t = Task PANEL
    PROPERTIES(t) id, name, nameStatus SELECT 'buttonGroup',
                  nameObject, addressObject READONLY,
                  nameAuthor, nameAssignedTo,
                  nameType, namePriority, tags,
                  start, deadline, progress,
                  clientId READONLY, unplanned READONLY,
                  description
    PROPERTIES(t) beginExecution

    EDIT Task OBJECT t
;

DESIGN task {
    OBJECTS {
        NEW pane {
            horizontal = TRUE;
            fill = 1;
            NEW leftPane {
                fill = 1;
                NEW header {
                    alignment = STRETCH;
                    NEW main {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        MOVE PROPERTY(id(t)) { flex = 0; };
                        MOVE PROPERTY(name(t)) { flex = 1; fontSize = 16; }
                    }
                    NEW object {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        MOVE PROPERTY(nameObject(t)) { flex = 1; }
                        MOVE PROPERTY(addressObject(t)) { flex = 1; }
                        MOVE PROPERTY(beginExecution(t)) { flex = 0; }
                    }
                    NEW params {
                        lines = 2;
                        alignment = STRETCH;
                        MOVE PROPERTY(nameAuthor(t));
                        MOVE PROPERTY(nameAssignedTo(t));
                        MOVE PROPERTY(nameType(t));
                        MOVE PROPERTY(namePriority(t));
                        MOVE PROPERTY(tags(t));
                        NEW progress {
                            horizontal = TRUE;
                            MOVE PROPERTY(start(t));
                            MOVE PROPERTY(deadline(t));
                            MOVE PROPERTY(progress(t));
                        }
                        MOVE PROPERTY(clientId(t));
                        MOVE PROPERTY(unplanned(t));
                    }
                }
                NEW details {
                    tabbed = TRUE;
                    fill = 1;
                    NEW description {
                        caption = 'Описание';
                        MOVE PROPERTY(description(t)) { caption = ''; fill = 1; }
                    }
                }
            }
            NEW rightPane {
                fill = 1;
            }
        }
    }
}

@defineTaskFormStatusContainer(task);
DESIGN task {
    status {
        MOVE PROPERTY(nameStatus(t));
    }
}

showTask (LONG id) {
    FOR LONG(Task t AS Task) = id DO
        SHOW task OBJECTS t = t DOCKED MANAGESESSION;
} @@api;

FORM tasks 'Задачи'
    OBJECTS t = Task BACKGROUND rgbColorPriority(t)
    PROPERTIES(t) READONLY id, name, nameObject, nameAuthor, nameAssignedTo,
                           nameStatus, nameType, namePriority,
                           start, deadline, progress,
                           tags, closed, unplanned
    PROPERTIES(t) NEWSESSION NEW, EDIT, DELETE

    FILTERGROUP active
        FILTER 'Открытые' opened(t) 'F8' DEFAULT
        FILTER 'Закрытые' closed(t) 'F7'

    FILTERGROUP my
        FILTER 'Мои задачи' author(t) = currentPerformer() 'F6'
        FILTER 'Назначенные мне' assignedTo(t, currentUser()) 'F5'

    LIST Task OBJECT t
;

@defineTaskHistoryForm(task, task, t);

@defineTaskObjectsForm(tasks, t, 'Задачи');

@defineTaskFiles(task, t, 'Файл задачи');

// who may fetch an attached file through the download endpoint: the task's
// participants — assignee (team-aware, same predicate as apiTasks), author, or
// whoever uploaded the file. Deliberately wider than apiTasks: file links in
// desktop comments (defineTaskCommentsFiles) go through this same endpoint.
canDownload(TaskFile f) += assignedTo(task(f), currentUser()) OR in(author(task(f)), currentUser()) OR user(f) = currentUser();

@defineTaskComments(task, t, rightPane);
@defineTaskCommentsHistory(task);

@defineTaskCommentsCreate(task, history);

@defineTaskCommentsFiles(task, StoreTask);

@defineTaskCommentsCreate(task, file);

@defineTaskStatusChange(task, 'Задача');
@defineTaskStatusChangeForm(task, t, 'Задача');

DESIGN tasks {
    PROPERTY(tags(t)) { valueHeight = 18; }
}

NAVIGATOR {
    operations {
        NEW tasks;
    }
}
