MODULE StoreTaskCore;

// Utils — regexpReplace/replace для plainFromHtml; Security — роль администратора в
// canDownload (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskSettings, TaskPerformer, Security,
        StoreTaskNumerator, StoreTaskObjectUtils, StoreTaskDocUtils,
        StoreTaskFileUtils, StoreTaskCommentUtils,
        StoreTaskType, StoreTaskStatus, StoreTaskPriority, StoreTaskTag,
        CheckObject, Utils;

NAMESPACE StoreTask;

// Store task (work order): inspect/handle a CheckObject. Copied from the MyCompany
// template task and adapted — target object made abstract, execution hook added.
CLASS Task 'Задача';

readonly = ABSTRACT CASE BOOLEAN (Task);

@defineTaskID(task, 'Управление персоналом', 'ST', 6);

// Client-side key for offline creation (#36714): the phone mints a UUID when the task
// is born and keeps addressing it by that UUID forever — the ST number is a display
// attribute, not a key the client depends on. GROUP AGGR declares uniqueness, and
// uniqueness is idempotency: a retried POST of the same UUID cannot create a second task.
clientId 'Ключ клиента' = DATA STRING[36] (Task) INDEXED;
taskByClientId = GROUP AGGR Task t BY clientId(t);
// one resolver for both kinds of address. The ST number wins, but the formats never
// overlap anyway: a UUID is exactly 36 chars, an ST id is shorter.
taskByAnyId (STRING[50] s) = OVERRIDE task(s), taskByClientId(STRING[36](s));

@defineTaskPropertyObject(task);

name '{Name}' = DATA ISTRING (Task) CHARWIDTH 30 IN id;
@defineTaskPropertyValue(task, name, '{Name}');
propertyLongTask (STRING p) += p = '{Name}';

idName '{Name}' (Task t) = CONCAT ' ', '#' + id(t), name(t);

prefixName = ABSTRACT VALUE ISTRING (Task);

fullName (Task t) = CONCAT ' - ', prefixName(t), name(t);

// short per-type hint under the task name in the mobile app's task list
// (StoreTaskApi.apiTasks -> subtitle); each type plugs its own, NULL is fine
mobileSubtitle 'Детали' = ABSTRACT VALUE ISTRING[100] (Task);

// --- inspection object (abstract target) ---
checkObject = DATA CheckObject (Task);
nameObject 'Объект' (Task t) = name(checkObject(t));
addressObject 'Адрес' (Task t) = address(checkObject(t));
@defineTaskPropertyValue(task, checkObject, 'Объект', nameObject);

author 'Автор' = DATA TaskPerformer (Task);
idAuthor 'Автор' (Task t) = id(author(t));
nameAuthor 'Автор' (Task t) = name(author(t));
WHEN LOCAL SET(Task t IS Task) AND NOT author(t) AND currentPerformer() DO author(t) <- currentPerformer();
@defineTaskPropertyValue(task, author, 'Автор', nameAuthor);

assignedTo 'Назначена на' = DATA TaskPerformer (Task) INDEXED;
idAssignedTo 'Назначена на' (Task t) = id(assignedTo(t));
nameAssignedTo 'Назначена на' (Task t) = name(assignedTo(t));
@defineTaskPropertyValue(task, assignedTo, 'Назначена на', nameAssignedTo);

// видимость задачи — членство в назначенном исполнителе с учётом иерархии (#36835):
// задача на магазин видна всем внутри магазина, на отдел клининга — клинингу и входящим
// в него полотёрам, на полотёров — только полотёрам
assignedTo (Task t, User u) = inAll(assignedTo(t), u) MATERIALIZED;

// --- взятие задачи на себя (#36835) ---
// Отдельное поле, а не перезапись assignedTo: назначение и взятие — разные факты, и,
// затирая назначение, мы потеряли бы и то, что задача была командной, и возможность
// вернуть её в пул. «Взял» — это координация, а не замок: выполнять задачу по-прежнему
// может любой, кто её видит. Иначе человек, взявший задачу офлайн и заполнивший бланк в
// поле, при возврате связи обнаружил бы, что задача чужая, — и его работу пришлось бы
// выбрасывать; модель к тому же допускает несколько выполнений на задачу (Execution).
takenBy 'Взял на себя' = DATA TaskPerformer (Task) INDEXED;
idTakenBy 'Взял на себя' (Task t) = id(takenBy(t));
nameTakenBy 'Взял на себя' (Task t) = name(takenBy(t));
@defineTaskPropertyValue(task, takenBy, 'Взял на себя', nameTakenBy);

takenAt 'Взята' = DATA DATETIME (Task);

// Переназначение возвращает задачу в пул. Без сброса пометка застревает: новый отдел
// видит задачу «занятой» человеком, которого в нём нет (canTake пуст у всех), а у
// прежнего взявшего плитка главной считает задачу, которой нет в его списке, — дефект
// доверия #36751. CHANGED, а не SETCHANGED: снятие назначения в NULL — тоже возврат
// в пул. При создании задачи takenBy пуст, и гвард гасит событие.
WHEN CHANGED(assignedTo(Task t)) AND takenBy(t) DO {
    takenBy(t) <- NULL;
    takenAt(t) <- NULL;
}

start 'Дата начала' = DATA DATE (Task);
@defineTaskPropertyValue(task, start, 'Дата начала');
start(Task t) <- currentDate() WHEN SET(t IS Task);

deadline 'Срок' = DATA DATE (Task);
@defineTaskPropertyValue(task, deadline, 'Срок');

progress 'Готово, %' = DATA INTEGER (Task);
@defineTaskPropertyValue(task, progress, 'Готово, %');

description 'Описание' = DATA RICHTEXT (Task) CHARWIDTH 20;

// === текст без разметки ===
// RICHTEXT — это HTML из десктопного редактора (Quill: <p>, <br>, списки, @mention-чипы).
// Телефону он отдаётся чистым текстом: переносы строк из <br> и закрывающих блоков, теги
// долой, сущности обратно в символы, пробелы и переносы по краям — тоже долой (trim()
// базы снимает только пробелы, а закрывающий </p> оставляет перенос в хвосте — проверено
// на стенде). regexpReplace — платформенная обёртка над PostgreSQL REGEXP_REPLACE;
// шаблоны — сырыми строками, чтобы \s дошёл до базы как есть.
//
// Формула живёт здесь, в общем предке, потому что нужна двоим: описанию задачи (#36842)
// и тексту сообщения ленты (TaskComment.plainText, #36844) — второй экземпляр той же
// выжимки означал бы два места, где чинить одну и ту же ошибку разбора.
plainFromHtml (STRING html) = regexpReplace(
    replace(replace(replace(replace(replace(replace(
        regexpReplace(
            regexpReplace(html, r'<br\s*/?>|</p>|</div>|</li>|</tr>|</h[1-6]>', '\n', 'gi'),
            r'<[^>]*>', '', 'g'),
        '&nbsp;', ' '), '&quot;', '"'), '&#39;', '\''), '&lt;', '<'), '&gt;', '>'), '&amp;', '&'),
    r'^\s+|\s+$', '', 'g');

// Описание для мобильного клиента (#36842): сырой HTML на телефон не уходит — ни в
// текстовый виджет как есть (человек увидит теги), ни в рендер разметки на устройстве.
plainDescription 'Описание' (Task t) = plainFromHtml(STRING(description(t)));

status 'Статус' = DATA TaskStatus (Task);
nameStatus 'Статус' (Task t) = name(status(t)) IN id;
@defineTaskPropertyValue(task, status, 'Статус', nameStatus);

closed 'Закрыта' (Task t) = closed(status(t));
opened 'Открыта' (Task t) = t IS Task AND NOT closed(t);

// удаление исполнителя с открытыми задачами молча оставило бы их ничьими и невидимыми
// всем (ссылки платформа обнуляет) — общий гвард на любого исполнителя любого хоста
CONSTRAINT DROPPED(TaskPerformer p IS TaskPerformer) AND PREV(assignedTo(Task t) = p) AND PREV(opened(t))
    MESSAGE 'Нельзя удалить исполнителя, на которого назначены открытые задачи';

// Право взять — то же транзитивное членство, что и видимость, минус два случая, в которых
// кнопка бессмысленна: у учётки нет исполнителя (takenBy ссылается на TaskPerformer, так
// что служебный аккаунт задачу видит, а взять не может) и задача назначена лично на меня —
// брать её не у кого, она и так моя. Второе — не придирка: без него «свободные в моей
// команде» превращаются в «назначенные мне», а на телефоне личные поручения уезжают в пул.
//
// apiTakeTask намеренно мягче: он проверяет видимость и исполнителя, но не отказывает в
// захвате личной задачи — метка на ней безвредна, а лишний код ошибки клиенту, который
// рисует кнопку по canTake, не нужен.
canTake 'Можно взять' (Task t, User u) = TRUE IF opened(t) AND assignedTo(t, u) AND NOT takenBy(t)
                                                 AND performer(u) AND NOT (assignedTo(t) = performer(u));
// Снять может тот, кто взял, и автор задачи — и только с открытой: у выполненной
// пометка «кто брал» — история, стирать её незачем.
canRelease (Task t, User u) = TRUE IF opened(t) AND takenBy(t) AND (takenBy(t) = performer(u) OR author(t) = performer(u));

// «Моя» задача — взятая мной либо назначенная лично на меня и никем не взятая. Считать
// своим весь пул подразделения нельзя: плитка на главной разошлась бы со списком, тот же
// дефект доверия, что разбирали в #36751.
mine 'Моя' (Task t, User u) = TRUE IF (takenBy(t) = performer(u)
                                       OR (assignedTo(t) = performer(u) AND NOT takenBy(t)));

// Участник задачи (#36844): назначенный — с учётом иерархии, тем же предикатом, что и
// видимость списка, — и автор. Участникам открыта переписка по задаче и сама задача в
// приложении (apiTasks): директор, поставивший задачу работнику, иначе не увидел бы в
// телефоне ни её, ни ответа в ленте. Автор — участник, но не исполнитель: заполнять
// бланк, менять статус и брать задачу (StoreTaskApi.canTouch, apiSetStatus, canTake)
// по-прежнему может лишь назначенный. Взявший (takenBy) отдельно не нужен: взять можно
// только назначенную на себя или своё подразделение, а переназначение сбрасывает пометку.
participant 'Участник' (Task t, User u) = TRUE IF assignedTo(t, u) OR inAll(author(t), u);

// === единственная точка записи взятия/снятия ===
// Гвард — ВНУТРИ применяемого действия, и это несущая стена: APPLY SERIALIZABLE при
// конфликте записи НЕ отменяет проигравшего, а молча перезапускает транзакцию
// (DataSession.repeatApply), перевыполняя только её тело. Гвард снаружи при ретрае не
// перечитывается — проигравший записал бы себя поверх победителя, и «первый выигрывает»
// из тикета не выполнялось бы. Внутри тела ретрай видит свежий снапшот: победителя не
// трогаем, коммитим пусто, а ответ каждый слой строит по зафиксированному состоянию.
doTake (Task t) {
    NEWSESSION {
        APPLY SERIALIZABLE {
            // currentPerformer() в гварде обязателен: без него учётка без исполнителя
            // записала бы takenAt при пустом takenBy — битая строка
            IF opened(t) AND NOT takenBy(t) AND currentPerformer() THEN {
                takenBy(t) <- currentPerformer();
                takenAt(t) <- currentDateTime();
            }
        }
    }
}

doRelease (Task t) {
    NEWSESSION {
        APPLY SERIALIZABLE {
            // право перепроверяется в той же транзакции: параллельный чужой захват не
            // затирается — снять НОВОГО взявшего вправе только автор
            IF canRelease(t, currentUser()) THEN {
                takenBy(t) <- NULL;
                takenAt(t) <- NULL;
            }
        }
    }
}

// Бэк-офисные действия поверх примитивов: как beginExecution — сначала сохранить
// карточку, сама операция отдельной транзакцией, после неё ответ по факту.
takeTask 'Взять на себя' (Task t) {
    IF NOT canTake(t, currentUser()) THEN {
        IF NOT currentPerformer() THEN {
            MESSAGE 'Ваша учётная запись не связана с исполнителем';
            RETURN;
        }
        IF takenBy(t) THEN {
            MESSAGE (CONCAT ', ', 'Задачу уже взял ' + (OVERRIDE name(takenBy(t)), 'другой исполнитель'),
                                  STRING[19](takenAt(t)));
            RETURN;
        }
        IF closed(t) THEN {
            MESSAGE 'Задача уже закрыта';
            RETURN;
        }
        IF assignedTo(t) = currentPerformer() THEN {
            MESSAGE 'Задача назначена лично на вас — взятие не требуется';
            RETURN;
        }
        MESSAGE 'Задача не назначена ни на вас, ни на ваше подразделение';
        RETURN;
    }
    APPLY;
    IF canceled() THEN RETURN;
    doTake(t);
    IF takenBy(t) AND NOT (takenBy(t) = currentPerformer()) THEN {
        MESSAGE (CONCAT ', ', 'Задачу уже взял ' + (OVERRIDE name(takenBy(t)), 'другой исполнитель'),
                              STRING[19](takenAt(t)));
        RETURN;
    }
    IF NOT takenBy(t) THEN {
        IF closed(t) THEN {
            MESSAGE 'Задача уже закрыта';
            RETURN;
        }
        MESSAGE 'Не удалось взять задачу';
    }
}

releaseTask 'Снять с себя' (Task t) {
    IF NOT canRelease(t, currentUser()) THEN {
        IF takenBy(t) AND closed(t) THEN {
            MESSAGE 'Задача закрыта — пометка «кто брал» остаётся в истории';
            RETURN;
        }
        MESSAGE 'Снять задачу может тот, кто её взял, и автор задачи';
        RETURN;
    }
    APPLY;
    IF canceled() THEN RETURN;
    doRelease(t);
    IF takenBy(t) THEN {
        MESSAGE (CONCAT ', ', 'Задачу уже взял ' + (OVERRIDE name(takenBy(t)), 'другой исполнитель'),
                              STRING[19](takenAt(t)));
    }
}

type 'Тип' = DATA TaskType (Task);
nameType 'Тип' (Task t) = name(type(t)) IN id;
@defineTaskPropertyValue(task, type, 'Тип', nameType);

WHEN LOCAL SET(Task t IS Task) AND NOT CHANGED(type(t)) DO type(t) <- defaultTaskType();

WHEN LOCAL SETCHANGED(type(Task l)) AND NOT allow(type(l), status(l)) DO
    status(l) <- firstTaskStatus(type(l));

CONSTRAINT SETCHANGED(status(Task l)) AND type(l) AND NOT allow(type(l), status(l))
    CHECKED BY status[Task]
    MESSAGE 'Статус недопустим для выбранного типа';

// Создана на месте, вне графика проверок (#36716). Ставится мобильной ручкой
// apiCreateTask задачам с бланком; плановые рождаются графиком (#36710) и бэк-офисом.
// Пока ни на что не влияет — заведён сразу, потому что задним числом его к уже
// проведённым проверкам не приделать; считать ли такие проверки в отчётах наравне
// с плановыми — открытый вопрос к заказчику.
unplanned 'Внеплановая' = DATA BOOLEAN (Task);

priority 'Приоритет' = DATA TaskPriority (Task);
namePriority 'Приоритет' (Task t) = name(priority(t));
idColorPriority (Task t) = idColor(priority(t));
rgbColorPriority (Task t) = rgbColor(priority(t));
@defineTaskPropertyValue(task, priority, 'Приоритет', namePriority);

in 'Вкл.' = DATA BOOLEAN (Task, TaskTag);
tags 'Теги' (Task t) = GROUP CONCAT name(TaskTag tg) IF in(t, tg), ', ' ORDER name(tg), tg;
@defineTaskPropertyValue(task, tags, 'Теги');

onCreate ABSTRACT LIST (Task);

// each task type implements execution creation for its kind (guarded by type id)
startExecution ABSTRACT LIST (Task);

// save the task, then create its execution in an isolated session
beginExecution 'Начать' (Task t) {
    APPLY;
    IF canceled() THEN RETURN;
    NEWSESSION { startExecution(t); APPLY; }
}

FORM task 'Задача'
    OBJECTS t = Task PANEL
    PROPERTIES(t) id, name, nameStatus SELECT 'buttonGroup',
                  nameObject, addressObject READONLY,
                  nameAuthor, nameAssignedTo,
                  nameTakenBy READONLY, takenAt READONLY,
                  nameType, namePriority, tags,
                  start, deadline, progress,
                  clientId READONLY, unplanned READONLY,
                  description
    PROPERTIES(t) beginExecution,
                  takeTask SHOWIF canTake(t, currentUser()),
                  releaseTask SHOWIF canRelease(t, currentUser())

    EDIT Task OBJECT t
;

DESIGN task {
    OBJECTS {
        NEW pane {
            horizontal = TRUE;
            fill = 1;
            NEW leftPane {
                fill = 1;
                NEW header {
                    alignment = STRETCH;
                    NEW main {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        MOVE PROPERTY(id(t)) { flex = 0; };
                        MOVE PROPERTY(name(t)) { flex = 1; fontSize = 16; }
                    }
                    NEW object {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        MOVE PROPERTY(nameObject(t)) { flex = 1; }
                        MOVE PROPERTY(addressObject(t)) { flex = 1; }
                        MOVE PROPERTY(takeTask(t)) { flex = 0; };
                        MOVE PROPERTY(releaseTask(t)) { flex = 0; };
                        MOVE PROPERTY(beginExecution(t)) { flex = 0; }
                    }
                    NEW params {
                        lines = 2;
                        alignment = STRETCH;
                        MOVE PROPERTY(nameAuthor(t));
                        MOVE PROPERTY(nameAssignedTo(t));
                        MOVE PROPERTY(nameTakenBy(t));
                        MOVE PROPERTY(takenAt(t));
                        MOVE PROPERTY(nameType(t));
                        MOVE PROPERTY(namePriority(t));
                        MOVE PROPERTY(tags(t));
                        NEW progress {
                            horizontal = TRUE;
                            MOVE PROPERTY(start(t));
                            MOVE PROPERTY(deadline(t));
                            MOVE PROPERTY(progress(t));
                        }
                        MOVE PROPERTY(clientId(t));
                        MOVE PROPERTY(unplanned(t));
                    }
                }
                NEW details {
                    tabbed = TRUE;
                    fill = 1;
                    NEW description {
                        caption = 'Описание';
                        MOVE PROPERTY(description(t)) { caption = ''; fill = 1; }
                    }
                }
            }
            NEW rightPane {
                fill = 1;
            }
        }
    }
}

@defineTaskFormStatusContainer(task);
DESIGN task {
    status {
        MOVE PROPERTY(nameStatus(t));
    }
}

showTask (LONG id) {
    FOR LONG(Task t AS Task) = id DO
        SHOW task OBJECTS t = t DOCKED MANAGESESSION;
} @@api;

FORM tasks 'Задачи'
    OBJECTS t = Task BACKGROUND rgbColorPriority(t)
    PROPERTIES(t) READONLY id, name, nameObject, nameAuthor, nameAssignedTo, nameTakenBy,
                           nameStatus, nameType, namePriority,
                           start, deadline, progress,
                           tags, closed, unplanned
    PROPERTIES(t) NEWSESSION NEW, EDIT, DELETE

    FILTERGROUP active
        FILTER 'Открытые' opened(t) 'F8' DEFAULT
        FILTER 'Закрытые' closed(t) 'F7'

    FILTERGROUP my
        FILTER 'Мои задачи' author(t) = currentPerformer() 'F6'
        FILTER 'Назначенные мне' assignedTo(t, currentUser()) 'F5'
        FILTER 'Свободные в моей команде' canTake(t, currentUser()) 'F9'

    LIST Task OBJECT t
;

@defineTaskHistoryForm(task, task, t);

@defineTaskObjectsForm(tasks, t, 'Задачи');

@defineTaskFiles(task, t, 'Файл задачи');

// Администратор системы — роль с sid 'admin'. Считается по has(), а не по mainRole:
// роль может быть и дополнительной.
systemAdminRole () = GROUP MAX UserRole r IF sid(r) = 'admin';
isSystemAdmin () = has(currentUser(), systemAdminRole());

// who may fetch an attached file through the download endpoint: the task's
// participants — assignee (team-aware, same predicate as apiTasks), author, or
// whoever uploaded the file. Deliberately wider than apiTasks: file links in
// desktop comments (defineTaskCommentsFiles) go through this same endpoint.
//
// Плюс администратор системы: в АРМ он открывает саму задачу и видит в её ленте
// ссылки на вложения — отказ по ссылке, нарисованной рядом с текстом, читается как
// поломка, а не как защита. Право остаётся узким: ручка download — @@api, и рядовой
// сотрудник по подставленному id чужой файл по-прежнему не вытянет.
canDownload(TaskFile f) += assignedTo(task(f), currentUser()) OR in(author(task(f)), currentUser()) OR user(f) = currentUser()
    OR (isSystemAdmin() AND f IS TaskFile);

@defineTaskComments(task, t, rightPane);
@defineTaskCommentsHistory(task);

@defineTaskCommentsCreate(task, history);

@defineTaskCommentsFiles(task, StoreTask);

@defineTaskCommentsCreate(task, file);

@defineTaskStatusChange(task, 'Задача');
@defineTaskStatusChangeForm(task, t, 'Задача');

DESIGN tasks {
    PROPERTY(tags(t)) { valueHeight = 18; }
}

NAVIGATOR {
    operations {
        NEW tasks;
    }
}
