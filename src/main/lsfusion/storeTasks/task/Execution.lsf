MODULE Execution;

// StoreTaskType — за TaskType в executionKind (транзитивному REQUIRE не доверять)
// Также Time — currentDateTime; Utils — round; CheckObject — distance; StoreTaskStatus —
// taskStatus; StoreTaskTakeover — takenBy/takenAt, которые снимает «Вернуть в новые»;
// SystemEvents — onStarted, которым чистятся пустые дубли выполнений; StoreTaskForms —
// TaskFile (фото результата) и формы task/tasks, которые модуль расширяет (транзитивному
// REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskForms, StoreTaskType, TaskPerformer, Time, Utils, CheckObject,
        StoreTaskStatus, StoreTaskTakeover, SystemEvents;

NAMESPACE StoreTask;

// One attempt at doing a task. Type-specific details (checklist answers, recount
// lines, ...) are attached by subclasses in the type modules.
CLASS ExecutionState 'Статус выполнения' {
    active 'В работе',
    finished 'Завершено'
}
name '{Name}' (ExecutionState o) = ISTRING[50](caption(o)) IF o IS ExecutionState CHARWIDTH 12;

CLASS Execution 'Выполнение';

task = DATA Task (Execution) NONULL DELETE;
nameObject 'Объект' (Execution e) = nameObject(task(e));
nameType 'Тип' (Execution e) = nameType(task(e));

executor 'Проверяющий' = DATA TaskPerformer (Execution);
nameExecutor 'Проверяющий' (Execution e) = name(executor(e));
WHEN LOCAL SET(Execution e IS Execution) AND NOT executor(e) AND currentPerformer() DO executor(e) <- currentPerformer();

dateTime 'Дата/время' = DATA DATETIME (Execution);
dateTime(Execution e) <- currentDateTime() WHEN SET(e IS Execution);

state = DATA ExecutionState (Execution);
nameState 'Статус' (Execution e) = name(state(e)) IN id;
WHEN LOCAL SET(Execution e IS Execution) AND NOT CHANGED(state(e)) DO state(e) <- ExecutionState.active;
finished 'Завершено' (Execution e) = state(e) = ExecutionState.finished;

// short per-type result summary, shown in the executions list (e.g. "84% — passed")
resultSummary = ABSTRACT ISTRING[100] (Execution);
nameResult 'Результат' (Execution e) = resultSummary(e);

succeeded = ABSTRACT BOOLEAN (Execution);

// === чей это снимок: «было» или «стало» (#36842) ===
// Фото выполнения зеркалится в файлы задачи (SimpleExecution.onFinish), и без этой
// ссылки оно неотличимо от снимка проблемы, приложенного автором: обе строки — TaskFile
// с task(f). Различить их по имени файла нельзя — имя человек меняет. Карточка на
// телефоне разводит «было» и «стало» в разные блоки, и разводит именно по ней.
execution = DATA Execution (TaskFile) INDEXED;

// Снимок результата одного выполнения: photo(SimpleExecution) одно, но связь ведём на
// класс файлов, а не на поле, — второй снимок ничего здесь не сломает (возьмётся
// первый, как в firstFile метакода файлов).
resultPhoto (Execution e) = GROUP MIN TaskFile f IF execution(f) = e;

countExecution 'Выполнений' (Task t) = GROUP SUM 1 IF task(Execution e) = t;
countSucceeded 'Успешных' (Task t) = GROUP SUM 1 IF task(Execution e) = t AND succeeded(e);
allDone (Task t) = countExecution(t) AND countExecution(t) = countSucceeded(t);
lastExecution (Task t) = GROUP LAST Execution e ORDER dateTime(e), e BY task(e);
// Самое раннее выполнение задачи — им разрешается спор при чистке дублей (onStarted ниже):
// стираем пустые, кроме первого. ORDER DESC, как у firstTaskStatus в StoreTaskType, — это
// и есть «первый по тому же порядку, по которому lastExecution берёт последнего».
firstExecution (Task t) = GROUP LAST Execution e ORDER DESC dateTime(e), e BY task(e);
nameLastResult 'Результат' (Task t) = resultSummary(lastExecution(t));

// === где физически шла работа (#36838) ===
// Шесть фактов на задаче: время, широта и долгота фактического начала работы — и то же
// для завершения. Именно на задаче, а не на выполнении: вопрос акта — «где был человек,
// когда начал и когда закрыл ЗАДАЧУ», и отвечать на него надо без прохода по выполнениям.
// НЕ start(Task): то — «Дата начала» в смысле постановки, проставляется при создании
// (StoreTaskCore), и слить два смысла в одно слово — значит гарантировать путаницу.
//
// Значения приходят из мобильного API и сняты УСТРОЙСТВОМ в момент действия — клиент
// возит их в офлайн-очереди вместе с самой операцией, поэтому задача, начатая в
// самолётном режиме, несёт координаты места работы, а не места, где появилась сеть.
// Пустые координаты — тоже факт (подвал, склад, отказ в разрешении): завершение из-за
// их отсутствия не блокируется. Журнал api/GeoLog это не дублирует: там — кто с чем
// обращался к API, здесь — свойство самой задачи.
startedAt 'Работа начата' = DATA DATETIME (Task);
startedLatitude 'Широта (начало)' = DATA DOUBLE (Task);
startedLongitude 'Долгота (начало)' = DATA DOUBLE (Task);
finishedAt 'Работа завершена' = DATA DATETIME (Task);
finishedLatitude 'Широта (завершение)' = DATA DOUBLE (Task);
finishedLongitude 'Долгота (завершение)' = DATA DOUBLE (Task);

// Расстояние не хранится, а выводится из сохранённых точек и координат объекта:
// производная величина, у которой нет своего момента истины. Формула сама отдаёт
// NULL при любой недостающей координате (см. её IS NULL-обвязку в CheckObject).
// Целые метры: это число читают в карточке и кладут в акт, а GPS и близко не даёт
// девять знаков дробной части, которые сырой DOUBLE тащит на экран.
startedDistance 'От объекта при начале, м' (Task t) =
    round(distance(checkObject(t), startedLatitude(t), startedLongitude(t)), 0);
finishedDistance 'От объекта при завершении, м' (Task t) =
    round(distance(checkObject(t), finishedLatitude(t), finishedLongitude(t)), 0);

// post-finish effects (ticket 27 hook): hosts and type modules attach reactions here —
// runs in the finishing session, so both the ARM form and the mobile API go through it
onFinish ABSTRACT LIST (Execution);

// Завершение БЕЗ применения: состояние и реакции — здесь, APPLY — на вызывающем
// (#36872). Разделено не ради красоты: применение внутри съедало отказ. CONSTRAINT
// («Приложите фото выполненной работы») откатывает APPLY и взводит canceled(), но
// вложенный APPLY гасил флаг — внешняя проверка видела уже пустую сессию и считала
// её успешной. На десктопе человек хотя бы читал сообщение констрейнта, через API
// не оставалось и его: телефон показывал «завершено» по незакрытой задаче.
finishExecution (Execution e) {
    state(e) <- ExecutionState.finished;
    onFinish(e);
}

// Почему выполнение нельзя завершить прямо сейчас — текст для человека; NULL значит
// «можно». Предусловия знает вид выполнения, а не общий шов, поэтому точка расширения.
//
// По смыслу это дубль констрейнтов завершения, и он намеренный. Констрейнт остаётся:
// он — инвариант ДАННЫХ, через него отказывают ручки телефона (свой APPLY + canceled())
// и он ловит запись state мимо finishExecution. Но одного констрейнта на десктопе мало:
// он срабатывает ПОСЛЕ того, как state переведён в «Завершено» в текущей сессии, а откат
// APPLY сессию не чистит. Форма остаётся с finished(e) = TRUE, и дальше человек заперт:
// колонки ввода спрятаны (SHOWIF NOT finished), комментарий стал READONLY, «Добавить
// фото» исчезло, корректирующие задачи уже созданы в сессии через onFinish, а закрыть
// форму нельзя — любой следующий APPLY падает на том же констрейнте. То есть сообщение
// «приложите фото» приходило ровно в тот момент, когда приложить его уже нечем.
// Поэтому десктопная обёртка спрашивает ДО перевода состояния и выходит, не тронув
// ничего: форма остаётся рабочей, человек дополняет бланк и жмёт «Завершить» снова.
//
// Тексты держать в паре с сообщениями констрейнтов: условия у них общие
// (missingRequired, missingEvidence, resolution, requirePhoto) и живут в одном месте —
// разойтись могут только слова.
finishBlocked = ABSTRACT ISTRING[250] (Execution);

// Десктопная обёртка: форма применяет сразу, а сообщение об отказе показывает сама
// платформа. Ручкам API она не годится — им нужен canceled() после своего APPLY.
finish 'Завершить' (Execution e) {
    IF finishBlocked(e) THEN {
        MESSAGE finishBlocked(e);
        RETURN;
    }
    finishExecution(e);
    APPLY;
}

// === чем открывать задачу на телефоне (#36872) ===
// Вид выполнения объявляет СЕРВЕР, а не клиент: 'fill' — бланк (шаблон с полями),
// 'simple' — простое выполнение с фотоотчётом, пусто — открывать нечем (задачу
// видно, работать по ней в приложении нельзя). До этого список открываемых типов
// был захардкожен в приложении, и каждый новый тип задачи требовал релиза клиента —
// в том числе «Поручение», которое приложение уже умело создавать, но не закрывать.
// Значение доопределяет модуль типа, потому что только он знает, чем его задача
// выполняется; клиент выбирает экран по строке и не знает про типы вовсе.
//
// Объявлено на ТИПЕ, а не на задаче, и это несёт свой смысл: вид выполнения нужен
// ещё до того, как задача существует — пресет создания (apiQuickActions) отдаёт его
// телефону, и поручение, созданное в подвале без связи, открывается своим экраном
// сразу, не дожидаясь, пока сервер подтвердит создание.
// VALUE, а не EXCLUSIVE по умолчанию: реализации у всех модулей одной сигнатуры
// (TaskType), и различаются они условием на значение, а не классом параметра —
// ровно как у mobileSubtitle, соседней абстракции той же формы.
executionKind = ABSTRACT VALUE ISTRING[10] (TaskType);
executionKind (Task t) = executionKind(type(t));

// Автозавершение задачи — по ФАКТУ завершения выполнения, а не по пересчёту succeeded.
// Событие висело на SETCHANGED(succeeded), а succeeded(Filling) считался из текущих порога,
// весов и шкалы: снижение порога в шаблоне закрывало задним числом старые задачи — в том
// числе отменённые, — прямо при сохранении формы шаблона. Снимок итога (Filling.recordResult)
// убирает пересчёт у проверок, но условие обязано держать и другие источники succeeded: у
// простого выполнения оно зависит от «Требовать фото» задачи (SimpleExecution).
// opened(t) — то самое «не трогать закрытые»: «Отменено» остаётся «Отменено».
//
// Задача связана ОТДЕЛЬНЫМ параметром, и гвард — NOT CHANGED(status(t)), а не
// NOT CHANGED(status(task(e))). CHANGED считается по всей композиции — `(f OR PREV(f)) AND
// NOT f = PREV(f)`, — и у выполнения, рождённого в этой же сессии, PREV(task(e)) пуст:
// status(task(e)) «менялся» с NULL на статус задачи, и гвард молча гасил автозакрытие всякий
// раз, когда выполнение создано и завершено одним APPLY (eval, сиды, импорт). Двухсессионные
// пути — телефон, десктоп, офлайн-очереди — этого не видели. Смысл гварда прежний: не
// перебивать статус, который в этой сессии уже поставили — руками или startExecution
// («В работе»).
WHEN LOCAL SETCHANGED(state(Execution e)) AND finished(e) AND allDone(Task t) AND t = task(e)
    AND opened(t) AND NOT CHANGED(status(t))
    DO {
        status(t) <- taskStatus('done');
        autoStatus(t) <- TRUE;
    }

// ===== «Начать» — ровно один раз (дефект 4 журнала приёмки) =====
// Кнопка была доступна и после того, как выполнение уже есть, и повторное нажатие
// заводило второй бланк. Пустой дубль — не безобидная лишняя строка: lastExecution — это
// GROUP LAST, последним становится дубль, и через него читают карточка, отчёты и телефон,
// то есть готовая работа заслоняется пустым бланком. Реализации startExecution заодно
// снова ставят «В работе» — в том числе у закрытой задачи.
//
// Условие — «выполнения нет ВОВСЕ», а не «нет незавершённого»: ровно то правило, по
// которому живут ручки телефона (FillWriteApi.apiStartExecution, SimpleApi.apiStartSimple).
// «Нет незавершённого» пустило бы второй бланк после завершения — то самое, что ручки
// запрещают намеренно. Нужно ли перевыполнение после возврата на доработку — решается
// отдельным действием (#37157), а не послаблением здесь.
//
// opened(t) в условии — про закрытую задачу: у неё старт не должен возвращать «В работе».
//
// Проверка — в ОБЩЕМ действии, а не в реализациях хука: startExecution — ABSTRACT LIST,
// и в каждый модуль типа её пришлось бы копировать.
canBegin 'Можно начать' (Task t) = TRUE IF executionKind(t) AND opened(t) AND NOT lastExecution(t);

// save the task, then create its execution in an isolated session
beginExecution 'Начать' (Task t) {
    IF NOT canBegin(t) THEN {
        IF lastExecution(t) THEN {
            MESSAGE 'По задаче уже есть выполнение — начать её заново нельзя. Чтобы вернуть задачу в пул, нажмите «Вернуть в новые»';
            RETURN;
        }
        IF closed(t) THEN {
            MESSAGE 'Задача закрыта — начинать выполнение не по чему';
            RETURN;
        }
        MESSAGE 'Для этого типа задачи выполнение не предусмотрено';
        RETURN;
    }
    APPLY;
    IF canceled() THEN RETURN;
    NEWSESSION { startExecution(t); APPLY; }
}

// ===== возврат задачи в пул (вопрос 3 журнала приёмки) =====
// Статус вручную возвращали в «Новый», а бланк оставался «В работе»: система не возражала,
// и задача выглядела неначатой, имея выполнение. После правки выше такая задача осталась
// бы ещё и без «Начать» — то есть запертой. Значит, возврат в пул нужен явным действием,
// которое приводит в порядок ВСЁ: стирает пустой бланк, снимает взятие, ставит «Новый».
//
// Чем выполнение уже занято, знает его вид, а не общий шов, — поэтому точка расширения,
// как finishBlocked. NULL значит «пустое, стирать нечего».
filled 'Заполнено' = ABSTRACT BOOLEAN (Execution);

// Почему задачу нельзя вернуть в новые — текст для человека; NULL значит «можно».
// Агрегаты по ВСЕМ выполнениям задачи, а не по lastExecution: на базе до этой правки дубли
// уже есть, и стирать чьи-то ответы только потому, что последним оказался пустой бланк,
// нельзя. После чистки ниже и canBegin выполнение у задачи всё равно одно.
returnBlocked (Task t) = CASE
    WHEN closed(t) THEN 'Задача закрыта — вернуть её в новые нельзя'
    WHEN (GROUP SUM 1 IF task(Execution e) = t AND finished(e)) THEN
        'По задаче есть завершённое выполнение — вернуть её в новые нельзя'
    WHEN (GROUP SUM 1 IF task(Execution e) = t AND filled(e)) THEN
        'В бланке уже есть ответы — вернуть задачу в новые нельзя';

// Показываем там, где действию есть что менять: у задачи, которая и так «Новая»,
// возвращать нечего, у закрытой — незачем (и returnBlocked это же повторит отказом).
canReturn 'Можно вернуть в новые' (Task t) = TRUE IF opened(t) AND NOT (status(t) = taskStatus('new'));

// Три записи — одной транзакцией: иначе констрейнт ниже отказал бы своему же действию,
// увидев «Новый» при ещё живом выполнении.
returnToNew 'Вернуть в новые' (Task t) {
    IF returnBlocked(t) THEN {
        MESSAGE returnBlocked(t);
        RETURN;
    }
    APPLY;
    IF canceled() THEN RETURN;
    NEWSESSION {
        DELETE Execution e WHERE task(e) = t;
        takenBy(t) <- NULL;
        takenAt(t) <- NULL;
        status(t) <- taskStatus('new');
        APPLY;
    }
}

// Прямой перевод в «Новый» при существующем выполнении — отказ с подсказкой про действие
// выше. Констрейнт, а не гвард на форме: статус двигают карточка, канбан (drag&drop пишет
// status APPLY) и грид списка — одна правка данных тремя разными механизмами.
//
// Ручку apiSetStatus он задевает тоже, и это осознанно: без него телефон воспроизводил бы
// ровно тот же дефект. Клиент со своей стороны перестал предлагать «Новый» задаче с
// выполнением (task_detail_screen.dart), так что отказ достаётся лишь старой версии
// приложения; её строка остаётся в очереди с причиной на экране «Не отправлено», а
// следующие уезжают — отказ по нестрогой строке цепочку не держит (OutboxDrain).
//
// БЕЗ CHECKED BY, и это проверено на стенде: опция убирала «Новый» из списка статусов у
// всякой задачи, чья текущий статус не «Новый», — то есть и там, где выполнения нет и
// переводить можно. Отказ остаётся на APPLY: лучше отказ с подсказкой, чем молча
// недостающая кнопка там, где она законна.
// PREV(status(t)) — «у задачи УЖЕ БЫЛ статус», то есть это перевод, а не рождение. Без
// этой оговорки запрет бил по созданию: статус новой задаче проставляет событие
// (StoreTaskCore.lsf:149), SETCHANGED срабатывает и на нём, и всякая сессия, где задача
// заводится ВМЕСТЕ с выполнением, переставала применяться — демо-скрипты, загрузка
// истории, автотест подсчёта (scoring_check, сценарий F). Поймано запуском теста, а не
// глазами: отказ приходил с текстом этого констрейнта там, где ждали совсем другой.
CONSTRAINT SETCHANGED(status(Task t)) AND PREV(status(t))
    AND status(t) = taskStatus('new') AND lastExecution(t)
    MESSAGE 'У задачи уже есть выполнение — прямой перевод в «Новый» запрещён. Нажмите «Вернуть в новые»: действие удалит пустой бланк и снимет взятие';

// Чистка пустых дублей, заведённых повторным «Начать» до этой правки. Правило
// самоограничивающееся, как перекраска приоритетов в StoreTaskInitial: удаляется только
// пустое незавершённое выполнение задачи, у которой есть более раннее, — после первого
// прохода условие перестаёт выполняться. Самое раннее не трогаем никогда: у задачи с одним
// пустым бланком (человек начал и не дозаполнил) удалять нечего.
// task(e) в условии — не для красоты: без него отрицания (NOT finished, NOT filled, NOT
// «это первое») истинны для чего угодно, а класс в DELETE — подпись, а не фильтр.
onStarted () + {
    DELETE Execution e WHERE e IS Execution AND task(e) AND NOT (firstExecution(task(e)) = e)
                             AND NOT finished(e) AND NOT filled(e);
}

EXTEND FORM task
    PROPERTIES(t) beginExecution SHOWIF canBegin(t), returnToNew SHOWIF canReturn(t)
    PROPERTIES(t) READONLY startedAt, startedLatitude, startedLongitude, startedDistance,
                           finishedAt, finishedLatitude, finishedLongitude, finishedDistance

    OBJECTS e = Execution
    PROPERTIES(e) READONLY dateTime, nameExecutor, nameState, nameResult
    FILTERS task(e) = t
    ORDERS dateTime(e)
;

DESIGN task {
    // Кнопки задачи — в тот же ряд, где «Взять»/«Снять» (объявлен в StoreTaskForms);
    // PulseForm потом уводит весь ряд в отдельную строку действий под названием.
    object {
        MOVE PROPERTY(beginExecution(t)) { flex = 0; }
        MOVE PROPERTY(returnToNew(t)) { flex = 0; }
    }
    details {
        NEW executionsTab FIRST {
            caption = 'Выполнения';
            // когда и где работа началась и закончилась — над списком выполнений;
            // подписи в группах укорочены: полные глобальные («Широта (начало)») здесь
            // дублировали бы заголовок группы
            NEW workGeo {
                horizontal = TRUE;
                alignment = STRETCH;
                NEW startedGeo {
                    caption = 'Начало работы';
                    fill = 1;
                    MOVE PROPERTY(startedAt(t)) { caption = 'Когда'; }
                    MOVE PROPERTY(startedLatitude(t)) { caption = 'Широта'; }
                    MOVE PROPERTY(startedLongitude(t)) { caption = 'Долгота'; }
                    MOVE PROPERTY(startedDistance(t)) { caption = 'От объекта, м'; }
                }
                NEW finishedGeo {
                    caption = 'Завершение работы';
                    fill = 1;
                    MOVE PROPERTY(finishedAt(t)) { caption = 'Когда'; }
                    MOVE PROPERTY(finishedLatitude(t)) { caption = 'Широта'; }
                    MOVE PROPERTY(finishedLongitude(t)) { caption = 'Долгота'; }
                    MOVE PROPERTY(finishedDistance(t)) { caption = 'От объекта, м'; }
                }
            }
            MOVE BOX(e) { caption = ''; fill = 1; }
        }
    }
}

EXTEND FORM tasks
    PROPERTIES(t) READONLY nameLastResult, countExecution
;
