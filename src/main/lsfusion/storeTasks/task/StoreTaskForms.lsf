MODULE StoreTaskForms;

// StoreTaskCore — модель задачи; StoreTaskTakeover — takeTask/releaseTask, canTake/canRelease,
// nameTakenBy/takenAt на формах; StoreTaskDocUtils — компоновка списка, контейнер статуса,
// журнал смен статуса; StoreTaskObjectUtils — вкладка истории; StoreTaskFileUtils — файлы
// задачи; StoreTaskCommentUtils — комментарии; StoreTaskSettings — папка operations;
// TaskPerformer — currentPerformer; Authentication — currentUser; CheckObject и StoreTaskType —
// фильтры списка задач по объекту и типу: классы и диалоги выбора checkObjects/taskTypees;
// StoreTaskRights — canCloseForeign, isSystemAdmin; ObjectCategory — категория объекта
// колонкой и фильтром списка (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskTakeover, StoreTaskSettings, TaskPerformer, Authentication,
        StoreTaskDocUtils, StoreTaskObjectUtils, StoreTaskFileUtils, StoreTaskCommentUtils,
        CheckObject, StoreTaskType, StoreTaskRights, StoreTaskColor, ObjectCategory;

NAMESPACE StoreTask;

// Десктопная карточка задачи и список задач: формы task/tasks, их компоновка и всё, что
// живёт на карточке через метакоды meta/ — история изменений, файлы, комментарии, журнал
// смен статуса. Классы вложений рождаются здесь же: TaskFile, TaskComment и
// TaskStatusChange объявляют метакоды, которые тем же вызовом кладут их на форму, так что
// отделить класс от карточки нельзя. Отсюда правило: модуль, которому нужен TaskFile или
// TaskComment (ручки телефона, выполнение, лента) либо который расширяет карточку
// (EXTEND FORM task, DESIGN task { details { … } }), требует StoreTaskForms явно.

assignedLocked = ABSTRACT BOOLEAN (Task);

FORM task 'Задача'
    OBJECTS t = Task PANEL
    PROPERTIES(t) id, name, nameStatus SELECT 'buttonGroup',
                  nameObject, addressObject READONLY,
                  nameAuthor READONLYIF assignedLocked(t), nameAssignedTo READONLYIF assignedLocked(t),
                  nameTakenBy READONLY, takenAt READONLY,
                  nameType, namePriority, tags,
                  start, deadline, progress READONLY,
                  clientId READONLY, unplanned READONLY,
                  description
    // «Начать» и «Вернуть в новые» кладёт на карточку task/Execution.lsf: обе кнопки
    // спрашивают, есть ли у задачи выполнение, а lastExecution объявлен там
    PROPERTIES(t) takeTask SHOWIF canTake(t, currentUser()),
                  releaseTask SHOWIF canRelease(t, currentUser())
    // Проведена (StoreTaskCore.proceed): у закрытой — отработали ли реакции закрытия; у
    // открытой показывать нечего. Кнопку «Провести» кладёт StoreTaskAccess — при ней право
    PROPERTIES(t) READONLY proceeded SHOWIF closed(t)

    EDIT Task OBJECT t
;

DESIGN task {
    OBJECTS {
        NEW pane {
            horizontal = TRUE;
            fill = 1;
            NEW leftPane {
                fill = 1;
                NEW header {
                    alignment = STRETCH;
                    NEW main {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        MOVE PROPERTY(id(t)) { flex = 0; };
                        MOVE PROPERTY(name(t)) { flex = 1; fontSize = 16; }
                    }
                    NEW object {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        MOVE PROPERTY(nameObject(t)) { flex = 1; }
                        MOVE PROPERTY(addressObject(t)) { flex = 1; }
                        MOVE PROPERTY(takeTask(t)) { flex = 0; };
                        MOVE PROPERTY(releaseTask(t)) { flex = 0; };
                        // «Начать» и «Вернуть в новые» встают сюда же из Execution.lsf
                    }
                    NEW params {
                        lines = 2;
                        alignment = STRETCH;
                        MOVE PROPERTY(nameAuthor(t));
                        MOVE PROPERTY(nameAssignedTo(t));
                        MOVE PROPERTY(nameTakenBy(t));
                        MOVE PROPERTY(takenAt(t));
                        MOVE PROPERTY(nameType(t));
                        MOVE PROPERTY(namePriority(t));
                        MOVE PROPERTY(tags(t));
                        NEW progress {
                            horizontal = TRUE;
                            MOVE PROPERTY(start(t));
                            MOVE PROPERTY(deadline(t));
                            MOVE PROPERTY(progress(t));
                        }
                        MOVE PROPERTY(clientId(t));
                        MOVE PROPERTY(unplanned(t));
                        MOVE PROPERTY(proceeded(t));
                    }
                }
                NEW details {
                    tabbed = TRUE;
                    fill = 1;
                    NEW description {
                        caption = 'Описание';
                        MOVE PROPERTY(description(t)) { caption = ''; fill = 1; }
                    }
                }
            }
            NEW rightPane {
                fill = 1;
            }
        }
    }
}

@defineTaskFormStatusContainer(task);
DESIGN task {
    status {
        MOVE PROPERTY(nameStatus(t));
    }
}

// Фильтры списка задач по атрибутам — локальные свойства-параметры: пустое значение
// пропускает все строки, селекторы на форме пишут их через диалоги выбора (INPUT NULL —
// сброс). Селекторы переносит в ленту фильтров над вкладками PulseForm (home); без home
// (core-only-хост) они остаются в дефолтной панели. Шаблонный фильтр — отдельно в FormTask
// (fillable): ссылка template(Task) объявлена там, ядро о бланках не знает.
objectFilter = DATA LOCAL CheckObject ();
nameObjectFilter 'Объект' () = name(objectFilter());
typeFilter = DATA LOCAL TaskType ();
nameTypeFilter 'Тип' () = name(typeFilter());
// «Задача проходит фильтр» — пустое значение пропускает все строки. Условие вынесено в
// свойство, чтобы применить его к обоим объектам Task формы tasks — списку t и доске
// канбана tk (StoreTaskKanban): на 6.2 нет зеркала [FILTER tasks.t], доске фильтры
// нужно передавать явно.
inObjectFilter (Task t) = NOT objectFilter() OR checkObject(t) = objectFilter();
inTypeFilter (Task t) = NOT typeFilter() OR type(t) = typeFilter();

CLASS TaskMyFilter 'Чьи задачи' {
    mine 'Мои задачи',
    assigned 'Назначенные мне',
    free 'Свободные в моей команде'
}

myFilter = DATA LOCAL TaskMyFilter ();
nameMyFilter 'Чьи задачи' () = caption(myFilter());

inMy = ABSTRACT CASE BOOLEAN (TaskMyFilter, Task);
inMy (TaskMyFilter f, Task t) += WHEN f = TaskMyFilter.mine AND t IS Task THEN author(t) = currentPerformer();
inMy (TaskMyFilter f, Task t) += WHEN f = TaskMyFilter.assigned AND t IS Task THEN assignedTo(t, currentUser());
inMy (TaskMyFilter f, Task t) += WHEN f = TaskMyFilter.free AND t IS Task THEN canTake(t, currentUser());

inMyFilter (Task t) = NOT myFilter() OR inMy(myFilter(), t);

selectMine 'Мои задачи' () { myFilter() <- TaskMyFilter.mine; } CHANGEKEY 'F6;showing=all' HIDE;
selectAssigned 'Назначенные мне' () { myFilter() <- TaskMyFilter.assigned; } CHANGEKEY 'F5;showing=all' HIDE;
selectFree 'Свободные в моей команде' () { myFilter() <- TaskMyFilter.free; } CHANGEKEY 'F9;showing=all' HIDE;

performerInactive 'Исполнитель неактивен' (Task t) = opened(t) AND (archived(assignedTo(t)) OR archived(takenBy(t)));

FORM tasks 'Задачи'
    // Приоритет больше не заливает строку целиком: он красил все двенадцать колонок,
    // включая те, где он ни при чём, и оказывался самым громким на экране. Теперь это
    // узкая цветная колонка-полоска слева — см. priorityMark в PulseForm.
    //
    // Статус — плашкой: statusHtml несёт разметку значением, вид задаётся в CSS по
    // классу. Так обходится то, что у ячеек грида нет признака колонки.
    OBJECTS t = Task
    PROPERTIES(t) READONLY priorityMark BACKGROUND rgbColorPriority(t),
                           id, name, statusHtml,
                           nameObject, nameAuthor,
                           nameAssignedTo BACKGROUND rgb(TaskColor.dangerSubtle) IF performerInactive(t),
                           nameTakenBy BACKGROUND rgb(TaskColor.dangerSubtle) IF opened(t) AND archived(takenBy(t)),
                           nameType, namePriority,
                           start, deadline, progress,
                           tags, closed, unplanned
    PROPERTIES(t) NEWSESSION NEW, EDIT, DELETE SHOWIF canCloseForeign()

    PROPERTIES nameObjectFilter() ON CHANGE { DIALOG checkObjects OBJECTS o = objectFilter() INPUT NULL DO { objectFilter() <- o; } }
    PROPERTIES nameTypeFilter() ON CHANGE { DIALOG taskTypees OBJECTS o = typeFilter() INPUT NULL DO { typeFilter() <- o; } }
    PROPERTIES nameMyFilter() SELECT 'dropdown'
    PROPERTIES selectMine(), selectAssigned(), selectFree()

    // Условия — предикатами: тот же предикат применён к объекту доски tk (StoreTaskKanban),
    // фильтры действуют и на доске
    FILTERS inObjectFilter(t)
    FILTERS inTypeFilter(t)
    FILTERS inMyFilter(t)

    LIST Task OBJECT t
;

@defineTaskHistoryForm(task, task, t);

@defineTaskObjectsForm(tasks, t, 'Задачи');

@defineTaskFiles(task, t, 'Файл задачи');

// Ключ клиента у файла задачи (#36914) — тот же приём, что у задачи и сообщения ленты
// (clientId(Task) выше, clientId(TaskComment)): снимки уезжают с телефона по одному
// очередью, и ретрай записи, чей ответ потерялся в дороге, обязан узнаваться сервером,
// а не превращаться во второй такой же кадр на задаче. Пусто у всего, что рождено не
// телефоном: файлы из АРМ и зеркалированные фото выполнения ключа не несут.
clientId 'Ключ клиента' = DATA STRING[36] (TaskFile) INDEXED;
taskFileByClientId = GROUP AGGR TaskFile f BY clientId(f);

prevClosed (Task t) = PREV(closed(t));

CONSTRAINT SET(TaskFile f IS TaskFile) AND NOT file(f) AND prevClosed(task(f)) AND NOT isSystemAdmin()
    MESSAGE 'Добавить файл вставкой строк к закрытой задаче нельзя: у вставленных строк нет содержимого. Переоткройте задачу или добавьте файл с содержимым'
    PROPERTIES id(task(f)), name(f);

@defineTaskComments(task, t, rightPane);
@defineTaskCommentsHistory(task);

@defineTaskCommentsCreate(task, history);

@defineTaskCommentsFiles(task, StoreTask);

@defineTaskCommentsCreate(task, file);

@defineTaskStatusChange(task, 'Задача');
@defineTaskStatusChangeForm(task, t, 'Задача');

// Когда задача закрылась — последний переход в её нынешний закрытый статус по журналу
// смены статусов (метакод выше, поэтому и селектор «Актуальность» объявлен здесь, после него).
closedAt 'Закрыта' (Task t) = dateTimeLastChange(t, status(t)) IF closed(t);
// Закрыта за последнюю неделю: такие задачи ещё «на слуху» — их ищут, по ним переспрашивают
recentlyClosed (Task t) = closed(t) AND toDate(closedAt(t)) > sum(currentDate(), -7);
actual (Task t) = opened(t) OR recentlyClosed(t);

// «Актуальные» по умолчанию, а не «Открытые»: выполненная вчера задача не должна пропадать
// из списка и с доски (колонка «Выполнено» канбана была всегда пустой — доска отбирает
// задачи тем же условием, что список). Старше недели закрытые уходят, их показывает «Закрытые».
CLASS TaskActiveFilter 'Актуальность' {
    actual 'Актуальные',
    opened 'Открытые',
    closed 'Закрытые',
    all 'Все'
}

activeFilter = DATA LOCAL TaskActiveFilter ();
nameActiveFilter 'Актуальность' () = caption(activeFilter());

inActiveFilter (Task t) = CASE
    WHEN activeFilter() = TaskActiveFilter.actual THEN actual(t)
    WHEN activeFilter() = TaskActiveFilter.opened THEN opened(t)
    WHEN activeFilter() = TaskActiveFilter.closed THEN closed(t)
    ELSE t IS Task;

selectActual 'Актуальные' () { activeFilter() <- TaskActiveFilter.actual; } CHANGEKEY 'F10;showing=all' HIDE;
selectOpened 'Открытые' () { activeFilter() <- TaskActiveFilter.opened; } CHANGEKEY 'F8;showing=all' HIDE;
selectClosed 'Закрытые' () { activeFilter() <- TaskActiveFilter.closed; } CHANGEKEY 'F7;showing=all' HIDE;

unplannedFilter 'Внеплановые' = DATA LOCAL BOOLEAN ();
inUnplannedFilter (Task t) = NOT unplannedFilter() OR unplanned(t);

performerInactiveFilter 'Исполнитель неактивен' = DATA LOCAL BOOLEAN ();
inPerformerInactiveFilter (Task t) = NOT performerInactiveFilter() OR performerInactive(t);

EXTEND FORM tasks
    PROPERTIES nameActiveFilter() SELECT 'dropdown'
    PROPERTIES selectActual(), selectOpened(), selectClosed()
    PROPERTIES unplannedFilter(), performerInactiveFilter()

    FILTERS inActiveFilter(t)
    FILTERS inUnplannedFilter(t)
    FILTERS inPerformerInactiveFilter(t)

    EVENTS ON INIT { activeFilter() <- TaskActiveFilter.actual; }
;

DESIGN tasks {
    PROPERTY(tags(t)) { valueHeight = 18; }
    PROPERTY(selectMine()) { hide = TRUE; }
    PROPERTY(selectAssigned()) { hide = TRUE; }
    PROPERTY(selectFree()) { hide = TRUE; }
    PROPERTY(selectActual()) { hide = TRUE; }
    PROPERTY(selectOpened()) { hide = TRUE; }
    PROPERTY(selectClosed()) { hide = TRUE; }
}

// expose category on the tasks list — this is the hook reports will grow onto:
// filtering results by category is one of the "готово когда" bullets, and the
// primary place the operations user does it is the tasks grid.
categoryObject 'Категория' (Task t) = nameCategory(checkObject(t));

objectCategoryFilter 'Категория задана' = DATA LOCAL BOOLEAN ();
inObjectCategoryFilter (Task t) = NOT objectCategoryFilter() OR category(checkObject(t));

toggleObjectCategoryFilter 'Категория задана' () { objectCategoryFilter() <- NOT objectCategoryFilter(); } CHANGEKEY 'F4;showing=all' HIDE;

EXTEND FORM tasks
    PROPERTIES(t) READONLY categoryObject
    PROPERTIES objectCategoryFilter(), toggleObjectCategoryFilter()

    FILTERS inObjectCategoryFilter(t)
;

DESIGN tasks {
    PROPERTY(toggleObjectCategoryFilter()) { hide = TRUE; }
}

NAVIGATOR {
    operations {
        NEW tasks;
    }
}
