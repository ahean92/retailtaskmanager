MODULE DeadlineNormative;

// StoreTaskCore — Task, deadline/type/priority; StoreTaskType/StoreTaskPriority — каталоги,
// по которым строена матрица; Time — currentDate; SystemEvents — onStarted, которым
// существующие задачи без срока получают норматив (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskType, StoreTaskPriority, Time, SystemEvents;

NAMESPACE StoreTask;

// ===== Норматив срока (#37160): «Срок выполнения, дней» по типу задачи и приоритету =====
// Задача без срока для всей логики сроков невидима: «срок завтра» и «просрочено» считаются
// от deadline, и задача, заведённая в бэк-офисе или через API без срока, никогда не станет
// просроченной — ни исполнитель, ни руководитель о ней не услышит. Норматив закрывает только
// такие задачи: явный срок, пресет (QuickAction.deadlineDays), правило графика
// (SchedulePlan.taskDeadline) и срок корректирующих из шаблона (Corrective.deadlineDays) он
// не перебивает — подставляется, когда срока иначе не было бы вовсе.
//
// Матрица (тип × приоритет), пустая клетка — без норматива: матрица настраивается под
// процессы заказчика, и «срок для всех» по умолчанию наврал бы чаще, чем помог. Отдельная
// клетка «без приоритета» на типе — для задач, которым приоритет не ставят: у корректирующих
// его нет, а норматив им нужен (дополнение к #37160 от 24.09: срок подставляется, когда у
// шаблона пуст «Срок устранения» — иначе такая задача не попадает ни в «Просрочено», ни в
// «срок завтра»).

// То же базовое имя, что у сроков пресета/правила/шаблона: одно понятие — «срок, дней»,
// разные подписи. Задача с приоритетом читает свою клетку и в «без приоритета» не
// заглядывает: пустая клетка у приоритета — осознанная настройка, а не пропуск.
deadlineDays 'Срок выполнения, дней' = DATA INTEGER (TaskType, TaskPriority);
deadlineDays 'Срок без приоритета, дней' = DATA INTEGER (TaskType);

CONSTRAINT deadlineDays(TaskType tt, TaskPriority p) AND deadlineDays(tt, p) <= 0
    MESSAGE 'Норматив срока должен быть больше нуля';

CONSTRAINT deadlineDays(TaskType tt) AND deadlineDays(tt) <= 0
    MESSAGE 'Норматив срока должен быть больше нуля';

normativeDays 'Норматив, дней' (Task t) = CASE
    WHEN priority(t) THEN deadlineDays(type(t), priority(t))
    ELSE deadlineDays(type(t));

// Подстановка при создании — той же формой вычисляемого присваивания, что start выше в
// StoreTaskCore: событие срабатывает на применении, когда тип и приоритет уже записаны.
// Явный срок той же сессии не трогает: вычисляемое присваивание — умолчание, явное
// изменение сильнее (тот же контракт, на который опирается start в apiCreateTask). Гварда
// на сам deadline здесь быть не должно — условие события, читающее присваиваемое свойство,
// делает его рекурсивным. Корректирующая сюда не доходит — она рождается внутри
// глобального события (onProceed), и событие создания её не проходит; ей норматив ставит
// createCorrective явно (см. Corrective).
//
// От currentDate(), а не от start(t): порядок двух событий применения платформа не
// обещает, и сумма с ещё пустым start оставила бы задачу без срока. Созданная задним
// числом задача получает норматив от сегодня — щедрее, чем от даты начала, но редко и
// не страшно.
deadline(Task t) <- sum(currentDate(), normativeDays(t))
    WHEN SET(t IS Task) AND normativeDays(t);

// Существующие открытые задачи без срока — одним проходом на старте, самоограничивающимся,
// как proceeded в StoreTaskCore: после него без срока остаются только задачи без
// норматива, и повторные старты ничего не меняют (новые сроки получают разве что задачи,
// чей норматив завели в матрице после выката). Закрытые не трогаются: показатель
// «выполнено в срок» (#37160) судит закрытые по сроку, и задним числом поставленный срок
// переврал бы его.
onStarted () + {
    deadline(Task t) <- sum(currentDate(), normativeDays(t))
        WHERE t IS Task AND opened(t) AND NOT deadline(t) AND normativeDays(t);
}

// --- матрица в карточке типа: тот же приём, что матрица статусов (StoreTaskType) ---
EXTEND FORM taskType
    PROPERTIES(o) deadlineDays

    OBJECTS np = TaskPriority
    PROPERTIES(np) READONLY name
    PROPERTIES deadlineDays(o, np)
    ORDERS name(np)
;

DESIGN taskType {
    BOX(np) {
        caption = 'Норматив срока';
        // клетка «без приоритета» — рядом с матрицей, а не на основной панели:
        // это четвёртая сторона той же настройки
        MOVE PROPERTY(deadlineDays(o));
    }
}
