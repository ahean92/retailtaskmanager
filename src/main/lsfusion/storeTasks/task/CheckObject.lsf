MODULE CheckObject;

REQUIRE StoreTaskSettings;

NAMESPACE StoreTask;

// Abstract target of a task/inspection. A store (Location) is one implementation;
// equipment, an employee, a land plot could be others. Kept abstract on purpose so
// the task framework never depends on a concrete object type.
CLASS ABSTRACT CheckObject 'Объект проверки';

name '{Name}' = ABSTRACT ISTRING[150] (CheckObject) CHARWIDTH 20;

// --- вложенность: объект внутри объекта ---
// Сканер на кассе, касса в магазине, оборудование на складе. Глубина любая, отдельного
// уровня «касса» нет — обычная иерархия. Абстракт, потому что структуру знает хост:
// ERP отдаёт «железка стоит в магазине» (erp/CheckAssetLocation), самостоятельному
// хосту дерево заводят руками (StoreTaskStandalone.parentObject).
//
// Реализация на класс ровно одна — MULTI EXCLUSIVE по умолчанию, и это к лучшему: у
// дерева обязан быть единственный источник, иначе «почему у этого сканера такой
// родитель» превращается в вопрос про порядок модулей.
parent = ABSTRACT CheckObject (CheckObject);
nameParent 'Внутри объекта' (CheckObject o) = name(parent(o));

// Уровень предка — канонический паттерн иерархии платформы (MasterData.Category).
// Материализуется: читается на каждом открытии каталога и в фильтре «объект и всё, что
// внутри него» (FILTERS level(checkObject(t), o)), а меняется только при правке дерева —
// ровно тот профиль, для которого материализация и рекомендована.
// CYCLES по умолчанию NO, то есть констрейнт на цикл платформа ставит сама; своего
// писать не надо.
level 'Уровень' (CheckObject child, CheckObject parent) =
    RECURSION 1l IF child IS CheckObject AND parent = child
         STEP 2l IF parent = parent($parent) MATERIALIZED;

// «Магазин №4 / Касса №4 / Сканер». Для плоского каталога совпадает с названием — у
// объекта без родителя предок ровно один, он сам, — поэтому её можно ставить туда, где
// раньше стояло name, ничего не меняя визуально на сегодняшних данных.
canonicalName 'Объект' (CheckObject o) =
    GROUP CONCAT name(CheckObject p), ' / ' ORDER DESC level(o, p) CHARWIDTH 30;

// --- собственные адрес и координаты: то, что объект ХРАНИТ ---
// Заводятся только у расположения — магазин, склад, РЦ, теплица. У того, что внутри,
// координат нет и быть не должно: «где это» — вопрос к расположению, а не к сканеру.
// Тот же шов, что у name: откуда они берутся, решает хост. Констрейнта на пустоту
// намеренно нет — у хостов есть объекты без координат; дыры показывает форма
// checkObjects фильтром «Без координат».
ownAddress 'Адрес' = ABSTRACT ISTRING[250] (CheckObject) CHARWIDTH 30;
ownLatitude 'Широта' = ABSTRACT DOUBLE (CheckObject);
ownLongitude 'Долгота' = ABSTRACT DOUBLE (CheckObject);

// Расположение — ближайший предок с собственными координатами (сам объект, если они
// есть у него). Именно «ближайший с координатами», а не «корень дерева»: если однажды
// магазины подвесят под регион или юрлицо, вариант с корнем молча обнулил бы координаты
// у всех магазинов разом. Второй рекурсии для этого не нужно — всё достаётся из уже
// материализованного level одним GROUP LAST: LAST убывающего порядка — это минимальный
// уровень, то есть ближайший предок.
site 'Расположение' (CheckObject o) = GROUP LAST CheckObject p
    ORDER DESC level(o, p)
    WHERE level(o, p) AND ownLatitude(p) AND ownLongitude(p) MATERIALIZED;

// Объект, на котором человек может стоять. Дешёвая форма того же признака: расположение
// — это объект с собственными координатами.
isSite (CheckObject o) = TRUE IF ownLatitude(o) AND ownLongitude(o);

// --- адрес и координаты: то, что объект ПОКАЗЫВАЕТ ---
// Имена и сигнатуры прежние, поэтому полтора десятка мест, которые их читают (apiTasks,
// distance, журнал координат, формы, отчёты), не трогаются и начинают работать по дереву
// сами. Хранение — только наверху, чтение — по всей ветке: у задачи на сканере обязано
// быть расстояние, иначе телефон не поймёт, что она «здесь», и не отсортирует список.
latitude 'Широта' (CheckObject o) = ownLatitude(site(o));
longitude 'Долгота' (CheckObject o) = ownLongitude(site(o));
address 'Адрес' (CheckObject o) = OVERRIDE ownAddress(o), ownAddress(site(o));

// Stable business key, in the same shape as TaskPerformer.id: the host owns it, and
// anything outside the database addresses an object by it — the mobile client's store
// selector, an ERP pushing a metric for one shop. An internal object number would tie
// those callers to this database's row ids.
id '{ID}' = ABSTRACT ISTRING[30] (CheckObject) CHARWIDTH 10;
checkObject (ISTRING[30] c) = GROUP MAX CheckObject o IF id(o) = c;

// --- "which objects are near this point" ---
// Great-circle distance in metres, computed by PostgreSQL: answering the question at
// all means measuring every object against one point, and a formula keeps that inside
// the same SELECT that reads them instead of pulling the whole catalogue into lsf.
// Metres, so the radius below reads the way a person states it. least() guards asin's
// domain against float rounding on the (irrelevant here, but free) antipodal case.
//
// The outer IS NULL test is load-bearing, not defensive noise. least() in PostgreSQL
// does not propagate NULL — it *skips* it, so least(1::float8, NULL) is 1, and a call
// with a missing coordinate returned asin(1): 20 015 km, half the planet, instead of
// nothing. Worse, a FORMULA without a trailing NULL keyword promises the platform that
// a NULL argument yields NULL without the formula running; the optimizer trusts that
// promise and folds away any `IF` guard written around the call, so this cannot be
// fixed at the call site — only here, where the promise is actually kept.
distance (DOUBLE latA, DOUBLE lonA, DOUBLE latB, DOUBLE lonB) = FORMULA DOUBLE
    'CASE WHEN ($1) IS NULL OR ($2) IS NULL OR ($3) IS NULL OR ($4) IS NULL THEN NULL ELSE 12742017.6 * asin(sqrt(least(1::float8, power(sin(radians(($3) - ($1)) / 2), 2) + cos(radians(($1))) * cos(radians(($3))) * power(sin(radians(($4) - ($2)) / 2), 2)))) END';

distance 'Расстояние, м' (CheckObject o, DOUBLE lat, DOUBLE lon) = distance(latitude(o), longitude(o), lat, lon);

// How far from an object a performer may be and still count as "at" it. A mall with
// its parking fits in 500 m; a warehouse district needs more, a dense high street
// less — so it is a setting, with the default inlined at its only use.
nearbyRadius 'Радиус «рядом», м' = DATA INTEGER ();

// Zero is not a setting, it is a misconfiguration, and it has to be caught here because
// nothing downstream can: a radius of nought demands that the phone stand at the object's
// exact floating-point coordinate — eleven centimetres away is already too far — so every
// performer is at no object, every task list is empty, and no screen anywhere can explain
// why. Seen on a live customer stand. Zero therefore means what an empty field means.
nearbyRadiusOrDefault () = OVERRIDE (nearbyRadius() IF nearbyRadius() > 0), 500;

// Distance, but only while the object is within the radius — one property to filter
// and sort by, so "nearby" means the same thing in every query that asks.
nearbyDistance (CheckObject o, DOUBLE lat, DOUBLE lon) =
    distance(o, lat, lon) IF distance(o, lat, lon) <= nearbyRadiusOrDefault();

// "the object with the smallest distance" — LAST of a descending order, the same
// idiom as fillingTask in api/FillApi. Ties break on the object itself so a performer
// standing between two shops gets a stable answer rather than a shuffling one.
//
// Только адресуемые объекты, и это не мелочь: «где я стою» существует ради того,
// чтобы отсюда получить objectId и вернуть его в apiTasks. Объект с координатами, но
// без бизнес-ключа («Склад (демо)» на стенде) оказывался ближайшим, становился
// выбранным — и не совпадал ни с одной задачей: человек стоял на объекте, а весь его
// список был только для чтения (поймано приёмкой #36837).
//
// isSite(o) — гвард ровно того же рода. Вложенный объект показывает координаты своего
// расположения, поэтому без него холодильник конкурировал бы с магазином на равных:
// расстояние одинаковое, порядок ломается по o, то есть произвольно, — и телефон мог
// бы выбрать «своим объектом» холодильник, получив пустой список задач. Стоять человек
// может только в расположении.
nearestObject (DOUBLE lat, DOUBLE lon) =
    GROUP LAST CheckObject o ORDER DESC nearbyDistance(o, lat, lon), o WHERE nearbyDistance(o, lat, lon) AND id(o) AND isSite(o);

// The same, with the radius taken off. It exists for one sentence on the phone: "рядом
// нет объектов с координатами" and "вы в 12 км от ближайшего" are different news and
// call for different things from the person, and nothing inside the radius can tell them
// apart — the answer is the same empty list either way. Inside the radius this coincides
// with nearestObject: the nearest of all is the nearest of those that are near.
nearestObjectAnywhere (DOUBLE lat, DOUBLE lon) =
    GROUP LAST CheckObject o ORDER DESC distance(o, lat, lon), o WHERE distance(o, lat, lon) AND id(o) AND isSite(o);

// The object a performer is working at: the one they picked, or the nearest when they
// did not pick. The pick has to exist, because the nearest is not always the right
// answer — two shops in one mall sit at the same coordinates and no ordering can tell
// them apart, so the performer chooses out of the list and only they can.
// A picked object still has to be inside the radius: otherwise passing an id would walk
// straight past the geo gate and pull another town's tasks.
chosenObject (ISTRING[30] id, DOUBLE lat, DOUBLE lon) = OVERRIDE
    (checkObject(id) IF nearbyDistance(checkObject(id), lat, lon)),
    nearestObject(lat, lon);

EXTEND FORM options
    PROPERTIES() nearbyRadius
;

DESIGN options {
    commons {
        MOVE PROPERTY(nearbyRadius());
    }
}

// An object without coordinates is invisible to "nearby" queries in the mobile client,
// so the administrator needs to see the holes before a performer does.
//
// Вложенность показана колонкой пути (canonicalName), а НЕ группой TREE — по той же
// причине, по которой ниже нет карты: вторая группа объектов над CheckObject не несёт
// фильтров, которые хост вешает на `o`, и дерево показало бы объекты всех арендаторов.
// Дереву нужен тот же шов видимости, что и карте.
FORM checkObjects 'Объекты проверки'
    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, canonicalName, nameParent, address, latitude, longitude

    // «Без координат» означает то же, что и раньше — «невидим для поиска рядом», — но
    // теперь по дереву: у вложенного объекта своих координат нет по построению, а вот
    // отсутствие расположения у всей ветки как раз и есть дыра.
    FILTERGROUP coordinates
        FILTER 'Без координат' NOT site(o) 'F9'

    // Deliberately no MAP group object next to the grid, tempting as it is (the view
    // type costs one keyword and leaflet is already on the page). A second group object
    // over CheckObject carries none of the filters a host puts on `o` — StoreTaskMite
    // restricts this form to the caller's organization — so the map would show every
    // tenant's objects. It needs a visibility seam in the subsystem first.

    LIST CheckObject OBJECT o
;

// Not in the NAVIGATOR on purpose: fillable/CheckAsset already puts `checkAssets` into
// Справочники under the very same caption, and two identical entries is what a host
// administrator would actually see. This form is the cross-implementation view (every
// CheckObject, whatever class implements it, read-only, with the "no coordinates" gap
// filter); checkAssets is one implementation's editable catalogue. Whoever wants both
// visible has to give them distinguishable captions first.
