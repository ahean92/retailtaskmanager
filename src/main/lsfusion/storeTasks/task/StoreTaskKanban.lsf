MODULE StoreTaskKanban;

// Authentication — currentUser; StoreTaskForms — формы task/tasks (доска — вкладка списка,
// карточка открывается с доски); TaskPerformer — inAll (автор с учётом подразделений);
// StoreTaskAcceptance — приёмка на доске: canDecide/mayDecide и диалог возврата askReturn;
// StoreTaskRights — isSystemAdmin, canCloseForeign; StoreTaskAccess — closeAllowed, taskVisible
// (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskForms, StoreTaskStatus, StoreTaskType, StoreTaskTag, StoreTaskPriority, SystemEvents, Authentication,
        TaskPerformer, StoreTaskAcceptance, StoreTaskAccess, StoreTaskRights;

NAMESPACE StoreTask;

kanbanI18n () = JSON FROM edit = 'Изменить', delete = 'Удалить', inactive = 'Исполнитель неактивен';

onWebClientInit() + {
    onWebClientInit('storeTasks/dragula.js') <- 1;
    onWebClientInit('storeTasks/dragula.css') <- 1;
    onWebClientInit('storeTasks/kanban.js') <- 2;
    onWebClientInit('storeTasks/kanban.css') <- 2;
    onWebClientInit('storeTasks/storetaskkanban.js') <- 3;
}

// Закрытые статусы — тоже колонки (closed): при «Актуальных» в них закрытые за неделю (recentlyClosed).
// Закрывают задачу из её карточки — выполнением или выбором статуса там. С доски закрыть может
// только автор задачи (решено 24.09, #36733): он ставил работу, ему и решать, что она сделана,
// одним движением. Остальным закрытые колонки только для чтения. Вытащить карточку из
// закрытой колонки доска не даёт (nextStatuses, держит JS); сервер этот перенос отдельно не
// запрещает — его судят те же правила переходов (StoreTaskWorkflow), что и выбор статуса в
// карточке.
kanbanStatuses () = JSON FROM id = TaskStatus s, name(s), closed = closed(s) WHERE s IS TaskStatus ORDER sortingOrder(s), s;

// Администратор правилами статусов не ограничен (StoreTaskWorkflow) — и здесь тоже.
// Задачу «На приёмке» закрывает с доски и принимающий (#37157): перенос в «Выполнено» — это
// «Принять», а принимающий по роли на объекте — не обязательно автор.
closeOnBoard (Task t) = isSystemAdmin() OR (inAll(author(t), currentUser()) AND closeAllowed(t)) OR canDecide(t, currentUser());
deleteOnBoard (Task t) = t IS Task AND canCloseForeign();
dropOnBoard = ABSTRACT BOOLEAN (Task, TaskStatus);

jsonTags (Task t) = JSON FROM name(TaskTag tg), idColor(tg) WHERE in(t, tg) ORDER name(tg), tg;

order = DATA LONG (User, Task);
currentOrder (Task t) = order(currentUser(), t);

EXTEND FORM tasks
    OBJECTS tk = Task CUSTOM 'storeTaskKanban'
    OPTIONS JSON FROM statuses = kanbanStatuses(), i18n = kanbanI18n()
    PAGESIZE 2000
    PROPERTIES(tk) name = idName,
        nameObject,
        nameAuthor,
        nameAssignedTo,
        performerInactive,
        nameStatus,
        // Перенос карточки — это смена status с доски. Правило «закрыть с доски может только
        // автор» доска держит ещё при перетаскивании (closeOnBoard → canClose в JS), а сервер —
        // здесь, на случай, если JS его не удержал: перенос в закрытую колонку не от автора —
        // отказ, статус не меняется.
        //
        // Приёмка (#37157): перенос из «На приёмке» в открытую колонку — это «Вернуть», с тем же
        // диалогом причины, что у кнопки карточки (иначе доска — обход приёмки); в «Выполнено» —
        // «Принять» (шаг журнала пишет событие смены статуса в StoreTaskAcceptance); не вправе
        // решать — отказ здесь, до записи, со своим сообщением вместо текста констрейнта.
        // Допустимые колонки доска гасит ещё при перетаскивании (nextStatuses), это — на случай,
        // если JS не удержал.
        status ON CHANGE {
            INPUT id = LONG DO {
                LOCAL target = BOOLEAN (TaskStatus);
                target(TaskStatus st) <- TRUE WHERE LONG(st) = id;
                FOR target(TaskStatus s) DO {
                    IF status(tk) = s THEN
                        formRefresh();
                    ELSE IF onAcceptance(tk) AND NOT closed(s) THEN {
                        IF canDecide(tk, currentUser()) THEN askReturn(tk);
                        ELSE MESSAGE 'Вернуть задачу с приёмки может принимающий или роль с правом «Закрывать чужую задачу»';
                    } ELSE IF onAcceptance(tk) AND closed(s) AND NOT s = canceledStatus() AND NOT canDecide(tk, currentUser()) THEN
                        MESSAGE 'Принять задачу может принимающий или роль с правом «Закрывать чужую задачу»';
                    ELSE IF closed(s) AND NOT closeOnBoard(tk) THEN
                        MESSAGE 'Закрыть задачу с доски может только её автор. Откройте задачу и закройте её в карточке.';
                    ELSE IF NOT dropOnBoard(tk, s) THEN
                        MESSAGE (CONCAT '', 'Перевести задачу из «', nameStatus(tk), '» в «', name(s),
                            '» нельзя: переход вам не разрешён или задача изменилась, пока была открыта доска');
                    ELSE NEWSESSION {
                        status(tk) <- s;
                        APPLY;
                    }
                    IF NOT status(tk) = s THEN
                        formRefresh();
                } ELSE
                    formRefresh();
            }
        },
        closeOnBoard,
        deleteOnBoard,
        nameType,
        idColorPriority, namePriority,
        tags = jsonTags,
        start,
        deadline,
        description,
        currentOrder ON CHANGE {
            INPUT ord = INTEGER DO NEWSESSION {
                order(currentUser(), tk) <- ord;
                APPLY;
            }
        }
    ORDERS status(tk), currentOrder(tk)
    // v6: на 7.0 доска наследовала фильтры списка зеркалом [FILTER tasks.t](tk); выражения
    // [FILTER form.obj]/[VIEW form.obj] появились только в 7.0, поэтому условия селекторов
    // применены к tk явно (шаблонный фильтр — своим EXTEND'ом в FormTask, «Не на объекте» —
    // в Execution, «Источник» — в ScheduleForms, «Категория задана» — в StoreTaskForms,
    // переход с плитки — в HomeDashboard). Групп фильтров на форме нет: их выбор
    // живёт в клиенте, и доске его не передать — вместо них локальные селекторы.
    FILTERS inObjectFilter(tk)
    FILTERS inTypeFilter(tk)
    FILTERS inMyFilter(tk)
    FILTERS inActiveFilter(tk)
    FILTERS inUnplannedFilter(tk)
    FILTERS inPerformerInactiveFilter(tk)
    FILTERS inObjectCategoryFilter(tk)
    FILTERS taskVisible(tk)

    PROPERTIES(tk) GRID edit = openTask, delete = DELETE NEWSESSION

    // Кнопки «+» в колонке нет: клиент 6.2 не умеет вызывать действия формы из компонента
    // (только менять свойства). Задачу создают кнопкой «Добавить» списка, она рождается «Новой».
;

// v6: плашки «Показано X из Y» нет: счёт по видимым строкам доски требует
// [VIEW tasks.tk]/[FILTER tasks.tk] (7.0), на 6.2 замены нет.

kanbanRefresh 'Обновить' () {
    formRefresh();
} IMAGE 'refresh.png';

EXTEND FORM tasks
    PROPERTIES() kanbanRefresh
;

DESIGN tasks {
    OBJECTS {
        NEW content {
            horizontal = TRUE;
            fill = 1;
            alignment = STRETCH;
            NEW boards {
                tabbed = TRUE;
                fill = 1;
                MOVE BOX(t) { caption = 'Список'; }
                NEW kanbanTab {
                    caption = 'Канбан';
                    NEW kanbanHeader {
                        horizontal = TRUE;
                        alignment = STRETCH;
                        childrenAlignment = END;
                        MOVE PROPERTY(kanbanRefresh());
                    }
                    MOVE GRID(tk) { fill = 1; }
                }
            }
            NEW filterPanel {
                caption = 'Фильтры';
                width = 260;
                fill = 1;
                MOVE PROPERTY(nameMyFilter());
                MOVE PROPERTY(nameActiveFilter());
                MOVE PROPERTY(unplannedFilter());
                MOVE PROPERTY(performerInactiveFilter());
                MOVE PROPERTY(objectCategoryFilter());
                MOVE FILTERCONTROLS(t);
            }
        }
        REMOVE BOX(tk);
    }
}
