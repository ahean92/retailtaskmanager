MODULE StoreTaskKanban;

// Authentication — currentUser; StoreTaskForms — формы task/tasks (доска — вкладка списка,
// карточка открывается с доски); TaskPerformer — inAll (автор с учётом подразделений)
// (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskForms, StoreTaskStatus, StoreTaskType, StoreTaskTag, StoreTaskPriority, SystemEvents, Authentication,
        TaskPerformer;

NAMESPACE StoreTask;

kanbanI18n () = JSON FROM edit = 'Изменить', delete = 'Удалить', unassigned = 'Не назначено';

onWebClientInit() + {
    onWebClientInit('storeTasks/dragula.js') <- 1;
    onWebClientInit('storeTasks/dragula.css') <- 1;
    onWebClientInit('storeTasks/kanban.js') <- 2;
    onWebClientInit('storeTasks/kanban.css') <- 2;
    onWebClientInit('storeTasks/storetaskkanban.js') <- 3;
}

// Закрытые статусы — тоже колонки (closed): в них задачи, закрытые за неделю (recentlyClosed).
// Закрывают задачу из её карточки — выполнением или выбором статуса там. С доски закрыть может
// только автор задачи (решено 24.09, #36733): он ставил работу, ему и решать, что она сделана,
// одним движением. Остальным закрытые колонки только для чтения; вытащить карточку из
// закрытой колонки не может никто — переоткрытие тоже из карточки.
kanbanStatuses () = JSON FROM id = TaskStatus s, name(s), closed = closed(s) WHERE s IS TaskStatus ORDER sortingOrder(s), s;

// Администратор правилами статусов не ограничен (StoreTaskWorkflow) — и здесь тоже
closeOnBoard (Task t) = isSystemAdmin() OR inAll(author(t), currentUser());

jsonTags (Task t) = JSON FROM name(TaskTag tg), idColor(tg) WHERE in(t, tg) ORDER name(tg), tg;

order = DATA LONG (User, Task);
currentOrder (Task t) = order(currentUser(), t);

createTaskStatus (TaskStatus s) {
    NEWSESSION {
        NEW t = Task {
            status(t) <- s;
            order(currentUser(), t) <- -LONG(t);
            onCreate(t);
            SHOW task OBJECTS t = t DOCKED;
        }
    }
}

EXTEND FORM tasks
    OBJECTS tk = Task CUSTOM 'storeTaskKanban'
    OPTIONS JSON FROM statuses = kanbanStatuses(), i18n = kanbanI18n()
    PROPERTIES(tk) name = idName,
        nameObject,
        nameAuthor,
        nameAssignedTo,
        nameStatus,
        // Перенос карточки — это смена status с доски. Правило «закрыть с доски может только
        // автор» доска держит ещё при перетаскивании (closeOnBoard → canClose в JS), а сервер —
        // здесь, на случай, если JS его не удержал: перенос в закрытую колонку не от автора —
        // отказ, статус не меняется. Остальное (тип задачи, матрица переходов) судят
        // констрейнты при APPLY, как и при смене статуса в карточке.
        status ON CHANGE {
            INPUT s = TaskStatus DO {
                IF closed(s) AND NOT closeOnBoard(tk) THEN
                    MESSAGE 'Закрыть задачу с доски может только её автор. Откройте задачу и закройте её в карточке.';
                ELSE {
                    status(tk) <- s;
                    APPLY;
                }
            }
        },
        closeOnBoard,
nameType,
idColorPriority, namePriority,
tags = jsonTags,
start,
deadline,
description,
currentOrder ON CHANGE {
INPUT ord = INTEGER DO {
order(currentUser(), tk) <- ord;
APPLY;
}
}
ORDERS status(tk), currentOrder(tk)
FILTERS actual(tk)
FILTERS [FILTER tasks.t](tk)

PROPERTIES(tk) GRID edit = EDIT NEWSESSION, delete = DELETE

CUSTOMS createTaskStatus[TaskStatus]
;

DESIGN tasks {
    OBJECTS {
        NEW content {
            horizontal = TRUE;
            fill = 1;
            alignment = STRETCH;
            NEW boards {
                tabbed = TRUE;
                fill = 1;
                MOVE BOX(t) { caption = 'Список'; }
                NEW kanbanTab {
                    caption = 'Канбан';
                    MOVE GRID(tk) { fill = 1; }
                }
            }
            NEW filterPanel {
                caption = 'Фильтры';
                width = 260;
                fill = 1;
                MOVE FILTERGROUPS(t);
                MOVE FILTERCONTROLS(t);
            }
        }
        REMOVE BOX(tk);
    }
}
