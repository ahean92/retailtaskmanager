MODULE StoreTaskRights;

REQUIRE Security, Authentication;

NAMESPACE StoreTask;

systemAdminRole () = GROUP MAX UserRole r IF sid(r) = r'admin';
isSystemAdmin () = has(currentUser(), systemAdminRole());
isSystemAdmin (User u) = has(u, systemAdminRole());

@addRoleApplicationSetting(seeAllTasks, 'Видеть все задачи', BOOLEAN);
@addRoleApplicationSetting(assignExecutor, 'Назначать исполнителя', BOOLEAN);
@addRoleApplicationSetting(closeForeignTask, 'Закрывать чужую задачу', BOOLEAN);
@addRoleApplicationSetting(editTemplates, 'Править шаблоны и справочники', BOOLEAN);
@addRoleApplicationSetting(editSettings, 'Править настройки', BOOLEAN);
@addRoleApplicationSetting(seeCoordinates, 'Видеть журнал координат', BOOLEAN);
@addRoleApplicationSetting(createTaskBatch, 'Массовое создание задач', BOOLEAN);
@addRoleApplicationSetting(allowMetricImport, 'Разрешить импорт показателей извне (apiSetMetric)', BOOLEAN);

canSeeAllTasks () = isSystemAdmin() OR (GROUP SUM 1 IF seeAllTasks(UserRole r) AND has(currentUser(), r));
canAssign () = isSystemAdmin() OR (GROUP SUM 1 IF assignExecutor(UserRole r) AND has(currentUser(), r));
canCloseForeign (User u) = isSystemAdmin(u) OR (GROUP SUM 1 IF closeForeignTask(UserRole r) AND has(u, r));
canCloseForeign () = canCloseForeign(currentUser());
canEditCatalogs () = isSystemAdmin() OR (GROUP SUM 1 IF editTemplates(UserRole r) AND has(currentUser(), r));
canEditOptions () = isSystemAdmin() OR (GROUP SUM 1 IF editSettings(UserRole r) AND has(currentUser(), r));
canSeeCoordinates () = isSystemAdmin() OR (GROUP SUM 1 IF seeCoordinates(UserRole r) AND has(currentUser(), r));
canCreateBatch () = isSystemAdmin() OR (GROUP SUM 1 IF createTaskBatch(UserRole r) AND has(currentUser(), r));
allowMetricImport () = GROUP SUM 1 IF allowMetricImport(UserRole r) AND has(currentUser(), r);

byPerson () = currentUser() IS CustomUser;

systemFlow = DATA LOCAL BOOLEAN ();

catalogsLocked () = byPerson() AND NOT canEditCatalogs() AND NOT systemFlow();
optionsLocked () = byPerson() AND NOT canEditOptions();
