MODULE StoreTaskInitial;

// StoreTaskStatus — taskStatus/sortingOrder; StoreTaskPriority — taskPriority/color;
// StoreTaskColor — TaskColor.* (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskStatus, StoreTaskPriority, StoreTaskColor;

NAMESPACE StoreTask;

// Идемпотентно, как и соседние сиды (ChecklistTask, Issue): повторные «Стандартные данные»
// на живой базе не должны плодить второй набор статусов и приоритетов.
loadDefaultData () + {
    IF NOT taskStatus('new') THEN NEW s = TaskStatus { name(s) <- 'Новый'; id(s) <- r'new'; sortingOrder(s) <- 1; }
    IF NOT taskStatus('in progress') THEN NEW s = TaskStatus { name(s) <- 'В работе'; id(s) <- r'in progress'; sortingOrder(s) <- 2; }
    IF NOT taskStatus('done') THEN NEW s = TaskStatus { name(s) <- 'Выполнено'; id(s) <- r'done'; sortingOrder(s) <- 3; closed(s) <- TRUE; }
    IF NOT taskStatus('canceled') THEN NEW s = TaskStatus { name(s) <- 'Отменено'; id(s) <- r'canceled'; sortingOrder(s) <- 4; closed(s) <- TRUE; }

    IF NOT taskPriority('low') THEN NEW p = TaskPriority {
        name(p) <- 'Низкий';
        id(p) <- r'low';
        color(p) <- TaskColor.secondarySubtle;
    }
    IF NOT taskPriority('normal') THEN NEW p = TaskPriority {
        name(p) <- 'Обычный';
        id(p) <- r'normal';
    }
    IF NOT taskPriority('high') THEN NEW p = TaskPriority {
        name(p) <- 'Высокий';
        id(p) <- r'high';
        color(p) <- TaskColor.warningSubtle;
    }
    IF NOT taskPriority('urgent') THEN NEW p = TaskPriority {
        name(p) <- 'Срочный';
        id(p) <- r'urgent';
        color(p) <- TaskColor.dangerSubtle;
    }
}
