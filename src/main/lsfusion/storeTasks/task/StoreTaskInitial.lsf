MODULE StoreTaskInitial;

// StoreTaskStatus — taskStatus/sortingOrder; StoreTaskPriority — taskPriority/color;
// StoreTaskColor — TaskColor.*; StoreTaskSettings — seedRequiredData (транзитивному REQUIRE не
// доверять)
REQUIRE StoreTaskCore, StoreTaskStatus, StoreTaskPriority, StoreTaskColor, StoreTaskSettings;

NAMESPACE StoreTask;

// Идемпотентно, как и соседние сиды (ChecklistTask, Issue): сид идёт на каждом старте
// сервера, а не только по «Стандартным данным», и ни старт, ни повторная кнопка на живой
// базе не должны плодить второй набор статусов и приоритетов.
seedRequiredData () + {
    IF NOT newStatus() THEN NEW s = TaskStatus { name(s) <- 'Новый'; id(s) <- r'new'; sortingOrder(s) <- 1; }
    IF NOT inProgressStatus() THEN NEW s = TaskStatus { name(s) <- 'В работе'; id(s) <- r'in progress'; sortingOrder(s) <- 2; }
    IF NOT doneStatus() THEN NEW s = TaskStatus { name(s) <- 'Выполнено'; id(s) <- r'done'; sortingOrder(s) <- 3; closed(s) <- TRUE; }
    IF NOT canceledStatus() THEN NEW s = TaskStatus { name(s) <- 'Отменено'; id(s) <- r'canceled'; sortingOrder(s) <- 4; closed(s) <- TRUE; }

    // Цвета насыщенные, а не *Subtle. Пастель была верна, пока приоритет заливал
    // строку целиком: на всю ширину бледного оттенка достаточно, а насыщенный сделал
    // бы таблицу нечитаемой. Теперь приоритет — полоска в 4px слева (priorityMark в
    // StoreTaskCore), и на такой площади пастель не видно вовсе.
    // «Обычный» намеренно без цвета: полоски у него быть не должно, иначе выделять
    // нечего — отмечено всё.
    IF NOT taskPriority('low') THEN NEW p = TaskPriority {
        name(p) <- 'Низкий';
        id(p) <- r'low';
        color(p) <- TaskColor.secondary;
    }
    IF NOT taskPriority('normal') THEN NEW p = TaskPriority {
        name(p) <- 'Обычный';
        id(p) <- r'normal';
    }
    IF NOT taskPriority('high') THEN NEW p = TaskPriority {
        name(p) <- 'Высокий';
        id(p) <- r'high';
        color(p) <- TaskColor.warning;
    }
    IF NOT taskPriority('urgent') THEN NEW p = TaskPriority {
        name(p) <- 'Срочный';
        id(p) <- r'urgent';
        color(p) <- TaskColor.danger;
    }
}
