MODULE StoreTaskRefusal;

// System — классы TEXT и INTERNAL-вызовов (транзитивному REQUIRE не доверять)
REQUIRE System;

NAMESPACE StoreTask;

// ===== Отказ по существу: refuse вместо throwException =====
// Отказ мутации — «задача не назначена», «бланк уже завершён», не прошедший констрейнт —
// прерывает действие исключением, как и прежде, но отвечает HTTP 422, а не 500. На 500
// остаётся только настоящий сбой: запрос к базе, NPE, TOO LONG QUERY. Телефон по коду, а не
// по тексту исключения, решает, что делать со строкой очереди: отказ показывает причиной и
// предлагает «Убрать из очереди», сбой — повторяет позже (outbox_drain.dart).
//
// Код ставит Java (RefuseAction): статус ответа платформа берёт у исключения, и кроме как
// своим исключением его не задать. Так отвечает веб-клиент (через него ходят телефоны) на
// 6.2 и на master; встроенный HTTP сервера приложений на 6.2 статус исключения не смотрит и
// отвечает 500 — там телефон узнаёт отказ по классу LSFStatusException в тексте ответа.
//
// Остальное — как у throwException: текст сообщения, откат сессии, TRY … CATCH; с пустым
// сообщением действие молчит (не вызывается вовсе), поэтому required-гвард по-прежнему
// пишется с КОНСТАНТНЫМ сообщением (см. шапку ApiCommon).
//
// Чтения отказывают по-прежнему телом {error, message} с кодом (denyTask, denyLocked —
// ApiCommon): у них есть что сказать машине, а частичного ответа, который надо прервать,
// нет. Модуль — в ядре, а не рядом с ручками: отказывают и модели (Execution, права,
// доступ), когда их зовёт ручка.
refuse INTERNAL 'lsfusion.solutions.storetask.api.RefuseAction' (TEXT);
