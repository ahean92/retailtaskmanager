MODULE ServiceAccount;

REQUIRE Authentication;

NAMESPACE StoreTask;

serviceAccount 'Служебная' = DATA BOOLEAN (CustomUser);

EXTEND FORM customUser
    PROPERTIES(u) serviceAccount
;

DESIGN customUser {
    login {
        MOVE PROPERTY(serviceAccount(u)) AFTER PROPERTY(isLocked(u));
    }
}

EXTEND FORM customUsers
    PROPERTIES(u) READONLYIF isReadonly() serviceAccount AFTER isLocked(u)
;
