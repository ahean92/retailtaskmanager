MODULE StoreTaskPrint;

REQUIRE StoreTaskPrintTemplate, StoreTaskCore, StoreTaskType, Execution, Filling;

NAMESPACE StoreTask;

answer 'Ответ' (Filling e, Field f) = OVERRIDE
    name(optionValue(e, f)),
    ISTRING[500](numberValue(e, f)),
    textValue(e, f),
    (IF boolValue(e, f) = TTRUE THEN 'Да' ELSE ('Нет' IF boolValue(e, f) = TFALSE)),
    ISTRING[500](dateValue(e, f)),
    // снимок-первым (#36841): в акте ФИО на момент заполнения, а не текущее имя ссылки
    nameRefValue(e, f);

FORM printTask 'Задача'
    OBJECTS o = Task PANEL
    PROPERTIES(o) READONLY id, name, nameStatus, nameType, namePriority,
                           nameObject, addressObject,
                           nameAuthor, nameAssignedTo,
                           start, deadline, description,
                           // где физически шла работа (#36838): «завершено в 4 км от
                           // объекта» — ровно то, ради чего точки и заводились
                           startedAt, startedLatitude, startedLongitude, startedDistance,
                           finishedAt, finishedLatitude, finishedLongitude, finishedDistance

    OBJECTS e = Execution
    PROPERTIES(e) READONLY nameExecutor, dateTime, nameState, nameResult
    FILTERS task(e) = o

    OBJECTS fl = Filling
    PROPERTIES(fl) READONLY nameTemplate, percent, nameVerdict, nameResolution
    FILTERS task(fl) = o

    OBJECTS s = Section
    PROPERTIES(s) READONLY name
    PROPERTIES(fl, s) READONLY sectionScore, sectionMax, sectionPercent
    FILTERS template(s) = template(fl)

    OBJECTS f = Field
    PROPERTIES(f) READONLY name, hint
    PROPERTIES READONLY answer(fl, f), comment(fl, f), countPhoto(fl, f), firstPhoto(fl, f)
    FILTERS section(f) = s
;

@definePrintTemplate(task, 'Печатная форма задачи');
@definePrintTemplateType(task, type, TaskType, taskType, 'Типы задач');
@definePrintTemplateForm(task, t, type, type, id, object);
