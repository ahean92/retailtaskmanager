MODULE PulseForm;

REQUIRE StoreTaskCore, SystemEvents;

NAMESPACE StoreTask;

// ===== Оформление форм =====
// В отличие от навигатора, формы не перерисовываются компонентом: их десятки, они
// собираются из .lsf, и заменить отрисовку значило бы переписать грид, редакторы
// ячеек, фильтры и сортировку — всё, что платформа уже умеет. Поэтому здесь только
// стили поверх платформенных классов (.data-grid-*, .btn-toolbar, .filter).
//
// Область видимости — одна форма, а не общий файл на всё: стили форм, в отличие от
// навигатора, ложатся на десятки экранов обоих хостов, и раскатывать их сразу на
// всё, не посмотрев ни на одном, — не тот размен.
//
// Привязка делается атрибутом, который платформа ставит сама: корень каждой формы
// несёт lsfusion-form="<каноническое имя>", а контейнеры — lsfusion-container.
// Поэтому здесь нет ни DESIGN, ни своего класса: раскатка — это замена одного
// селектора в CSS на .form, и ни строчки в .lsf.
onWebClientInit() + {
    onWebClientInit('storeTasks/pulseForm.css') <- 1;
}

// Полоска приоритета живёт в StoreTaskCore рядом с самой формой, а не здесь:
// перенести её сюда не вышло — свойство, добавленное через EXTEND FORM, платформа
// кладёт в панель, и MOVE в грид падает с «should be in panel instead of grid».
// Колонка — часть замысла формы, ей там и место.

// Свойство типа HTMLTEXT платформа считает многострочным и отводит ему область в
// несколько строк: строка грида выросла с 27 до 84 пикселей, то есть ровно то, ради
// чего затевалась плотность, пропало. charHeight возвращает высоту к одной строке.
// В объявлении свойства этого не задать — CHARHEIGHT в языке нет, только CHARWIDTH;
// высота настраивается из дизайна.
DESIGN tasks {
    PROPERTY(statusHtml(t)) { charHeight = 1; }
}
