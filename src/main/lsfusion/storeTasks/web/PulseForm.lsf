MODULE PulseForm;

REQUIRE StoreTaskCore, GeoLog, SystemEvents;

NAMESPACE StoreTask;

// ===== Режимы грида =====
// Формы не перерисовываются компонентом: их десятки, они собираются из .lsf, и
// заменить отрисовку значило бы переписать грид, редакторы ячеек, фильтры и
// сортировку — всё, что платформа уже умеет. Здесь только стили поверх её классов.
//
// Но одного вида на все гриды не бывает. Реестр важных объектов и журнал однотипных
// записей — разные задачи чтения: в первом строк немного и в каждой надо
// разобраться, во втором их сотни и нужен объём. Поэтому режим объявляет сама форма,
// одной строкой:
//
//     @pulseGridRegistry(tasks, t);     // задачи, объекты проверки, шаблоны
//     @pulseGridLog(geoRequests, r);    // координаты, AI-запросы, доставки
//     @pulseCard(task, pane);           // карточка: подпись над полем
//     @pulseCardMain(task, leftPane); // колонка, отдающая ширину соседней
//
// Форма, которая не сказала ничего, остаётся в платформенном виде — раскатка на все
// гриды поэтому безопасна: ничего не меняется, пока не попросят.
//
// Названия по назначению, а не по размеру: автор формы утверждает, ЧТО у него за
// данные, а как это выглядит — решает pulseForm.css и может менять, не трогая формы.
onWebClientInit() + {
    onWebClientInit('storeTasks/pulseForm.css') <- 1;
}

// Класс ставится на контейнер группы объектов. Свойство называется именно `class`:
// ViewProxyUtil обрабатывает его отдельной веткой, поле elementClass по имени не
// пишется («property doesn't exist»). На ГЛАВНОМ контейнере формы класс до DOM не
// доходит — проверено, — а на контейнере группы объектов доходит.
//
// Два метакода вместо одного с параметром-режимом: подстановка ## внутрь строковой
// константы ненадёжна, а выигрыш от одного лишнего аргумента того не стоит.
META pulseGridRegistry(form, obj)
    DESIGN form {
        BOX(obj) { class = 'pulse-grid pulse-grid-registry'; }
    }
END

META pulseGridLog(form, obj)
    DESIGN form {
        BOX(obj) { class = 'pulse-grid pulse-grid-log'; }
    }
END

// Карточка: подпись над полем. Контейнер параметром — режим не привязан ни к форме,
// ни к её устройству, и вешается на любой уровень: на корневой контейнер формы или
// на отдельный блок внутри.
META pulseCard(form, container)
    DESIGN form {
        container { class = 'pulse-card'; }
    }
END

// Основная колонка карточки — та, что отдаёт ширину соседней. Нужна, когда рядом
// стоит колонка заданной ширины (у нас — «Обсуждение»): контейнер карточки разложен
// флексом С ПЕРЕНОСОМ, а перенос считается по ЖЕЛАЕМЫМ ширинам, ДО сжатия. Основная
// колонка желает ширину своего содержимого — под тысячу пикселей, — соседка на строку
// не помещается и уезжает вниз, под карточку. Класс обнуляет это желание: колонка
// по-прежнему растягивается на всё свободное, но больше не выталкивает соседку.
META pulseCardMain(form, container)
    DESIGN form {
        container { class = 'pulse-card-main'; }
    }
END

// ---- применение ----

@pulseGridRegistry(tasks, t);

// Журнал координат — контрастный пример: те же базовые правила, но без карточек,
// с мелким кеглем и плотными полями.
@pulseGridLog(geoRequests, r);

// Карточка задачи. Контейнер pane объявлен в DESIGN task (StoreTaskCore) и включает
// обе колонки формы.
@pulseCard(task, pane);
@pulseCardMain(task, leftPane);

// ---- частности «Задач» ----
// Полоска приоритета живёт в StoreTaskCore рядом с самой формой: свойство,
// добавленное через EXTEND FORM, платформа кладёт в панель, и MOVE в грид падает с
// «should be in panel instead of grid».
DESIGN tasks {
    // Свойство типа HTMLTEXT платформа считает многострочным и отводит ему область в
    // несколько строк: строка грида вырастала с 27 до 84 пикселей. charHeight
    // возвращает высоту к одной строке. В объявлении свойства этого не задать —
    // CHARHEIGHT в языке нет, только CHARWIDTH; высота настраивается из дизайна.
    PROPERTY(statusHtml(t)) { charHeight = 1; }

    // Номер задачи не помещался: формат ST000078 — восемь знаков, а колонка была уже,
    // и во всех строках стояло одинаковое «ST00…», то есть колонка не различала
    // ничего. Ширина задаётся здесь, а не в объявлении свойства: id используется и в
    // других формах.
    PROPERTY(id(t)) { charWidth = 9; }

    // Перенос там, где текст обрезался многоточием. Это платформенная возможность
    // (wrap у свойства), а не борьба с CSS: клиент сам вешает html-or-text-wrap и
    // считает высоту строки. wrapWordBreak — чтобы длинное слово рвалось, а не
    // распирало колонку.
    //
    // Перенос задаётся у СВОЙСТВА, а не режимом грида, и это намеренно: какие колонки
    // длинные — знает форма, а не режим. В журнале перенос обычно не нужен вовсе:
    // строки там однотипные и короткие, а растить их значит терять объём.
    PROPERTY(name(t)) { wrap = TRUE; wrapWordBreak = TRUE; }
    PROPERTY(nameObject(t)) { wrap = TRUE; wrapWordBreak = TRUE; }
}

// ---- карточка задачи: всё под одним таб-контейнером ----
// Было: «шапка» с основными свойствами и таб-контейнер с остальным — соседи, идущие
// сверху вниз. Стало: шапка переезжает в тот же контейнер отдельной вкладкой
// «Основное», и разделов становится ровно один список.
//
// Так карточка перестаёт быть двухэтажной: у неё один способ переключения, а не
// «сверху всегда видно одно, снизу выбираешь другое». Заодно освобождается высота —
// шапка занимала треть экрана независимо от того, нужна ли она сейчас.
//
// Правка живёт здесь, а не в StoreTaskCore: это решение нашего оформления, и снимается
// вместе с модулем.
DESIGN task {
    details {
        NEW basic FIRST {
            caption = 'Основное';
            fill = 1;
            MOVE header;
        }
    }

    // Код не помещался — во всех задачах стояло «ST00…», то есть поле не показывало
    // ничего. Ширина задаётся здесь, а не в объявлении свойства: id живёт и в других
    // формах, и менять его везде ради одной — лишнее.
    PROPERTY(id(t)) { charWidth = 9; }

    // Даты обрезались на последнем знаке: «28.08.202». Платформа отводит полю ширину
    // по числу знаков типа, а считает её по своему эталонному кеглю — реальный шрифт
    // клиента шире, и десятого знака не хватает. Двенадцать знаков закрывают разницу.
    PROPERTY(start(t)) { charWidth = 12; }
    PROPERTY(deadline(t)) { charWidth = 12; }

    // ---- действия отдельной строкой ----
    // «Взять», «Освободить» и «Начать» стояли в одном ряду со свойствами объекта.
    // Кнопка среди полей читается как ещё одно поле: то же место в сетке, та же
    // подпись сверху — а делает она совсем другое. Отдельная строка сразу под
    // названием: сначала «что за задача», потом «что с ней можно сделать».
    header {
        NEW actions AFTER main {
            horizontal = TRUE;
            alignment = STRETCH;
            MOVE PROPERTY(takeTask(t));
            MOVE PROPERTY(releaseTask(t));
            MOVE PROPERTY(beginExecution(t));
        }
    }

    // ---- свойства: одна сетка в две колонки ----
    // «Объект» был горизонтальным рядом, и в него же складывают свои поля соседние
    // модули: шаблон (FormTask), правило и начало периода (StoreTaskSchedule),
    // источник (Corrective). Пять-шесть полей в одну строку не помещались и раньше, а
    // рядом с «Обсуждением» колонка стала уже — и обрезались уже все. Две колонки, как
    // у свойств ниже: подписи выстраиваются по одной вертикали, а новое поле от любого
    // модуля просто занимает следующую ячейку, не ломая строку.
    object {
        horizontal = FALSE;
        lines = 2;
    }

    // «Дата начала / Срок / Готово» лежали вложенным горизонтальным контейнером ВНУТРИ
    // сетки: три поля делили ширину одной ячейки и обрезались все три («28.08.202»).
    //
    // Колонки задаются ДВУМЯ контейнерами, а не lines = 2. lines раскладывает свойства
    // сам и как ему удобно: пары получались перепутанными («Приоритет» слева, «Тип»
    // справа), и порядком объявления это не чинится — раскладка от него не зависит.
    // Два контейнера рядом дают ровно те пары, которые задуманы: вид и важность,
    // автор и исполнитель, кто взял и когда, начало и срок.
    params {
        lines = 1;
        horizontal = TRUE;
        alignment = STRETCH;
        NEW paramsLeft {
            fill = 1;
            MOVE PROPERTY(nameType(t));
            MOVE PROPERTY(nameAuthor(t));
            MOVE PROPERTY(nameTakenBy(t));
            MOVE PROPERTY(start(t));
            MOVE PROPERTY(progress(t));
            MOVE PROPERTY(clientId(t));
        }
        NEW paramsRight {
            fill = 1;
            MOVE PROPERTY(namePriority(t));
            MOVE PROPERTY(nameAssignedTo(t));
            MOVE PROPERTY(takenAt(t));
            MOVE PROPERTY(deadline(t));
            MOVE PROPERTY(unplanned(t));
            MOVE PROPERTY(tags(t));
        }
    }

    // Полоса статуса растягивалась во всю ширину карточки и была самым громким
    // элементом экрана, хотя это обычный выбор из четырёх значений. Ширина задаётся
    // здесь, а не в CSS: размер платформа проставляет инлайново, и правило по классу
    // его не перебивает.
    PROPERTY(nameStatus(t)) { fill = 0; valueWidth = 420; }

    rightPane {
        // Ширина задаётся ЗДЕСЬ, а не в CSS: fill платформа переводит во flex
        // инлайновым стилем, и правило по классу его не перебивает (проверено —
        // computed оставался flex: 1 1 auto, обе колонки по 1130px, отсюда перенос).
        // fill = 0 снимает растяжение, width даёт колонке её размер.
        fill = 0;
        width = 280;

        // Комментарии сюда НЕ переносятся, и это осознанно. Из разделов карточки
        // «Обсуждение» единственный про «читать параллельно» — остальные про
        // «открыть и разобраться». За вкладкой переписку не видно, пока смотришь на
        // свойства, поэтому она остаётся в правой колонке (rightPane), куда её
        // кладёт @defineTaskComments.
        //
        // Одного возврата мало: pane разложен флексом С ПЕРЕНОСОМ, и правая колонка без
        // заданной ширины не помещалась рядом — уезжала вниз.
        //
        // Ширина узкая намеренно: переписку читают колонкой, а не полосой в пол-экрана,
        // и от ширины зависит, поместится ли она рядом с «Основным» — на 1920 вставала
        // и при 360, на 1440 уезжала вниз. Перенос при этом сохраняется: на совсем
        // узком окне лента уйдёт под карточку, а не выдавит её в горизонтальную
        // прокрутку.
    }
}
