MODULE StoreTaskNotification;

// TaskPerformer — по-настоящему: inAll/performer стоят в notify(), а транзитивному
// REQUIRE не доверять (конвенция модуля)
// Также StoreTaskSettings — папка operations (транзитивному REQUIRE не доверять)
// StoreTaskForms — класс TaskFile: картинка уведомления (#37125) — ссылка на него, а
// модуль, которому нужен TaskFile, требует StoreTaskForms явно (правило StoreTaskForms)
// Utils — mod в подписи «N новых»; StoreTaskTextUtils — dateText в текстах по сроку;
// Authentication — currentUser/User: закрывший задачу исключается из адресатов «задача
// закрыта» (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, TaskPerformer, Time, StoreTaskSettings, StoreTaskForms, Utils, StoreTaskTextUtils,
        Authentication;

NAMESPACE StoreTask;

// Уведомления: довести событие до человека и показать, что ему приходило (#36717).
// Три слоя, и путать их — главная ошибка (docs/mvp/notifications-design.md):
//   событие      — что произошло (каталог NotificationEvent);
//   уведомление  — запись, адресованная человеку; ОНА ЖЕ журнал (класс Notification);
//   доставка     — попытка отправить наружу: почта, пуш, мессенджер (класс Delivery).
// «В приложении» — не канал: уведомление существует, значит в журнале оно есть; строка
// доставки хранила бы факт, что запись, которая уже лежит в базе, в базе лежит.

// === каталоги ===
// Каталоги, а не статические классы: событие или канал добавляются модулем — в том
// числе модулем хоста, — как это уже сделано с TaskType в Corrective/FormTask.
CLASS NotificationEvent 'Событие уведомления';
id '{ID}' = DATA STRING[30] (NotificationEvent);
name '{Name}' = DATA ISTRING[100] (NotificationEvent) NONULL CHARWIDTH 25;
notificationEvent = GROUP AGGR NotificationEvent e BY id(e);

CLASS NotificationChannel 'Канал уведомлений';
id '{ID}' = DATA STRING[30] (NotificationChannel);
name '{Name}' = DATA ISTRING[50] (NotificationChannel) NONULL CHARWIDTH 15;
notificationChannel = GROUP AGGR NotificationChannel c BY id(c);

// события первой версии; свои события модуль (в т.ч. хоста) сидирует так же
seedNotificationEvents () {
    IF NOT notificationEvent('taskAssigned') THEN
        NEW e = NotificationEvent { id(e) <- 'taskAssigned'; name(e) <- 'Назначена задача'; }
    IF NOT notificationEvent('deadlineNear') THEN
        NEW e = NotificationEvent { id(e) <- 'deadlineNear'; name(e) <- 'Срок наступает завтра'; }
    IF NOT notificationEvent('overdue') THEN
        NEW e = NotificationEvent { id(e) <- 'overdue'; name(e) <- 'Задача просрочена'; }
    IF NOT notificationEvent('fillingFinished') THEN
        NEW e = NotificationEvent { id(e) <- 'fillingFinished'; name(e) <- 'Проверка завершена'; }
    IF NOT notificationEvent('correctiveCreated') THEN
        NEW e = NotificationEvent { id(e) <- 'correctiveCreated'; name(e) <- 'Создано корректирующее действие'; }
    IF NOT notificationEvent('taskClosed') THEN
        NEW e = NotificationEvent { id(e) <- 'taskClosed'; name(e) <- 'Задача закрыта'; }
}
onStarted () + { seedNotificationEvents(); }
loadDefaultData () + { seedNotificationEvents(); }

// === уведомление — запись журнала ===
CLASS Notification 'Уведомление';
performer = DATA TaskPerformer (Notification) NONULL;
namePerformer 'Кому' (Notification n) = name(performer(n));
event = DATA NotificationEvent (Notification) NONULL;
nameEvent 'Событие' (Notification n) = name(event(n));
task = DATA Task (Notification);
idTask 'Задача' (Notification n) = id(task(n));
nameTask 'Название задачи' (Notification n) = name(task(n));
dateTime 'Дата/время' = DATA DATETIME (Notification) IN id;
title 'Заголовок' = DATA ISTRING[100] (Notification) IN id;
body 'Текст' = DATA ISTRING[500] (Notification) CHARWIDTH 40;
viewed 'Прочитано' = DATA BOOLEAN (Notification);

// Сколько событий слилось в запись: 1 у обычной, у цепочки (см. режимы ниже) — по
// одному на каждое слитое событие. Это и номер редакции текста: каждая редакция уходит
// наружу своей строкой доставки (NotificationDelivery), поэтому второй комментарий за
// день не теряется, а даёт новый пуш с новым текстом.
revision 'Событий' = DATA INTEGER (Notification);

// Цепочка ещё копит события (потоковый режим): следующее того же вида по той же задаче
// сольётся в эту запись, а не заведёт новую. Снимается, когда человек увидел, из-за
// чего запись копилась (closeThread), — с этого момента запись становится историей, и
// следующее событие начнёт новую.
openThread 'Копит события' = DATA BOOLEAN (Notification);

// Картинка события (#37125) — вложение, из-за которого уведомление и пришло. Ссылка на
// TaskFile, а не байты: телефон качает миниатюру той же ручкой и тем же правом, что и
// вложения ленты задачи (apiTaskFile?id=&thumb=1, canDownload). Поле УВЕДОМЛЕНИЯ, а не
// «поле комментария»: любое будущее событие, у которого есть картинка, показывается тем
// же способом, а клиент по-прежнему рисует пришедшее и про виды событий не знает (#36717).
image 'Вложение' = DATA TaskFile (Notification);

date 'Дата' (Notification n) = toDate(dateTime(n)) MATERIALIZED;

// === дедупликация — структурным ключом, а не склеенной строкой ===
// Два режима, и режим — свойство события (код, не данные: он часть смысла события).
//
// Суточный (по умолчанию): одно уведомление на (человек, событие, задача, день);
// повторный прогон регламента поэтому ничего не дублирует, а просроченная задача
// напоминает о себе раз в день. Строковый ключ вида event + '/' + id(t) ломается ровно
// там, где дороже всего: id(Task) в момент создания может быть ещё не присвоен, ключ
// оказался бы NULL и уникальность молча выключилась бы. Осознанное следствие ключа:
// уведомление без задачи из-под дедупликации выпадает (NULL в BY исключает строку) —
// у всех событий первой версии задача есть.
//
// Потоковый (threaded): одна ЗАПИСЬ на непрочитанную цепочку, но КАЖДОЕ событие — своя
// редакция и свой пуш. Заведён для комментариев: суточный режим давал по задаче один
// пуш в день, и второе за день сообщение человек не видел, пока сам не откроет список
// (#36844 принял это осознанно, отменено 2026-09-16). Запись копит события, пока
// человек не увидел, из-за чего она копилась, — тогда закрывается (closeThread), и
// следующее событие начинает новую. Шторка при этом держит одну строку с растущим
// счётчиком: пуш редакции встаёт на место прежнего (PushFcm, tag).
threaded = ABSTRACT CASE BOOLEAN (NotificationEvent);

// Суточный ключ: у потокового события его нет — записи цепочек из-под уникальности по
// дню выпадают намеренно (закрытая утром и открытая вечером цепочка делят день).
dayKey (Notification n) = date(n) IF NOT threaded(event(n));
notification = GROUP AGGR Notification n BY performer(n), event(n), task(n), dayKey(n);

// Потоковый ключ: не больше одной открытой цепочки на (человек, событие, задача) —
// уникальность и есть гарантия, что события сливаются в одну запись, а не плодят их.
openNotification = GROUP AGGR Notification n WHERE openThread(n) BY performer(n), event(n), task(n);

// Запись, в которую сейчас попадёт событие (e, t) для человека p, в любом режиме —
// то, что производителю или шву (NotificationWatcher) нужно знать про «уже есть»
currentNotification (TaskPerformer p, NotificationEvent e, Task t) =
    OVERRIDE openNotification(p, e, t), notification(p, e, t, currentDate());

// «2 новых», «5 новых», «21 новое» — подпись счётчика в тексте цепочки; у одиночной
// записи подписи нет. Слово согласовано с подразумеваемым «сообщение»: сегодня потоковое
// событие одно — комментарий, — и текст читается «3 новых · Пётр: …»
mergedCaption (INTEGER c) = (STRING(c) + (IF mod(c, 10) = 1 AND NOT mod(c, 100) = 11 THEN ' новое' ELSE ' новых')) IF c > 1;

// === текст живёт с событием ===
// Реализация абстрактна над двумя параметрами, и условие обязано связывать оба:
// не просто id(e) = '...', а ещё AND t IS Task — диспетчеризация по значению одного
// первого параметра не работает (те же грабли, что calcValue в HomeTaskMetrics.lsf).
// Явный каст к ISTRING[100]/[500] тоже обязателен: конкатенация складывает длины
// операндов, и без каста реализация шире объявленного класса — сервер не стартует.
// Как задача зовётся в заголовке: названием, а нет названия — номером, а нет и его —
// типом. Заголовки собираются конкатенацией, а '…' + NULL = NULL: у задачи без названия
// заголовок пропадал ЦЕЛИКОМ, и телефон показывал «(без заголовка)» вместо
// «Комментарий: ST000014». Номер вторым, а не первым: человек знает задачу по названию.
// Тип третьим, потому что номер задаче присваивается применением, а уведомление о
// назначении рождается в той же сессии, что и сама задача, — id там ещё пуст (см.
// дедупликацию выше, там та же грабля).
notificationTaskName (Task t) = OVERRIDE name(t), ISTRING(id(t)), nameType(t);

title = ABSTRACT CASE ISTRING[100] (NotificationEvent, Task);
body = ABSTRACT CASE ISTRING[500] (NotificationEvent, Task);

// Картинка — тем же приёмом и по той же причине, что title/body: значение считается в
// момент записи и хранится в поле, а не вычисляется при чтении. Уведомление — документ о
// том, что случилось, а не окно в текущее состояние: переименовали задачу, дописали в
// переписку — запись, которая уже лежит в журнале, этого не замечает.
//
// Одно исключение, и оно по замыслу: открытая цепочка (потоковый режим, notifyThread)
// переписывает title/body/image и сбрасывает «прочитано» на каждое слитое событие —
// запись цепочки и есть «что нового в переписке», и застывший текст первого сообщения
// дня был бы в ней ошибкой (возврат #36717: утреннее «принято» вместо вечернего «срочно
// перезвоните»). Меняет её только СВОЁ следующее событие, не чтение состояния; записи
// суточных событий не меняются вовсе.
image = ABSTRACT CASE TaskFile (NotificationEvent, Task);

// === точка входа для событий ===
// Новое событие = одна реализация title/body (и image, если у события есть картинка)
// плюс один WHEN с вызовом notify().
// Журнал, доставки, API и клиент при этом не трогаются вообще.
//
// Адресат уведомления — всегда ЧЕЛОВЕК: лента (performer(n) = currentPerformer()),
// отметка «прочитано», mute и пуш-устройства работают по личному исполнителю. Задача же
// с #36835 может быть назначена на подразделение — такая нотификация раскладывается по
// составу с учётом иерархии (inAll, материализовано); для личного исполнителя цикл
// вырождается в прежнюю одиночную запись. Осознанные следствия:
//   большой отдел получает по записи (и пушу) на каждого — назначение на магазин
//     целиком и должно греметь;
//   назначивший, если сам входит в состав, тоже получает запись — «в пул вашей команды
//     упала задача» как координация не лишняя;
//   исполнитель без учётки (mite: Employee без логина) строки больше не получает:
//     читать её было некому, а доставки только копили «нет устройств»;
//   mute(юнит, событие) не действует — глушат себе (свой личный performer), не отделу.
createNotification (TaskPerformer tp, NotificationEvent e, Task st) {
    NEW n = Notification {
        performer(n) <- tp;
        event(n) <- e;
        task(n) <- st;
        dateTime(n) <- currentDateTime();
        title(n) <- title(e, st);
        body(n) <- body(e, st);
        image(n) <- image(e, st);
        revision(n) <- 1;
        openThread(n) <- TRUE IF threaded(e);
    }
}

notifyDaily (TaskPerformer tp, NotificationEvent e, Task st) {
    IF NOT notification(tp, e, st, currentDate()) THEN
        createNotification(tp, e, st);
}

// Открытая цепочка есть — событие сливается в неё: новая редакция, текст с счётчиком и
// свежими подробностями, запись снова непрочитанная и снова наверху ленты (dateTime).
// Нет — начинается новая. Слияние идемпотентно В ПРЕДЕЛАХ СЕССИИ по данным, а не по
// локали: производитель зовёт notify на одного человека дважды, когда тот и исполнитель,
// и автор (NotificationComment) или ещё и наблюдатель (NotificationWatcher), — в суточном
// режиме второй вызов гасил ключ по дню, здесь его гасит CHANGED(revision): редакция в
// этой сессии уже поднята (или запись в ней рождена) — значит, это событие уже учтено.
notifyThread (TaskPerformer tp, NotificationEvent e, Task st) {
    IF openNotification(tp, e, st) THEN {
        FOR Notification n = openNotification(tp, e, st) AND NOT CHANGED(revision(n)) DO {
            revision(n) <- revision(n) + 1;
            dateTime(n) <- currentDateTime();
            title(n) <- title(e, st);
            body(n) <- ISTRING[500](CONCAT ' · ', mergedCaption(revision(n)), body(e, st));
            image(n) <- image(e, st);
            viewed(n) <- NULL;
        }
    } ELSE
        createNotification(tp, e, st);
}

// Ветки объявлены выше точки входа: lsFusion разбирает модуль за один проход, и имя,
// объявленное ниже вызова, «не найдено»
notify (TaskPerformer p, NotificationEvent e, Task st) {
    FOR inAll(p, User u) AND TaskPerformer tp = performer(u) DO
        IF threaded(e) THEN
            notifyThread(tp, e, st);
        ELSE
            notifyDaily(tp, e, st);
}

// Человек увидел, из-за чего цепочка копилась: она закрывается и считается прочитанной
// вместе с этим — следующее событие начнёт новую запись. Что считать «увидел», знает
// производитель события (для комментария — отметка прочтения переписки), поэтому зовёт
// он, а ядро только закрывает.
closeThread (TaskPerformer p, NotificationEvent e, Task t) {
    FOR Notification n = openNotification(p, e, t) DO {
        openThread(n) <- NULL;
        viewed(n) <- TRUE;
    }
}

// Дополнительные адресаты события по задаче (#37135) — подписка. Зовётся производителем
// события РЯДОМ с notify(), а не изнутри него, и это несущая стена: у события может не
// оказаться основного адресата вовсе — проверка завершена, а ответственные роли на объекте
// не назначены; срок подходит у задачи, которую ещё ни на кого не повесили. Внутри notify()
// наблюдатель в этих случаях не услышал бы ничего, а именно ради завершения проверки в
// основном и подписываются.
//
// Событие «назначена задача» сюда не приходит намеренно, и исключение это структурное —
// его просто неоткуда позвать, а не сравнение id со строкой: назначение говорит про
// исполнителя и наблюдателю не сообщает ничего.
//
// Дедупликация достаётся даром: ключ (человек, событие, задача, день) выше — назначенный,
// который заодно наблюдатель, получит одну запись, а не две.
notifyWatchers ABSTRACT LIST (NotificationEvent, Task);

// Запись пришла ПО ПОДПИСКЕ (#37136): адресат получил её только потому, что наблюдает за
// задачей, — не исполнитель, не автор и не ответственная роль. Лента телефона помечает
// такие записи: уведомление по своей задаче и по задаче, за которой лишь следишь, —
// разные вещи, и человек должен видеть, почему ему это пришло.
//
// Ставит реализация шва в момент создания записи и дальше не трогает — по той же причине,
// что title/body/image: уведомление — документ о том, что случилось, а не окно в текущее
// состояние. Будь пометка вычисляемой при чтении, отписка или закрытие задачи стёрли бы
// объяснение у записи, которая уже лежит в ленте, — а подписываются в основном ради
// завершения проверки, после которого задача как раз закрывается. Слияние события в
// открытую цепочку (notifyThread) переписывает текст, но не пометку: почему запись
// пришла, решено при её рождении и от числа сообщений не зависит.
viaWatch 'По подписке' = DATA BOOLEAN (Notification);

// === доставка — попытка отправить наружу ===
// Внешних каналов в этой версии нет (пуш через FCM — отдельной задачей): строки
// Delivery появятся вместе с первым каналом, который добавит матрицу включения
// (событие × канал) и регламент-диспетчер неотправленных. Отправка сознательно не в
// сессии бизнес-операции: сбой SMTP не должен откатывать назначение задачи.
CLASS Delivery 'Доставка';
notification = DATA Notification (Delivery) NONULL DELETE;
channel = DATA NotificationChannel (Delivery) NONULL;
nameChannel 'Канал' (Delivery d) = name(channel(d));
sent 'Отправлено' = DATA DATETIME (Delivery);
error 'Ошибка' = DATA ISTRING[250] (Delivery);
attempts 'Попыток' = DATA INTEGER (Delivery);

// канал подключается модулем — тот же приём, что startExecution и onFinish
send ABSTRACT LIST (Delivery);

// === событие: назначена задача ===
// Более специфичное событие может подавить «назначена» (корректирующая задача шлёт
// своё correctiveCreated — два уведомления одному человеку об одном факте не нужны).
suppressAssigned = ABSTRACT CASE BOOLEAN (Task);

title (NotificationEvent e, Task t) += WHEN id(e) = 'taskAssigned' AND t IS Task THEN
    ISTRING[100]('Вам назначена задача: ' + notificationTaskName(t));
// срок — по-русски (приёмка 10.09, п. 2): «04.09.2026», а не ISO «2026-09-04»; так же
// в двух событиях регламента ниже
body (NotificationEvent e, Task t) += WHEN id(e) = 'taskAssigned' AND t IS Task THEN
    ISTRING[500](CONCAT ' · ', nameObject(t), 'срок ' + dateText(deadline(t)));

// Срабатывает и на создание с исполнителем, и на переназначение. Гвард на
// currentPerformer(): создатель, назначивший задачу себе (мобильная apiCreateTask без
// assigneeId делает ровно так), о собственном действии не уведомляется; в сессии
// графика/регламента currentPerformer() NULL — сравнение не срабатывает и уведомление
// уходит.
WHEN SETCHANGED(assignedTo(Task t)) AND assignedTo(t)
    AND NOT suppressAssigned(t)
    AND NOT assignedTo(t) = currentPerformer() DO
    notify(assignedTo(t), notificationEvent('taskAssigned'), t);

// === событие: задача закрыта ===
// Реакция проведения (StoreTaskCore.onProceed, #36987): срабатывает один раз на закрытие
// любым путём — автозакрытие по выполнению, смена статуса на карточке, в списке, на доске и
// с телефона, кнопка «Провести» — и не срабатывает на повторное закрытие переоткрытой
// задачи. Отмена — тот же исход и та же точка: адресаты и канал те же, различается текст.
// Внутри транзакции закрытия здесь только запись журнала — наружу её несёт доставка
// (NotificationDelivery) своей сессией; отклонённый APPLY не оставляет ни записи, ни письма.
//
// Кому: исполнителю и автору, кроме того, кто закрыл сам, — о собственном действии не
// уведомляют (гвард currentPerformer() у «назначена задача» выше). Подразделение
// раскладывается по составу с иерархией, как в notify, но циклом здесь, а не notify(p, …)
// на подразделение целиком: исключить внутри него закрывшего было бы нечем — тот же приём,
// что у наблюдателей (NotificationWatcher). Задача на магазин закрывается кем-то из
// магазина — остальные узнают, что из общего пула она ушла. В сессии регламента живого
// пользователя нет — исключать некого, уходит всем (то же допущение, что у «назначена»).
// Тот, кто и исполнитель, и автор, получает одну запись — ключ по дню. Наблюдателям — швом
// рядом (#37135): подписываются в основном ради того, чем задача кончится.
//
// Более специфичное закрытие может подавить «закрыта» (тот же приём, что suppressAssigned):
// задача, закрытая приёмкой, гремит как «Результат принят» (NotificationAcceptance) — тем же
// адресатам, и вторая запись об одном факте была бы шумом (#37125).
suppressClosed = ABSTRACT CASE BOOLEAN (Task);

title (NotificationEvent e, Task t) += WHEN id(e) = 'taskClosed' AND t IS Task THEN
    ISTRING[100]((IF canceledTask(t) THEN 'Задача отменена: ' ELSE 'Задача закрыта: ') + notificationTaskName(t));
body (NotificationEvent e, Task t) += WHEN id(e) = 'taskClosed' AND t IS Task THEN
    ISTRING[500](CONCAT ' · ', nameObject(t), nameStatus(t));

onProceed (Task t) + {
    IF NOT suppressClosed(t) THEN {
        FOR (inAll(assignedTo(t), User u) OR inAll(author(t), u)) AND TaskPerformer tp = performer(u)
            AND NOT u = currentUser() DO
            notify(tp, notificationEvent('taskClosed'), t);
        notifyWatchers(notificationEvent('taskClosed'), t);
    }
}

// === события по сроку: регламент ===
title (NotificationEvent e, Task t) += WHEN id(e) = 'deadlineNear' AND t IS Task THEN
    ISTRING[100]('Срок завтра: ' + notificationTaskName(t));
body (NotificationEvent e, Task t) += WHEN id(e) = 'deadlineNear' AND t IS Task THEN
    ISTRING[500](CONCAT ' · ', nameObject(t), 'срок ' + dateText(deadline(t)));

title (NotificationEvent e, Task t) += WHEN id(e) = 'overdue' AND t IS Task THEN
    ISTRING[100]('Просрочена: ' + notificationTaskName(t));
body (NotificationEvent e, Task t) += WHEN id(e) = 'overdue' AND t IS Task THEN
    ISTRING[500](CONCAT ' · ', nameObject(t), 'срок был ' + dateText(deadline(t)));

// Точка входа для платформенного Scheduler — админ добавляет через Scheduler → Задания
// (рекомендуется ежедневно, после полуночи). Прогон идемпотентен: дедупликация выше
// гарантирует по одной записи на (человек, событие, задача, день) — просроченная и
// не закрытая задача поэтому напоминает о себе раз в день, пока открыта.
// Сданная на приёмку (#37157) о сроке не напоминает: срок исполнителем выполнен, дальше
// решает принимающий. У «просрочена» это уже внутри overdueTask (StoreTaskCore), у «срок
// завтра» правило своё — исключение здесь.
processNotifications 'Сформировать уведомления по срокам' () {
    NEWSESSION {
        FOR opened(Task t) AND deadline(t) = sum(currentDate(), 1) AND NOT onAcceptance(t) AND assignedTo(t) DO
            notify(assignedTo(t), notificationEvent('deadlineNear'), t);
        FOR opened(Task t) AND overdueTask(t) AND assignedTo(t) DO
            notify(assignedTo(t), notificationEvent('overdue'), t);
        // наблюдателям (#37135) — своими проходами и БЕЗ гварда assignedTo: подписка на
        // задачу не зависит от того, назначена ли она на кого-нибудь. Прогон остаётся
        // идемпотентным — дедупликация та же
        FOR opened(Task t) AND deadline(t) = sum(currentDate(), 1) AND NOT onAcceptance(t) DO
            notifyWatchers(notificationEvent('deadlineNear'), t);
        FOR opened(Task t) AND overdueTask(t) DO
            notifyWatchers(notificationEvent('overdue'), t);
        // журнал глубже 30 дней API не отдаёт (NotificationApi) — старое чистится здесь
        // же; доставки уходят каскадом (DELETE на ссылке)
        DELETE Notification n WHERE n IS Notification AND date(n) < subtract(currentDate(), 30);
        APPLY;
    }
}

// === журнал в бэк-офисе: что и кому сформировано ===
FORM notifications 'Уведомления'
    OBJECTS n = Notification
    PROPERTIES(n) READONLY dateTime, namePerformer, nameEvent, title, body,
                           idTask, nameTask, viewed, viaWatch, revision, openThread
    ORDERS dateTime(n) DESC

    FILTERGROUP read
        FILTER 'Непрочитанные' NOT viewed(n) 'F8'

    OBJECTS d = Delivery
    PROPERTIES(d) READONLY nameChannel, sent, error, attempts
    FILTERS notification(d) = n

    LIST Notification OBJECT n
;

DESIGN notifications {
    OBJECTS {
        MOVE BOX(n) { fill = 3; }
        MOVE BOX(d) { caption = 'Доставки'; fill = 1; }
    }
}

NAVIGATOR {
    operations {
        NEW notifications IMAGE 'fa-solid fa-bell';
    }
}
