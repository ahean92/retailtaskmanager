MODULE NotificationFill;

// события уведомлений, живущие над заполнениями и корректирующими задачами (#36717);
// ядро (StoreTaskNotification) про Filling/Corrective ничего не знает
REQUIRE StoreTaskNotification, StoreTaskCore, Filling, Execution, FillingHeader,
        Corrective, ObjectRole;

NAMESPACE StoreTask;

// === проверка завершена → ответственным ролям объекта ===
// Кому адресовано — данные (роли на объекте, #36708), а не код: у каждого заказчика
// свой список ролей, и назначение человека на роль — настройка карточки объекта.
title (NotificationEvent e, Task t) += WHEN id(e) = 'fillingFinished' AND t IS Task THEN
    ISTRING[100]('Проверка завершена: ' + notificationTaskName(t));
body (NotificationEvent e, Task t) += WHEN id(e) = 'fillingFinished' AND t IS Task THEN
    ISTRING[500](CONCAT ' · ', nameObject(t), resultSummary(lastExecution(t)));

// В сессии завершения (onFinish), так что и АРМ, и мобильный apiFinishExecution
// проходят через одну точку. Один человек на двух ролях объекта получает одну
// запись — второй вызов notify гасится дедупликацией.
onFinish (Filling e) + {
    FOR active(ObjectRole r) AND TaskPerformer p = personFilling(e, r) DO
        notify(p, notificationEvent('fillingFinished'), task(e));
    // наблюдателям (#37135) — отдельной строкой, а не вместе с ролями: подписка живёт на
    // задаче, а роли — на объекте, и объект без назначенных ролей не должен обнулять
    // подписку. Ради завершения проверки в основном и подписываются
    notifyWatchers(notificationEvent('fillingFinished'), task(e));
}

// === создано корректирующее действие → исполнителю ===
title (NotificationEvent e, Task t) += WHEN id(e) = 'correctiveCreated' AND t IS Task THEN
    ISTRING[100]('Корректирующее действие: ' + notificationTaskName(t));
body (NotificationEvent e, Task t) += WHEN id(e) = 'correctiveCreated' AND t IS Task THEN
    ISTRING[500](CONCAT ' · ', nameObject(t), nameSourceField(t));

WHEN SET(isCorrective(Task t)) AND assignedTo(t) DO
    notify(assignedTo(t), notificationEvent('correctiveCreated'), t);

// наблюдателям (#37135) — своим событием и без гварда на исполнителя: подписаны на
// исходную задачу, а корректирующая рождается из её замечания
WHEN SET(isCorrective(Task t)) DO
    notifyWatchers(notificationEvent('correctiveCreated'), t);

// корректирующая задача назначается при создании — второе уведомление «назначена»
// тому же человеку о том же факте было бы шумом, correctiveCreated специфичнее
suppressAssigned (Task t) += WHEN isCorrective(t) THEN TRUE;
