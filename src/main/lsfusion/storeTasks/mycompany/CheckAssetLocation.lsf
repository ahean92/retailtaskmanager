MODULE CheckAssetLocation;

// CheckAsset — assetLocation/CheckAsset; CheckObject — класс значения шва
// (транзитивному REQUIRE не доверять)
REQUIRE CheckAsset, CheckObjectLocation, CheckObject;

NAMESPACE StoreTask;

// Puts an inspected asset in an ERP store. This is the second half of the Location
// seam — CheckObjectLocation makes a store inspectable in its own right, this one
// says which store a device belongs to — and it is why the fillable engine no longer
// drags Inventory into the shared core.
location 'Магазин' = DATA Location (CheckAsset);
nameLocation 'Магазин' (CheckAsset a) = name(location(a));

// Это и есть место железки в дереве объектов. Адрес и координаты отсюда больше не
// переписываются: их даёт ядро через расположение (CheckObject.site), поднимаясь по
// этой самой ссылке. Данные не трогаются — менялись три реализации, а не хранение.
//
// Ссылка типизирована на магазин, поэтому в ERP-сборке железка может стоять только в
// магазине. Понадобится «сканер внутри кассы» — сюда добавляется собственная ссылка на
// CheckAsset, а этот шов становится OVERRIDE над ней и location; заводить второй
// источник дерева до появления такого требования незачем.
//
// Реализуется шов артефакта, а не parent напрямую: единственную реализацию parent на
// CheckAsset занял сам артефакт (fillable/CheckAsset), чтобы дерево было доступно и
// приёму задач извне. assetLocation — приоритетная половина того OVERRIDE, то есть
// поведение ERP-сборки не меняется: где магазин известен, он и есть родитель.
assetLocation (CheckAsset a) += location(a);
