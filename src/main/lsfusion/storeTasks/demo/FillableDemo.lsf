MODULE FillableDemo;

// DemoSeed — ensureSimTemplate (тот же шаблон, что у генераторов ERP-демо); CheckAssetLocation —
// location(CheckAsset); StoreTaskCore — Task/checkObject/priority; StoreTaskType —
// TaskType/taskType; Template — templateByName (транзитивному REQUIRE не доверять)
REQUIRE DemoSeed, FormTask, CheckAsset, CheckAssetLocation, Location, StoreTaskPriority, StoreTaskCore,
        StoreTaskType, Template;

NAMESPACE StoreTask;

// Демо ERP-хоста (Location); подключается только через demo/StoreTaskDemoLib.
// Acceptance template for the unified engine: a SIM-swap procedure (no scoring,
// resolution required) exercising scan / number+norm / boolean / photo / longtext.
generateSimDemo 'Демо: замена SIM' () {
    // ensure the 'form' task type exists (loadDefaultData does not re-run on an existing DB)
    NEWSESSION {
        IF NOT taskType('form') THEN NEW tt = TaskType { name(tt) <- 'Процедура'; id(tt) <- 'form'; }
        APPLY;
    }
    // шаблон — общий сид DemoSeed.ensureSimTemplate (то же имя, разделы и поля, что здесь были
    // дословно повторены): идемпотентен по имени, вторая копия означала бы два места правки
    NEWSESSION {
        ensureSimTemplate();
        APPLY;
    }
    NEWSESSION {
        NEW a = CheckAsset {
            assetName(a) <- 'Прибор мониторинга №1';
            location(a) <- (GROUP MAX Location l IF name(l) = 'Демо-магазин');
            NEW t = Task {
                checkObject(t) <- a;
                type(t) <- formTaskType();
                template(t) <- templateByName('Замена SIM-карты');
                priority(t) <- (GROUP MAX TaskPriority p IF id(p) = 'high');
            }
        }
        APPLY;
    }
}
