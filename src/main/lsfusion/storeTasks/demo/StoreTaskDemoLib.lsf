MODULE StoreTaskDemoLib;

// Demo generators as one package. Neither production aggregator (StoreTaskLib, StoreTask)
// pulls it in: resetDemoTasks and generateDemoTasksMix DELETE every task, and a button
// that does that on the settings form of a live host is not something to get transitively.
// A host that is a demo stand requires the package itself:
//
//     REQUIRE StoreTask, StoreTaskDemoLib;   // ERP host on mycompany
//
// DemoSeed (shared seeds: option sets, templates, table rows, ERP lookups), the four
// generators built on it — TestDataDemo, ChecklistDemo, TaskResetDemo, TaskMixDemo — and
// FillableDemo need an ERP host (Product, Category, Location); ScorecardDemo needs only the
// platform, so the standalone host takes just that one.
REQUIRE DemoSeed, TestDataDemo, ChecklistDemo, TaskResetDemo, TaskMixDemo, FillableDemo, ScorecardDemo;

NAMESPACE StoreTask;
