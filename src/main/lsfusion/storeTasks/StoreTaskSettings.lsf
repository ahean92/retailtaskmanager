MODULE StoreTaskSettings;

NAMESPACE StoreTask;

FORM options 'Настройки';

DESIGN options {
    OBJECTS {
        NEW tabbedPane {
            tabbed = TRUE;
            fill = 1;
            NEW commons {
                caption = 'Основное';
            }
        }
    }
}

// Иконка каждому пункту навигатора задаётся явно классами FontAwesome ('fa-solid fa-...'):
// без IMAGE платформа подбирает иконку сама, но ищет по англоязычному словарю, а заголовки
// здесь русские — совпадений почти нет, и все пункты получают один и тот же дефолтный значок
// формы. Новый пункт навигатора заводится сразу со своим IMAGE.
// У корневой папки запись из двух половин ('файл;классы'): шрифтовые иконки умеет только
// веб-клиент, десктопному достаётся png — платформа сама раздаёт каждому своё.
NAVIGATOR {
    NEW FOLDER storeTask 'Управление персоналом' WINDOW toolbar IMAGE 'storeTask.png;fa-solid fa-users-gear' {
        NEW FOLDER operations 'Операции' IMAGE 'fa-solid fa-briefcase' {
        }
        NEW FOLDER catalogs 'Справочники' IMAGE 'fa-solid fa-book' {
        }
        NEW FOLDER reports 'Отчёты' IMAGE 'fa-solid fa-chart-column' {
        }
        NEW FOLDER settings 'Настройка' IMAGE 'fa-solid fa-sliders' {
            NEW options IMAGE 'fa-solid fa-gear';
        }
    }
}
