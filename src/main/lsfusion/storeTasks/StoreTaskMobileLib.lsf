MODULE StoreTaskMobileLib;

// The field interface on top of the core: what the phone shows besides the tasks
// themselves — the home screen and its role-configured blocks (with their web mirrors,
// the dashboard and the supervisor's metrics), quick-create presets, branding, the
// download link — and the JSON handles that serve exactly that. Requires the core; the
// core never requires this. ExternalApp stays a host option and is not here either.
REQUIRE StoreTaskCoreLib,
        // оформление мобильного клиента (бренд: название/цвета/логотип для приложения)
        Branding, BrandingApi,
        // раздача самого приложения: путь к apk и пункт «Скачать приложение» в навигаторе
        AppDownload,
        // главная страница мобильного клиента — блоки, настраиваемые по ролям; встроенные
        // показатели по задачам и главная по умолчанию — отдельным модулем
        HomeScreen, HomeTaskMetrics, HomeDashboard, SupervisorMetrics, HomeApi,
        // пресеты создания задач в поле + предзагрузка шаблонов и исполнителей
        QuickAction, QuickActionApi;

NAMESPACE StoreTask;
