MODULE CorrectiveRecheck;

// StoreTaskCore — task/checkObject/status/opened; Execution — finished/dateTime; Filling —
// recordedNonconformity/notApplicable/answered; Template — template; StoreTaskStatus — taskStatus;
// StoreTaskForms — карточка task, которую модуль расширяет; Field — field(Template, code) и
// code(Field): пункт ищется по коду, а не по объекту (#37174)
// (транзитивному REQUIRE не доверять)
REQUIRE Corrective, Time, StoreTaskCore, StoreTaskForms, Execution, Filling, Field, Template, StoreTaskStatus;

NAMESPACE StoreTask;

// Пункт корректирующей в конкретной проверке: в новой редакции чек-листа (#37174) это
// другой объект поля с тем же кодом. Без этого проверка по новой редакции корректирующую
// по старой не нашла бы, и та не снялась бы никогда.
recheckField (Filling p, Task t) = field(template(p), code(sourceField(t)));

recheckFilling (Task t) = GROUP LAST Filling p ORDER DESC dateTime(p), p
    WHERE isCorrective(t) AND finished(p)
      AND checkObject(task(p)) = checkObject(t)
      AND family(template(p)) = family(template(sourceField(t)))
      AND dateTime(p) > dateTime(sourceFilling(t))
      AND answered(p, recheckField(p, t)) AND NOT notApplicable(p, recheckField(p, t));

recheckDate 'Перепроверено' (Task t) = toDate(dateTime(recheckFilling(t)));
// По записанному несоответствию, а не по nonconformity: перепроверка — завершённая проверка
// (finished в recheckFilling), итог у неё записан всегда (Filling.recordResult + бэкфилл), и
// значение то же. Разница — в цене компиляции: nonconformity — IF по resultRecorded, и его живая
// ветвь (liveNonconformity по всем механикам) попадала в запросы событий ниже при каждом
// завершении бланка — ~3,6 с из 6,9 с apiFinishExecution на стенде 2026-09-25 (та же грабля,
// что у текстов уведомлений, см. Filling.recordedSummary).
recheckFailed 'Подтверждено' (Task t) =
    recordedNonconformity(recheckFilling(t), recheckField(recheckFilling(t), t));
recheckPassed 'Снято перепроверкой' (Task t) = TRUE IF recheckFilling(t) AND NOT recheckFailed(t);

// Повторная корректирующая (#37160, дополнение от 24.09): перепроверка не подтвердила
// устранение — завершение проверки создаёт новую задачу по тому же пункту (pendingCorrective
// держит только открытые и не устранённые), и без пометки она неотличима от первой. Ссылка —
// на прежнюю: это самая сильная пара задач для разбора, исполнитель отметил «устранено»,
// а проверка показала обратное.
repeated 'Повторная' = DATA BOOLEAN (Task);
repeatedFrom = DATA Task (Task);
nameRepeatedFrom 'Повторная для' (Task t) = idName(repeatedFrom(t));

// Прежняя устранённая корректирующая того же пункта, которую перепроверяла завершающаяся
// проверка. Читается в момент создания новой (шов ниже): несоответствие у проверки в этот
// момент ещё живое, а не записанное (recordResult идёт после onFinish — см. Filling), поэтому
// повод здесь — завершённая проверка над устранённой задачей того же пункта, а провал
// гарантирует needsCorrective, по которому новая задача и создаётся.
prevCorrective (Filling e, Field f) = GROUP MAX Task t0
    IF isCorrective(t0) AND checkObject(t0) = checkObject(task(e))
      AND familyField(sourceField(t0)) = familyField(f)
      AND resolved(t0) AND recheckFilling(t0) = e;

onCorrectiveCreated (Task t, Filling e) + {
    FOR Task t0 = prevCorrective(e, sourceField(t)) DO {
        repeated(t) <- TRUE;
        repeatedFrom(t) <- t0;
    }
}

WHEN LOCAL SET(recheckPassed(Task t)) AND NOT resolved(t) AND NOT CHANGED(resolved(t)) DO {
    resolved(t) <- TRUE;
    resolvedDate(t) <- recheckDate(t);
}

WHEN LOCAL SET(recheckPassed(Task t)) AND opened(t) AND NOT CHANGED(status(t)) DO {
    status(t) <- taskStatus('done');
    autoStatus(t) <- TRUE;
}

EXTEND FORM task
    PROPERTIES(t) READONLY recheckDate SHOWIF isCorrective(t),
                           recheckFailed SHOWIF isCorrective(t),
                           repeated SHOWIF isCorrective(t),
                           nameRepeatedFrom SHOWIF repeated(t)
;

DESIGN task {
    correctiveInfo {
        MOVE PROPERTY(recheckDate(t));
        MOVE PROPERTY(recheckFailed(t));
        MOVE PROPERTY(repeated(t));
        MOVE PROPERTY(nameRepeatedFrom(t));
    }
}

EXTEND FORM filling
    PROPERTIES(ct) READONLY recheckDate, recheckFailed, repeated
;
