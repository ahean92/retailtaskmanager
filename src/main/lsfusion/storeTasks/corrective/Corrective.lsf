MODULE Corrective;

// StoreTaskStatus — taskStatus; StoreTaskType — taskType; TaskPerformer — currentPerformer;
// StoreTaskForms — TaskFile/TaskComment (фото и комментарий выполнения) и карточка task,
// которую модуль расширяет; TaskWatcher — наблюдатели, которых корректирующая наследует у
// исходной задачи; TemplateClone — шов copyTemplate, в который модуль складывает копирование
// СВОИХ настроек шаблона (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskForms, Execution, Filling, Field, SimpleExecution, ObjectRole, Time, StoreTaskStatus, StoreTaskType, TaskPerformer,
        TaskWatcher, TemplateClone;

NAMESPACE StoreTask;

onStarted () + {
    IF NOT taskType('corrective') THEN
        NEW t = TaskType { name(t) <- 'Корректирующее действие'; id(t) <- 'corrective'; }
}
loadDefaultData () + {
    IF NOT taskType('corrective') THEN
        NEW t = TaskType { name(t) <- 'Корректирующее действие'; id(t) <- 'corrective'; }
}
correctiveTaskType () = taskType('corrective');
isCorrective (Task t) = type(t) = correctiveTaskType();

mobileSubtitle(Task t) += ISTRING[100](name(t) IF isCorrective(t));

// корректирующее действие закрывается тем же простым выполнением, что и поручение,
// — и тем же экраном телефона (#36872)
executionKind(TaskType tt) += ISTRING[10]('simple' IF tt = correctiveTaskType());

sourceFilling = DATA Filling (Task);
sourceField   = DATA Field (Task);
nameSourceField 'Пункт' (Task t) = name(sourceField(t));
dateSource 'Дата проверки' (Task t) = toDate(dateTime(sourceFilling(t)));

startExecution(Task t) + {
    IF isCorrective(t) THEN {
        NEW se = SimpleExecution { task(se) <- t; }
        status(t) <- taskStatus('in progress');
        autoStatus(t) <- TRUE;
    }
}

assignByRole 'Роль для устранения' = DATA ObjectRole (Template);
deadlineDays 'Срок устранения, дн.' = DATA INTEGER (Template);
nameAssignByRole 'Роль для устранения' (Template t) = name(assignByRole(t));

CONSTRAINT deadlineDays(Template t) AND deadlineDays(t) <= 0
    MESSAGE 'Срок устранения должен быть больше нуля';

// Настройки корректирующих — при клонировании шаблона (TemplateClone). Здесь, а не в общем
// списке присваиваний: свойства объявлены тут, и правило копирования должно жить рядом с
// ними — иначе копия «чек-листа гипермаркета» тихо перестала бы заводить корректирующие.
copyTemplate (Template f, Template t) + {
    assignByRole(t) <- assignByRole(f);
    deadlineDays(t) <- deadlineDays(f);
}

resolved 'Устранено' = DATA BOOLEAN (Task);
resolvedDate 'Дата устранения' = DATA DATE (Task);
resolvedBy = DATA TaskPerformer (Task);
nameResolvedBy 'Устранил' (Task t) = name(resolvedBy(t));

WHEN LOCAL SET(resolved(Task t)) AND NOT CHANGED(resolvedDate(t)) DO
    resolvedDate(t) <- currentDate();
WHEN LOCAL SET(resolved(Task t)) AND NOT CHANGED(resolvedBy(t)) AND currentPerformer() DO
    resolvedBy(t) <- currentPerformer();
// снятый признак не должен оставлять за собой дату и автора устранения
WHEN LOCAL DROPPED(resolved(Task t)) DO {
    resolvedDate(t) <- NULL;
    resolvedBy(t) <- NULL;
}

// По факту завершения выполнения, а не по пересчёту succeeded — тот же разбор, что у
// соседнего события автозавершения в Execution: succeeded умеет меняться от правки
// настроек, и «устранено» не должно проставляться задним числом.
WHEN LOCAL SETCHANGED(state(Execution e)) AND finished(e) AND succeeded(e) AND isCorrective(task(e))
    AND NOT resolved(task(e)) AND NOT CHANGED(resolved(task(e))) DO {
        resolved(task(e)) <- TRUE;
        resolvedBy(task(e)) <- executor(e);
    }

existsCorrective (Filling e, Field f) =
    GROUP SUM 1 IF sourceFilling(Task t) = e AND sourceField(t) = f AND isCorrective(t);

// По ПУНКТУ семейства, а не по объекту поля (#37174): в новой редакции чек-листа тот же
// вопрос — другое поле, и по нему завелась бы вторая корректирующая на то же нарушение,
// пока первая ещё открыта.
pendingCorrective (CheckObject o, Field f) =
    GROUP SUM 1 IF isCorrective(Task t) AND checkObject(t) = o
                AND familyField(sourceField(t)) = familyField(f)
                AND opened(t) AND NOT resolved(t);

countCorrective 'Корректирующих задач' (Filling e) =
    GROUP SUM 1 IF sourceFilling(Task t) = e AND isCorrective(t);


needsCorrective (Filling e, Field f) =
    finished(e) AND nonconformity(e, f) AND template(f) = template(e)
    AND NOT existsCorrective(e, f)
    AND NOT pendingCorrective(checkObject(task(e)), f);

countNeedsCorrective 'К созданию' (Filling e) = GROUP SUM 1 IF needsCorrective(e, Field f);


createCorrective (Filling e) {
    FOR needsCorrective(e, Field f)
        NEW t = Task DO {
            type(t)         <- correctiveTaskType();
            // Статус, автор и номер — здесь, а не событиями StoreTaskCore (статус по типу и
            // автор — локальные, номер — глобальное нумератора): локальные события
            // выполняются один раз до применения, а глобальное нумератора стоит в порядке
            // применения раньше проведения, и задача, рождённая внутри глобального события —
            // реакцией проведения (onProceed ниже), — ни тех, ни этого не проходит.
            // Проверено на стенде: такая корректирующая оставалась без статуса (ни в одной
            // колонке доски; констрейнт на статус пустого не ловит), без автора и без
            // ST-номера. Из onFinish тот же код события проходит: они видят значения уже
            // записанными и молчат. Автор — кто проводит; в сессии без исполнителя
            // (регламент) — проверяющий, чьё это замечание.
            status(t)       <- firstTaskStatus(correctiveTaskType());
            autoStatus(t)   <- TRUE;
            author(t)       <- OVERRIDE currentPerformer(), executor(e);
            IF numeratorTask() AND NOT id(t) THEN assignIdTask(t);
            checkObject(t)  <- checkObject(task(e));
            name(t)         <- 'Устранить: ' + name(f);
            // исполнитель исходной задачи мог уйти в архив после назначения — на него
            // нельзя (StoreTaskCore); по роли архивных не отдаёт сам person()
            assignedTo(t)   <- (OVERRIDE person(checkObject(task(e)), assignByRole(template(e))), activePerformer(assignedTo(task(e))));
            deadline(t)     <- sum(toDate(dateTime(e)), deadlineDays(template(e)));
            sourceFilling(t) <- e;
            sourceField(t)   <- f;
            requirePhoto(t) <- TRUE;
            // Наблюдатели исходной задачи переходят на корректирующую (#37136). Следят за
            // проверкой ради того, чем она кончится, а найденное ею замечание — продолжение
            // той же истории: смежник, ждущий устранения, ждёт именно эту задачу. Без
            // наследования уведомление «создано корректирующее» наблюдателям не уходило вовсе
            // (у только что рождённой задачи подписчиков нет), а уйди оно — открыть задачу
            // было бы нельзя: видят её участники, наблюдатель исходной им не был.
            // Здесь, при создании, а не своим событием: уведомление наблюдателям
            // (NotificationFill) — событие на тот же SET, и наследование обязано случиться
            // раньше него. В блоке, где задача рождается, это верно по построению.
            watcher(t, TaskPerformer p) <- TRUE WHERE watcher(task(e), p);
            // Фото нарушения из проверки — фото ПРОБЛЕМЫ задачи, как снимок автора у задачи,
            // поставленной с телефона (#37183): видны в карточке (apiTasks.files — NOT inChat),
            // а не вложениями к реплике проверяющего. У снимка с телефона это выходит само:
            // defineTaskCommentsCreate(task, file) заводит пустое сообщение, и событие
            // defineTaskCommentsFiles цепляет файл к нему. Здесь же в той же сессии рождается
            // реплика с текстом, авто-сообщение подавлено её гвардом, и событие прицепило бы
            // снимки к реплике — а вложение сообщения с текстом лента считает своим (inChat),
            // и карточка телефона снимки теряла. Поэтому пустое сообщение под снимки заводится
            // явно, а явную привязку событие не трогает (NOT CHANGED). Оно идёт ПЕРЕД репликой:
            // последним сообщением сессии остаётся реплика — её текст и отсутствие снимка
            // берёт уведомление о комментарии (lastFeedComment).
            IF countPhoto(e, f) THEN {
                NEW pc = TaskComment {
                    task(pc) <- t;
                    FOR photo(e, f, INTEGER i) NEW tf = TaskFile DO {
                        task(tf) <- t;
                        comment(tf) <- pc;
                        file(tf) <- RAWFILE(photo(e, f, i));
                        name(tf) <- 'Фото нарушения ' + i;
                        extension(tf) <- 'jpg';
                    }
                }
            }
            // Реплика проверяющего по пункту — в переписку задачи. Рождена в одной сессии с
            // задачей, так что пустое авто-сообщение из defineTaskCommentsCreate(task, history)
            // подавлено его же гвардом («у t ещё нет нового сообщения»), и история рождения
            // задачи ложится в её собственные сообщения (событие сверяет задачу, #37183).
            IF comment(e, f) THEN
                NEW tc = TaskComment {
                    task(tc) <- t;
                    text(tc) <- RICHTEXT(comment(e, f));
                }
        }
}

onFinish (Filling e) + {
    createCorrective(e);
}

// Реакция проведения (#36987): по завершённой проверке закрытой задачи — задачи на
// устранение её замечаний, если их ещё нет. Обычно они уже есть: их заводит onFinish выше в
// сессии завершения, и это остаётся — непройденная проверка задачу не закрывает
// (succeeded = finished AND passed), а замечания у неё как раз есть. Здесь добираются
// проверки, чьё завершение через finishExecution не прошло — итог записан напрямую (сиды,
// загрузка истории), — и закрытые руками. Исход реакция читает сама: отменённая проверка
// задач на устранение не порождает. Повтор безопасен: needsCorrective не даёт второй задачи
// по замечанию, у которого она есть, — то же правило, что у кнопки «Создать корректирующие
// задачи». Задача рождается внутри глобального события — статус и автор ей ставятся явно
// (createCorrective).
onProceed (Task t) + {
    IF NOT canceledTask(t) THEN
        FOR task(Filling e) = t AND finished(e) DO
            createCorrective(e);
}

generateCorrective 'Создать корректирующие задачи' (Filling e) {
    IF NOT finished(e) THEN {
        MESSAGE 'Корректирующие задачи создаются по завершённой проверке';
        RETURN;
    }
    APPLY;
    IF canceled() THEN RETURN;
    IF NOT countNeedsCorrective(e) THEN {
        MESSAGE 'По всем несоответствиям задачи на устранение уже есть';
        RETURN;
    }
    NEWSESSION {
        MESSAGE 'Будет создано корректирующих задач: ' + countNeedsCorrective(e);
        createCorrective(e);
        APPLY;
    }
}

openSourceFilling 'Исходная проверка' (Task t) {
    IF sourceFilling(t) THEN
        SHOW filling OBJECTS e = sourceFilling(t) DOCKED NEWSESSION;
}

sourcePhoto 'Фото нарушения' (Task t) = firstPhoto(sourceFilling(t), sourceField(t));

EXTEND FORM template
    PROPERTIES(t) nameAssignByRole, deadlineDays
;

DESIGN template {
    header {
        NEW corrective {
            horizontal = TRUE;
            caption = 'Корректирующие действия';
            MOVE PROPERTY(nameAssignByRole(t));
            MOVE PROPERTY(deadlineDays(t));
        }
    }
}

EXTEND FORM filling
    PROPERTIES(e) generateCorrective SHOWIF finished(e),
                  countCorrective READONLY, countNeedsCorrective READONLY SHOWIF countNeedsCorrective(e)

    OBJECTS ct = Task
    PROPERTIES(ct) READONLY id, nameSourceField, name, nameAssignedTo, nameStatus,
                            deadline, resolved, resolvedDate
    PROPERTIES(ct) TOOLBAR openSimpleExecution
    PROPERTIES(ct) NEWSESSION EDIT
    FILTERS sourceFilling(ct) = e AND isCorrective(ct)
    ORDERS deadline(ct)
;

DESIGN filling {
    OBJECTS {
        NEW corrective {
            caption = 'Корректирующие задачи';
            fill = 1;
            alignment = STRETCH;
            NEW correctiveTop {
                horizontal = TRUE;
                MOVE PROPERTY(countCorrective(e));
                MOVE PROPERTY(countNeedsCorrective(e));
                MOVE PROPERTY(generateCorrective(e));
            }
            MOVE BOX(ct) { caption = ''; fill = 1; }
        }
    }
}

EXTEND FORM task
    PROPERTIES(t) READONLY nameSourceField SHOWIF isCorrective(t),
                           dateSource SHOWIF isCorrective(t),
                           resolvedDate SHOWIF isCorrective(t),
                           nameResolvedBy SHOWIF isCorrective(t)
    PROPERTIES(t) resolved SHOWIF isCorrective(t)

    PROPERTIES(t) requirePhoto SHOWIF isCorrective(t)
    PROPERTIES(t) READONLY sourcePhoto SHOWIF sourcePhoto(t)
    PROPERTIES(t) openSourceFilling SHOWIF sourceFilling(t)
;

DESIGN task {
    header {
        NEW corrective {
            caption = 'Корректирующее действие';
            horizontal = TRUE;
            alignment = STRETCH;
            NEW correctiveInfo {
                fill = 1;
                lines = 3;
                MOVE PROPERTY(nameSourceField(t));
                MOVE PROPERTY(dateSource(t));
                MOVE PROPERTY(openSourceFilling(t));
                MOVE PROPERTY(requirePhoto(t));
                MOVE PROPERTY(resolved(t));
                MOVE PROPERTY(resolvedDate(t));
                MOVE PROPERTY(nameResolvedBy(t));
            }
            MOVE PROPERTY(sourcePhoto(t)) { valueHeight = 120; valueWidth = 160; }
        }
    }
}
