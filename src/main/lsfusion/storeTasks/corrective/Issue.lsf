MODULE Issue;

// Execution — за executionKind (транзитивному REQUIRE не доверять)
// Также StoreTaskCore — status/mobileSubtitle/type; StoreTaskStatus — taskStatus;
// StoreTaskType — taskType; StoreTaskForms — карточка task, которую модуль расширяет;
// StoreTaskSettings — seedRequiredData (транзитивному REQUIRE не доверять)
REQUIRE SimpleExecution, Execution, StoreTaskCore, StoreTaskForms, StoreTaskStatus, StoreTaskType, StoreTaskSettings;

NAMESPACE StoreTask;

seedRequiredData () + {
    IF NOT taskType('issue') THEN
        NEW t = TaskType { name(t) <- 'Поручение'; id(t) <- 'issue'; }
}
issueTaskType () = taskType('issue');
isIssue (Task t) = type(t) = issueTaskType();

mobileSubtitle(Task t) += ISTRING[100](name(t) IF isIssue(t));

// поручение выполняется фотоотчётом — телефон открывает его простым экраном (#36872)
executionKind(TaskType tt) += ISTRING[10]('simple' IF tt = issueTaskType());

startExecution(Task t) + {
    IF isIssue(t) THEN {
        NEW se = SimpleExecution { task(se) <- t; }
        status(t) <- taskStatus('in progress');
        autoStatus(t) <- TRUE;
    }
}

EXTEND FORM task
    // v6: requirePhoto добавлялся к форме task и здесь, и в Corrective.lsf — 6.2 запрещает
    // повторное добавление («was already defined»). Оставлено одно добавление в Corrective.lsf
    // с объединённым условием isCorrective(t) OR isIssue(t).
    PROPERTIES(t) TOOLBAR openSimpleExecution SHOWIF isIssue(t)
;
