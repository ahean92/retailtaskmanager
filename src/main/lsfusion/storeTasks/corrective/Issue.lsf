MODULE Issue;

// Execution — за executionKind (транзитивному REQUIRE не доверять)
REQUIRE SimpleExecution, Execution;

NAMESPACE StoreTask;

onStarted () + {
    IF NOT taskType('issue') THEN
        NEW t = TaskType { name(t) <- 'Поручение'; id(t) <- 'issue'; }
}
loadDefaultData () + {
    IF NOT taskType('issue') THEN
        NEW t = TaskType { name(t) <- 'Поручение'; id(t) <- 'issue'; }
}
issueTaskType () = taskType('issue');
isIssue (Task t) = type(t) = issueTaskType();

mobileSubtitle(Task t) += ISTRING[100](name(t) IF isIssue(t));

// поручение выполняется фотоотчётом — телефон открывает его простым экраном (#36872)
executionKind(TaskType tt) += ISTRING[10]('simple' IF tt = issueTaskType());

startExecution(Task t) + {
    IF isIssue(t) THEN {
        NEW se = SimpleExecution { task(se) <- t; }
        status(t) <- taskStatus('in progress');
    }
}

EXTEND FORM task
    PROPERTIES(t) requirePhoto SHOWIF isIssue(t)
    PROPERTIES(t) TOOLBAR openSimpleExecution SHOWIF isIssue(t)
;
