MODULE StoreTaskHypothesisLib;

// Проверка гипотез о данных ERP: человек формулирует гипотезу словами, LLM по исходникам
// развёрнутой сборки пишет код её проверки, человек читает код и утверждает, дальше
// проверка живёт в расписании и порождает задачи. Данные в модель не уезжают: она видит
// исходники и текст гипотезы, а входные и выходные данные трогает только подготовленный
// код — уже на стороне ERP.
//
// Пакет над ядром, как и остальные четыре: ядру о нём знать незачем, а ему от ядра нужны
// исполнители (автор гипотезы), навигатор и приёмка заявок.
REQUIRE StoreTaskCoreLib, StoreTaskIntakeLib,
        // контракт «куда пишет код проверки» — отдельным модулем: его текст целиком
        // уезжает в подсказку для модели
        HypothesisContract,
        // гипотеза, версия проверки, утверждение
        Hypothesis,
        // прогон: EVAL, воронка, находки
        HypothesisRun,
        HypothesisForms,
        // журнал обращений к генератору: попытки, починки, ходы, деньги
        HypothesisJob,
        // код проверки от агента claude cli через ai-service
        HypothesisAi,
        // находки -> задачи через приёмку заявок
        HypothesisTask,
        // утверждённая проверка по периоду
        HypothesisSchedule;

NAMESPACE StoreTask;
