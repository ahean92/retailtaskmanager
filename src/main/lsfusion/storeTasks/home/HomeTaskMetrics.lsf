MODULE HomeTaskMetrics;

// HomeScreen — HomeBlock/HomeMetric, их поля и перечисления, calcValue (точка расширения),
// homeBlock; StoreTaskCore — Task, opened/checkObject/overdueTask/dueTodayTask;
// StoreTaskTakeover — mine; Authentication — currentUser; CheckObject — CheckObject;
// DefaultData — loadDefaultData (транзитивному REQUIRE не доверять)
REQUIRE HomeScreen, StoreTaskCore, StoreTaskTakeover, Authentication, CheckObject, DefaultData;

NAMESPACE StoreTask;

// ===== Задачи на главной: встроенные показатели и главная по умолчанию. =====
// Каркас главной (HomeScreen) о задачах не знает — здесь та реализация calcValue, которая
// считает «моих» задач по сети и по объекту, и сид главной на чистой базе: блок «Мои задачи»
// и сводка из этих трёх показателей. Показатель на других данных подключается таким же
// отдельным += — из модуля интеграции с ERP, например, — не трогая ни каркас, ни этот модуль.

// Встроенные показатели по задачам исполнителя — по сети. «Моя» здесь — mine(), а не
// видимость: после иерархии (#36835) assignedTo(t, u) — это весь пул подразделения, и
// плитка «6 задач» разошлась бы со списком, где своих у человека две. Тот же дефект
// доверия, что уже разбирали в #36751.
calcValue (HomeMetric m) += WHEN code(m) = 'myOpen' THEN
    (GROUP SUM 1 IF opened(Task t) AND mine(t, currentUser()));
calcValue (HomeMetric m) += WHEN code(m) = 'myOverdue' THEN
    (GROUP SUM 1 IF opened(Task t) AND mine(t, currentUser()) AND overdueTask(t));
calcValue (HomeMetric m) += WHEN code(m) = 'myToday' THEN
    (GROUP SUM 1 IF opened(Task t) AND mine(t, currentUser()) AND dueTodayTask(t));

// ... и они же по одному объекту. Ноль выписан явно: GROUP SUM на пустой выборке даёт
// NULL, NULL выпадает из экспорта, и клиент откатился бы на сетевую цифру — плитка в
// магазине без задач показала бы «6 здесь · 6 всего» вместо «0 здесь · 6 всего».
// «Задач нет» — это не отсутствие данных, это ноль; отсутствием данных NULL остаётся
// у внешних показателей (dataValue), где магазин без числа и правда ничего не прислал.
calcValue (HomeMetric m, CheckObject o) += WHEN code(m) = 'myOpen' AND o IS CheckObject THEN
    (OVERRIDE (GROUP SUM 1 IF opened(Task t) AND mine(t, currentUser()) AND checkObject(t) = o), 0);
calcValue (HomeMetric m, CheckObject o) += WHEN code(m) = 'myOverdue' AND o IS CheckObject THEN
    (OVERRIDE (GROUP SUM 1 IF opened(Task t) AND mine(t, currentUser()) AND checkObject(t) = o AND overdueTask(t)), 0);
calcValue (HomeMetric m, CheckObject o) += WHEN code(m) = 'myToday' AND o IS CheckObject THEN
    (OVERRIDE (GROUP SUM 1 IF opened(Task t) AND mine(t, currentUser()) AND checkObject(t) = o AND dueTodayTask(t)), 0);

// главная по умолчанию на чистой базе (идемпотентно)
loadDefaultData () + {
    IF NOT homeBlock('myTasks') THEN
        NEW b = HomeBlock {
            code(b) <- 'myTasks'; type(b) <- HomeBlockType.tasks;
            title(b) <- 'Мои задачи'; icon(b) <- '📋'; blockOrder(b) <- 1; active(b) <- TRUE;
        }
    IF NOT homeBlock('myKpi') THEN
        NEW b = HomeBlock {
            code(b) <- 'myKpi'; type(b) <- HomeBlockType.metrics; view(b) <- MetricView.tiles;
            title(b) <- 'Сводка'; icon(b) <- '📊'; blockOrder(b) <- 2; active(b) <- TRUE;
            // в разрезе магазина: плитка отвечает «что делать здесь», а сетевая цифра
            // добирается второй половиной — «1 здесь · 6 всего». На уже развёрнутой базе
            // блок существует и сюда не попадает — там флаг ставится в настройке главной.
            byObject(b) <- TRUE;
            NEW m = HomeMetric {
                block(m) <- b; code(m) <- 'myOpen'; name(m) <- 'Открытых'; metricOrder(m) <- 1;
                taskFilter(m) <- HomeTaskFilter.open; mineOnly(m) <- TRUE; active(m) <- TRUE;
            }
            NEW m = HomeMetric {
                block(m) <- b; code(m) <- 'myToday'; name(m) <- 'На сегодня'; metricOrder(m) <- 2;
                taskFilter(m) <- HomeTaskFilter.today; mineOnly(m) <- TRUE; active(m) <- TRUE;
            }
            NEW m = HomeMetric {
                block(m) <- b; code(m) <- 'myOverdue'; name(m) <- 'Просрочено'; metricOrder(m) <- 3;
                color(m) <- '#D9342B'; taskFilter(m) <- HomeTaskFilter.overdue; mineOnly(m) <- TRUE;
                inverse(m) <- TRUE; active(m) <- TRUE;
            }
        }
}
