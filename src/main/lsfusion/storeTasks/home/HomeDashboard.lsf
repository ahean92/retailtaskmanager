MODULE HomeDashboard;

// Authentication — currentUser; StoreTaskCore — opened/mine/overdueTask/dueTodayTask;
// StoreTaskSettings — папка storeTask (транзитивному REQUIRE не доверять)
REQUIRE HomeScreen, Authentication, StoreTaskCore, StoreTaskSettings;

NAMESPACE StoreTask;

// Переход с плитки дашборда в список задач. В форму едет сам показатель, а не значение
// перехода: он знает и вид фильтра, и чьи задачи считал (mineOnly), — а цифра на плитке и
// список за ней обязаны сходиться. Открытая из навигатора форма показателя не получает, и
// тогда всё пропускает первая ветка фильтра.
//
// BEFORE t — не косметика. Фильтр формы применяется к той группе объектов, которая в
// порядке групп идёт последней среди использованных им; dm, дописанный в конец, забирал
// фильтр себе. Фильтровался невидимый список показателей, а список задач оставался
// нетронутым — «Просрочено» открывало все открытые задачи. Тем же приёмом и по той же
// причине заведён tst в @defineTaskStatusChangeForm.
EXTEND FORM tasks
    OBJECTS dm = HomeMetric PANEL NULL BEFORE t
    FILTERS NOT (dm IS HomeMetric)
        OR (((taskFilter(dm) = HomeTaskFilter.open AND opened(t))
                OR (taskFilter(dm) = HomeTaskFilter.today AND opened(t) AND dueTodayTask(t))
                OR (taskFilter(dm) = HomeTaskFilter.overdue AND opened(t) AND overdueTask(t)))
            AND (NOT mineOnly(dm) OR mine(t, currentUser())))
;

// Показателю без перехода кнопка не открывает ничего: пустой объект в OBJECTS без пометки
// NULL гасит действие целиком, и это ровно то, что нужно — «Выручка» в список задач не
// ведёт. Без гварда список открылся бы пустым: ни одна ветка фильтра не сработала бы.
openTasks 'Открыть задачи' (HomeMetric m) {
    SHOW tasks OBJECTS dm = (m IF taskFilter(m));
}

titleBlock 'Блок' (HomeMetric m) = title(block(m));
blockPos 'Блок №' (HomeMetric m) = blockOrder(block(m));
percentOfTarget 'К плану, %' (HomeMetric m) = NUMERIC[6,2](100 * value(m) / target(m)) IF target(m);

FORM homeDashboard 'Дашборд'
    OBJECTS m = HomeMetric
    PROPERTIES(m) READONLY blockPos, metricOrder, titleBlock, name, value, unit, previous, target, percentOfTarget
    PROPERTIES(m) openTasks TOOLBAR
    FILTERS active(m) AND visible(block(m))
    ORDERS blockPos(m), metricOrder(m)

    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, name

    OBJECTS mo = HomeMetric
    PROPERTIES value(mo, o) READONLY COLUMNS (mo) HEADER name(mo)
    FILTERS byObject(block(mo)) AND active(mo) AND visible(block(mo))
;

DESIGN homeDashboard {
    OBJECTS {
        MOVE BOX(m) { caption = 'Показатели'; fill = 2; }
        MOVE BOX(o) { caption = 'По объектам'; fill = 3; }
    }
}

NAVIGATOR {
    storeTask {
        NEW homeDashboard FIRST;
    }
}
