MODULE HomeDashboard;

// Authentication — currentUser; StoreTaskCore — opened/overdueTask/dueTodayTask/onAcceptance;
// StoreTaskTakeover — mine; StoreTaskAcceptance — canDecide («ждут моего решения», #37157);
// StoreTaskForms — форма tasks, в которую ведёт переход с плитки;
// StoreTaskSettings — папка storeTask; CheckObject — isPlace/archived, отбор объектов разреза;
// StoreTaskKanban — доска tk, на которую переход с плитки действует так же (транзитивному REQUIRE не доверять)
REQUIRE HomeScreen, Authentication, StoreTaskCore, StoreTaskTakeover, StoreTaskAcceptance, StoreTaskForms,
        StoreTaskSettings, CheckObject, StoreTaskKanban;

NAMESPACE StoreTask;

// Переход с плитки дашборда в список задач. В форму едут вид перехода, «только мои» и тип
// показателя: они знают и вид фильтра, и чьи задачи считал показатель (mineOnly), — а цифра
// на плитке и список за ней обязаны сходиться. Открытая из навигатора форма их не получает,
// и тогда всё пропускает первая ветка фильтра.
//
// «Ждут приёмки» (#37157) — своей веткой: «свои» у него не mine (сданная у исполнителя не
// «моя»), а «ждёт моего решения» среди задач, где я участник, — canDecide и participant, как у
// плитки исполнителя (HomeTaskMetrics).
tileFilter = DATA LOCAL HomeTaskFilter ();
tileMineOnly = DATA LOCAL BOOLEAN ();
tileTaskType = DATA LOCAL TaskType ();

inTileFilter (Task t) = CASE
    WHEN NOT tileFilter() THEN t IS Task
    WHEN tileFilter() = HomeTaskFilter.acceptance THEN onAcceptance(t)
        AND (NOT tileMineOnly() OR (canDecide(t, currentUser()) AND participant(t, currentUser())))
    WHEN tileFilter() = HomeTaskFilter.open THEN opened(t)
        AND (NOT tileMineOnly() OR mine(t, currentUser()))
    WHEN tileFilter() = HomeTaskFilter.today THEN opened(t) AND dueTodayTask(t)
        AND (NOT tileTaskType() OR type(t) = tileTaskType())
        AND (NOT tileMineOnly() OR mine(t, currentUser()))
    WHEN tileFilter() = HomeTaskFilter.overdue THEN opened(t) AND overdueTask(t)
        AND (NOT tileMineOnly() OR mine(t, currentUser()));

EXTEND FORM tasks
    FILTERS inTileFilter(t)
    FILTERS inTileFilter(tk)
;

// Показателю без перехода кнопка не открывает ничего: «Выручка» в список задач не ведёт.
openTasks 'Открыть задачи' (HomeMetric m) {
    IF taskFilter(m) THEN NEWSESSION {
        tileFilter() <- taskFilter(m);
        tileMineOnly() <- mineOnly(m);
        tileTaskType() <- metricTaskType(m);
        SHOW tasks NOWAIT;
    }
}

titleBlock 'Блок' (HomeMetric m) = title(block(m));
blockPos 'Блок №' (HomeMetric m) = blockOrder(block(m));
percentOfTarget 'К плану, %' (HomeMetric m) = NUMERIC[6,2](100 * value(m) / target(m)) IF target(m);

FORM homeDashboard 'Дашборд'
    OBJECTS m = HomeMetric
    PROPERTIES(m) READONLY blockPos, metricOrder, titleBlock, name, value, unit, previous, target, percentOfTarget
    PROPERTIES(m) openTasks TOOLBAR DISABLEIF NOT taskFilter(m)
    FILTERS active(m) AND visible(block(m))
    ORDERS blockPos(m), metricOrder(m)

    // Разрез — по местам, как выбор объекта на телефоне (HomeApi): касса и весы стоят внутри
    // магазина, и в разрезе их числа — шум; закрытый магазин — тоже
    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, name
    FILTERS isPlace(o) AND NOT archived(o)

    // колонки показателей — в том же порядке, что строки слева и плитки на телефоне
    OBJECTS mo = HomeMetric
    PROPERTIES(mo) READONLY metricOrder SHOWIF NULL // v6: ORDERS требует draw на форме
    PROPERTIES value(mo, o) READONLY COLUMNS (mo) HEADER name(mo)
    FILTERS byObject(block(mo)) AND active(mo) AND visible(block(mo))
    ORDERS metricOrder(mo)
;

DESIGN homeDashboard {
    OBJECTS {
        MOVE BOX(m) { caption = 'Показатели'; fill = 2; }
        MOVE BOX(o) { caption = 'По объектам'; fill = 3; }
    }
}

NAVIGATOR {
    storeTask {
        NEW homeDashboard FIRST IMAGE 'fa-solid fa-gauge-high';
    }
}
