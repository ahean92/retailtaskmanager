MODULE PulseRail;

// Подписи левого навигатора: разделы без иконок, пункты — короткими названиями. Только вид:
// состав меню собирают модули, которые объявляют пункты, а цвета и отступы — платформа.
// StoreTaskSettings — разделы operations/catalogs/reports/settings; StoreTaskForms — пункт
// tasks; CheckAsset, Template, TaskUnit — пункты checkAssets, templates, taskUnits
// (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskSettings, StoreTaskForms, CheckAsset, Template, TaskUnit;

NAMESPACE StoreTask;

NAVIGATOR {
    // NOIMAGE — у заголовка раздела иконка только шумит: смысл несёт текст, а место
    // иконки нужно, чтобы подпись встала по одной вертикали с иконками своих же
    // пунктов. Снимается здесь, на сервере, а не правилом в CSS.
    operations NOIMAGE;
    catalogs NOIMAGE;
    reports NOIMAGE;
    settings NOIMAGE;

    // Подписи статические: счётчик в HEADER (просрочка на «Задачах», размеры справочников)
    // 6.2 не компилирует — навигаторное чтение один безключевой SELECT, и батч из
    // нескольких GROUP SUM падает «Операция над множеством некорректна».
    tasks HEADER 'Задачи';
    checkAssets HEADER 'Объекты проверки';
    templates HEADER 'Шаблоны';
    taskUnits HEADER 'Подразделения';
}
