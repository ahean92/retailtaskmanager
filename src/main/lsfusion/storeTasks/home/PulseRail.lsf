MODULE PulseRail;

REQUIRE StoreTaskSettings, StoreTaskCore, SupervisorMetrics, CheckAsset, Template, TaskUnit, SystemEvents;

NAMESPACE StoreTask;

// ===== Левый навигатор «Пульс» =====
// Окно toolbar рисует свой React-компонент (web/storeTasks/pulseNav.js): разделы
// подписями вместо аккордеонов, счётчики у правого края, свои отступы. Платформенной
// отрисовкой этого не добиться — подпись она ужимает по содержимому, а папку
// показывает раскрывающимся узлом.
//
// Компонент, а не HTML-шаблон окна (второй способ, который платформа тоже даёт):
// шаблон расставляет элементы по местам <Lsf:имя/>, то есть перечисляет их поимённо,
// а меню у нас собирают модули — пункт очередного не появился бы, пока кто-нибудь не
// вспомнит про правку шаблона. Компонент обходит root/children и о новых пунктах
// узнаёт сам. Тот же довод, по которому главная мобильного собирается из
// блоков-данных, а не зашивается в клиент.
//
// Статус: прототип на десктоп. Что НЕ пострадало — мобильный вид платформа выбирает
// раньше кастомного (getNavigatorWidgetView отдаёт mobileViews при MainFrame.mobile),
// а открепление и всплытие ReactNavigatorView наследует от ParkedNavigatorView; нашей
// стала только отрисовка. Что осталось непокрытым — свёрнутый режим «только иконки»:
// подпись там прячет платформенное правило по классу .nav-link, которого у наших
// элементов нет.

onWebClientInit() + {
    onWebClientInit('storeTasks/pulseNav.js') <- 1;
    onWebClientInit('storeTasks/pulseRail.css') <- 1;
}

// Имя в UpperCamel платформа понимает как React-компонент (Custom.isReactComponent);
// сам React везёт платформа — web/react/*.min.js лежат в сборке.
EXTEND WINDOW toolbar CUSTOM 'PulseNav';

// Верхняя панель — не одно окно, а три: logo (логотип), root (корневые разделы
// вкладками) и system (тема, закрепление, дизайн, администрирование, учётная запись,
// поиск). Каждое берётся отдельно, тем же способом.
//
// Оговорка, которую стоит помнить при обновлении платформы: наш здесь только корень
// storeTask в окне root. Логотип и всё содержимое system объявлены платформой
// (SystemEvents, System, Authentication, Security), и теперь их вид определяет эта
// библиотека — для любого хоста, который её подключит. Появится в system новый
// платформенный пункт — он приедет сам (компонент обходит root, а не список имён),
// но выглядеть будет по-нашему.
EXTEND WINDOW logo CUSTOM 'PulseLogo';
EXTEND WINDOW root CUSTOM 'PulseRoot';
EXTEND WINDOW system CUSTOM 'PulseSystem';

// ---- счётчик на «Задачах» ----
// Считается ровно то, что откроется по клику. Форма tasks показывает открытые задачи
// по всей сети (фильтры «Мои» / «Назначенные мне» — необязательные, по умолчанию
// выключены), поэтому здесь сетевой overdue() из SupervisorMetrics, а не счёт по
// mine(). Счётчик, расходящийся со списком, который он открывает, — это дефект
// доверия #36751 в чистом виде, только теперь в меню.
//
// Ноль не показывается вовсе: пустая плашка «0» — шум, делающий вид, что о нём нужно
// помнить.
badge (INTEGER n, STRING[10] kind) =
    (' <span class="pulse-badge pulse-badge-' + kind + '">' + STRING[10](n) + '</span>') IF n > 0;

// ---- размеры справочников ----
// Серым, а не цветом, и в этом вся разница: красная плашка на «Задачах» зовёт открыть
// пункт, а «10» на объектах — просто масштаб, чтобы не открывать справочник ради
// вопроса «сколько их вообще».
//
// Считается ровно то, что откроется: у шаблонов и подразделений в форме включён по
// умолчанию фильтр «активные», поэтому архивные в счёт не идут. У объектов проверки
// фильтра нет — там все.
countAssets () = GROUP SUM 1 IF CheckAsset a IS CheckAsset;
countTemplates () = GROUP SUM 1 IF active(Template t);
countUnits () = GROUP SUM 1 IF active(TaskUnit u);

// HEADER заменяет подпись элемента целиком, поэтому название пишется здесь же.
// CONCAT '' — чтобы при нулевом счётчике осталось одно название, а не «Задачи» с
// хвостом NULL; закрывающие теги литералы, они остаются в любом случае.
//
// Название заворачивается в свой span, чтобы длинная подпись обрезалась многоточием,
// а счётчик рядом оставался целым: строку пункта раскладывает флексом PulseNav, и обе
// части должны быть его элементами, а не текстовым узлом и элементом.
caption (STRING[60] title, STRING n) = CONCAT '', '<span class="pulse-title">', title, '</span>', n;

headerTasks () = caption('Задачи', badge(overdue(), 'crit'));
headerAssets () = caption('Объекты проверки', badge(countAssets(), 'mute'));
headerTemplates () = caption('Шаблоны', badge(countTemplates(), 'mute'));
headerUnits () = caption('Подразделения', badge(countUnits(), 'mute'));

NAVIGATOR {
    // NOIMAGE — у заголовка раздела иконка только шумит: смысл несёт текст, а место
    // иконки нужно, чтобы подпись встала по одной вертикали с иконками своих же
    // пунктов. Снимается здесь, на сервере, а не правилом в CSS.
    operations NOIMAGE;
    catalogs NOIMAGE;
    reports NOIMAGE;
    settings NOIMAGE;

    tasks HEADER headerTasks();
    checkAssets HEADER headerAssets();
    templates HEADER headerTemplates();
    taskUnits HEADER headerUnits();
}
