MODULE PulseForm;

REQUIRE StoreTaskCore, StoreTaskForms, GeoLog, SystemEvents,
        // модули, которые досыпают свои колонки в «Задачи»: чтобы их убрать,
        // надо загрузиться после них
        ScheduleForms, Execution, ObjectRole,
        // канбан перестраивает «Задачи» под себя; чтобы наша лента фильтров легла
        // поверх его раскладки, а не под неё, загружаемся после
        StoreTaskKanban;

NAMESPACE StoreTask;

// ===== Режимы грида =====
// Формы не перерисовываются компонентом: их десятки, они собираются из .lsf, и
// заменить отрисовку значило бы переписать грид, редакторы ячеек, фильтры и
// сортировку — всё, что платформа уже умеет. Здесь только стили поверх её классов.
//
// Но одного вида на все гриды не бывает. Реестр важных объектов и журнал однотипных
// записей — разные задачи чтения: в первом строк немного и в каждой надо
// разобраться, во втором их сотни и нужен объём. Поэтому режим объявляет сама форма,
// одной строкой:
//
//     @pulseGridRegistry(tasks, t);     // задачи, объекты проверки, шаблоны
//     @pulseGridLog(geoRequests, r);    // координаты, AI-запросы, доставки
//     @pulseCard(task, pane);           // карточка: подпись над полем
//     @pulseCardMain(task, leftPane);  // колонка, отдающая ширину соседней
//     @pulseFilterBar(tasks, t);       // наборы фильтров лентой над списком
//
// Форма, которая не сказала ничего, остаётся в платформенном виде — раскатка на все
// гриды поэтому безопасна: ничего не меняется, пока не попросят.
//
// Названия по назначению, а не по размеру: автор формы утверждает, ЧТО у него за
// данные, а как это выглядит — решает pulseForm.css и может менять, не трогая формы.
onWebClientInit() + {
    onWebClientInit('storeTasks/pulseForm.css') <- 1;
}

// Класс ставится на контейнер группы объектов. Свойство называется именно `class`:
// ViewProxyUtil обрабатывает его отдельной веткой, поле elementClass по имени не
// пишется («property doesn't exist»). На ГЛАВНОМ контейнере формы класс до DOM не
// доходит — проверено, — а на контейнере группы объектов доходит.
//
// Два метакода вместо одного с параметром-режимом: подстановка ## внутрь строковой
// константы ненадёжна, а выигрыш от одного лишнего аргумента того не стоит.
META pulseGridRegistry(form, obj)
    DESIGN form {
        BOX(obj) { class = 'pulse-grid pulse-grid-registry'; }
    }
END

META pulseGridLog(form, obj)
    DESIGN form {
        BOX(obj) { class = 'pulse-grid pulse-grid-log'; }
    }
END

// Фильтры лентой над списком, а не колонкой справа. Наборы фильтров — это
// переключатели над данными, и место им там, где на данные смотрят: сверху, в одну
// строку. Справа они стоили ширины: панель занимала 260 пикселей на все 774 пикселя
// высоты, а содержимого в ней было на 126 — остальное пустота, вычтенная из списка.
META pulseFilterBar(form, obj)
    DESIGN form {
        BOX(obj) {
            NEW pulseFilters FIRST {
                horizontal = TRUE;
                alignment = STRETCH;
                class = 'pulse-filter-bar';
                MOVE FILTERGROUPS(obj) { horizontal = TRUE; };
            }
        }
        // Опустевшая колонка не должна забирать ширину: со своим fill она растянулась
        // бы на свободное место впустую.
        rightPane { fill = 0; }
    }
END

// Карточка: подпись над полем. Контейнер параметром — режим не привязан ни к форме,
// ни к её устройству, и вешается на любой уровень: на корневой контейнер формы или
// на отдельный блок внутри.
META pulseCard(form, container)
    DESIGN form {
        container { class = 'pulse-card'; }
    }
END

// Основная колонка карточки — та, что отдаёт ширину соседней. Нужна, когда рядом
// стоит колонка заданной ширины (у нас — «Обсуждение»): контейнер карточки разложен
// флексом С ПЕРЕНОСОМ, а перенос считается по ЖЕЛАЕМЫМ ширинам, ДО сжатия. Основная
// колонка желает ширину своего содержимого — под тысячу пикселей, — соседка на строку
// не помещается и уезжает вниз, под карточку. Класс обнуляет это желание: колонка
// по-прежнему растягивается на всё свободное, но больше не выталкивает соседку.
META pulseCardMain(form, container)
    DESIGN form {
        container { class = 'pulse-card-main'; }
    }
END

// ---- применение ----

@pulseGridRegistry(tasks, t);

// Журнал координат — контрастный пример: те же базовые правила, но без карточек,
// с мелким кеглем и плотными полями.
@pulseGridLog(geoRequests, r);

// Журналы внутри карточки задачи: выполнения, история правок, смена статуса. Это
// записи о том, что произошло — однотипные, их накапливается много, и читают их
// объёмом, а не по одной.
@pulseGridLog(task, e);
@pulseGridLog(task, taskl);
@pulseGridLog(task, stch);

// Файлы — тоже журнал, хотя раньше я решил иначе. Довод «строк единицы, и каждую
// открывают» оказался слабее устройства самого грида: восемь колонок в шестистах
// пикселях, и подписи рвутся на три строки. Режим журнала снимает иконку из шапки и
// ужимает разрядку — то есть лечит ровно узкие колонки, из-за которых список и был
// тесным.
@pulseGridLog(task, of);

// Карточка задачи. Контейнер pane объявлен в DESIGN task (StoreTaskCore) и включает
// обе колонки формы.
@pulseCard(task, pane);
@pulseCardMain(task, leftPane);

// ---- график проверок ----
// Цвет ячейки — единственное, что несёт смысл на этом экране, и до сих пор он ничего
// не объяснял: розовый мог значить и «просрочено», и «сделано». Легенда под матрицей.
//
// Цвета продублированы из backgroundAt (StoreTaskSchedule): там они заданы литералами
// в CASE и переиспользовать их нечем. Меняете там — поменяйте здесь; других мест нет.
scheduleLegend 'Обозначения' () = HTMLTEXT(
    '<span class="pulse-legend">'
  + '<b style="background:rgb(200,220,255)"></b>в работе'
  + '<b style="background:rgb(255,200,200)"></b>срок прошёл'
  + '<b style="background:rgb(200,255,200)"></b>выполнена'
  + '<b style="background:rgb(255,240,150)"></b>запланирована правилом'
  + '<b style="background:rgb(242,243,245)"></b>выходной'
  + '</span>');

EXTEND FORM scheduleOverview
    PROPERTIES() READONLY scheduleLegend
;

// Матрица «объект × день месяца»: тридцать узких колонок и несколько строк. По задаче
// чтения это журнал — плотность здесь и есть смысл экрана, месяц должен помещаться
// целиком.
@pulseGridLog(scheduleOverview, o);

DESIGN scheduleOverview {
    // Управление собирается в одну строку над матрицей. Было три места: фильтры
    // сверху, интервал — отдельным блоком со своим заголовком-группой («Интервал дат»
    // над полем «Интервал дат»), и уже под ними матрица. Три полосы на три контрола.
    OBJECTS {
        NEW pulseControls FIRST {
            horizontal = TRUE;
            alignment = STRETCH;
            class = 'pulse-filter-bar';
            MOVE PROPERTY(nameCategoryFilter());
            MOVE PROPERTY(nameTaskTypeFilter());

            // Интервал не помещался и обрывался на «30.09.202»: платформа считает
            // ширину по числу знаков типа, а два срока с разделителем в неё не влезают.
            MOVE PROPERTY(dates) { charWidth = 26; }
        }
    }

    // Код объекта убран: «i44», «b05», «m51» — служебные обозначения, по которым
    // объект не узнают, а имя («Санта №44, Луницец») и так уникально. Восемьдесят
    // восемь пикселей уходят дням, которых тридцать.
    REMOVE PROPERTY(id(o));

    // Заголовок группы «Объект проверки» снят: он стоял строкой над матрицей и
    // повторял то, что и так написано на вкладке формы. Строка экрана за слово,
    // которое ничего не добавляет.
    BOX(o) { caption = ''; }

    // Легенда под матрицей, без подписи: строка сама себя объясняет.
    MOVE PROPERTY(scheduleLegend()) { caption = ''; }
}

// ---- фильтры «Задач»: лента над обоими видами ----
// У формы теперь две вкладки — «Список» и «Канбан» (StoreTaskKanban), и набор фильтров
// на них ОДИН: канбан отбирает записи по фильтрам списка. Поэтому «развести по
// вкладкам» не выходит буквально — контейнер живёт в одном месте, и уехав в «Список»,
// фильтры пропали бы с канбана, хотя продолжали бы на него действовать. Худший из
// возможных вариантов: настройка работает, но её не видно.
//
// Лента ставится НАД вкладками — там она обслуживает оба вида сразу и никому не
// принадлежит. Панель справа при этом снимается: 260 пикселей она забирала у обоих.
DESIGN tasks {
    OBJECTS {
        NEW pulseFilters FIRST {
            horizontal = TRUE;
            alignment = STRETCH;
            class = 'pulse-filter-bar';
            MOVE FILTERGROUPS(t) { horizontal = TRUE; };
            MOVE FILTERCONTROLS(t);
        }
        REMOVE filterPanel;
    }
}

// ---- частности «Задач» ----
// Полоска приоритета живёт в StoreTaskCore рядом с самой формой: свойство,
// добавленное через EXTEND FORM, платформа кладёт в панель, и MOVE в грид падает с
// «should be in panel instead of grid».
DESIGN tasks {
    // Свойство типа HTMLTEXT платформа считает многострочным и отводит ему область в
    // несколько строк: строка грида вырастала с 27 до 84 пикселей. charHeight
    // возвращает высоту к одной строке. В объявлении свойства этого не задать —
    // CHARHEIGHT в языке нет, только CHARWIDTH; высота настраивается из дизайна.
    PROPERTY(statusHtml(t)) { charHeight = 1; }

    // Номер задачи не помещался: формат ST000078 — восемь знаков, а колонка была уже,
    // и во всех строках стояло одинаковое «ST00…», то есть колонка не различала
    // ничего. Ширина задаётся здесь, а не в объявлении свойства: id используется и в
    // других формах.
    PROPERTY(id(t)) { charWidth = 9; }

    // Перенос там, где текст обрезался многоточием. Это платформенная возможность
    // (wrap у свойства), а не борьба с CSS: клиент сам вешает html-or-text-wrap и
    // считает высоту строки. wrapWordBreak — чтобы длинное слово рвалось, а не
    // распирало колонку.
    //
    // Перенос задаётся у СВОЙСТВА, а не режимом грида, и это намеренно: какие колонки
    // длинные — знает форма, а не режим. В журнале перенос обычно не нужен вовсе:
    // строки там однотипные и короткие, а растить их значит терять объём.
    PROPERTY(name(t)) { wrap = TRUE; wrapWordBreak = TRUE; }
    PROPERTY(nameObject(t)) { wrap = TRUE; wrapWordBreak = TRUE; }

    // ---- лишние колонки ----
    // Колонок набралось двадцать одна: ядро объявляет шестнадцать, ещё пять досыпают
    // график, выполнения и роли на объекте. Каждая по отдельности осмысленна, вместе
    // они превращают список в таблицу, которую невозможно прочитать: важное тонет
    // среди служебного, и ни одна колонка не получает достаточной ширины.
    //
    // Остаются те, по которым задачу узнают в списке: важность (полоска), код, что
    // делать, состояние, где, кто делает, к какому сроку и насколько готово. Восемь.
    //
    // Убрано, и почему:
    REMOVE PROPERTY(namePriority(t));   // важность уже показывает полоска слева
    REMOVE PROPERTY(nameAuthor(t));     // кто поставил — вопрос к карточке, не к списку
    REMOVE PROPERTY(nameTakenBy(t));    // то же: подробность одной задачи
    REMOVE PROPERTY(nameType(t));       // вид задачи виден по названию
    REMOVE PROPERTY(start(t));          // из двух дат в списке важнее срок
    REMOVE PROPERTY(tags(t));           // метки — материал для фильтра, а не колонка
    REMOVE PROPERTY(closed(t));         // состояние уже есть колонкой; фильтр отдельно
    REMOVE PROPERTY(unplanned(t));      // редкий признак, ради него колонка всем
    REMOVE PROPERTY(categoryObject(t)); // категория объекта — про объект, не про задачу
    REMOVE PROPERTY(nameRule(t));       // правило графика: видно в самом графике
    REMOVE PROPERTY(periodStart(t));    // то же
    REMOVE PROPERTY(nameLastResult(t)); // итог последнего выполнения — во вкладке задачи
    REMOVE PROPERTY(countExecution(t)); // счётчик попыток — там же

    // Служебные колонки истории правок: кто и когда завёл, кто и когда менял. В
    // реестре задач это четыре колонки ради вопроса, который задают редко и обычно
    // про одну задачу — а ответ на него есть в разделе «История».
    REMOVE PROPERTY(nameUserFirstHistory(t));
    REMOVE PROPERTY(dateTimeFirstHistory(t));
    REMOVE PROPERTY(nameUserLastHistory(t));
    REMOVE PROPERTY(dateTimeLastHistory(t));
}

// ---- выполнения ----
// Координаты убраны, расстояние оставлено. «53.904512 / 27.561523» — это не ответ, а
// исходные данные: глядя на две дроби, человек не узнаёт ничего, ради чего открыл
// вкладку. Вопрос у неё один — был ли исполнитель на месте, — и отвечает на него
// «От объекта, м». Координаты понадобились бы, чтобы открыть карту, но карты здесь нет;
// сами значения никуда не делись — они в задаче и в журнале координат.
//
// Возврат — снятие двух строк.
DESIGN task {
    REMOVE PROPERTY(startedLatitude(t));
    REMOVE PROPERTY(startedLongitude(t));
    REMOVE PROPERTY(finishedLatitude(t));
    REMOVE PROPERTY(finishedLongitude(t));
}

// ---- список файлов ----
// Тот же временный перевод, что у заголовков разделов, и по той же причине: подписи
// приходят из общего метакода StoreTaskFileUtils, а вокруг всё по-русски.
//
// «Порядок» (index) убран: это служебное поле ручной сортировки вложений, колонку в
// списке оно занимает всегда, а трогают его почти никогда. Заодно уходит и подпись,
// которая не помещалась в свою колонку ни при каком оформлении.
//
DESIGN task {
    REMOVE PROPERTY(index(of));

    PROPERTY(extension(of))   { caption = 'Тип'; }
    PROPERTY(description(of)) { caption = 'Описание'; }
    PROPERTY(nameUser(of))    { caption = 'Кто'; }
    PROPERTY(dateTime(of))    { caption = 'Когда'; }
    PROPERTY(open(of))        { caption = 'Открыть'; }

    // Ширина списка остаётся метакодовой — шестьсот пикселей, — и половина вкладки
    // пустует. Развернуть её отсюда не вышло: fill к заданной ширине ничего не
    // прибавляет, а width = 0 в паре с fill схлопнул список до 133 пикселей (для
    // контейнера lsFusion это не тот же приём, что flex-basis в CSS, — проверено).
    // Ширина задана в StoreTaskFileUtils на все формы сразу, там ей и место.
}

// ---- временный перевод заголовков разделов ----
// Заголовки приходят из общих метакодов (StoreTaskObjectUtils, StoreTaskFileUtils,
// StoreTaskDocUtils, StoreTaskCommentUtils) и написаны по-английски, а вокруг всё
// по-русски. Настоящее место для перевода — сами метакоды или ресурсный бандл: они
// используются не только задачей, и переводить надо один раз для всех. Здесь это
// временная заплатка на одну форму, снимается удалением блока.
//
// Счётчик сохраняется: badged — платформенная функция, та же, что в метакодах, и
// подставляет то же число рядом с заголовком.
DESIGN task {
    history { caption = badged('История', countHistories(t)); }
    files { caption = badged('Файлы', countFiles(t)); }
    comments { caption = badged('Обсуждение', countComment(t)); }
    BOX(stch) { caption = badged('Смена статуса', countStatusChange(t)); }
}

// ---- карточка задачи: всё под одним таб-контейнером ----
// Было: «шапка» с основными свойствами и таб-контейнер с остальным — соседи, идущие
// сверху вниз. Стало: шапка переезжает в тот же контейнер отдельной вкладкой
// «Основное», и разделов становится ровно один список.
//
// Так карточка перестаёт быть двухэтажной: у неё один способ переключения, а не
// «сверху всегда видно одно, снизу выбираешь другое». Заодно освобождается высота —
// шапка занимала треть экрана независимо от того, нужна ли она сейчас.
//
// Правка живёт здесь, а не в StoreTaskCore: это решение нашего оформления, и снимается
// вместе с модулем.
DESIGN task {
    details {
        NEW basic FIRST {
            caption = 'Основное';
            fill = 1;
            MOVE header;
        }

        // «Обсуждение» — такой же раздел, как остальные. Держать его отдельной
        // колонкой значило платить за это шириной: карточке оставалось на 280
        // пикселей меньше, и поля начинали обрезаться. Счётчик в заголовке раздела
        // остаётся — непрочитанное видно, не открывая.
        MOVE comments { fill = 1; }
    }

    // Код не помещался — во всех задачах стояло «ST00…», то есть поле не показывало
    // ничего. Ширина задаётся здесь, а не в объявлении свойства: id живёт и в других
    // формах, и менять его везде ради одной — лишнее.
    PROPERTY(id(t)) { charWidth = 9; }


    // ---- действия отдельной строкой ----
    // «Взять», «Освободить» и «Начать» стояли в одном ряду со свойствами объекта.
    // Кнопка среди полей читается как ещё одно поле: то же место в сетке, та же
    // подпись сверху — а делает она совсем другое. Отдельная строка сразу под
    // названием: сначала «что за задача», потом «что с ней можно сделать».
    header {
        NEW actions AFTER main {
            horizontal = TRUE;
            alignment = STRETCH;
            class = 'pulse-card-actions';
            // Статус переезжает сюда из платформенной строки состояния формы. Там он
            // висел сам по себе у правого края — над карточкой, но не в ней: ни с
            // одной колонкой полей не совпадал, и выравнивать его было не с чем.
            // В строке действий он встаёт по левому краю карточки, рядом с кнопкой,
            // которая этот же статус и меняет.
            MOVE PROPERTY(nameStatus(t));
            MOVE PROPERTY(takeTask(t));
            MOVE PROPERTY(releaseTask(t));
            MOVE PROPERTY(beginExecution(t));
        }
    }

    // ---- свойства: одна сетка в две колонки ----
    // «Объект» был горизонтальным рядом, и в него же складывают свои поля соседние
    // модули: шаблон (FormTask), правило и начало периода (StoreTaskSchedule),
    // источник (Corrective). Пять-шесть полей в одну строку не помещались и раньше, а
    // рядом с «Обсуждением» колонка стала уже — и обрезались уже все. Две колонки, как
    // у свойств ниже: подписи выстраиваются по одной вертикали, а новое поле от любого
    // модуля просто занимает следующую ячейку, не ломая строку.
    object {
        horizontal = FALSE;
        lines = 2;
        // Класс просит равные колонки: иначе этот блок делит ширину по содержимому, а
        // блок свойств ниже — пополам, и правые колонки двух блоков не совпадают.
        class = 'pulse-card-cols';
    }

    // «Дата начала / Срок / Готово» лежали вложенным горизонтальным контейнером ВНУТРИ
    // сетки: три поля делили ширину одной ячейки и обрезались все три («28.08.202»).
    //
    // Колонки задаются ДВУМЯ контейнерами, а не lines = 2. lines раскладывает свойства
    // сам и как ему удобно: пары получались перепутанными («Приоритет» слева, «Тип»
    // справа), и порядком объявления это не чинится — раскладка от него не зависит.
    // Два контейнера рядом дают ровно те пары, которые задуманы: вид и важность,
    // автор и исполнитель, кто взял и когда, начало и срок.
    params {
        lines = 1;
        horizontal = TRUE;
        alignment = STRETCH;
        class = 'pulse-card-cols';
        NEW paramsLeft {
            fill = 1;
            MOVE PROPERTY(nameType(t));
            MOVE PROPERTY(nameAuthor(t));
            MOVE PROPERTY(nameTakenBy(t));
            MOVE PROPERTY(start(t));
            MOVE PROPERTY(unplanned(t));
            MOVE PROPERTY(clientId(t));
        }
        NEW paramsRight {
            fill = 1;
            MOVE PROPERTY(namePriority(t));
            MOVE PROPERTY(nameAssignedTo(t));
            MOVE PROPERTY(takenAt(t));
            MOVE PROPERTY(deadline(t));
            MOVE PROPERTY(progress(t));
            MOVE PROPERTY(tags(t));
        }
    }

    // Ширина по содержимому: fill = 0 снимает растяжение (платформа ставит
    // fill-parent-perc), заданной ширины больше нет — четыре сегмента занимают
    // ровно столько, сколько нужно их подписям.
    PROPERTY(nameStatus(t)) { fill = 0; }

    rightPane {
        // Колонка опустела — «Обсуждение» уехало в разделы. fill = 0 не даёт ей
        // забрать половину ширины впустую: со своим fill = 1 из StoreTaskCore пустой
        // контейнер всё равно растянулся бы на свободное место.
        fill = 0;
    }
}
