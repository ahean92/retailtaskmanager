MODULE AiDraftDecision;

// AiServiceClient — что ответил сервис (aiTypeId/aiObjectHint/… , aiQuestion, aiOutcome) и
// ошибка шага; AiTools — подсказка -> запись (countMatch*/…ByHint, objectNamedInRequest,
// roleHere, aiRequestObject/aiRequestText); StoreTaskType — taskType/defaultTaskType; Issue —
// за taskType('issue'): поручение, тип по умолчанию для задачи, которую человек описал
// словами; FormTask — usesTemplate; Template — template(code); CheckObject — checkObject(id);
// TaskPerformer — taskPerformer(id)/currentPerformer; StoreTaskPriority — taskPriority(id);
// Time — currentDate/toDateISO (транзитивному REQUIRE не доверять)
REQUIRE AiServiceClient, AiTools, StoreTaskType, Issue, FormTask, Template, CheckObject,
        TaskPerformer, StoreTaskPriority, Time;

NAMESPACE StoreTask;

// ===== Решение сервера по ответу модели: подсказки -> сущности, правила подсистемы, =====
// ===== уточняющий вопрос. =====
// Шаг 4 сценария (см. AiTaskDraft) — намеренно на сервере, а не в сервисе: сервис знает про
// prompt и JSON, но не знает, что бланк применим только к бланочным типам, что исполнителя
// ищут по «огрызку» фамилии, а «несколько подходящих объектов» — не ошибка, а вопрос человеку.
// Само правило похожести подсказки и записи — в AiTools (граница с сервисом записана там).

// --- решение сервера: ссылки на сущности и что сказать человеку ---
aiType = DATA LOCAL TaskType ();
aiObject = DATA LOCAL CheckObject ();
aiPerformer = DATA LOCAL TaskPerformer ();
aiTemplate = DATA LOCAL Template ();
aiPriority = DATA LOCAL TaskPriority ();
aiClarification = DATA LOCAL ISTRING[250] ();
// чем уточняемся: object | performer. По нему и по подсказке телефон получает готовый
// список вариантов — тот же, по которому задан вопрос
aiClarifyKind = DATA LOCAL STRING[20] ();
aiClarifyHint = DATA LOCAL ISTRING[250] ();
aiWarning = DATA LOCAL ISTRING[500] ();

aiBatchDimension = DATA LOCAL ObjectDimension ();
aiBatchValue = DATA LOCAL ISTRING[150] ();
aiBatch = DATA LOCAL BOOLEAN ();
aiBatchCount = DATA LOCAL INTEGER ();
aiBatchAnswer = DATA LOCAL STRING[10] ();

// Замечания копятся: «срок в прошлом» и «у исполнителя нет роли на объекте» — разные
// вещи, и человеку стоит увидеть обе. CONCAT пропускает пустые сам.
addWarning (ISTRING[400] w) {
    aiWarning() <- ISTRING[500](CONCAT '; ', aiWarning(), w);
}

// Вопрос задаётся ОДИН — первый недостающий. Список из трёх вопросов на экране
// телефона — это форма, а от формы человек и уходил в AI.
askClarification (ISTRING[250] q) {
    IF NOT aiClarification() THEN
        aiClarification() <- q;
}

// Вопрос со списком: кроме текста запоминаем, из чего выбирать. Вариант, выбранный
// пальцем, экономит человеку набор названия, а системе — второй заход в модель.
askChoice (ISTRING[250] q, STRING[20] kind, ISTRING[250] hint) {
    IF NOT aiClarification() THEN {
        aiClarification() <- q;
        aiClarifyKind() <- kind;
        aiClarifyHint() <- hint;
    }
}

// ============================== 4. решение ==============================
// Тип. Модель называет его id из контекста; не назвала — берём по подсказке, а если и
// её нет, задача с бланком — «процедура», а без бланка — «поручение». Поручение
// умолчанием выбрано не случайно: сценарий тикета — «поставь человеку задачу словами»,
// и это ровно оно.
aiResolveType () {
    aiType() <- taskType(aiTypeId());
    IF NOT aiType() AND aiTypeHint() AND countMatchTaskType(aiTypeHint()) = 1 THEN
        aiType() <- taskTypeByHint(aiTypeHint());
}

// Бланк. Только с кодом и только опубликованная редакция (template(code) и matchTemplate),
// поэтому «нашёлся» здесь уже означает «его можно поставить в задачу».
aiResolveTemplate () {
    aiTemplate() <- template(aiTemplateCode());
    IF NOT aiTemplate() AND aiTemplateHint() AND countMatchTemplate(aiTemplateHint()) = 1 THEN
        aiTemplate() <- templateByHint(aiTemplateHint());
    IF NOT aiTemplate() AND aiTemplateHint() AND countMatchTemplate(aiTemplateHint()) > 1 THEN
        addWarning(ISTRING[400]('Подходит несколько бланков — выбран не был'));
}

// Объект — единственное, из-за чего разговор чаще всего и уходит в уточнение.
// Порядок попыток: id из контекста, подсказка по всему каталогу, объект, на котором
// стоит телефон. Несколько подходящих — вопрос со списком, ни одного — вопрос из
// требований дословно.
aiResolveObject () {
    LOCAL namedCount = INTEGER ();
    namedCount() <- countNamedInRequest(aiStemLength());

    // 1. Подходит несколько — обычно улицей: «на Ленина» это три Санты.
    //
    // Считаем по САМОМУ ТЕКСТУ запроса (namedInRequest), а не по подсказке модели:
    // подсказка бывает и с опечаткой («Ленинна» — не находит ничего), и настолько
    // общей, что подходит всему каталогу («Санта» — это все десять магазинов).
    //
    // Стоит человек на одном из подходящих — это и есть ответ: спрашивать «на какой из
    // трёх Ленина?» у того, кто стоит на одной из них, невежливо. Не стоит ни на одной
    // — выбор за ним, списком.
    IF namedCount() > 1 THEN {
        IF namedInRequest(aiRequestObject()) THEN
            aiObject() <- aiRequestObject();
        ELSE
            askChoice('Уточните объект — в запросе названо несколько', 'named', NULL);
    }

    // 2. Ответ модели — только когда сам запрос ничего не решил. Модель называет ровно
    // один код даже там, где запрос подходит трём, и называет его уверенно: раньше
    // сервер этот код принимал не глядя, и задача молча уезжала на чужой объект.
    IF NOT aiObject() AND NOT aiClarification() THEN
        aiObject() <- checkObject(aiObjectId());
    IF NOT aiObject() AND NOT aiClarification() AND aiObjectHint() THEN {
        IF countMatchObject(aiObjectHint()) = 1 THEN
            aiObject() <- objectByHint(aiObjectHint());
        ELSE {
            // Подходит несколько, а человек стоит на одном из них — это он, как и в шаге 1.
            // Модель повторяет название объекта телефона целиком («МАГАЗИН МИНСК
            // ДУНИНА-МАРЦИНКЕВИЧА 11»), а под него первым словом подходит весь каталог
            // сети, — и вопрос уезжал на телефон с тысячами вариантов.
            IF matchObject(aiRequestObject(), aiObjectHint()) THEN
                aiObject() <- aiRequestObject();
            ELSE IF countMatchObject(aiObjectHint()) > 1 THEN
                askChoice('Уточните объект — подходит несколько', 'object', aiObjectHint());
            // Не нашлось никого, а человек стоит на объекте — берём его и говорим об этом
            // замечанием. Чаще всего это не чужой магазин, а свой, названный моделью
            // криво: 3B переписывает кириллический код объекта телефона латиницей
            // («SC3001» вместо «СК3001»), и вопрос «в каком магазине?» получал тот, кто в
            // нём стоит. Замечание едет на карточку черновика, так что выбранный за
            // человека объект он видит до «Создать».
            ELSE IF aiRequestObject() THEN {
                aiObject() <- aiRequestObject();
                addWarning(ISTRING[400]('Объект «' + aiObjectHint() + '» не найден — задача ставится на '
                                        + name(aiRequestObject())));
            } ELSE
                askClarification(ISTRING[250]('Объект «' + aiObjectHint()
                                              + '» не найден. В каком магазине выполнить задачу?'));
        }
    }

    // 3. Модель могла не заметить магазин в фразе вовсе — 3B на «Иванову в Уручье убрать
    // вещи» уносит «Уручье» в название задачи и оставляет объект пустым. Тогда его
    // ищет сервер, по тому же тексту (namedInRequest): названный магазин старше того,
    // на котором стоит телефон, — иначе задача молча уедет на соседний объект.
    IF NOT aiObject() AND NOT aiClarification() AND namedCount() = 1 THEN
        aiObject() <- objectNamedInRequest(aiStemLength());

    // объект не назван вовсе — берём тот, на котором человек стоит: «поставь проверку»
    // в торговом зале означает «здесь», и переспрашивать об этом невежливо
    IF NOT aiObject() AND NOT aiClarification() THEN
        aiObject() <- aiRequestObject();
    IF NOT aiObject() AND NOT aiClarification() THEN
        askClarification('В каком магазине выполнить задачу?');
}

aiResolveCriterion () {
    aiBatchDimension() <- objectDimension(aiDimensionId());
    IF NOT aiBatchDimension() AND aiDimensionHint() AND countMatchDimension(aiDimensionHint()) = 1 THEN
        aiBatchDimension() <- dimensionByHint(aiDimensionHint());
    IF NOT aiBatchDimension() AND aiValueHint() AND countDimensionOfValue(aiValueHint()) = 1 THEN
        aiBatchDimension() <- dimensionOfValue(aiValueHint());

    IF countMatchDimensionValue(aiBatchDimension(), aiValueHint()) = 1 THEN
        aiBatchValue() <- dimensionValueByHint(aiBatchDimension(), aiValueHint());
}

aiAskBatchOrObject (CheckObject o) {
    aiObject() <- o;
    askChoice(ISTRING[250]('Назван объект «' + name(o) + '» ('
                           + name(aiBatchDimension()) + ': '
                           + (OVERRIDE dimensionValue(o, aiBatchDimension()), 'не задан')
                           + '), а критерий — «' + name(aiBatchDimension()) + ' = ' + aiBatchValue()
                           + '». Одна задача в «' + name(o) + '» или пачка по критерию?'),
              r'batchOrObject', NULL);
}

aiAnswerBatchOrObject (AiRequest asked, CheckObject namedObject, INTEGER namedCount) {
    IF NOT aiBatchDimension() THEN aiBatchDimension() <- batchDimension(asked);
    IF NOT aiBatchValue() THEN aiBatchValue() <- batchValue(asked);
    IF aiBatchAnswer() THEN {
        IF aiBatchAnswer() = r'one' THEN
            IF draftObject(asked) THEN
                aiObject() <- draftObject(asked);
            ELSE
                askClarification('В каком магазине выполнить задачу?');
        RETURN;
    }
    LOCAL one = BOOLEAN ();
    LOCAL batch = BOOLEAN ();
    one() <- regexPatternMatch(lower(aiRequestText()), '(^|[^[:alpha:]])(одну|одна|одно|одной|один)([^[:alpha:]]|$)');
    batch() <- regexPatternMatch(lower(aiRequestText()), '(^|[^[:alpha:]])(пачк[[:alpha:]]*|все|всё|всех|всем|критери[[:alpha:]]*)([^[:alpha:]]|$)');
    IF namedCount > 1 THEN
        askChoice('Уточните объект — в запросе названо несколько', 'named', NULL);
    ELSE IF one() AND NOT batch() THEN
        aiObject() <- OVERRIDE namedObject, draftObject(asked);
    ELSE IF NOT one() AND NOT batch() AND namedObject THEN
        aiObject() <- namedObject;
    ELSE IF one() OR NOT batch() THEN
        aiAskBatchOrObject(draftObject(asked));
}

aiResolveBatch () {
    aiResolveCriterion();
    LOCAL namedCount = INTEGER ();
    LOCAL object = CheckObject ();
    namedCount() <- countNamedInRequest(aiBatchStemLength());
    object() <- objectNamedInRequest(aiBatchStemLength()) IF namedCount() = 1;
    IF askedBatchOrObject(aiDialogId()) THEN
        aiAnswerBatchOrObject(askedBatchOrObject(aiDialogId()), object(), namedCount());
    ELSE IF object() AND aiBatchValue() THEN
        aiAskBatchOrObject(object());
    ELSE
        aiObject() <- object();
    IF aiObject() OR aiClarification() THEN RETURN;

    IF aiBatchDimension() AND aiValueHint() AND NOT aiBatchValue() THEN {
        IF countMatchDimensionValue(aiBatchDimension(), aiValueHint()) > 1 THEN
            askChoice(ISTRING[250]('Уточните критерий — в разрезе «' + name(aiBatchDimension())
                                   + '» подходит несколько значений: '
                                   + dimensionValueMatches(aiBatchDimension(), aiValueHint())),
                      'dimensionValue', aiValueHint());
        ELSE
            askClarification(ISTRING[250]('В разрезе «' + name(aiBatchDimension())
                                          + '» нет объектов со значением «' + aiValueHint()
                                          + '». Уточните критерий.'));
    }

    IF NOT aiBatchDimension() AND aiValueHint() AND countDimensionOfValue(aiValueHint()) > 1 THEN
        askClarification(ISTRING[250]('Значение «' + aiValueHint() + '» встречается в разрезах: '
                                      + dimensionsOfValue(aiValueHint()) + '. По какому ставить задачи?'));

    IF NOT aiBatchValue() THEN RETURN;

    aiBatch() <- TRUE;
    aiBatchCount() <- dimensionHasValue(aiBatchDimension(), aiBatchValue());
    IF namedCount() > 1 THEN
        addWarning(ISTRING[400]('В запросе узнаются объекты: ' + namedInRequestMatches(aiBatchStemLength())
                                + ' — ставится пачка по критерию; для одной задачи назовите магазин точнее'));

    IF aiBatchCount() > aiBatchLimitOrDefault() THEN
        askClarification(ISTRING[250]('По критерию «' + name(aiBatchDimension()) + ' = ' + aiBatchValue()
                                      + '» попало ' + aiBatchCount() + ' объектов, потолок пачки — '
                                      + aiBatchLimitOrDefault() + '. Сузьте критерий.'));
}

// Исполнитель. Не назван — задача на себя, и это не догадка: так же поступает
// apiCreateTask, когда пресет не назвал исполнителя. Назван, но не найден — вопрос:
// выдумывать человека нельзя.
aiResolvePerformer () {
    aiPerformer() <- taskPerformer(aiPerformerId());
    IF NOT aiPerformer() AND aiPerformerHint() THEN {
        IF countMatchPerformer(aiPerformerHint()) = 1 THEN
            aiPerformer() <- performerByHint(aiPerformerHint());
        ELSE {
            IF countMatchPerformer(aiPerformerHint()) > 1 THEN
                askChoice('Уточните исполнителя — подходит несколько', 'performer', aiPerformerHint());
            ELSE
                askClarification(ISTRING[250]('Исполнитель «' + aiPerformerHint()
                                              + '» не найден. Кому поручить задачу?'));
        }
    }
    IF NOT aiPerformer() AND NOT aiPerformerHint() THEN
        aiPerformer() <- currentPerformer();
    IF aiPerformer() AND aiObject() AND NOT roleHere(aiObject(), aiPerformer()) THEN
        addWarning(ISTRING[400]('У исполнителя нет роли на этом объекте'));
}

aiTemplateType () = taskType('form');
aiPlainType () = OVERRIDE taskType('issue'), defaultTaskType();

// Правила подсистемы поверх выбора модели. Их место здесь, а не в prompt: модель можно
// попросить их соблюдать, но полагаться на просьбу нельзя — черновик, нарушающий
// констрейнт, обернулся бы отказом APPLY уже после того, как человек нажал «Создать».
aiApplyRules () {
    // бланк требует бланочного типа: не назвали тип — ставим «процедуру», назвали
    // небланочный — бланк отбрасываем, потому что констрейнт FormTask его не пропустит
    IF aiTemplate() AND NOT aiType() THEN
        aiType() <- aiTemplateType();
    IF aiTemplate() AND aiType() AND NOT usesTemplate(aiType()) THEN {
        // Замечание — только если модель ВЫБРАЛА бланк кодом из списка: это
        // противоречие в её ответе, и человеку стоит его увидеть. Бланк, найденный по
        // подсказке словами, — просто эхо фразы («проверить выкладку» похоже на
        // название бланка), и сообщать о его отбрасывании значит шуметь на каждом
        // втором поручении.
        IF aiTemplateCode() THEN
            addWarning(ISTRING[400]('Бланк «' + name(aiTemplate()) + '» неприменим к типу «'
                                    + name(aiType()) + '» — задача создаётся без бланка'));
        aiTemplate() <- NULL;
    }
    IF NOT aiType() THEN
        aiType() <- aiPlainType();
    IF usesTemplate(aiType()) AND NOT aiTemplate() THEN {
        addWarning(ISTRING[400]('Тип «' + name(aiType()) + '» заполняется по бланку, а бланк не выбран — ставится «'
                                + name(aiPlainType()) + '»'));
        aiType() <- aiPlainType();
    }
    IF NOT aiType() THEN {
        aiErrorCode() <- 'noTaskType';
        aiError() <- 'В системе не заведено ни одного типа задач';
    }

    // название: модель могла не выделить его — тогда им становится сам запрос, урезанный
    // до длины поля. Пустое название задача не переживёт (apiCreateTask: name required),
    // а спрашивать «как назвать задачу?» у человека, который её только что описал, глупо.
    IF NOT aiTaskName() THEN
        aiTaskName() <- ISTRING[250](aiRequestText());

    aiPriority() <- taskPriority(aiPriorityId());

    IF aiDeadline() AND aiDeadline() < currentDate() THEN {
        addWarning(ISTRING[400]('Срок ' + toDateISO(aiDeadline()) + ' уже прошёл'));
        aiDeadline() <- NULL;
    }

    // Описание модель пишет ПРО ТОТ магазин, который выбрала сама, и называет его
    // прямым текстом: на «на Советской убрать витрины» приезжает «Уборка витрин на
    // улице Советская, Столин». Если сервер её выбор не принял — подходило трое, —
    // то в черновике не остаётся объекта, а описание продолжает называть Столин.
    // Человеку это врёт дважды: его спрашивают «какой магазин?», показывая рядом
    // ответ, и выбранная им Малорита уедет в задачу с описанием про Столин.
    //
    // Поэтому описание живёт ровно столько, сколько объект, о котором оно написано.
    // Потери нет: ответ на уточнение — это следующий шаг разговора, и описание для
    // него модель напишет заново, уже про правильный магазин.
    IF NOT aiObject() AND NOT aiBatch() THEN
        aiDescription() <- NULL;
}

// Исход одним словом — им телефон выбирает экран. Ошибка старше уточнения: если
// сервис не ответил, спрашивать человека не о чем.
aiResolveOutcome () {
    aiOutcome() <- 'ok';
    IF aiClarification() THEN aiOutcome() <- 'clarify';
    IF aiError() THEN aiOutcome() <- 'error';
}

aiResolve () {
    IF aiError() THEN {
        aiResolveOutcome();
        RETURN;
    }
    aiResolveType();
    aiResolveTemplate();
    IF aiBatchMode() THEN aiResolveBatch();
    IF NOT aiBatch() THEN {
        IF NOT aiObject() THEN aiResolveObject();
        aiResolvePerformer();
    }
    aiApplyRules();
    // Вопрос модели — ПОСЛЕДНИМ и только если сервер сам не собрал черновик. Модель
    // склонна спрашивать там, где всё уже разрешено: на «На Багратиона убраться по всем
    // стелажам» она спросила «в каком магазине?», хотя объект по адресу нашёлся
    // однозначно — и человек увидел вопрос вместо готовой задачи. Раньше вопрос
    // принимался первым и побеждал любой разбор, потому что askClarification оставляет
    // первый заданный.
    IF aiQuestion() AND aiOutcome() = 'clarify'
        AND NOT ((aiObject() OR aiBatch()) AND aiType() AND aiTaskName()) THEN
        askClarification(aiQuestion());
    aiResolveOutcome();
}
