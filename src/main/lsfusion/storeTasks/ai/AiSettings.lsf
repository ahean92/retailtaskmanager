MODULE AiSettings;

// Time — за currentDateTime() в отметке проверки связи; StoreTaskSettings — за форму
// настроек, в которую встаёт вкладка. Перечислено явно, транзитивному REQUIRE не
// доверять: именно на таком доверии PushDevice уже один раз не собрался. Utils —
// messageCaughtException в разборе отказа сервиса.
REQUIRE StoreTaskSettings, Time, StoreTaskRights, Utils;

NAMESPACE StoreTask;

// ===== Настройка AI-постановки задач. =====
// Постановка задачи текстом («поставь Иванову проверить выкладку Pepsi в магазине на
// Ленина до пятницы») делается тремя слоями, и здесь настраивается стык с первым из них:
//
//   Flutter  ->  lsFusion  ->  AI-сервис  ->  локальная LLM в Docker
//
// lsFusion — единственная точка входа: телефон к модели не ходит и её адреса не знает,
// а модель к базе не ходит и SQL не видит. Всё, что нужно AI-сервису знать о бизнесе,
// собирает и отдаёт сервер (AiTools), а решение «что за задача получилась» принимает
// снова сервер (AiDraftDecision) — сервис остаётся тонким: prompt, вызов модели, разбор
// ответа.
//
// Здесь — адрес сервиса, ключ доступа к нему и рамки обращения. Модель НЕ настраивается
// отсюда сознательно: её выбирают переменными окружения контейнера (LLM_MODEL), и
// сменить её можно, не трогая ни lsFusion, ни телефон. Сервер лишь показывает, что
// ответил сервис на /health, — чтобы администратор видел, с какой моделью работает
// стенд, не заходя на сервер по ssh.

aiEnabled 'AI-постановка задач включена' = DATA BOOLEAN ();

// Пусто = localhost:8010, адрес из docker-compose: типовая установка держит AI-сервис
// на той же машине, что и сервер приложений, и заставлять администратора вводить
// «http://localhost:8010» руками — лишний способ ошибиться. Без схемы и порта адрес не
// работает, поэтому подсказка стоит в подписи.
aiUrl 'Адрес AI-сервиса (http://хост:порт)' = DATA ISTRING[250] () CHARWIDTH 30;
aiUrlOrDefault () = OVERRIDE aiUrl(), 'http://localhost:8010';

// Ключ доступа — AI_API_KEY на стороне сервиса. Пусто — заголовок не шлётся: так живут
// стенды, где сервис слушает только localhost и ключа не требует. В форме поле показывается
// звёздочками (echoSymbols): ключ вводят один раз и больше не читают.
aiApiKey 'Ключ AI-сервиса' = DATA STRING[200] () CHARWIDTH 30;
// Заголовок целиком, NULL без ключа: три вызова сервиса кладут его в HEADERS одной строкой
aiAuthorization () = 'Bearer ' + aiApiKey();

// Таймаут — не украшение: LLM без GPU думает секунды, а иногда десятки секунд, и
// обращение без потолка держит поток сервера столько, сколько модели вздумается.
// Ноль означает то же, что пусто, — по той же причине, что и nearbyRadius в CheckObject:
// нулевой таймаут не настройка, а поломка, при которой не проходит ни один запрос.
aiTimeout 'Таймаут ответа, с' = DATA INTEGER ();
aiTimeoutOrDefault () = OVERRIDE (aiTimeout() IF aiTimeout() > 0), 90;

// Сколько записей каждого справочника уезжает в контекст модели. Ограничение
// обязательно: контекст компактной модели — это несколько тысяч токенов, и каталог из
// 365 магазинов Санты в него не влезает, а если влезет — утопит в себе сам запрос.
// Отбор кандидатов делает AiTools, здесь — только потолок.
aiContextLimit 'Записей справочника в контексте' = DATA INTEGER ();
aiContextLimitOrDefault () = OVERRIDE (aiContextLimit() IF aiContextLimit() > 0), 40;

// Хранить ли в журнале то, что уехало в модель. По умолчанию НЕТ: контекст — это
// фамилии исполнителей и адреса объектов, то есть персональные данные, и лежать в журнале
// весь срок его хранения им незачем. Включается на время разбора инцидента («почему AI
// выбрал не того человека») и выключается обратно — ровно тот минимум, о котором говорит
// требование к логированию.
aiLogContext 'Хранить переданный контекст в журнале' = DATA BOOLEAN ();

// Сколько живёт запись журнала AI-запросов (#37347). И без контекста она — персональные
// данные: логин, текст запроса, ответ модели, — и хранится ограниченный срок. Пусто — 30
// дней; ноль — тоже пусто, как у таймаута выше. Объявлено здесь, рядом с остальными
// настройками AI; сама очистка — в AiRequest, общим регламентом (StoreTaskLogRetention).
aiLogKeepDays 'Хранить журнал AI-запросов, дней' = DATA INTEGER ();
aiLogKeepDaysOrDefault () = OVERRIDE (aiLogKeepDays() IF aiLogKeepDays() > 0), 30;

// --- генерация кода гипотез: поток агента ---
// Код проверки гипотез пишет агент, и потоков у него два (см. ai-service, CODEGEN_PROVIDER):
// claude — агент claude cli, zai — GLM кодинг-плана Z.AI, fallback — claude, а при его сбое
// Z.AI. Какой поток работает, решается ЗДЕСЬ, а не переменными окружения контейнера: в
// отличие от модели черновиков (LLM_MODEL) это выбор поставщика, за которым стоят ключ и
// деньги, и менять его администратору удобнее из формы, чем по ssh. Настройки уезжают
// в каждом запросе /v1/hypothesis-code и перекрывают окружение сервиса.
aiCodegenProvider 'Поток генератора кода (claude/zai/fallback)' = DATA ISTRING[20] () CHARWIDTH 20;
aiCodegenProviderOrDefault () = OVERRIDE aiCodegenProvider(), 'claude';
// Сервис незнакомое слово молча понимает как claude: опечатка в «zai» оставила бы поток на
// claude, и никто бы этого не заметил.
CONSTRAINT aiCodegenProvider() AND NOT (aiCodegenProvider() = 'claude' OR aiCodegenProvider() = 'zai'
        OR aiCodegenProvider() = 'fallback')
    MESSAGE 'Поток генератора кода — claude, zai или fallback';

// Ключ API кодинг-плана Z.AI (личный кабинет z.ai). Нужен потокам zai и fallback; без
// него zai ответит noKey, а fallback просто не привлечётся. Как и «Ключ AI-сервиса»,
// показывается звёздочками: вводят один раз и больше не читают.
aiZaiApiKey 'Ключ Z.AI (кодинг-план)' = DATA STRING[200] () CHARWIDTH 30;

// Модель Z.AI для генерации кода. Старшая GLM-5.3 пишет код по исходникам заметно лучше
// быстрой — менять стоит, только когда нужна дешёвая прикидка.
aiZaiModel 'Модель Z.AI' = DATA ISTRING[100] () CHARWIDTH 20;

CONSTRAINT (CHANGED(aiEnabled()) OR CHANGED(aiUrl()) OR CHANGED(aiApiKey())
        OR CHANGED(aiTimeout()) OR CHANGED(aiContextLimit()) OR CHANGED(aiLogContext())
        OR CHANGED(aiLogKeepDays()) OR CHANGED(aiCodegenProvider()) OR CHANGED(aiZaiApiKey())
        OR CHANGED(aiZaiModel()))
    AND optionsLocked()
    MESSAGE 'Менять настройки может роль с правом «Править настройки»';
aiZaiModelOrDefault () = OVERRIDE aiZaiModel(), 'GLM-5.3';

// --- что ответил /health в последний раз ---
// Не настройка, а память о последней проверке связи: «AI не работает» имеет с полдюжины
// причин по обе стороны (сервис не поднят, модель не скачалась, адрес с опечаткой), и
// администратору нужна не догадка, а последний ответ сервиса целиком.
aiModel 'Модель' = DATA ISTRING[100] () CHARWIDTH 20;
aiCheckedAt 'Связь проверена' = DATA DATETIME ();
aiLastError 'Последняя ошибка' = DATA ISTRING[500] () CHARWIDTH 40;

// Таймаут платформы задаётся в миллисекундах и в LONG (System.timeoutHttp). Отдельным
// свойством, потому что читают его два действия — проверка связи здесь и сам запрос
// черновика в AiServiceClient.
aiTimeoutMillis () = LONG(aiTimeoutOrDefault()) * 1000;

// ===== Вызов AI-сервиса — один на все обращения к нему. =====
// Черновик задачи (AiServiceClient), генерация кода гипотезы (HypothesisAi) и проверка связи
// (checkAi ниже) говорят с одним сервисом, одним ключом и одинаково понимают его отказы,
// поэтому и разбор отказа один: три копии уже успели разойтись — у генерации кода не было
// ветки 504.
//
// Тело — FILE (EXPORT JSON ... TO): платформа отправит его байтами с типом по расширению;
// без тела — GET. Итог раскладывается по локалям: ответ — aiCallResponse, отказ — кодом
// в aiCallCode (по нему решают вызывающий и телефон) и подробностями в aiCallError (адрес,
// статус, текст исключения — для журнала и администратора).
//
// Любой ответ вне 2xx платформа бросает исключением, успев записать статус и тело
// (CallHTTPAction); обрыв связи бросает до записи статуса. Поэтому статус сбрасывается перед
// вызовом, а разбор отказа целиком живёт в CATCH: проверка failedHttp() после вызова не
// срабатывала бы никогда.
aiCallResponse = DATA LOCAL STRING ();
aiCallCode = DATA LOCAL STRING[30] ();
aiCallError = DATA LOCAL ISTRING[500] ();

callAiService (STRING url, FILE body, LONG timeout) {
    aiCallResponse() <- NULL;
    aiCallCode() <- NULL;
    aiCallError() <- NULL;
    // Потолок ожидания — у каждого свой: черновик ждёт модель секунды, генерация кода —
    // минуты, проверка связи — коротко; по умолчанию платформа ждала бы полчаса
    timeoutHttp() <- timeout;
    // Единственный заголовок — ключ доступа (без ключа заголовка нет). Content-Type не
    // задаём: тело — файл, и платформа выводит его из расширения (json -> application/json)
    LOCAL headers = STRING (STRING);
    headers('Authorization') <- aiAuthorization();
    statusHttp() <- NULL;
    TRY {
        IF body THEN
            EXTERNAL HTTP POST url HEADERS headers PARAMS body TO aiCallResponse;
        ELSE
            EXTERNAL HTTP GET url HEADERS headers TO aiCallResponse;
    } CATCH {
        IF statusHttp() = 401 THEN {
            aiCallCode() <- 'unauthorized';
            aiCallError() <- 'AI-сервис отклонил ключ доступа (HTTP 401): проверьте «Ключ AI-сервиса» в настройках';
        } ELSE IF statusHttp() THEN {
            // 504 сервис отдаёт сам, когда модель не уложилась в свой таймаут: человеку это
            // «думает слишком долго», а не «сломано»
            aiCallCode() <- (OVERRIDE ('timeout' IF statusHttp() = 504), 'serviceError');
            aiCallError() <- ISTRING[500]('AI-сервис ответил ошибкой (HTTP ' + statusHttp() + '): '
                                          + (OVERRIDE aiCallResponse(), 'пустой ответ'));
        } ELSE {
            aiCallCode() <- 'unavailable';
            aiCallError() <- ISTRING[500]('AI-сервис не отвечает по адресу ' + url + ': ' + messageCaughtException());
        }
    }
}

// --- проверка связи ---
// Кнопка отвечает на три разных вопроса разом: жив ли сервис, видит ли он модель и
// какая это модель. Порознь их не разделить снаружи — «AI не отвечает» выглядит
// одинаково для всех трёх, — а внутри они уже разделены: /health возвращает status
// сервиса и llm ('up' / 'down') отдельно.
checkAi 'Проверить связь с AI-сервисом' () {
    NEWSESSION {
        aiLastError() <- NULL;
        aiCheckedAt() <- currentDateTime();

        // Ключ — и сюда: /health его не требует, но проверяет, если он передан, — так
        // опечатка в ключе видна здесь, а не на первом запросе с телефона. Потолок короткий:
        // проверка связи должна отвечать быстро, а запрос черновика — успевать
        callAiService(aiUrlOrDefault() + '/health', NULL, 15000);
        IF aiCallCode() THEN {
            aiLastError() <- aiCallError();
            MESSAGE 'Связи нет.\n\n' + aiLastError()
                + '\n\nПроверьте адрес, ключ и то, что сервис запущен: systemctl status rtm-ai или docker compose ps';
            APPLY;
            RETURN;
        }

        LOCAL healthStatus = STRING[20] ();
        LOCAL healthLlm = STRING[20] ();
        LOCAL healthModel = ISTRING[100] ();
        LOCAL healthDetail = ISTRING[400] ();
        LOCAL healthKeyRequired = BOOLEAN ();
        IMPORT FROM JSONFILE(aiCallResponse()) TO()
            healthStatus = 'status', healthLlm = 'llm',
            healthModel = 'model', healthDetail = 'detail',
            healthKeyRequired = 'keyRequired';

        aiModel() <- healthModel();

        IF NOT healthLlm() = 'up' THEN {
            aiLastError() <- ISTRING[500]('AI-сервис работает, но модель недоступна: '
                                          + (OVERRIDE healthDetail(), 'причина не указана'));
            MESSAGE 'AI-сервис отвечает, но LLM не поднялась.\n\n' + aiLastError()
                + '\n\nПервый запуск скачивает модель — это занимает минуты; журнал: docker compose logs -f llm';
            APPLY;
            RETURN;
        }

        // Сервис требует ключ, а в настройке его нет: /health на это не жалуется (он открыт),
        // а первый же запрос черновика получил бы 401
        IF healthKeyRequired() AND NOT aiApiKey() THEN {
            aiLastError() <- 'AI-сервис требует ключ доступа, а «Ключ AI-сервиса» не задан: запросы будут отклонены';
            MESSAGE 'Связь есть, модель ' + (OVERRIDE aiModel(), 'не названа') + '.\n\n' + aiLastError()
                + '\n\nКлюч — AI_API_KEY в настройках сервиса (/etc/rtm-ai.env или .env).';
            APPLY;
            RETURN;
        }

        IF NOT aiEnabled() THEN
            MESSAGE 'Связь есть, модель ' + (OVERRIDE aiModel(), 'не названа') + '.'
                + '\n\nНо AI-постановка выключена галкой выше, и в приложении её не будет.';
        ELSE
            MESSAGE 'Связь есть. Модель: ' + (OVERRIDE aiModel(), 'не названа') + '.';
        APPLY;
    }
}

// Ключи — только тому, кто вправе их менять. echoSymbols прячет ключ на экране, но значение
// всё равно уезжает в клиент; скрытое SHOWIF форма не читает и не отправляет вовсе. Остальным
// ключ и не нужен: проверка связи берёт его из базы сама.
EXTEND FORM options
    PROPERTIES() aiEnabled, aiUrl, aiApiKey SHOWIF canEditOptions(), aiTimeout, aiContextLimit, aiLogContext,
        aiLogKeepDays, checkAi
    PROPERTIES() aiCodegenProvider, aiZaiApiKey SHOWIF canEditOptions(), aiZaiModel
    PROPERTIES() READONLY aiModel, aiCheckedAt, aiLastError
;

DESIGN options {
    tabbedPane {
        NEW aiTab {
            caption = 'AI';
            NEW aiService {
                caption = 'AI-сервис';
                MOVE PROPERTY(aiEnabled());
                MOVE PROPERTY(aiUrl());
                MOVE PROPERTY(aiApiKey()) { echoSymbols = TRUE; }
                NEW aiLimits {
                    horizontal = TRUE;
                    MOVE PROPERTY(aiTimeout());
                    MOVE PROPERTY(aiContextLimit());
                }
                MOVE PROPERTY(aiLogContext());
                MOVE PROPERTY(aiLogKeepDays());
                MOVE PROPERTY(checkAi());
            }
            NEW aiCodegen {
                caption = 'Генератор кода гипотез';
                MOVE PROPERTY(aiCodegenProvider());
                MOVE PROPERTY(aiZaiModel());
                MOVE PROPERTY(aiZaiApiKey()) { echoSymbols = TRUE; }
            }
            NEW aiState {
                caption = 'Последняя проверка';
                MOVE PROPERTY(aiModel());
                MOVE PROPERTY(aiCheckedAt());
                MOVE PROPERTY(aiLastError());
            }
        }
    }
}
