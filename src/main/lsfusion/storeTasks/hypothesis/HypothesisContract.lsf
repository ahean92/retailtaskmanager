MODULE HypothesisContract;

NAMESPACE StoreTask;

// Контракт между сгенерированным кодом проверки и подсистемой гипотез.
//
// Код проверки пишет СЮДА и больше никуда: это единственные свойства, которые прогон
// потом читает, и единственное, что модели разрешено менять. Всё остальное для кода
// проверки — только чтение. Проверить это машинально нельзя (EVAL исполняет что угодно),
// поэтому граница держится двумя вещами: человек читает код перед утверждением, а
// неутверждённая версия не создаёт задач.
//
// Свойства локальные: прогон читает их сразу после EVAL, в той же сессии, и в базе им
// делать нечего. Ключ строк — INTEGER, нумерацию задаёт сам код проверки; дыры и порядок
// значения не имеют, прогон обходит непустые по возрастанию.
//
// Почему контракт вынесен в отдельный модуль: на него ссылаются трое — прогон, подсказка
// для модели и человек, читающий сгенерированный код. Текст этого файла целиком уезжает
// в промпт, поэтому в нём нет ничего, кроме контракта.

// --- за какой период считали; строкой, потому что период определяет сам код проверки
// (месяц, неделя, «последние 30 дней») и сравнивать его не с чем ---
checkedPeriod 'Период' = DATA LOCAL ISTRING[20] ();

// --- воронка: сколько предметов осталось после каждого шага отбора ---
// Она и есть ответ на «почему пусто»: без неё пустой результат неотличим от кода,
// который отобрал не то. Код проверки заполняет её по шагам своего отбора.
funnelStep 'Шаг' = DATA LOCAL ISTRING[150] (INTEGER);
funnelCount 'Сколько' = DATA LOCAL INTEGER (INTEGER);

// --- находки: то, на что гипотеза показала пальцем ---
// foundCode — устойчивый ключ предмета в ERP (код магазина, код оборудования, артикул):
// по нему находка сопоставляется с прошлым прогоном и по нему же строится ключ
// идемпотентности задачи. Не внутренний идентификатор объекта: он меняется при переносе
// базы и человеку ничего не говорит.
foundCode 'Ключ' = DATA LOCAL ISTRING[100] (INTEGER);
foundName 'Предмет' = DATA LOCAL ISTRING[250] (INTEGER);
// Код площадки (магазина) — по нему находка превращается в задачу на конкретный объект
foundSite 'Площадка' = DATA LOCAL ISTRING[30] (INTEGER);
// Числа, на которых стоит вывод: «остаток 0 при продажах 12 шт/день». Человеку — чтобы
// проверить вывод не открывая код
foundDetails 'Детали' = DATA LOCAL ISTRING[500] (INTEGER);
// Позиции, которые задача по находке должна перечислить строками: коды товаров через
// запятую («4810001,4810002»). Нужны, когда находка — магазин, а делать предстоит по
// конкретным позициям внутри него: пересчитать семь товаров с отрицательным остатком, а
// не весь ассортимент. Код — тот же устойчивый ключ ERP, что и в foundCode. Не задано —
// задача получает бланк целиком, как если бы её поставили руками.
foundRows 'Позиции' = DATA LOCAL TEXT (INTEGER);

// --- сравнение групп: на чём стоит вердикт гипотезы вида «X приводит к Y» ---
// Воронка отвечает «сколько нашлось», а такая гипотеза проверяется иначе: сравнением
// опытной группы с контрольной («продажи в дни без ценника» против «после печати»).
// Одна строка — одно значение одного показателя в одной группе; показатель с двумя
// группами — две строки с одинаковым compareMetric. Значение дробное: доли, средние и
// отклонения в целые числа воронки не помещаются.
//
// compareSize — на скольких наблюдениях стоит значение. Без него разница «−23%» на трёх
// днях и на трёх тысячах выглядит одинаково, и вердикт по ней не вынести.
compareGroup 'Группа' = DATA LOCAL ISTRING[100] (INTEGER);
compareMetric 'Показатель' = DATA LOCAL ISTRING[150] (INTEGER);
compareValue 'Значение' = DATA LOCAL NUMERIC[18,4] (INTEGER);
compareSize 'Наблюдений' = DATA LOCAL INTEGER (INTEGER);

// Вывод словами — что показало сравнение, с числами: «продажи без ценника на 23% ниже,
// 1 240 пар позиция-день против 3 100». Вердикт (подтверждена/опровергнута) код НЕ
// выносит: его ставит человек, прочитав воронку, сравнение и этот вывод.
conclusion 'Вывод' = DATA LOCAL TEXT ();

// Сбрасывается перед каждым прогоном: прогон обязан прочитать только то, что написал
// его собственный скрипт, а локали живут столько же, сколько сессия
clearContract () {
    checkedPeriod() <- NULL;
    funnelStep(INTEGER i) <- NULL;
    funnelCount(i) <- NULL;
    foundCode(i) <- NULL;
    foundName(i) <- NULL;
    foundSite(i) <- NULL;
    foundDetails(i) <- NULL;
    foundRows(i) <- NULL;
    compareGroup(i) <- NULL;
    compareMetric(i) <- NULL;
    compareValue(i) <- NULL;
    compareSize(i) <- NULL;
    conclusion() <- NULL;
}
