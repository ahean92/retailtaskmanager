MODULE NonconformityReport;

REQUIRE Filling, Time, Utils, ReportPeriod;

NAMESPACE StoreTask;

nameTemplate 'Шаблон' (Field f) = name(template(f));

checked (Filling e, Field f) = answered(e, f) AND NOT notApplicable(e, f);

counted (Filling e, DATE dFrom, DATE dTo) = finished(e) AND matchScope(e) AND inPeriod(e, dFrom, dTo);

countChecked 'Проверок' (Field f, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF checked(Filling e, f) AND counted(e, dFrom, dTo);
countFail 'Несоответствий' (Field f, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF nonconformity(Filling e, f) AND checked(e, f) AND counted(e, dFrom, dTo);
countCriticalFail 'Критичных' (Field f, DATE dFrom, DATE dTo) = countFail(f, dFrom, dTo) IF critical(f);
shareFail 'Доля, %' (Field f, DATE dFrom, DATE dTo) =
    NUMERIC[6,2](100 * NUMERIC[16,4](countFail(f, dFrom, dTo)) / countChecked(f, dFrom, dTo));

countedObj (Filling e, CheckObject o, DATE dFrom, DATE dTo) =
    finished(e) AND checkObject(task(e)) = o
    AND (NOT filterExecutorId() OR id(executor(e)) = filterExecutorId())
    AND inPeriod(e, dFrom, dTo);
countCheckedObj 'Проверок' (Field f, CheckObject o, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF checked(Filling e, f) AND countedObj(e, o, dFrom, dTo);
countFailObj 'Несоответствий' (Field f, CheckObject o, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF nonconformity(Filling e, f) AND checked(e, f) AND countedObj(e, o, dFrom, dTo);
countCriticalFailObj 'Критичных' (Field f, CheckObject o, DATE dFrom, DATE dTo) = countFailObj(f, o, dFrom, dTo) IF critical(f);
shareFailObj 'Доля, %' (Field f, CheckObject o, DATE dFrom, DATE dTo) =
    NUMERIC[6,2](100 * NUMERIC[16,4](countFailObj(f, o, dFrom, dTo)) / countCheckedObj(f, o, dFrom, dTo));

countFailPeriod 'Несоответствий' (Field f, DATE d) = countFail(f, d, periodEnd(d));

deductScore 'Снято' (Filling e, Field f) = itemMax(e, f) - itemScore(e, f) IF itemMax(e, f) > itemScore(e, f);
deductedTotal 'Снято' (Filling e) = totalMax(e) - totalScore(e);
columnDeducted 'Снято за период' (Field f, DATE dFrom, DATE dTo) =
    GROUP SUM deductScore(Filling e, f) IF counted(e, dFrom, dTo) AND template(e) = template(f);
addressObject 'Адрес' (Filling e) = addressObject(task(e));
dimensionCut 'Разрез' (Filling e) = dimensionCut(checkObject(task(e)));
weightLabel (Field f) = OVERRIDE (STRING[8](INTEGER(weight(f))) IF weight(f) = INTEGER(weight(f))), STRING[8](weight(f));
columnHeader 'Пункт' (Field f) = nameSection(f) + ' · ' + name(f) + ' (' + weightLabel(f) + ')';
hintNoTemplate 'Свод снятых баллов' () = 'Выберите шаблон проверки — снятые баллы раскладываются по его пунктам.';

FORM fieldFillings 'Заполнения с несоответствием'
    OBJECTS ff = Field PANEL
    PROPERTIES(ff) READONLY nameTemplate, nameSection, name

    OBJECTS dobj = CheckObject PANEL NULL
    OBJECTS ffrom = DATE PANEL NULL
    OBJECTS fto = DATE PANEL NULL

    OBJECTS e = Filling
    PROPERTIES(e) READONLY dateTime, nameObject, nameExecutor, nameTemplate, percent, nameVerdict
    PROPERTIES READONLY nameOptionValue(e, ff), numberValue(e, ff), comment(e, ff)
    PROPERTIES(e) NEWSESSION EDIT
    FILTERS nonconformity(e, ff), counted(e, ffrom, fto),
            (NOT (dobj IS CheckObject) OR checkObject(task(e)) = dobj)
    ORDERS dateTime(e)
;

DESIGN fieldFillings {
    OBJECTS {
        NEW header {
            alignment = STRETCH;
            NEW field {
                horizontal = TRUE;
                MOVE PROPERTY(nameTemplate(ff));
                MOVE PROPERTY(nameSection(ff));
                MOVE PROPERTY(name(ff)) { flex = 1; fontSize = 14; }
            }
        }
        MOVE BOX(e) { caption = ''; fill = 1; }
    }
}

showFillingsAll 'Заполнения' (Field f, DATE dFrom, DATE dTo) {
    SHOW fieldFillings OBJECTS ff = f, ffrom = dFrom, fto = dTo FLOAT;
}

showFillingsObj 'Заполнения' (Field f, CheckObject o, DATE dFrom, DATE dTo) {
    SHOW fieldFillings OBJECTS ff = f, dobj = o, ffrom = dFrom, fto = dTo FLOAT;
}

showFillingsPeriod 'Заполнения' (Field f, DATE d) {
    showFillingsAll(f, d, periodEnd(d));
}

FORM deductedFilling 'Заполнение'
    OBJECTS df = Filling PANEL
    PROPERTIES(df) READONLY nameObject, nameTemplate, dateTime, nameExecutor, percent, nameVerdict

    OBJECTS dfld = Field
    PROPERTIES(dfld) READONLY nameSection, index, name
    PROPERTIES READONLY nameOptionValue(df, dfld), numberValue(df, dfld),
                        itemScore(df, dfld), deductScore(df, dfld)
    FILTERS template(dfld) = template(df), deductScore(df, dfld)
    ORDERS sectionIndex(dfld), index(dfld)
;

DESIGN deductedFilling {
    OBJECTS {
        NEW head {
            horizontal = TRUE;
            MOVE PROPERTY(nameObject(df)) { fontSize = 14; }
            MOVE PROPERTY(percent(df));
            MOVE PROPERTY(nameVerdict(df));
        }
        MOVE BOX(dfld) { caption = 'Что снято'; fill = 1; }
    }
}

showDeductedFilling 'Заполнение' (Filling f) {
    SHOW deductedFilling OBJECTS df = f FLOAT;
}

reportFile = DATA LOCAL FILE ();

exportNonconformities 'Экспорт в XLSX' (DATE dFrom, DATE dTo) {
    EXPORT XLSX HEADER FROM
        'Шаблон' = nameTemplate(Field f),
        'Раздел' = nameSection(f),
        '№' = index(f),
        'Пункт' = name(f),
        'Критичный' = critical(f),
        'Проверок' = countChecked(f, dFrom, dTo),
        'Несоответствий' = countFail(f, dFrom, dTo),
        'Доля, %' = shareFail(f, dFrom, dTo),
        'Критичных' = countCriticalFail(f, dFrom, dTo)
        WHERE countFail(f, dFrom, dTo)
        ORDER shareFail(f, dFrom, dTo) DESC, countFail(f, dFrom, dTo) DESC
        TO reportFile;
    open(reportFile());
}

FORM deductedPrint 'Снятые баллы по пунктам'
    OBJECTS dFrom = DATE PANEL
    OBJECTS dTo = DATE PANEL
    OBJECTS tmpl = Template PANEL

    OBJECTS fc = Field
    FILTERS template(fc) = tmpl
    ORDERS sectionIndex(fc), index(fc)

    OBJECTS e = Filling
    PROPERTIES(e) READONLY dateTime, nameObject, addressObject, dimensionCut, nameExecutor
    PROPERTIES gained 'Набрано' = totalScore(e) READONLY, deducted 'Снято' = deductedTotal(e) READONLY
    PROPERTIES deductScore(e, fc) READONLY COLUMNS (fc) HEADER columnHeader(fc)
    FILTERS counted(e, dFrom, dTo), template(e) = tmpl
    ORDERS dateTime(e)

    OBJECTS fcT = Field
    PROPERTIES columnHeader(fcT) READONLY, columnDeducted(fcT, dFrom, dTo) READONLY
    FILTERS template(fcT) = tmpl
    ORDERS columnDeducted(fcT, dFrom, dTo) DESC
;

exportDeducted 'Экспорт в XLSX' (DATE dFrom, DATE dTo, Template tmpl) {
    PRINT deductedPrint OBJECTS dFrom = dFrom, dTo = dTo, tmpl = tmpl XLSX TO reportFile;
    open(reportFile());
}

FORM fieldNonconformities 'Повторяющиеся несоответствия'
    OBJECTS dFrom = DATE PANEL
    OBJECTS dTo = DATE PANEL
    PROPERTIES periodFrom 'Период с' = VALUE(dFrom), periodTo 'по' = VALUE(dTo)
    PROPERTIES() quarterly

    OBJECTS ft = Template PANEL NULL
    PROPERTIES filterTemplate 'Шаблон' = name(ft) SELECTOR
    OBJECTS fs = Section PANEL NULL
    PROPERTIES filterSection 'Раздел' = name(fs) SELECTOR
    PROPERTIES nameFilterObject() ON CHANGE { DIALOG checkObjects OBJECTS o = filterObject() INPUT NULL DO { filterObject() <- o; } }
    PROPERTIES nameFilterExecutor() ON CHANGE { DIALOG taskPerformers OBJECTS p = filterExecutor() INPUT NULL DO { filterExecutor() <- p; } }
    PROPERTIES nameFilterDimension() ON CHANGE { DIALOG objectDimensions OBJECTS d = filterDimension() INPUT NULL DO { filterDimension() <- d; } }

    PROPERTIES exportNonconformities(dFrom, dTo)
    PROPERTIES exportDeducted(dFrom, dTo, ft)

    OBJECTS pd = DATE
    FILTERS iterate(pd, dFrom, dTo), periodStart(pd) = pd

    OBJECTS f = Field
    PROPERTIES(f) READONLY nameTemplate, nameSection, index, name, critical
    PROPERTIES READONLY countChecked(f, dFrom, dTo), countFail(f, dFrom, dTo),
                        shareFail(f, dFrom, dTo), countCriticalFail(f, dFrom, dTo)
    PROPERTIES countFailPeriod(f, pd) READONLY COLUMNS (pd) HEADER namePeriod(pd)
               ON CONTEXTMENU showFillingsPeriod(f, pd)
    PROPERTIES showFillingsAll(f, dFrom, dTo) TOOLBAR
    FILTERS (NOT (ft IS Template) OR template(f) = ft), (NOT (fs IS Section) OR section(f) = fs),
            countChecked(f, dFrom, dTo)
    ORDERS shareFail(f, dFrom, dTo) DESC, countFail(f, dFrom, dTo) DESC

    FILTERGROUP fails
        FILTER 'Повторяющиеся (2+)' countFail(f, dFrom, dTo) >= 2 'F8'
        FILTER 'С несоответствиями' countFail(f, dFrom, dTo) 'F7' DEFAULT

    OBJECTS co = CheckObject
    PROPERTIES(co) READONLY id, name, address, dimensionCut
    PROPERTIES READONLY countCheckedObj(f, co, dFrom, dTo), countFailObj(f, co, dFrom, dTo),
                        shareFailObj(f, co, dFrom, dTo), countCriticalFailObj(f, co, dFrom, dTo)
    PROPERTIES showFillingsObj(f, co, dFrom, dTo) TOOLBAR
    FILTERS countCheckedObj(f, co, dFrom, dTo)
    ORDERS dimensionCut(co), shareFailObj(f, co, dFrom, dTo) DESC

    PROPERTIES hintNoTemplate() READONLY SHOWIF NOT (ft IS Template)

    OBJECTS fc = Field
    FILTERS ft IS Template, template(fc) = ft
    ORDERS sectionIndex(fc), index(fc)

    OBJECTS e2 = Filling
    PROPERTIES(e2) READONLY dateTime, nameObject, addressObject, dimensionCut, nameExecutor
    PROPERTIES gained 'Набрано' = totalScore(e2) READONLY, deducted 'Снято' = deductedTotal(e2) READONLY
    PROPERTIES deductScore(e2, fc) READONLY COLUMNS (fc) HEADER columnHeader(fc)
               ON CONTEXTMENU showDeductedFilling(e2)
    PROPERTIES showDeductedFilling(e2) TOOLBAR
    FILTERS counted(e2, dFrom, dTo), template(e2) = ft
    ORDERS dateTime(e2)

    OBJECTS fcT = Field
    PROPERTIES columnHeader(fcT) READONLY, columnDeducted(fcT, dFrom, dTo) READONLY
    FILTERS ft IS Template, template(fcT) = ft
    ORDERS columnDeducted(fcT, dFrom, dTo) DESC

    EVENTS ON INIT {
        ACTIVATE fieldNonconformities.dFrom = firstDayOfMonth(sumMonth(currentDate(), -5));
        ACTIVATE fieldNonconformities.dTo = lastDayOfMonth(currentDate());
    }
;

DESIGN fieldNonconformities {
    OBJECTS {
        NEW filters {
            alignment = STRETCH;
            NEW range {
                horizontal = TRUE;
                MOVE PROPERTY(periodFrom);
                MOVE PROPERTY(periodTo);
                MOVE PROPERTY(quarterly());
                MOVE PROPERTY(exportNonconformities(dFrom, dTo));
            }
            NEW cuts {
                horizontal = TRUE;
                MOVE PROPERTY(filterTemplate);
                MOVE PROPERTY(filterSection);
                MOVE PROPERTY(nameFilterObject());
                MOVE PROPERTY(nameFilterExecutor());
                MOVE PROPERTY(nameFilterDimension());
            }
        }
        NEW tabs {
            tabbed = TRUE;
            fill = 1;
            NEW repeats {
                caption = 'Повторяющиеся несоответствия';
                horizontal = TRUE;
                fill = 1;
                alignment = STRETCH;
                MOVE BOX(f) { caption = 'Пункты'; fill = 3; }
                MOVE BOX(co) { caption = 'По объектам'; fill = 2; }
            }
            NEW deducted {
                caption = 'Снятые баллы';
                alignment = STRETCH;
                MOVE PROPERTY(hintNoTemplate()) { fontSize = 14; }
                MOVE PROPERTY(exportDeducted(dFrom, dTo, ft));
                MOVE BOX(e2) { fill = 3; }
                MOVE BOX(fcT) { caption = 'Итоги по пунктам за период'; fill = 1; }
            }
        }
    }
}

NAVIGATOR {
    reports {
        NEW fieldNonconformities;
    }
}
