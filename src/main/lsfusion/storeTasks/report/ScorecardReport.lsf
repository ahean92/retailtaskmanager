MODULE ScorecardReport;

// CheckObject — address/parent; StoreTaskCore — task; Execution — finished/nameExecutor/dateTime,
// executor и offSite (#37342);
// Filling — nameVerdict/hasScored/percent; Template — templates/template; ObjectDimension —
// dimensionValue/objectDimensions; TaskPerformer — taskPerformers; StoreTaskSettings — папка
// reports; Time — currentDate/firstDayOfMonth/sumMonth; Utils — iterate; StoreTaskAcceptance —
// completedDate для «выполнено в срок» (#37160) (транзитивному REQUIRE не доверять)
REQUIRE ReportPeriod, VerdictScale, ObjectCategory, CheckCategory, CheckObject, StoreTaskCore, Execution, Filling, Template, ObjectDimension, TaskPerformer, StoreTaskSettings, Time, Utils,
        StoreTaskAcceptance;

NAMESPACE StoreTask;

// filterTemplate / nameFilterTemplate — общие для отчётов, объявлены в ReportPeriod
filterCategory = DATA LOCAL ObjectCategory ();
hideEmpty 'Скрыть без проверок' = DATA LOCAL BOOLEAN ();
nameFilterCategory 'Категория' () = name(filterCategory());

// Фильтр по шаблону выбирает СЕМЕЙСТВО — все его редакции (#37174): свод за полгода
// обязан складывать проверки по чек-листу, а не по одной его редакции. Чем это чревато,
// сказано отметкой mixedVersion ниже.
matchTemplate (Filling e) = NOT filterTemplate() OR family(template(e)) = family(filterTemplate());
matchCategory (Filling e) = NOT filterCategory() OR category(checkObject(task(e))) = filterCategory();
matchCategoryObj (CheckObject o) = NOT filterCategory() OR category(o) = filterCategory();

inScope (Filling e, DATE dFrom, DATE dTo) =
    finished(e) AND hasScored(e)
        AND matchTemplate(e) AND matchCategory(e) AND matchExecutor(e)
        AND inPeriod(e, dFrom, dTo);

scoredCounted (Filling e, CheckObject o, DATE dFrom, DATE dTo) =
    inScope(e, dFrom, dTo) AND checkObject(task(e)) = o;

countObj 'Проверок' (CheckObject o, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF scoredCounted(Filling e, o, dFrom, dTo);
// Ноль вместо пустоты — тот же приём, что в Filling.liveTotalScore, и по той же причине:
// GROUP SUM отдаёт NULL при нулевой сумме, и объект, все проверки которого на 0 %, получал
// пустой средний балл вместо нуля — то есть выглядел как объект БЕЗ проверок. Гейт —
// количество: объекта без проверок в периоде ноль по-прежнему не касается.
sumObj (CheckObject o, DATE dFrom, DATE dTo) =
    OVERRIDE (GROUP SUM NUMERIC[16,2](percent(Filling e)) IF scoredCounted(e, o, dFrom, dTo)), (0 IF countObj(o, dFrom, dTo));
avgObj 'Балл, %' (CheckObject o, DATE dFrom, DATE dTo) =
    NUMERIC[6,2](NUMERIC[16,4](sumObj(o, dFrom, dTo)) / countObj(o, dFrom, dTo));

// Уровень шкалы подбирается ЗДЕСЬ, а не вызовом levelByScale(шкала, avgObj(...)): у
// levelByScale процент — параметр без источника (он участвует только в сравнении
// minPercent(l) <= pct), поэтому подстановка в него агрегата с параметрами-датами, у
// которых источника тоже нет, даёт «операцию над множеством некорректна» при компиляции.
// Здесь агрегат стоит прямо в условии группировки: ключи — o/dFrom/dTo сверху и l от
// scale(l), и лишнего ключа-процента не появляется. levelByScale остаётся как есть — его
// зовут с percent(Filling), а это хранимая колонка.
levelObj (CheckObject o, DATE dFrom, DATE dTo) = GROUP LAST VerdictLevel l
    IF scale(l) = verdictScale(filterTemplate()) AND minPercent(l) <= avgObj(o, dFrom, dTo)
    ORDER minPercent(l), l;
verdictObj 'Оценка' (CheckObject o, DATE dFrom, DATE dTo) = name(levelObj(o, dFrom, dTo));
colorObj (CheckObject o, DATE dFrom, DATE dTo) = rgbColor(levelObj(o, dFrom, dTo));

// Смена редакции внутри периода (#37174). Проценты редакций с разным составом сравнимы
// условно — убрали пункт, и оставшиеся стали весить больше, — поэтому строка, где такое
// случилось, помечается, а не тихо усредняется.
//
// Через max и min номера, а не через подсчёт различных редакций: подсчёт различных — это
// агрегат над агрегатом, и промежуточное свойство пришлось бы считать отдельным запросом с
// ключами-датами, у которых нет источника (inPeriod только сравнивает с ними). Тот же
// разбор, что у levelObj выше.
mixedVersion 'Смена редакции' (CheckObject o, DATE dFrom, DATE dTo) = TRUE IF
    (GROUP MAX version(template(Filling e)) IF scoredCounted(e, o, dFrom, dTo))
    > (GROUP MIN version(template(Filling p)) IF scoredCounted(p, o, dFrom, dTo));

avgPeriod 'Балл, %' (CheckObject o, DATE d) = avgObj(o, d, periodEnd(d));
colorPeriod (CheckObject o, DATE d) = colorObj(o, d, periodEnd(d));

countAll 'Проверок' (DATE dFrom, DATE dTo) = GROUP SUM 1 IF inScope(Filling e, dFrom, dTo);
sumAll (DATE dFrom, DATE dTo) = OVERRIDE (GROUP SUM NUMERIC[16,2](percent(Filling e)) IF inScope(e, dFrom, dTo)), (0 IF countAll(dFrom, dTo));
avgAll 'Балл, %' (DATE dFrom, DATE dTo) = NUMERIC[6,2](NUMERIC[16,4](sumAll(dFrom, dTo)) / countAll(dFrom, dTo));
avgAllPeriod 'Балл, %' (DATE d) = avgAll(d, periodEnd(d));
countAllPeriod 'Проверок' (DATE d) = countAll(d, periodEnd(d));

// === доля работ не на объекте (#37342) ===
// Работа — завершённое выполнение любого вида, бланк или фотоотчёт поручения: правило «на
// объекте» одно на всех, и считать его только по оцениваемым проверкам значило бы не
// заметить курьера, закрывающего поручения из машины. Признак — на задаче
// (Execution.offSite), по её последнему выполнению; в период работа попадает по дате
// выполнения, как проверки выше. Фильтры по проверяющему и категории действуют; по
// шаблону — только на бланки: у поручения шаблона нет, и при выбранном шаблоне оно за
// бортом, как и в счётчике проверок.
matchTemplateWork (Execution e) = NOT filterTemplate() OR matchTemplate(e AS Filling);
workInScope (Execution e, DATE dFrom, DATE dTo) = finished(e) AND matchExecutor(e)
    AND matchCategoryObj(checkObject(task(e))) AND matchTemplateWork(e) AND inPeriod(e, dFrom, dTo);
workCounted (Execution e, CheckObject o, DATE dFrom, DATE dTo) =
    workInScope(e, dFrom, dTo) AND checkObject(task(e)) = o;

// Ноль при наличии работ — как avgObj: объект, где всё на месте, показывает 0, а не прочерк
offSitePercent (INTEGER part, INTEGER total) =
    OVERRIDE NUMERIC[6,1](100 * NUMERIC[16,4](part) / total), (0 IF total);

countWork 'Работ' (CheckObject o, DATE dFrom, DATE dTo) = GROUP SUM 1 IF workCounted(Execution e, o, dFrom, dTo);
countOffSite 'Не на объекте' (CheckObject o, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF workCounted(Execution e, o, dFrom, dTo) AND offSite(task(e));
offSiteShare 'Не на объекте, %' (CheckObject o, DATE dFrom, DATE dTo) =
    offSitePercent(countOffSite(o, dFrom, dTo), countWork(o, dFrom, dTo));
offSiteColorObj (CheckObject o, DATE dFrom, DATE dTo) = RGB(255, 200, 200) IF countOffSite(o, dFrom, dTo);

countWorkAll 'Работ' (DATE dFrom, DATE dTo) = GROUP SUM 1 IF workInScope(Execution e, dFrom, dTo);
countOffSiteAll 'Не на объекте' (DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF workInScope(Execution e, dFrom, dTo) AND offSite(task(e));
offSiteShareAll 'Не на объекте, %' (DATE dFrom, DATE dTo) =
    offSitePercent(countOffSiteAll(dFrom, dTo), countWorkAll(dFrom, dTo));
offSiteShareAllPeriod 'Не на объекте, %' (DATE d) = offSiteShareAll(d, periodEnd(d));

// По исполнителям — «кто закрывает задачи не с объекта»: тот же отбор, строка — исполнитель
// выполнения. Фильтр по проверяющему сужает и его — тогда строка одна.
countWorkBy 'Работ' (TaskPerformer p, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF workInScope(Execution e, dFrom, dTo) AND executor(e) = p;
countOffSiteBy 'Не на объекте' (TaskPerformer p, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF workInScope(Execution e, dFrom, dTo) AND executor(e) = p AND offSite(task(e));
offSiteShareBy 'Не на объекте, %' (TaskPerformer p, DATE dFrom, DATE dTo) =
    offSitePercent(countOffSiteBy(p, dFrom, dTo), countWorkBy(p, dFrom, dTo));

// === выполнено в срок (#37160) ===
// Закрытая задача со сроком — не позже него ли выполнена. Выполнена — сдана (приёмка:
// принятая позже, но сданная в срок — в срок, completedDate) или проведена (closedAt);
// период — по дате выполнения, как работы выше — по дате выполнения. Отменённые не в счёт:
// задача, снятая заказчиком, — не «выполнена с опозданием». Без срока — мимо доли: срока
// нет, судить не по чему (норматив #37160 закрывает большинство таких, но пустая клетка
// матрицы — осознанная настройка). Фильтры свода действуют: категория — по объекту задачи,
// проверяющий — по назначенному исполнителю, шаблон — только бланкам не имеет смысла,
// поручение со сроком в доле остаётся.
// Ноль при наличии закрытых — тот же гейт, что у offSitePercent: объект, где НИЧЕГО не в
// срок, показывает 0, а не прочерк; объект без закрытых задач остаётся прочерком.
onTimePercent (INTEGER part, INTEGER total) =
    OVERRIDE NUMERIC[6,1](100 * NUMERIC[16,4](part) / total), (0 IF total);

closedInScope (Task t, DATE dFrom, DATE dTo) =
    closed(t) AND NOT canceledTask(t) AND deadline(t) AND completedDate(t)
    AND completedDate(t) >= dFrom AND completedDate(t) <= dTo
    AND matchCategoryObj(checkObject(t))
    AND (NOT filterExecutor() OR assignedTo(t) = filterExecutor());

onTimeInScope (Task t, DATE dFrom, DATE dTo) = closedInScope(t, dFrom, dTo) AND completedDate(t) <= deadline(t);

countClosed 'Закрыто' (CheckObject o, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF closedInScope(Task t, dFrom, dTo) AND checkObject(t) = o;
countOnTime 'В срок' (CheckObject o, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF onTimeInScope(Task t, dFrom, dTo) AND checkObject(t) = o;
onTimeShare 'В срок, %' (CheckObject o, DATE dFrom, DATE dTo) =
    onTimePercent(countOnTime(o, dFrom, dTo), countClosed(o, dFrom, dTo));

countClosedAll 'Закрыто' (DATE dFrom, DATE dTo) = GROUP SUM 1 IF closedInScope(Task t, dFrom, dTo);
countOnTimeAll 'В срок' (DATE dFrom, DATE dTo) = GROUP SUM 1 IF onTimeInScope(Task t, dFrom, dTo);
onTimeShareAll 'В срок, %' (DATE dFrom, DATE dTo) =
    onTimePercent(countOnTimeAll(dFrom, dTo), countClosedAll(dFrom, dTo));

// По исполнителям — по назначенному: задача выполняет тот, на кого она назначена (взявший
// на себя переназначением становится назначенным). Тот же отбор, строка — исполнитель.
countClosedBy 'Закрыто' (TaskPerformer p, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF closedInScope(Task t, dFrom, dTo) AND assignedTo(t) = p;
countOnTimeBy 'В срок' (TaskPerformer p, DATE dFrom, DATE dTo) =
    GROUP SUM 1 IF onTimeInScope(Task t, dFrom, dTo) AND assignedTo(t) = p;
onTimeShareBy 'В срок, %' (TaskPerformer p, DATE dFrom, DATE dTo) =
    onTimePercent(countOnTimeBy(p, dFrom, dTo), countClosedBy(p, dFrom, dTo));

// Колонка дня — только если в этот день в отборе была проверка: полгода по дням — это
// 180 колонок, а проверки стоят в двух десятках из них. Месяцы и кварталы показываются
// все, как раньше: пустой месяц — тоже ответ («в июле этот магазин не проверяли»).
periodShown (DATE d) = NOT daily() OR countAllPeriod(d);

// Касса и весы — тоже объекты проверки, вложенные в магазин, и без отбора свод по магазинам
// тонул в сотне пустых строк оборудования. Вложенный объект остаётся, если по нему есть
// проверки в периоде — свод по поверке весов состоит именно из весов, — а без проверок
// показывается, только когда попросили явно.
withNested 'Вложенные объекты' = DATA LOCAL BOOLEAN ();
// Объект с работами в периоде — не пустой и без оцениваемых проверок (#37342): поручения,
// закрытые не с объекта, не должны прятаться за «Скрыть без проверок».
shownObj (CheckObject o, DATE dFrom, DATE dTo) = matchCategoryObj(o)
    AND (countObj(o, dFrom, dTo) OR countWork(o, dFrom, dTo)
         OR (NOT hideEmpty() AND (NOT parent(o) OR withNested())));

cutOf (Filling e) = OVERRIDE dimensionValue(checkObject(task(e)), filterDimension()),
    ('(не заполнено)' IF filterDimension() AND e IS Filling);
countCut 'Проверок' (ISTRING[150] cut, DATE dFrom, DATE dTo) = GROUP SUM 1 IF inScope(Filling e, dFrom, dTo) AND cutOf(e) = cut;
sumCut (ISTRING[150] cut, DATE dFrom, DATE dTo) = OVERRIDE (GROUP SUM NUMERIC[16,2](percent(Filling e)) IF inScope(e, dFrom, dTo) AND cutOf(e) = cut), (0 IF countCut(cut, dFrom, dTo));
avgCut 'Балл, %' (ISTRING[150] cut, DATE dFrom, DATE dTo) = NUMERIC[6,2](NUMERIC[16,4](sumCut(cut, dFrom, dTo)) / countCut(cut, dFrom, dTo));
avgCutPeriod 'Балл, %' (ISTRING[150] cut, DATE d) = avgCut(cut, d, periodEnd(d));

FORM objectFillings 'Заполнения объекта за период'
    OBJECTS dobj = CheckObject PANEL
    PROPERTIES(dobj) READONLY id, name, address

    OBJECTS ffrom = DATE PANEL NULL

    OBJECTS fto = DATE PANEL NULL

    OBJECTS e = Filling
    PROPERTIES(e) READONLY dateTime, nameTemplate, versionTemplate, nameExecutor, percent, nameVerdict
    PROPERTIES(e) NEWSESSION EDIT
    FILTERS scoredCounted(e, dobj, ffrom, fto)
    ORDERS dateTime(e)
;

DESIGN objectFillings {
    OBJECTS {
        NEW header {
            alignment = STRETCH;
            NEW head {
                horizontal = TRUE;
                MOVE PROPERTY(name(dobj)) { flex = 1; fontSize = 14; }
                MOVE PROPERTY(address(dobj));
            }
        }
        MOVE BOX(e) { caption = ''; fill = 1; }
    }
}

showFillingsObjPeriod 'Заполнения' (CheckObject o, DATE d) {
    SHOW objectFillings OBJECTS dobj = o, ffrom = d, fto = periodEnd(d) FLOAT;
}

showFillingsObjRange 'Заполнения' (CheckObject o, DATE dFrom, DATE dTo) {
    SHOW objectFillings OBJECTS dobj = o, ffrom = dFrom, fto = dTo FLOAT;
}

FORM scorecardPrint 'Свод баллов по объектам'
    OBJECTS dFrom = DATE PANEL

    OBJECTS dTo = DATE PANEL

    OBJECTS pd = DATE
    FILTERS iterate(pd, dFrom, dTo), periodStart(pd) = pd, periodShown(pd)

    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, name, address, nameCategory, dimensionCut
    PROPERTIES READONLY countObj(o, dFrom, dTo), avgObj(o, dFrom, dTo), verdictObj(o, dFrom, dTo),
                        mixedVersion(o, dFrom, dTo), countWork(o, dFrom, dTo), offSiteShare(o, dFrom, dTo),
                        countClosed(o, dFrom, dTo), onTimeShare(o, dFrom, dTo)
    PROPERTIES avgPeriod(o, pd) READONLY COLUMNS (pd) HEADER namePeriod(pd)
    FILTERS shownObj(o, dFrom, dTo)
    ORDERS dimensionCut(o), avgObj(o, dFrom, dTo) DESC

    OBJECTS ct = ISTRING[150]
    PROPERTIES cutValue 'Разрез' = VALUE(ct) READONLY
    PROPERTIES READONLY avgCut(ct, dFrom, dTo), countCut(ct, dFrom, dTo)
    PROPERTIES avgCutPeriod(ct, pd) READONLY COLUMNS (pd) HEADER namePeriod(pd)
    FILTERS countCut(ct, dFrom, dTo)
    ORDERS avgCut(ct, dFrom, dTo) DESC

    OBJECTS tp = DATE
    PROPERTIES(tp) READONLY namePeriod
    PROPERTIES READONLY avgAllPeriod(tp), countAllPeriod(tp), offSiteShareAllPeriod(tp)
    FILTERS iterate(tp, dFrom, dTo), periodStart(tp) = tp, periodShown(tp)

    // не на объекте по исполнителям (#37342) — как на экране
    OBJECTS px = TaskPerformer
    PROPERTIES performerName 'Исполнитель' = name(px) READONLY
    PROPERTIES READONLY countWorkBy(px, dFrom, dTo), offSiteShareBy(px, dFrom, dTo),
                        countClosedBy(px, dFrom, dTo), onTimeShareBy(px, dFrom, dTo)
    FILTERS countWorkBy(px, dFrom, dTo) OR countClosedBy(px, dFrom, dTo)
    ORDERS offSiteShareBy(px, dFrom, dTo) DESC, countWorkBy(px, dFrom, dTo) DESC
;

scorecardFile = DATA LOCAL FILE ();

exportScorecard 'Экспорт в XLSX' (DATE dFrom, DATE dTo) {
    PRINT scorecardPrint OBJECTS dFrom = dFrom, dTo = dTo XLSX TO scorecardFile;
    open(scorecardFile());
}

FORM scorecard 'Свод баллов по объектам'
    OBJECTS dFrom = DATE PANEL

    OBJECTS dTo = DATE PANEL
    PROPERTIES periodFrom 'Период с' = VALUE(dFrom), periodTo 'по' = VALUE(dTo)
    // Кварталы и дни взаимоисключающие: переключатель сам снимает второй. Штатная запись
    // галки тут не годится — у неё нет места, где погасить соседний флаг
    PROPERTIES() quarterly ON CHANGE { quarterly() <- NOT quarterly(); IF quarterly() THEN daily() <- NULL; },
                 daily ON CHANGE { daily() <- NOT daily(); IF daily() THEN quarterly() <- NULL; },
                 hideEmpty, withNested
    PROPERTIES totalAll 'Итого за диапазон' = avgAll(dFrom, dTo)
    // доля работ не на объекте за диапазон (#37342) — рядом с итоговым баллом
    PROPERTIES totalOffSite 'Не на объекте за диапазон, %' = offSiteShareAll(dFrom, dTo)
    // выполнено в срок за диапазон (#37160) — там же
    PROPERTIES totalOnTime 'В срок за диапазон, %' = onTimeShareAll(dFrom, dTo)

    PROPERTIES nameFilterTemplate() ON CHANGE { DIALOG templates OBJECTS t = filterTemplate() INPUT NULL DO { filterTemplate() <- t; } }
    PROPERTIES nameFilterCategory() ON CHANGE { DIALOG checkCategories OBJECTS k = filterCategory() INPUT NULL DO { filterCategory() <- k; } }
    PROPERTIES nameFilterExecutor() ON CHANGE { DIALOG taskPerformers OBJECTS p = filterExecutor() INPUT NULL DO { filterExecutor() <- p; } }
    PROPERTIES nameFilterDimension() ON CHANGE { DIALOG objectDimensions OBJECTS d = filterDimension() INPUT NULL DO { filterDimension() <- d; } }

    PROPERTIES exportScorecard(dFrom, dTo)

    OBJECTS pd = DATE
    FILTERS iterate(pd, dFrom, dTo), periodStart(pd) = pd, periodShown(pd)

    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, name, address, nameCategory, dimensionCut
    PROPERTIES READONLY avgObj(o, dFrom, dTo), countObj(o, dFrom, dTo),
        verdictObj(o, dFrom, dTo) BACKGROUND colorObj(o, dFrom, dTo),
        mixedVersion(o, dFrom, dTo),
        // работы и доля не на объекте (#37342); подсвечивается, если такие были
        countWork(o, dFrom, dTo), offSiteShare(o, dFrom, dTo) BACKGROUND offSiteColorObj(o, dFrom, dTo),
        // закрыто и доля в срок (#37160)
        countClosed(o, dFrom, dTo), onTimeShare(o, dFrom, dTo)
    PROPERTIES avgPeriod(o, pd) READONLY COLUMNS (pd) HEADER namePeriod(pd)
    BACKGROUND colorPeriod(o, pd)
    ON CONTEXTMENU showFillingsObjPeriod(o, pd)
    PROPERTIES showFillingsObjRange(o, dFrom, dTo) TOOLBAR
    FILTERS shownObj(o, dFrom, dTo)
    ORDERS dimensionCut(o), avgObj(o, dFrom, dTo) DESC

    OBJECTS ct = ISTRING[150]
    PROPERTIES cutValue 'Разрез' = VALUE(ct) READONLY
    PROPERTIES READONLY avgCut(ct, dFrom, dTo), countCut(ct, dFrom, dTo)
    PROPERTIES avgCutPeriod(ct, pd) READONLY COLUMNS (pd) HEADER namePeriod(pd)
    FILTERS countCut(ct, dFrom, dTo)
    ORDERS avgCut(ct, dFrom, dTo) DESC

    OBJECTS tp = DATE
    PROPERTIES(tp) READONLY namePeriod
    PROPERTIES READONLY avgAllPeriod(tp), countAllPeriod(tp), offSiteShareAllPeriod(tp)
    FILTERS iterate(tp, dFrom, dTo), periodStart(tp) = tp, periodShown(tp)

    // Не на объекте по исполнителям (#37342): только те, у кого в диапазоне были работы,
    // худшие сверху. Фильтр по проверяющему сужает блок до одной строки.
    OBJECTS px = TaskPerformer
    PROPERTIES performerName 'Исполнитель' = name(px) READONLY
    PROPERTIES READONLY countWorkBy(px, dFrom, dTo), offSiteShareBy(px, dFrom, dTo),
                        countClosedBy(px, dFrom, dTo), onTimeShareBy(px, dFrom, dTo)
    FILTERS countWorkBy(px, dFrom, dTo) OR countClosedBy(px, dFrom, dTo)
    ORDERS offSiteShareBy(px, dFrom, dTo) DESC, countWorkBy(px, dFrom, dTo) DESC

    // Без проверок — скрыты по умолчанию: свод открывают, чтобы увидеть оценки, а не
    // перечень всех объектов сети; кто остался без проверки — снятая галка
    EVENTS ON INIT {
        ACTIVATE scorecard.dFrom = firstDayOfMonth(sumMonth(currentDate(), -5));
        ACTIVATE scorecard.dTo = lastDayOfMonth(currentDate());
        hideEmpty() <- TRUE;
    }
;

DESIGN scorecard {
    OBJECTS {
        NEW filters {
            alignment = STRETCH;
            NEW range {
                horizontal = TRUE;
                MOVE PROPERTY(periodFrom);
                MOVE PROPERTY(periodTo);
                MOVE PROPERTY(quarterly());
                MOVE PROPERTY(daily());
                MOVE PROPERTY(hideEmpty());
                MOVE PROPERTY(withNested());
                MOVE PROPERTY(totalAll);
                MOVE PROPERTY(totalOffSite);
                MOVE PROPERTY(exportScorecard(dFrom, dTo));
            }
            NEW cuts {
                horizontal = TRUE;
                MOVE PROPERTY(nameFilterTemplate());
                MOVE PROPERTY(nameFilterCategory());
                MOVE PROPERTY(nameFilterExecutor());
                MOVE PROPERTY(nameFilterDimension());
            }
        }
        NEW body {
            horizontal = TRUE;
            fill = 1;
            alignment = STRETCH;
            MOVE BOX(o) { caption = 'Объекты'; fill = 4; }
            NEW totals {
                fill = 1;
                alignment = STRETCH;
                MOVE BOX(ct) { caption = 'Итоги по разрезу'; fill = 1; }
                MOVE BOX(tp) { caption = 'Итоги по периодам'; fill = 1; }
                MOVE BOX(px) { caption = 'Не на объекте по исполнителям'; fill = 1; }
            }
        }
    }
}

NAVIGATOR {
    reports {
        NEW scorecard IMAGE 'fa-solid fa-ranking-star';
    }
}
