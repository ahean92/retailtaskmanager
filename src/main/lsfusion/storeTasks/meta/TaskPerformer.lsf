MODULE TaskPerformer;

// Authentication is needed for real: User appears in a module-level property signature
// below, not inside a metacode body. Utils.ObjectUtils gets away without any REQUIRE
// only because every User reference there sits inside META and resolves in the caller.
REQUIRE Authentication;

NAMESPACE StoreTask;

// Whoever a task can be authored by, assigned to or executed by. Abstract on purpose:
// the host decides what a performer is — ERP maps its Employee/Assignee onto it, the
// standalone host maps the platform CustomUser. Modelled on ProjectManagement.Assignee,
// which it replaces for the extracted subsystem.
CLASS ABSTRACT TaskPerformer 'Исполнитель';

id '{ID}' = ABSTRACT ISTRING (TaskPerformer) CHARWIDTH 20;
name '{Name}' = ABSTRACT ISTRING (TaskPerformer) CHARWIDTH 20;

archived 'В архиве' = ABSTRACT BOOLEAN (TaskPerformer);
email 'Email' = ABSTRACT STRING[400] (TaskPerformer) CHARWIDTH 20;
active '{Active}' (TaskPerformer p) = NOT archived(p);

// a performer may stand for a group of people (a team), so membership is a relation
// rather than identity — same shape as Assignee.in
in 'Вкл.' = ABSTRACT BOOLEAN (TaskPerformer, User);

// --- иерархия подразделений (#36835) ---
// Хост говорит только факты: чей это подотдел. Транзитивность считает ядро — оставь её
// хосту, и каждый будет городить «магазин → отдел клининга → отдел полотёров» сам, и
// каждый ошибётся по-своему. Прямое членство хост по-прежнему отдаёт через in.
parent 'Входит в' = ABSTRACT TaskPerformer (TaskPerformer);
nameParent 'Входит в' (TaskPerformer p) = name(parent(p));

// Опечатка «сам в себя» ловится один раз здесь, на абстракции, — на всех реализаторов
// parent разом; петли длиннее шага отвергает детектор цикла RECURSION на APPLY
// (сообщение техническое, но данные целы — проверено на стенде).
CONSTRAINT parent(TaskPerformer p) = p MESSAGE 'Исполнитель не может входить сам в себя';

// Замыкание вверх по иерархии: level(c, u) — глубина u над c, 1 у самого c. Канонический
// платформенный шаблон (ср. MasterData.Category, Inventory.Location). Петля в данных
// хоста до базы не доходит: платформа ловит цикл на APPLY и откатывает транзакцию.
level (TaskPerformer child, TaskPerformer up) =
    RECURSION 1l IF child IS TaskPerformer AND up = child
        STEP 2l IF up = parent($up) MATERIALIZED;

// Членство с учётом иерархии: сотрудник входит в подразделение, если хост записал его в
// само подразделение или в любое входящее в него. Существование, а не глубина: SUM
// вместо MIN — уровень вхождения никто не читает, а инкрементально SUM дешевле (чистая
// дельта вместо переагрегации группы). Материализовано не для красоты: этот предикат
// стоит в WHERE каждого запроса списка задач, а исполнителей на подключённом стенде
// под двадцать тысяч — на лету это не считается.
//
// NB следующему хосту: платформа при старте пересчитывает только НОВЫЕ материализованные
// колонки. Если parent()/in() реализуются поверх УЖЕ ЗАПОЛНЕННЫХ данных (готовая
// иерархия, а не пустая), существующие level/hasIn/assignedTo[Task,User] надо пересчитать
// руками: Система → Рефлексия → Таблицы и колонки → «Пересчитать материализации».
hasIn (TaskPerformer p, User u) = GROUP SUM 1 IF level(TaskPerformer c, p) AND in(c, u) MATERIALIZED;
inAll 'Вкл. (с подразделениями)' (TaskPerformer p, User u) = TRUE IF hasIn(p, u);

// the logged-in user seen as a performer; NULL when this user is not one. The host
// implements it (ERP: performer(Employee e) += e).
performer = ABSTRACT TaskPerformer (User);
currentPerformer () = performer(currentUser());

// resolve by the host-owned id (what apiPerformers exports) for API writes. The id is
// abstract and no uniqueness is declared for it, so GROUP MAX rather than GROUP AGGR —
// same shape as CheckObject.checkObject.
taskPerformer (ISTRING[100] s) = GROUP MAX TaskPerformer p IF id(p) = s;

FORM taskPerformers 'Исполнители'
    OBJECTS p = TaskPerformer
    PROPERTIES(p) READONLY id, name, nameParent

    FILTERGROUP active
        FILTER '{Active}' active(p) DEFAULT

    LIST TaskPerformer OBJECT p
;
