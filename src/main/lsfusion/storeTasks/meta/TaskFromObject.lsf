MODULE TaskFromObject;

// CheckObject — класс объекта проверки и его абстракты; StoreTaskCore — сама задача и
// checkObject(Task); StoreTaskForms — карточка task, которую открывает действие
// (транзитивному REQUIRE не доверять)
REQUIRE CheckObject, StoreTaskCore, StoreTaskForms;

NAMESPACE StoreTask;

// Создание задачи по объекту проверки прямо из формы справочника, правым кликом.
//
// Две независимые вещи, и хост берёт то, чего ему не хватает:
//   * объект проверки из своего класса — @defineTaskObject, если класс им ещё не стал;
//   * пункт правого клика на форме — @defineTaskObjectContext, всегда.
// У хоста, который уже написал мостик руками (магазин, касса, весы у Соседей), первого
// не нужно вовсе — достаточно второго.

// ===== Действие: создать задачу по объекту =====
// Одно на все объекты проверки, а не по одному на класс: имя объекта подсистема и так
// знает — это абстрактное name(CheckObject), которое реализует каждый мостик.
createTask 'Создать задачу' (CheckObject o) {
    // Объект обязан быть в базе: NEWSESSION ниже не видит несохранённых изменений формы,
    // и ссылка на только что заведённый, но не записанный объект разрешилась бы в пустоту
    // — задача молча получила бы checkObject = NULL.
    APPLY;
    IF canceled() THEN RETURN;

    NEWSESSION {
        NEW t = Task {
            checkObject(t) <- o;
            // Имя — отправная точка, человек правит его в карточке. Пустым оставлять
            // нельзя: безымянная задача не читается ни в реестре, ни в телефоне.
            name(t) <- ISTRING(name(o));
            // SHOW внутри блока NEW не по недосмотру: параметр t виден только здесь,
            // за скобками блока его уже нет.
            SHOW task OBJECTS t = t DOCKED;
        }
    }
}

// ===== 1. Шов: класс хоста становится объектом проверки =====
// Нужен только тем, у кого мостика ещё нет. nameProp/idProp — свойства хоста, по одному
// параметру класса, и передавать их надо КВАЛИФИЦИРОВАННО (Stock.name, Item.id): слева
// стоят одноимённые name/id подсистемы, и без квалификатора реализация сослалась бы сама
// на себя.
//
// id нужен непустой и стабильный: по нему объект адресуют снаружи (мобильный клиент
// кладёт его в objectId), а имя меняют куда охотнее, чем код.
//
// Адрес и координаты (ownAddress/ownLatitude/ownLongitude) намеренно не реализуются: у
// товара или запчасти их нет. Следствие штатное — site() у такого объекта пуст, значит в
// геовыдачу телефона (apiNearbyObjects, сортировка задач по расстоянию) он не попадёт.
// Нужны координаты — хост реализует эти абстракты сам, шов им не мешает.
//
// И про масштаб: EXTEND CLASS делает объектами проверки ВЕСЬ справочник разом — каталог
// объектов, мобильный apiHome и материализации level/site вырастут на его размер.
META defineTaskObject(cls, nameProp, idProp)
    EXTEND CLASS ###cls : CheckObject;

    name (###cls o) += ISTRING[150](nameProp(o));
    id (###cls o) += ISTRING[30](idProp(o));
END

// ===== 2. Пункт правого клика на форме хоста =====
// Вешается на колонку, УЖЕ добавленную на форму: EXTEND PROPERTIES меняет свойство формы
// на месте, а не добавляет второе такое же. Отсюда требование платформы 7.0 — в 6.3
// этого блока нет вовсе, и там пункт пришлось бы вешать на колонку при её добавлении.
//
// form/obj/prop — имена формы, её объекта и колонки так, как они на форме записаны, и
// БЕЗ квалификатора namespace: в этих позициях парсер его не принимает вовсе.
META defineTaskObjectContext(form, obj, prop)
    EXTEND FORM form
        EXTEND PROPERTIES prop(obj) ON CONTEXTMENU createTask(obj)
    ;
END

// ===== 3. Одной строкой: и шов, и пункт меню =====
META defineTaskObject(cls, nameProp, idProp, form, obj, prop)
    @defineTaskObject(cls, nameProp, idProp);
    @defineTaskObjectContext(form, obj, prop);
END
