MODULE StoreTaskNumerator;

REQUIRE Numerator, StoreTaskSettings;

NAMESPACE StoreTask;

// Private copy of Utils.MetaNumerator's @defineID. Numerator itself is a platform module
// (platform/server/src/main/lsfusion/utils/Numerator.lsf), so the only ERP tie was the
// settings form: the numerator setting now lands on the subsystem's own options form
// instead of the ERP master-data one. That is the single visible change in ERP.
//
// The generated format is untouched — series followed by a zero-padded counter, e.g.
// ST000078. It is the mobile client's sync key, so existing numbers must not move.
// Metacode expands in the CALLING module's namespace, so the properties this creates
// keep their canonical names (StoreTask.id[StoreTask.Task], StoreTask.numeratorTask)
// and no migration is needed when switching from @defineID to @defineTaskID.
META defineTaskID(class, caption, srs, width)
    id '{ID}' = DATA STRING[50] (###class) IN id CHARWIDTH width INDEXED;
    ##class (STRING[50] id) = GROUP AGGR ###class o BY id(o);

    numerator###class = DATA Numerator();
    nameNumerator###class 'Numerator'##' - '##caption = name(numerator###class());

    loadDefaultNumerators () + {
        // The pointer is the idempotency key, not the numerator's name: the caption may
        // change (it did), and a second counter on a live database would restart the ST
        // numbers the phone identifies tasks by.
        IF NOT numerator###class() AND NOT GROUP SUM 1 IF name(Numerator n) = caption THEN {
            NEW n = Numerator {
                name(n) <- caption;
                series(n) <- srs;
                minValue(n) <- 1;
                maxValue(n) <- 999999;
                stringLength(n) <- width;
                numerator###class() <- n;
            }
        }
    }

    EXTEND FORM options
        PROPERTIES nameNumerator###class()
    ;

    DESIGN options {
        commons {
            MOVE PROPERTY(nameNumerator###class());
        }
    }

    // Номер — действием, а не только событием ниже. Событие глобальное, и объект, рождённый
    // внутри ДРУГОГО глобального события, которое в порядке применения стоит позже (реакция
    // проведения, StoreTaskCore.onProceed, #36987), до него уже не доходит: платформа идёт по
    // событиям одним проходом вперёд, а порядок между ними — по зависимостям, и нумератор
    // ставится раньше проведения, потому что проведение читает id (текст уведомления).
    // Корректирующая из реакции оставалась без ST-номера. Такой объект нумеруется явно в
    // месте рождения; в обычной сессии тот же вызов безвреден — событие видит номер уже
    // записанным и молчит.
    assignId###class (###class o) {
        id(o) <- CONCAT '', series(numerator###class()), curStringValue(numerator###class());
        incrementValueSession(numerator###class());
    }

    WHEN SETCHANGED(###class o IS ###class AND numerator###class() AND NOT id(o)) DO
        assignId###class(o);
END
