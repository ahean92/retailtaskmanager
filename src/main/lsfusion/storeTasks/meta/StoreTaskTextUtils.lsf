MODULE StoreTaskTextUtils;

// Utils — regexpReplace/replace/regexPatternMatch (транзитивному REQUIRE не доверять)
REQUIRE Utils;

NAMESPACE StoreTask;

// === текст без разметки ===
// RICHTEXT — это HTML из десктопного редактора (Quill: <p>, <br>, списки, @mention-чипы).
// Телефону он отдаётся чистым текстом: переносы строк из <br> и закрывающих блоков, теги
// долой, сущности обратно в символы, пробелы и переносы по краям — тоже долой (trim()
// базы снимает только пробелы, а закрывающий </p> оставляет перенос в хвосте — проверено
// на стенде). regexpReplace — платформенная обёртка над PostgreSQL REGEXP_REPLACE;
// шаблоны — сырыми строками, чтобы \s дошёл до базы как есть.
//
// Формула живёт отдельным модулем, потому что нужна двоим: описанию задачи
// (StoreTaskCore.plainDescription, #36842) и тексту сообщения ленты (TaskComment.plainText,
// #36844) — второй экземпляр той же выжимки означал бы два места, где чинить одну и ту же
// ошибку разбора.
plainFromHtml (STRING html) = regexpReplace(
    replace(replace(replace(replace(replace(replace(replace(
        regexpReplace(
            regexpReplace(html, r'<br\s*/?>|</p>|</div>|</li>|</tr>|</h[1-6]>', '\n', 'gi'),
            r'<[^>]*>', '', 'g'),
        '&nbsp;', ' '), '&quot;', '"'), '&#39;', '\''), '&apos;', '\''), '&lt;', '<'), '&gt;', '>'), '&amp;', '&'),
    r'^\s+|\s+$', '', 'g');

// === текст с разметкой ===
// Обратная к plainFromHtml: телефон присылает простой текст, а поле сообщения — RICHTEXT,
// то есть HTML редактора. Простой текст заворачивается в абзац, переносы становятся <br>,
// спецсимволы экранируются: иначе набранное с устройства «<проверить>» уехало бы в ленту
// как невалидный тег, и разбираять его пришлось бы и десктопу, и телефону. Потребителей
// у формулы два — сообщение ленты задачи (TaskCommentApi.apiAddTaskComment, #36844) и
// сообщение чата (ChatApi.apiAddChatMessage, #37366), — поэтому она живёт здесь, а не
// в каждом из них: два экземпляра означали бы два места, где чинить одну и ту же ошибку
// экранирования.
htmlFromPlain (TEXT t) = '<p>' + replace(replace(escapeXMLValue(t), '\r', ''), '\n', '<br>') + '</p>';

// === цвет текстом ===
// Цвета оформления и показателей хранятся строкой `#RRGGBB` — так их вставляют из
// брендбука, и так их разбирает телефон. Проверка одна на все такие поля: «зелёный»
// телефон молча заменит своей палитрой, а восьмизначный `#AARRGGBB` примет и сделает
// шапку почти прозрачной. Решётка необязательна (клиент понимает и без неё), пусто —
// законно: пустое поле значит «цвет приложения». Шаблон — сырой строкой: в обычной
// `{6}` прочиталось бы как ключ локализации.
invalidColor (STRING s) = TRUE IF s AND NOT regexPatternMatch(s, r'^#?[0-9A-Fa-f]{6}$');

// === даты словами ===
// Дата и время в текстах для человека — сообщениях бэк-офиса и уведомлениях: «04.09.2026
// 10:42», а не ISO-строка «2026-09-04 10:42:48», в которую превращает прямой каст к STRING
// (приёмка 10.09, п. 2). Тот же to_char, что в StoreTaskNumberUtils.numericString. В
// ответах API даты остаются ISO — это контракт с телефоном.
dateText (DATE d) = STRING[10](toChar(d, 'DD.MM.YYYY'));
dateTimeText (DATETIME d) = STRING[16](toChar(d, 'DD.MM.YYYY HH24:MI'));
