MODULE StoreTaskNumberUtils;

REQUIRE Utils;

NAMESPACE StoreTask;

// Число как текст без хвостовых нулей масштаба: прямой каст NUMERIC -> STRING сохраняет
// масштаб колонки («12.0000», «62.50»), а бланк должен читаться как «12» и «62.5».
// to_char с FM-маской гасит незначащие нули дробной части (позиции 9), но у целого
// оставляет висячую точку («12.») — её снимает rtrim. Маска на 14 целых разрядов —
// по ширине NUMERIC[18,4], чтобы большое значение не выродилось в «###».
numericString (NUMERIC[18,4] n) = STRING[20](rtrim(toChar(n, r'FM99999999999990.9999'), r'.'));
