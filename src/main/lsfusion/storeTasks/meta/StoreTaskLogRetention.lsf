MODULE StoreTaskLogRetention;

// StoreTaskRegulation — ensureDailyRegulation; SystemEvents — onFinallyStarted; Time —
// currentDateTime/subtractDay в метакоде ниже (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskRegulation, SystemEvents, Time;

NAMESPACE StoreTask;

// ===== Срок хранения журналов подсистемы (#37347). =====
// Журнал координат и журнал AI-запросов — персональные данные: кто, где и когда был, что
// просил у модели. Хранятся они ограниченный срок: у каждого журнала своя настройка в днях,
// рядом с остальными настройками его модуля, а старое удаляет одно действие на все журналы.
// Журнал встаёт в него метакодом ниже. Ядро про журналы пакетов не знает: журнал координат
// (api/GeoLog) живёт в ядре, журнал AI-запросов (ai/AiRequest) — в своём пакете, и хост без
// пакета получает то же действие без его половины.
//
// Документы с журналами не путать: обращения к генератору гипотез (HypothesisJob) принадлежат
// версии проверки и уходят вместе с ней — сюда они не входят.
cleanLogs 'Удалить записи журналов старше срока хранения' ABSTRACT LIST ();

// Сколько записей уходит одним APPLY. Больше — длиннее транзакция, меньше — дольше вся
// очистка. Платформа перед удалением объекта обнуляет каждое его свойство отдельным проходом,
// поэтому цена записи растёт с числом свойств журнала: на пяти тысячах транзакция идёт около
// секунды у журнала координат и до трёх — у журнала AI-запросов.
logCleanBatch () = 5000;

// Журнал — класс со свойством dateTime; keepDays — срок в днях, уже с подставленным значением
// по умолчанию; title — как журнал назвать в сообщении.
//
// Пачками, каждая своей сессией и своим APPLY: журнал, накопленный за год, — сотни тысяч
// записей, и удалять их одной транзакцией значит держать её всё время удаления. Граница срока
// считается один раз, до первой пачки: прогон не гонится за временем. Порядок не задаётся:
// без него платформа берёт пачку по возрастанию ключа, то есть в порядке создания записей, —
// старое уходит первым и без сортировки журнала по времени.
//
// Продолжать можно только после применённой пачки: отменённый APPLY оставил бы те же записи
// на месте, и цикл выбирал бы их снова без конца. Остаток подберёт следующий прогон.
//
// Сообщение — итог прогона: у задания планировщика оно ложится в его журнал, и по нему видно,
// сколько и по какому сроку удалено.
META defineLogRetention (cls, keepDays, title)
    clean###cls () {
        LOCAL NESTED limit = DATETIME ();
        LOCAL NESTED more = BOOLEAN ();
        LOCAL NESTED batch = INTEGER ();
        LOCAL NESTED total = INTEGER ();
        LOCAL NESTED stopped = BOOLEAN ();

        limit() <- subtractDay(currentDateTime(), keepDays());
        more() <- TRUE;
        WHILE more() DO {
            more() <- NULL;
            NEWSESSION {
                LOCAL expired = BOOLEAN (cls);
                FOR dateTime(cls r) < limit() TOP logCleanBatch() DO
                    expired(r) <- TRUE;
                batch() <- GROUP SUM 1 IF expired(cls r);
                DELETE cls r WHERE expired(r);
                APPLY;
                IF canceled() THEN
                    stopped() <- TRUE;
                ELSE {
                    total() <- total() (+) batch();
                    more() <- TRUE IF batch() >= logCleanBatch();
                }
            }
        }

        MESSAGE CONCAT '', title, ': удалено записей — ', (OVERRIDE total(), 0),
                ' (старше ', keepDays(), ' дн.)',
                ('; очистка прервана: пачка не применилась, остаток — следующим прогоном' IF stopped()) NOWAIT;
    }

    cleanLogs () + { clean###cls(); }
END

// Регламент (#37345): раз в сутки в 02:30 и при каждом старте сервера. Ночью — когда с
// телефонов не работают; до 03:00 — на это время платформа по умолчанию ставит своё
// «Обслуживание БД», и его VACUUM подбирает удалённое в ту же ночь. Имя — ключ, см.
// StoreTaskRegulation.
onFinallyStarted () + { ensureDailyRegulation('Пульс: очистка журналов', 'StoreTask.cleanLogs[]', 02:30); }
