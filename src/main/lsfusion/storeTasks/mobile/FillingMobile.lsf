MODULE FillingMobile;

REQUIRE Filling, Field, StoreTaskMobile, FormTask;

NAMESPACE StoreTask;

// Web-mobile fill screen for a unified filling (checklist / procedure) — single
// column, big controls. The native Flutter client uses FillApi instead; this is
// the lsFusion web-mobile parallel, dispatched via openMobileExecution.
FORM fillingMobile 'Заполнение'
    OBJECTS e = Filling PANEL
    PROPERTIES(e) nameObject READONLY, nameTemplate READONLY,
                  percent READONLY, nameVerdict READONLY, nameResolution,
                  nameState READONLY
    PROPERTIES(e) finish

    OBJECTS fld = Field
    PROPERTIES(fld) READONLY nameSection, name
    PROPERTIES nameOptionValue(e, fld), numberValue(e, fld), textValue(e, fld),
               boolValue(e, fld), dateValue(e, fld), firstPhoto(e, fld), countPhoto(e, fld),
               comment(e, fld), needsEvidence(e, fld) READONLY
    FILTERS template(fld) = template(e)
    ORDERS sectionIndex(fld), index(fld)

    EDIT Filling OBJECT e
;

DESIGN fillingMobile {
    OBJECTS {
        NEW head {
            alignment = STRETCH;
            MOVE PROPERTY(nameObject(e)) { fontSize = 18; }
            MOVE PROPERTY(nameTemplate(e));
            NEW headLine {
                horizontal = TRUE;
                alignment = STRETCH;
                MOVE PROPERTY(percent(e)) { fontSize = 22; }
                MOVE PROPERTY(nameVerdict(e));
                MOVE PROPERTY(nameResolution(e));
                MOVE PROPERTY(nameState(e));
                MOVE PROPERTY(finish(e)) { fontSize = 16; }
            }
        }
        MOVE BOX(fld) { caption = 'Поля'; fill = 1; }
    }
}

// dispatch: a filling execution opens the filling mobile screen
openMobileExecution(Filling e) + {
    SHOW fillingMobile OBJECTS e = e DOCKED NEWSESSION;
}

// task card subtitle for template-driven tasks (NULL for other types)
mobileSubtitle(Task t) += ISTRING[100](nameTemplate(t));
