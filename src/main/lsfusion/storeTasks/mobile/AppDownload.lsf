MODULE AppDownload;

// StoreTaskSettings — за форму настроек и папку навигатора, в которые встают путь и
// пункт скачивания. Явно, транзитивному REQUIRE не доверять.
REQUIRE StoreTaskSettings;

NAMESPACE StoreTask;

// ===== Раздача мобильного приложения. =====
// Приложение ставят не через магазин: заказчик выкладывает apk у себя, а сотрудник
// скачивает его по ссылке, которую ему дали. «Ссылку, которую дали» до сих пор давали
// в переписке — и на следующей сборке половина сети оставалась со старой версией.
//
// Здесь она живёт в самой системе: администратор кладёт файл на сервер и один раз
// прописывает путь, а в навигаторе появляется пункт «Скачать приложение». Путь, а не
// файл в базе, — сознательно: apk весит десятки мегабайт, обновляется чаще, чем что-либо
// в справочниках, и класть его в резервную копию базы вместе с задачами незачем.

// Путь читается НА СЕРВЕРЕ: файл берёт сервер и отдаёт его клиенту загрузкой. Поэтому
// здесь именно путь — абсолютный или относительный рабочей папке сервера, — а не ссылка:
// http-адрес сервер стал бы искать на диске как файл и не нашёл бы. Заодно раздача не
// зависит от того, с какого адреса открыт клиент и виден ли сервер снаружи.
apkPath 'Путь к файлу приложения (apk) на сервере' = DATA ISTRING[500] () CHARWIDTH 40;

// Что показывать рядом с кнопкой: версия и дата сборки — их проще перепечатать руками,
// чем вытащить из apk, а человеку важно ровно это — «та ли у меня версия».
apkVersion 'Версия' = DATA ISTRING[50] () CHARWIDTH 10;
apkUpdated 'Дата сборки' = DATA DATE ();

apkAvailable () = TRUE IF apkPath();

// Открытие идёт у клиента: веб-клиент отдаёт файл браузеру как загрузку, десктопный —
// открывает системным способом. Проверка «настроен ли путь» здесь, а не в SHOWIF, —
// пункт навигатора виден администратору всегда, и молчаливое ничего по нажатию было бы
// хуже внятного отказа.
downloadApk 'Скачать приложение' () {
    IF NOT apkPath() THEN {
        MESSAGE 'Путь к apk не задан. Укажите его в «Настройка → Настройки → Мобильное приложение».';
        RETURN;
    }
    open(apkPath());
}

EXTEND FORM options
    PROPERTIES() apkPath, apkVersion, apkUpdated, downloadApk
;

DESIGN options {
    tabbedPane {
        NEW mobileApp {
            caption = 'Мобильное приложение';
            MOVE PROPERTY(apkPath());
            NEW mobileAppRelease {
                horizontal = TRUE;
                MOVE PROPERTY(apkVersion());
                MOVE PROPERTY(apkUpdated());
            }
            MOVE PROPERTY(downloadApk());
        }
    }
}

NAVIGATOR {
    storeTask {
        NEW downloadApk;
    }
}
