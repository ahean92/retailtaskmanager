MODULE ScheduleForms;

// SchedulePlan — правило, его арифметика (daysBetween/matchesPeriodStart на её основе),
// generateForRule/fireable; StoreTaskCore — Task, checkObject/type/deadline/start/closed/
// opened/nameStatus; StoreTaskForms — формы task/tasks (переход к задаче, врезки правила);
// StoreTaskSettings — папки operations/catalogs; ObjectCategory — ObjectCategory, id/name,
// category(CheckObject); StoreTaskType — TaskType; FormTask — formTaskType; CheckObject —
// CheckObject, id/name; Time — currentDate, iterate/interval/from/to, extractDay,
// firstDayOfMonth/lastDayOfMonth (транзитивному REQUIRE не доверять)
REQUIRE SchedulePlan, StoreTaskCore, StoreTaskForms, StoreTaskSettings, ObjectCategory, StoreTaskType,
        FormTask, CheckObject, Time;

NAMESPACE StoreTask;

// ===== Десктоп планировщика: календарь «объекты × даты», карточка и список правил, =====
// ===== врезки правила в карточку и список задач. =====
// Модель и генератор — SchedulePlan; здесь только то, что смотрит человек: клетки календаря
// (задача/прогноз/цвет/счётчик), диалог «задачи и правила на день», выбор категории, формы
// и навигатор.

// --- calendar view: stores × dates, colour when task exists, click → open task ---
// Row/cell filters. Both LOCAL NESTED so they survive APPLY. Empty = no filter.
categoryFilter = DATA LOCAL NESTED ObjectCategory ();
nameCategoryFilter 'Категория' () = name(categoryFilter());

taskTypeFilter = DATA LOCAL NESTED TaskType ();
nameTaskTypeFilter 'Тип задачи' () = name(taskTypeFilter());

// A task's calendar day: deadline if set, otherwise start. Both are DATA dates.
taskDate (Task t) = OVERRIDE deadline(t), start(t);

// The task shown in cell (o, d) — any task on this store landing on this day
// that also matches the (optional) type filter.
taskAt (CheckObject o, DATE d) =
    GROUP MAX Task t IF checkObject(t) = o AND taskDate(t) = d
                    AND (NOT taskTypeFilter() OR type(t) = taskTypeFilter());

// "Does `d` fall on the period grid of a rule?" Written in pure lsFusion so the
// result is guaranteed to be TRUE or NULL — a FORMULA BOOLEAN returning PG's FALSE
// leaks through as truthy under lsFusion's boolean rules and paints every cell yellow.
// Modulo is emulated via integer division: n divides x iff (x/n)*n = x.
periodOffset (SchedulePlan r, DATE d) = daysBetween(d, startDate(r));
matchesPeriodStart (SchedulePlan r, DATE d) =
    TRUE IF periodOffset(r, d) >= 0
        AND periodOffset(r, d) = (periodOffset(r, d) / periodDays(r)) * periodDays(r);

// Rule that plans this store for this date. Forecast is FUTURE only (d >= today):
// past periods without an actual task are just history, not plans — they should stay
// white, not yellow. type(r) may be NULL — the generator falls back to formTaskType(),
// so a rule without a type matches a filter of "form".
plannedAt (CheckObject o, DATE d) =
    GROUP MAX SchedulePlan r IF
        active(r) AND category(o) = category(r)
        AND d >= currentDate()
        AND matchesPeriodStart(r, d)
        AND (NOT taskTypeFilter()
             OR type(r) = taskTypeFilter()
             OR (NOT type(r) AND taskTypeFilter() = formTaskType()));

// How many tasks / plans live in the cell (o, d). Same filters as taskAt / plannedAt,
// so the count matches what the eye sees.
countTaskAt (CheckObject o, DATE d) =
    GROUP SUM 1 IF Task t IS Task AND checkObject(t) = o AND taskDate(t) = d
                AND (NOT taskTypeFilter() OR type(t) = taskTypeFilter());

countPlanAt (CheckObject o, DATE d) =
    GROUP SUM 1 IF SchedulePlan r IS SchedulePlan
                AND active(r) AND category(o) = category(r)
                AND d >= currentDate()
                AND matchesPeriodStart(r, d)
                AND (NOT taskTypeFilter()
                     OR type(r) = taskTypeFilter()
                     OR (NOT type(r) AND taskTypeFilter() = formTaskType()));

countAt (CheckObject o, DATE d) =
    (OVERRIDE countTaskAt(o, d), 0) (+) (OVERRIDE countPlanAt(o, d), 0);

// Cell colour, priority order: task status → forecast → default white.
//   green  — task closed
//   red    — task open and past deadline
//   blue   — task open in progress
//   yellow — no task yet, but a rule plans one for this day
//   white  — nothing planned or done
backgroundAt (CheckObject o, DATE d) =
    CASE
        WHEN closed(taskAt(o, d))                                             THEN RGB(200, 255, 200)
        WHEN opened(taskAt(o, d)) AND deadline(taskAt(o, d)) < currentDate() THEN RGB(255, 200, 200)
        WHEN taskAt(o, d)                                                     THEN RGB(200, 220, 255)
        WHEN plannedAt(o, d)                                                  THEN RGB(255, 240, 150)
        ELSE                                                                       RGB(255, 255, 255)
    ;

// Cell value — the count for cells with MORE THAN one task/plan (1 gets its colour
// but no number, to keep the calendar tidy). Empty otherwise (a bare space so the
// value stays non-null, avoiding the "Не определено" placeholder for empty ISTRING).
cellText 'Задача' (CheckObject o, DATE d) =
    OVERRIDE
        (STRING[3](countAt(o, d)) IF countAt(o, d) > 1),
        (STRING[1](' ') IF o IS CheckObject AND d IS DATE);

// `openTaskAt` is defined below the FORM schedulePlan declaration — it needs to
// SHOW that form on click, and lsFusion requires declaration-before-use.

// Row filter over a date interval: a store belongs on the calendar iff it has any
// task or planned period landing within the interval. Same filters as the coloured
// cells, so what appears matches what's shown.
hasActivityInInterval (CheckObject o, INTERVAL[DATE] i) =
    GROUP SUM 1 IF iterate(DATE d, from(i), to(i))
                AND (taskAt(o, d) OR plannedAt(o, d));

// --- category picker helper ---
// categoryId is a plain ISTRING because storing the id keeps the rule stable across a
// host classifier re-import (see class comment). This dialog lets the operator pick a
// concrete ObjectCategory instead of typing the id by hand.
FORM objectCategoriesLookup 'Категории'
    OBJECTS c = ObjectCategory
    PROPERTIES(c) READONLY id, name
    LIST ObjectCategory OBJECT c
;

chooseCategory 'Выбрать категорию...' (SchedulePlan p) {
    DIALOG objectCategoriesLookup OBJECTS c INPUT DO {
        categoryId(p) <- id(c);
    }
}

// --- edit card ---
FORM schedulePlan 'Правило авто-создания задач'
    OBJECTS p = SchedulePlan PANEL
    PROPERTIES(p) name, archived,
                  nameTemplate, nameType,
                  categoryId, nameCategory READONLY,
                  startDate, periodDays, leadDays, deadlineDays,
                  nameAssignedTo, nameAssignByRole,
                  namePriority
    PROPERTIES(p) chooseCategory, generateForRule

    // forecast list — one row per upcoming period, laid out flat
    OBJECTS n = INTEGER
    PROPERTIES(p, n) READONLY futureTemplate, futureCategory,
                              futureCreate, futureStart, futureDeadline
    FILTERS          iterate(n, 0, 11)
    ORDERS           futureStart(p, n)

    EDIT SchedulePlan OBJECT p
;

DESIGN schedulePlan {
    OBJECTS {
        NEW header {
            alignment = STRETCH;
            NEW mainRow {
                horizontal = TRUE;
                alignment = STRETCH;
                MOVE PROPERTY(name(p)) { flex = 1; fontSize = 16; }
                MOVE PROPERTY(archived(p)) { flex = 0; }
            }
            NEW targetRow {
                horizontal = TRUE;
                alignment = STRETCH;
                MOVE PROPERTY(nameTemplate(p)) { flex = 1; }
                MOVE PROPERTY(nameType(p)) { flex = 0; }
            }
            NEW categoryRow {
                horizontal = TRUE;
                alignment = STRETCH;
                MOVE PROPERTY(categoryId(p)) { flex = 0; }
                MOVE PROPERTY(nameCategory(p)) { flex = 1; }
                MOVE PROPERTY(chooseCategory(p)) { flex = 0; }
            }
            NEW periodRow {
                horizontal = TRUE;
                alignment = STRETCH;
                MOVE PROPERTY(startDate(p)) { flex = 0; }
                MOVE PROPERTY(periodDays(p)) { flex = 0; }
                MOVE PROPERTY(leadDays(p)) { flex = 0; }
                MOVE PROPERTY(deadlineDays(p)) { flex = 0; }
                MOVE PROPERTY(namePriority(p)) { flex = 0; }
            }
            NEW assignRow {
                horizontal = TRUE;
                alignment = STRETCH;
                MOVE PROPERTY(nameAssignByRole(p)) { flex = 1; }
                MOVE PROPERTY(nameAssignedTo(p)) { flex = 1; }
                MOVE PROPERTY(generateForRule(p)) { flex = 0; }
            }
        }
        MOVE BOX(n) { caption = 'Прогноз: ближайшие 12 периодов'; fill = 1; }
    }
}

// --- list of rules ---
FORM schedulePlans 'Авто-создание задач'
    OBJECTS p = SchedulePlan
    PROPERTIES(p) READONLY name, nameTemplate, nameCategory,
                           startDate, periodDays, leadDays, deadlineDays,
                           nameAssignByRole, nameAssignedTo, namePriority, archived
    PROPERTIES(p) NEWSESSION NEW, EDIT, DELETE
    PROPERTIES(p) generateForRule TOOLBAR

    FILTERGROUP active
        FILTER '{Active}' active(p) 'F8' DEFAULT
        FILTER 'В архиве' archived(p) 'F7'

    FILTERGROUP fireable
        FILTER 'Готовы к запуску' fireable(p) 'F9'

    LIST SchedulePlan OBJECT p
;

// Row actions used by `cellDetails` — one row = one task or one plan; the operator
// picks which one to open. Declared before the form that references them.
openTaskFromCell 'Открыть' (Task t) {
    SHOW task OBJECTS t = t DOCKED;
}

openPlanFromCell 'Открыть' (SchedulePlan r) {
    SHOW schedulePlan OBJECTS p = r DOCKED;
}

// Two lists (tasks + plans) filtered to a specific (store, date). Same filters as
// the calendar itself, so what shows here matches what shows there.
FORM cellDetails 'Задачи и правила на день'
    OBJECTS o = CheckObject PANEL, d = DATE PANEL
    PROPERTIES(o) READONLY name
    PROPERTIES    dateHeader = VALUE(d) READONLY

    OBJECTS t = Task
    PROPERTIES(t) READONLY id, name, nameStatus, nameType, deadline
    PROPERTIES(t) openTaskFromCell TOOLBAR
    FILTERS       checkObject(t) = o AND taskDate(t) = d
                  AND (NOT taskTypeFilter() OR type(t) = taskTypeFilter())

    OBJECTS r = SchedulePlan
    PROPERTIES(r) READONLY name, nameTemplate, periodDays
    PROPERTIES(r) openPlanFromCell TOOLBAR
    FILTERS       active(r) AND category(o) = category(r)
                  AND d >= currentDate()
                  AND matchesPeriodStart(r, d)
                  AND (NOT taskTypeFilter()
                       OR type(r) = taskTypeFilter()
                       OR (NOT type(r) AND taskTypeFilter() = formTaskType()))
;

// Click handler:
//   * count > 1     -> open the details dialog (list of tasks + plans)
//   * task present  -> open the task
//   * only planned  -> open the rule that plans this day
//   * empty cell    -> nothing
openTaskAt (CheckObject o, DATE d) {
    IF countAt(o, d) > 1 THEN
        SHOW cellDetails OBJECTS o = o, d = d DOCKED;
    ELSE IF taskAt(o, d) THEN
        SHOW task OBJECTS t = taskAt(o, d) DOCKED;
    ELSE IF plannedAt(o, d) THEN
        SHOW schedulePlan OBJECTS p = plannedAt(o, d) DOCKED;
}

// Stores × dates. Cell = coloured block. Click → open the task (or the rule for a
// forecast cell). Filters: date interval + category + task type.
FORM scheduleOverview 'График проверок'
    OBJECTS dates = INTERVAL[DATE] PANEL NULL
    PROPERTIES dates = VALUE(dates)

    PROPERTIES() nameCategoryFilter, nameTaskTypeFilter

    OBJECTS d = DATE
    FILTERS  iterate(d, from(dates), to(dates))

    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, name
    PROPERTIES    cellText(o, d) COLUMNS (d) HEADER extractDay(d)
                  BACKGROUND backgroundAt(o, d)
                  ON CHANGE openTaskAt(o, d)

    FILTERS   hasActivityInInterval(o, dates) AND name(o)
              AND (NOT categoryFilter() OR category(o) = categoryFilter())
    ORDERS    name(o)

    EVENTS ON INIT {
        SEEK scheduleOverview.dates =
            interval(firstDayOfMonth(currentDate()), lastDayOfMonth(currentDate()));
    }
;

DESIGN scheduleOverview {
    // narrow column — fits a 1-3 digit count; single click fires ON CHANGE → openTaskAt
    PROPERTY(cellText(o, d)) { charWidth = 3; changeOnSingleClick = TRUE; }
}

NAVIGATOR {
    operations {
        NEW scheduleOverview;
    }
    catalogs {
        NEW schedulePlans;
    }
}

// --- surface rule provenance on the existing task views ---
// Task grid gains a "График" column and a filter to split scheduled from manual tasks.
// The task card shows rule + period read-only when the task was auto-created.
EXTEND FORM tasks
    PROPERTIES(t) READONLY nameRule, periodStart

    FILTERGROUP source
        FILTER 'Авто-создана' rule(t) 'F3'
        FILTER 'Заведены вручную' NOT rule(t) 'F2'
;

EXTEND FORM task
    PROPERTIES(t) READONLY nameRule SHOWIF rule(t),
                           periodStart SHOWIF rule(t)
;

DESIGN task {
    object {
        MOVE PROPERTY(nameRule(t));
        MOVE PROPERTY(periodStart(t));
    }
}
