MODULE SchedulePlan;

// StoreTaskCore — Task, checkObject/name/priority/assignedTo/deadline/start/type(Task);
// FormTask — template(Task), formTaskType; Template — Template; StoreTaskType — TaskType;
// StoreTaskPriority — TaskPriority; TaskPerformer — TaskPerformer, name; ObjectCategory —
// ObjectCategory, id/name, category(CheckObject); ObjectRole — ObjectRole, person; CheckObject —
// CheckObject; Time — currentDate/currentDateTime, sum/subtract по датам; Utils — iterate по
// целым; StoreTaskRegulation — ensureDailyRegulation; SystemEvents — onFinallyStarted
// (транзитивному REQUIRE не доверять)
// TemplateVersion — шов rebindTemplate, в который модуль складывает перевод СВОЕЙ ссылки
// на шаблон при публикации новой редакции
REQUIRE StoreTaskCore, FormTask, Template, TemplateVersion, StoreTaskType, StoreTaskPriority, TaskPerformer,
        ObjectCategory, ObjectRole, CheckObject, Time, Utils, StoreTaskRegulation, SystemEvents;

NAMESPACE StoreTask;

// ===== Правило авто-создания задач: модель, арифметика периодов, прогноз, генератор. =====
// Представление — ScheduleForms: карточка и список правил, календарь «График проверок»,
// врезки правила в карточку и список задач. Здесь ни одной формы: генератор зовёт платформенный
// планировщик (generateAll) из системного контекста, и модель обязана жить без десктопа.
//
// A rule that auto-creates tasks on a schedule ("this template, on every object of
// category X, every 30 days starting Aug 1"). Deliberately references the category by
// its stable id (ISTRING), not by an object link: in an ERP-host build the categorizer
// is host-owned (EXTEND CLASS StoreFormat : ObjectCategory), and a re-import-with-delete
// would strand a direct link. The id stays the same across such refreshes.
//
// Periods anchor to an operator-set startDate and step by periodDays. This is a very
// literal, no-magic model:
//   day 0                       startDate                (first period)
//   day periodDays              startDate + periodDays   (next period)
//   ...
// A monthly rule = periodDays = 30 (or 28/31 to taste); weekly = 7; daily = 1. Real
// calendar-month drift over years is acceptable — the operator can pick their own step.
// Choosing this over freqUnit={day,week,month} + firstDayOfWeek/firstDayOfMonth removes
// three FORMULA'd branches and the counter-intuitive "monthly rule fires only on the
// 31st" behavior that surfaced during the first run.

CLASS SchedulePlan 'Правило авто-создания задач';

name '{Name}' = DATA ISTRING[150] (SchedulePlan) IN id CHARWIDTH 25;
archived 'В архиве' = DATA BOOLEAN (SchedulePlan) IN base;
active '{Active}' (SchedulePlan p) = NOT archived(p);

// what to generate
template = DATA Template (SchedulePlan);
nameTemplate 'Шаблон' (SchedulePlan p) = name(template(p));

// task type — form / checklist / recount / pricing (whatever the operator picks).
// Left NULL means the generator falls back to the generic 'form' type at write time.
type = DATA TaskType (SchedulePlan);
nameType 'Тип задачи' (SchedulePlan p) = name(type(p));

// which objects — by category id, not by object link (see class comment)
categoryId 'Категория (ID)' = DATA ISTRING[30] (SchedulePlan) CHARWIDTH 10;
category (SchedulePlan p) = GROUP MAX ObjectCategory c IF id(c) = categoryId(p);
nameCategory 'Категория' (SchedulePlan p) = name(category(p));

// periodicity — anchor date + step in days. All the period math is derived from these
// two fields; no calendar-week / calendar-month arithmetic at all.
startDate 'Дата начала' = DATA DATE (SchedulePlan);
periodDays 'Период, дней' = DATA INTEGER (SchedulePlan);

CONSTRAINT periodDays(SchedulePlan p) AND periodDays(p) <= 0
    MESSAGE 'Период должен быть больше нуля';

// how many days BEFORE THE PERIOD START the task appears in the list. NULL means "at
// the period start" (task is visible for the whole period) — that is the least
// surprising default. A non-null value makes the task show up ahead of its period.
leadDays 'За, дней до срока' = DATA INTEGER (SchedulePlan);

// how many days the performer has to complete the task, counted from the PERIOD START
// (never from the appearance date — `leadDays` does not move it) and INCLUDING that
// first day: N = 4 on a period opening Sep 1 means a deadline of Sep 4, not Sep 5.
// Same "first day counts" convention as periodEnd = start + periodDays - 1, so
// deadlineDays = periodDays gives exactly the end of the period.
// NULL means "until the end of the period" (whole bucket). Set this when the task
// should NOT stretch across the whole period — e.g. monthly rule, but only 7 days
// to complete once it lands.
deadlineDays 'Срок выполнения, дн. (включая первый день)' = DATA INTEGER (SchedulePlan);

CONSTRAINT deadlineDays(SchedulePlan p) AND deadlineDays(p) <= 0
    MESSAGE 'Срок выполнения должен быть больше нуля';

// assignment — hybrid: role on the object wins (that is the whole point of ObjectRole),
// fixed performer is the fallback. NULL means "no assignee" — the task is still created.
assignedTo = DATA TaskPerformer (SchedulePlan);
nameAssignedTo 'Исполнитель' (SchedulePlan p) = name(assignedTo(p));

assignByRole = DATA ObjectRole (SchedulePlan);
nameAssignByRole 'Роль на объекте' (SchedulePlan p) = name(assignByRole(p));

priority = DATA TaskPriority (SchedulePlan);
namePriority 'Приоритет' (SchedulePlan p) = name(priority(p));

// --- Task-side extensions: which rule created this task and for which period ---
// Two DATA properties on Task, so a "мои задачи" list can filter by rule/period, and
// so the generator's dedup lookup is a plain aggregate. Kept on Task rather than in
// a separate log so a hand-created task and a generated one live in the same table
// (a manual task by definition has NULL rule).
rule = DATA SchedulePlan (Task);
nameRule 'Правило авто-создания' (Task t) = name(rule(t));

periodStart 'Начало периода' = DATA DATE (Task);

// --- до какого периода график доведён (#37345) ---
// Начало последнего периода, который генератор обработал по правилу. От него на следующем
// прогоне отсчитываются пропущенные периоды. Пусто — правило ещё не обрабатывалось, и
// генератор начинает с текущего периода, ничего не объявляя пропущенным: правило, заведённое
// с датой начала в прошлом, не «пропускало» периоды до своего рождения.
servicedPeriod 'Обработан по период' = DATA DATE (SchedulePlan);

// Перенастроенная сетка (дата начала, период) и архив снимают отметку: правило начинает с
// текущего периода, а не объявляет пропущенным всё, что легло между старой сеткой и новой.
WHEN SETCHANGED(startDate(SchedulePlan p)) OR SETCHANGED(periodDays(p)) OR SET(archived(p)) DO
    servicedPeriod(p) <- NULL;

// --- журнал графика (#37345) ---
// Строка на каждый обработанный период правила: сколько задач по нему создано или почему их
// нет. Ответ на «какой проверки не было и почему», которого у графика не было: задачи за
// пропущенный период не создавались, и следа от него не оставалось нигде.
CLASS ScheduleLog 'Журнал графика';
rule = DATA SchedulePlan (ScheduleLog) NONULL DELETE INDEXED;
nameRule 'Правило' (ScheduleLog l) = name(rule(l));
nameTemplate 'Шаблон' (ScheduleLog l) = nameTemplate(rule(l));
periodStart 'Начало периода' = DATA DATE (ScheduleLog);
periodEnd 'Конец периода' = DATA DATE (ScheduleLog);
deadline 'Срок' = DATA DATE (ScheduleLog);
dateTime 'Дата/время' = DATA DATETIME (ScheduleLog);
created 'Создано задач' = DATA INTEGER (ScheduleLog);
skipped 'Пропущен' = DATA BOOLEAN (ScheduleLog);
outcome 'Итог' (ScheduleLog l) =
    OVERRIDE (ISTRING[100]('пропущен: регламент не запускался') IF skipped(l)),
             ISTRING[100]('создано задач: ' + created(l));

// Одна строка на (правило, период): повторный прогон в том же периоде дописывает её, а не
// заводит вторую — тем же структурным ключом, что дедупликация уведомлений.
scheduleLog = GROUP AGGR ScheduleLog l BY rule(l), periodStart(l);

// --- period math ---
// PostgreSQL DATE - DATE = INTEGER (days). Wrapped in a FORMULA because lsFusion's
// bundled `subtract` only covers (DATE, INTEGER); we need the (DATE, DATE) direction.
daysBetween = FORMULA INTEGER '($1 - $2)::int';

// "Effectively today" for scheduling: shifted forward by leadDays. If leadDays = 3,
// on Aug 29 we already act as if it were Sep 1 — otherwise the first period of a rule
// starting Sep 1 would silently miss its lead time.
effectiveToday (SchedulePlan p) = sum(currentDate(), (OVERRIDE leadDays(p), 0));

// integer-division bucket index: which period we are currently servicing. Guarded so
// it stays NULL until the effective-today crosses startDate — no negative buckets.
bucketIndex (SchedulePlan p) =
    daysBetween(effectiveToday(p), startDate(p)) / periodDays(p)
    IF startDate(p) AND periodDays(p) AND effectiveToday(p) >= startDate(p);

// start of the currently open period — the marker written into periodStart(Task)
currentPeriodStart (SchedulePlan p) = sum(startDate(p), bucketIndex(p) * periodDays(p));

// last day of the currently open calendar bucket — the default deadline when
// `deadlineDays` is not set.
periodEnd (SchedulePlan p) = sum(currentPeriodStart(p), periodDays(p) - 1);

// when the task appears in the list — `leadDays` days BEFORE the period start.
//   leadDays SET  -> periodStart - leadDays (early birds)
//   leadDays NULL -> periodStart (task shows up the same day the period opens)
creationDate (SchedulePlan p) =
    OVERRIDE subtract(currentPeriodStart(p), leadDays(p)), currentPeriodStart(p);

// task's actual deadline — measured from period start, NOT from creationDate.
// `deadlineDays` is completely independent of `leadDays`.
//   deadlineDays SET  -> periodStart + (N - 1), i.e. the N-th day of the period with
//                        the period's first day counted as day 1 (N = 1 -> the
//                        deadline is the period start itself; N = 4 on a period
//                        opening Sep 1 -> Sep 4)
//   deadlineDays NULL -> end of the period (whole bucket)
taskDeadline (SchedulePlan p) =
    OVERRIDE sum(currentPeriodStart(p), deadlineDays(p) - 1), periodEnd(p);

// published(template(p)) — «архив» шаблона доведён до дела: правило, оставшееся на снятой
// редакции, перестаёт плодить по ней проверки, а не продолжает молча. Правило при этом не
// ломается и не чистится: публикация следующей редакции (#37174) перевесит его сама, а
// клону (#36985) его назначают руками. Черновик тем же условием отсекается: редакцию,
// которую ещё не опубликовали, график видеть не должен.
fireable 'Готов к запуску' (SchedulePlan p) =
    active(p) AND template(p) AND published(template(p)) AND category(p) AND startDate(p) AND periodDays(p)
    AND currentPeriodStart(p);

// Ссылка правила на шаблон переезжает на новую редакцию при её публикации (#37174).
// Реализация здесь, а не в TemplateVersion: свойство объявлено тут, и ядро про график
// знать не обязано — тот же приём, что у швов копирования шаблона.
rebindTemplate (Template f, Template t) + {
    template(SchedulePlan p) <- t WHERE template(p) = f;
}

// --- forecast: N periods ahead, computed on the fly ---
// A preview grid so the operator sees when future tasks will actually land while she
// tweaks startDate / periodDays / leadDays. Not stored anywhere — pure arithmetic over
// (SchedulePlan, period-offset INTEGER).
futureStart 'Начало периода' (SchedulePlan p, INTEGER n) = sum(startDate(p), n * periodDays(p));
futurePeriodEnd (SchedulePlan p, INTEGER n) = sum(futureStart(p, n), periodDays(p) - 1);
futureCreate 'Появится' (SchedulePlan p, INTEGER n) =
    OVERRIDE subtract(futureStart(p, n), leadDays(p)), futureStart(p, n);
// mirrors taskDeadline exactly, first day of the period included — keep the two in step
futureDeadline 'Срок' (SchedulePlan p, INTEGER n) =
    OVERRIDE sum(futureStart(p, n), deadlineDays(p) - 1), futurePeriodEnd(p, n);

// Rule-level context repeated per forecast row for readability. The `IF futureStart`
// guard keeps `n` genuinely used in the expression (lsFusion forbids unused parameters)
// and hides these cells for rows where the period itself can't be computed.
futureTemplate 'Шаблон' (SchedulePlan p, INTEGER n) = nameTemplate(p) IF futureStart(p, n);
futureCategory 'Категория' (SchedulePlan p, INTEGER n) = nameCategory(p) IF futureStart(p, n);

// Dedup guard: "does a task for this rule/object/period already exist?" Kept as a
// named property (rather than inlined into the FOR condition) both for readability
// and because the parser rejects a bare inline `[GROUP MAX ...]` in that position.
// Declared BEFORE generateForRule below — lsFusion requires declaration-before-use.
existingTask (SchedulePlan p, CheckObject o, DATE d) =
    GROUP MAX Task t IF rule(t) = p AND checkObject(t) = o AND periodStart(t) = d;

// То же по периоду целиком: период, за который задачи есть, пропущенным не считается.
periodTasks (SchedulePlan p, DATE d) = GROUP SUM 1 IF rule(Task t) = p AND periodStart(t) = d;

// --- какие периоды обрабатывать (#37345) ---
// Индекс периода по дате его начала — обратная арифметика к futureStart.
periodIndex (SchedulePlan p, DATE d) = daysBetween(d, startDate(p)) / periodDays(p);

// Первый ещё не обработанный период: следующий за отметкой; без отметки — текущий. Отметка
// старше даты начала — правило перенастроили, а событие сброса не догнало: тоже текущий.
firstPendingIndex (SchedulePlan p) =
    OVERRIDE ((periodIndex(p, servicedPeriod(p)) + 1) IF servicedPeriod(p) >= startDate(p)), bucketIndex(p);

// Текущий период обрабатывается всегда, даже если отметка уже на нём: объект, попавший в
// категорию посреди периода, получает задачу на следующем прогоне — так было и до #37345.
fromIndex (SchedulePlan p) =
    IF firstPendingIndex(p) < bucketIndex(p) THEN firstPendingIndex(p) ELSE bucketIndex(p);

// Строка журнала за период: заводится при первом касании, дальше дописывается.
recordPeriod (SchedulePlan p, INTEGER n) {
    IF NOT scheduleLog(p, futureStart(p, n)) THEN
        NEW l = ScheduleLog {
            rule(l) <- p;
            periodStart(l) <- futureStart(p, n);
            periodEnd(l) <- futurePeriodEnd(p, n);
            deadline(l) <- futureDeadline(p, n);
            dateTime(l) <- currentDateTime();
        }
}

recordSkipped (SchedulePlan p, INTEGER n) {
    recordPeriod(p, n);
    FOR ScheduleLog l = scheduleLog(p, futureStart(p, n)) DO
        skipped(l) <- TRUE;
}

// cnt — сколько создано этим прогоном; в строке копится: прогон посреди периода, доложивший
// задачу новому объекту категории, прибавляет её к созданным ранее.
recordCreated (SchedulePlan p, INTEGER n, INTEGER cnt) {
    recordPeriod(p, n);
    FOR ScheduleLog l = scheduleLog(p, futureStart(p, n)) DO
        created(l) <- (OVERRIDE created(l), 0) + cnt;
}

// --- generator ---
// Idempotent by construction — the existingTask guard checks by (rule, object,
// periodStart), so re-running within the same period creates nothing. Category is
// resolved on every run via id → resilient to a host re-import that wipes and re-
// creates the classifier.
//
// The whole thing runs in a NEWSESSION with APPLY: the Scheduler fires this from a
// system context with no form open, and each rule's batch should either commit as a
// whole or fail loudly (APPLY surfaces its own message).
//
// Периоды (#37345): от первого необработанного до текущего, по порядку. Период, срок
// которого ещё не прошёл, получает задачи; период с прошедшим сроком задач не получает — они
// родились бы уже просроченными — и уходит в журнал как пропущенный, если по нему ничего не
// создавалось. Текущий период — всегда как раньше: задачи создаются, даже если срок внутри
// периода уже позади (короткий deadlineDays), — это не пропуск, а обычная работа генератора.
generateForRule 'Сгенерировать сейчас' (SchedulePlan p) {
    // diagnostic path — a silent RETURN is the worst thing this button can do, so each
    // "not fireable" reason is surfaced explicitly. Order matches how a human reads a
    // rule top-to-bottom.
    IF NOT active(p)     THEN { MESSAGE 'Правило в архиве.'; RETURN; }
    IF NOT template(p)   THEN { MESSAGE 'Не задан шаблон.'; RETURN; }
    IF NOT published(template(p)) THEN { MESSAGE 'Шаблон «' + nameTemplate(p) + '» не опубликован: он в архиве или это черновик редакции. Опубликуйте редакцию — правило перевесится на неё само, — или назначьте правилу другой шаблон.'; RETURN; }
    IF NOT categoryId(p) THEN { MESSAGE 'Не задана категория.'; RETURN; }
    IF NOT category(p)   THEN { MESSAGE 'Категория с id "' + categoryId(p) + '" не найдена. Проверьте id или заведите категорию.'; RETURN; }
    IF NOT startDate(p)  THEN { MESSAGE 'Не задана дата начала.'; RETURN; }
    IF NOT periodDays(p) THEN { MESSAGE 'Не задан период (в днях).'; RETURN; }
    IF NOT currentPeriodStart(p) THEN {
        MESSAGE 'Правило ещё не в окне создания. Уменьшите дату начала или увеличьте «За, дней до срока».';
        RETURN;
    }

    NEWSESSION {
        LOCAL total = INTEGER ();
        LOCAL perPeriod = INTEGER ();
        LOCAL skippedTotal = INTEGER ();
        total() <- 0;
        skippedTotal() <- 0;

        FOR iterate(INTEGER n, fromIndex(p), bucketIndex(p)) ORDER n DO {
            IF n < bucketIndex(p) AND futureDeadline(p, n) < currentDate() THEN {
                IF NOT scheduleLog(p, futureStart(p, n)) AND NOT periodTasks(p, futureStart(p, n)) THEN {
                    recordSkipped(p, n);
                    skippedTotal() <- skippedTotal() + 1;
                }
            } ELSE {
                perPeriod() <- 0;
                FOR category(CheckObject o) = category(p) AND NOT existingTask(p, o, futureStart(p, n))
                    NEW t = Task DO {
                        rule(t) <- p;
                        periodStart(t) <- futureStart(p, n);
                        type(t) <- (OVERRIDE type(p), formTaskType());
                        template(t) <- template(p);
                        checkObject(t) <- o;
                        name(t) <- name(template(p));
                        priority(t) <- priority(p);
                        // исполнитель по умолчанию у правила мог уйти в архив — на него нельзя
                        // (StoreTaskCore); по роли архивных не отдаёт сам person()
                        assignedTo(t) <- (OVERRIDE person(o, assignByRole(p)), activePerformer(assignedTo(p)));
                        deadline(t) <- futureDeadline(p, n);
                        start(t) <- futureCreate(p, n);
                        perPeriod() <- perPeriod() + 1;
                    }
                recordCreated(p, n, perPeriod());
                total() <- total() + perPeriod();
            }
        }
        servicedPeriod(p) <- currentPeriodStart(p);

        // MESSAGE before APPLY on purpose: APPLY resets plain LOCALs, so reading
        // `total()` after it would yield NULL and the whole concatenation would
        // silently produce an empty message.
        MESSAGE 'Будет создано задач: ' + total()
            + (IF skippedTotal() > 0 THEN ', пропущено периодов: ' + skippedTotal() ELSE '');
        APPLY;
    }
}

// Entry point for the platform Scheduler — заводится сам (onFinallyStarted ниже). Runs every
// active rule; each rule is its own NEWSESSION, so a single rule's constraint violation
// does not abort the batch.
generateAll 'Сгенерировать задачи по всем графикам' () {
    // Правило, которое сейчас не готово (шаблон снят, категория не найдена…), отметку
    // теряет: когда оно снова заработает, журнал не должен объявить эти периоды «регламент
    // не запускался» — регламент запускался, не готово было правило. Своя сессия, как у
    // прогона: планировщик за действием сессию применяет, но полагаться на это незачем.
    NEWSESSION {
        servicedPeriod(SchedulePlan p) <- NULL WHERE active(p) AND NOT fireable(p) AND servicedPeriod(p);
        APPLY;
    }
    FOR active(SchedulePlan p) DO
        generateForRule(p);
}

// Регламент (#37345): раз в сутки в 00:30 — currentDate платформа к этому времени уже
// сменила — и сразу при каждом старте сервера: простой сервера нагоняется первыми секундами
// после старта, а не следующей ночью. Имя — ключ, см. StoreTaskRegulation.
onFinallyStarted () + { ensureDailyRegulation('Пульс: задачи по графику', 'StoreTask.generateAll[]', 00:30); }
