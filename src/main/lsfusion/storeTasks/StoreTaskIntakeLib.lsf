MODULE StoreTaskIntakeLib;

// Приём задач из внешних систем (MITE, хелпдеск, почта, руками) как один пакет: заявка и
// сопоставление площадки, справочник правил приёма, разбор «заявка → задача» и ручка
// apiTaskRequest. Требует только ядро; ядро о нём не знает — хост, которому внешние
// источники не нужны, пакет не подключает и ничего больше не теряет.
//
// Пакет ставится на своё место в сценарии «RTM внутри ERP заказчика, MITE рядом по HTTP».
// Слитый сценарий — артефакт, собранный и в MITE, и в ERP одной сборкой, — этого пакета не
// требует: там «инцидент → задача» становится обычным внутренним событием.
//
// Порядок REQUIRE — по зависимостям: модель заявки, справочник правил, разбор поверх обоих,
// ручка поверх разбора.
REQUIRE StoreTaskCoreLib,
        TaskRequest, IntakeRule, TaskIntake, TaskIntakeApi;

NAMESPACE StoreTask;
