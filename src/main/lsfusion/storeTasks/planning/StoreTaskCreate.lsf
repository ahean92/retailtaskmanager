MODULE StoreTaskCreate;

// Примитив создания задачи (doCreateTask) — один для ручки телефона, AI-черновика, пачки,
// сообщения чата и ручной перепроверки: проверки, сама задача, назначение исполнителя.
// StoreTaskTextUtils — htmlFromPlain: описание приходит простым текстом, поле — RICHTEXT;
// AssignRule — ruleAssignee, TaskPerformer — currentPerformer в assignCreatedTask
REQUIRE FormTask, SimpleExecution, StoreTaskTextUtils, AssignRule, TaskPerformer, StoreTaskCore, StoreTaskType,
        StoreTaskPriority, StoreTaskAcceptance, CheckObject, Template;

NAMESPACE StoreTask;

createdTask = DATA LOCAL Task ();
createRefusal = DATA LOCAL ISTRING[250] ();

templateMissing (TaskType type) =
    ISTRING[250](CONCAT ' ', 'Тип', '«' + name(type) + '»', 'заполняется по бланку — выберите бланк или другой тип') IF usesTemplate(type);

createDenied (Task t) = CASE
    WHEN NOT type(t) THEN ISTRING[250]('Не указан тип задачи')
    WHEN NOT name(t) THEN ISTRING[250]('Не указано название задачи')
    WHEN NOT checkObject(t) THEN ISTRING[250]('Не выбран объект')
    WHEN template(t) AND NOT usesTemplate(type(t)) THEN
        ISTRING[250](CONCAT ' ', 'Тип', '«' + name(type(t)) + '»', 'не заполняется по бланку — уберите бланк или смените тип')
    WHEN NOT template(t) AND usesTemplate(type(t)) THEN templateMissing(type(t))
    WHEN archived(assignedTo(t)) THEN
        ISTRING[250](CONCAT ' ', 'Исполнитель', '«' + name(assignedTo(t)) + '»', 'в архиве — выберите другого');

assignByPreset = ABSTRACT CASE BOOLEAN (STRING[30], TaskType, CheckObject, TaskPerformer);

// fromPhone — задача родилась на телефоне (apiCreateTask, задача из сообщения чата): только
// такая проверка по бланку — внеплановая. Пачка, AI-форма бэк-офиса и ручная перепроверка
// зовут тот же примитив, но внеплановыми не были: признак обещан отчётам для разделения.
doCreateTask (TaskType type, CheckObject object, ISTRING[250] name, Template tpl,
              TaskPerformer assignee, DATE created, DATE deadline, TaskPriority priority,
              TEXT descr, BOOLEAN photo, AcceptancePolicy acceptance, STRING[36] clientId,
              BOOLEAN fromPhone) {
    createdTask() <- NULL;
    createRefusal() <- NULL;
    NEW t = Task {
        IF clientId THEN clientId(t) <- clientId;
        type(t) <- type;
        checkObject(t) <- object;
        name(t) <- name;
        IF tpl THEN template(t) <- tpl;
        assignedTo(t) <- assignee;
        IF created THEN start(t) <- created;
        IF deadline THEN deadline(t) <- deadline;
        IF priority THEN priority(t) <- priority;
        IF descr THEN description(t) <- RICHTEXT(htmlFromPlain(descr));
        // требование фото выполнения приезжает данными пресета (#36716), не константой:
        // «позвонить поставщику» и «убрать витрину» — разные поручения
        requirePhoto(t) <- photo;
        // переопределение приёмки (#37157) — тем же путём, из пресета (apiQuickActions →
        // acceptance); без него — «как у типа», что и ставит событие по умолчанию
        IF acceptance THEN acceptancePolicy(t) <- acceptance;
        // задача с бланком, рождённая на телефоне, — внеплановая проверка: плановые
        // создаёт график (#36710) и бэк-офис
        IF fromPhone AND usesTemplate(type) THEN unplanned(t) <- TRUE;
        IF createDenied(t) THEN {
            createRefusal() <- createDenied(t);
            DELETE t;
        } ELSE
            createdTask() <- t;
    }
}

// Исполнитель задачи, созданной с телефона без явного исполнителя: по правилу назначения,
// если о нём просили (byRule), иначе — создатель. Общий шаг создания с телефона и задачи
// из сообщения чата; отказ по назначенному (createDenied — например, исполнитель в архиве)
// возвращается тем же createRefusal.
assignCreatedTask (BOOLEAN byRule) {
    IF NOT assignedTo(createdTask()) THEN
        assignedTo(createdTask()) <- OVERRIDE (ruleAssignee(createdTask()) IF byRule), currentPerformer();
    IF createDenied(createdTask()) THEN
        createRefusal() <- createDenied(createdTask());
}
