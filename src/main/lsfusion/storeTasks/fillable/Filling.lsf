MODULE Filling;

// FieldType — FieldType.number/scale/…; StoreTaskCore — checkObject(task(e)); StoreTaskForms —
// карточка task, которую модуль расширяет (транзитивному REQUIRE не доверять)
REQUIRE Execution, Template, Field, FillOption, Resolution, CheckAsset, VerdictScale, RefValue,
        StoreTaskNumberUtils, StoreTaskColor, FieldType, StoreTaskCore, StoreTaskForms;

NAMESPACE StoreTask;

// A filling of a template — the unified execution. A checklist inspection, a SIM swap,
// a repair are all fillings, differing only by their template's fields. Values are held
// as properties over (Filling, Field), typed by the field's FieldType.
CLASS Filling 'Заполнение' : Execution;
template = DATA Template (Filling);
nameTemplate 'Шаблон' (Filling e) = name(template(e));
// По какой редакции чек-листа проведена проверка (#37174): в сводах и списках заполнения
// разных редакций лежат рядом, и «по какому бланку это отвечали» — вопрос к строке
versionTemplate 'Редакция' (Filling e) = version(template(e));

// --- field values ---
optionValue = DATA Option (Filling, Field);
numberValue 'Значение' = DATA NUMERIC[14,4] (Filling, Field);
textValue 'Текст' = DATA ISTRING[500] (Filling, Field);
boolValue 'Да/Нет' = DATA TBOOLEAN (Filling, Field);
dateValue 'Дата' = DATA DATE (Filling, Field);
// Значение поля-ссылки (#36841): любой предмет справочника, а не только объект проверки —
// канал задаёт refKind(Field), объект проверки остаётся каналом 'object' по умолчанию.
// Рядом снимок текста на момент заполнения, тем же приёмом, что subjectName у строк:
// заполнение — документ, и увольнение сотрудника или переименование товара не должны
// менять акт задним числом. Снимок и есть свободный ввод: текст без ссылки.
refValue = DATA RefValue (Filling, Field);
refName 'Предмет' = DATA ISTRING[150] (Filling, Field);
nameRefValue 'Предмет' (Filling e, Field f) = OVERRIDE refName(e, f), name(refValue(e, f));
// Photos are keyed by an extra index, so a field holds 0..N of them: one shot rarely
// covers a whole display case, and an inspector who can attach only one ends up choosing
// which non-conformity to document. The index is 1-based and assigned by the API; it is
// NOT dense — удаление снимка по индексу (apiDeleteFieldPhoto) оставляет дыру.
photo 'Фото' = DATA IMAGEFILE (Filling, Field, INTEGER);
countPhoto 'Фото, шт.' (Filling e, Field f) = GROUP SUM 1 IF photo(e, f, INTEGER i);
lastPhotoIndex (Filling e, Field f) = GROUP MAX INTEGER i IF photo(e, f, i);
// «Первый снимок» для десктопной и печатной форм — минимальный СУЩЕСТВУЮЩИЙ индекс, а
// не единица: после удаления первого кадра (#36946) индексы не уплотняются, и жёсткое
// photo(e, f, 1) оставляло бы ячейку пустой при countPhoto = 2.
firstPhotoIndex (Filling e, Field f) = GROUP MIN INTEGER i IF photo(e, f, i);
// подпись обязательна: свойство уходит колонкой в печать задачи (StoreTaskPrint), а без
// неё платформа подставляет в акт имя свойства — колонка «First photo»
firstPhoto 'Фото' (Filling e, Field f) = photo(e, f, firstPhotoIndex(e, f));
// Фактические индексы снимков через запятую («1,3»): после удаления по индексу
// оставшиеся индексы НЕ уплотняются, так что «от 1 до countPhoto» — неправда, и
// клиент, который так итерирует, потеряет снимки за дырой (#36778, просмотр).
photoIndexes (Filling e, Field f) = GROUP CONCAT STRING(INTEGER i) IF photo(e, f, i), ',' ORDER i;
comment 'Комментарий' = DATA ISTRING[500] (Filling, Field) CHARWIDTH 25;

// ===== зафиксированный итог завершённой проверки =====
// Проведённая проверка — документ: по ней оценивают магазин, по её замечаниям заводят
// корректирующие, её печатают и показывают на телефоне. До этого её итог вычислялся из
// ТЕКУЩИХ настроек шаблона и общих справочников, и правка веса, балла варианта, нормы,
// порога или шкалы переписывала прошлое: «магазин получил в августе 72 %» в сентябре
// становилось 81 %. Тот же пересчёт двигал succeeded и через него — статусы старых задач.
//
// Приём тот же, что у refValue/refName выше и subject/subjectName у строк: рядом с живым
// расчётом лежит снимок на момент завершения. Ниже каждый узел цепочки раздвоен на live*
// (прежнее тело, считает по текущим настройкам) и публичное имя, которое отдаёт записанное
// завершённой проверке и живое — всем остальным. Публичные имена не менялись, поэтому ни
// один читатель — карточка, печать, своды, FillReadApi, телефон — не правится.
//
// Переключатель — отдельный флаг, а НЕ finished(e) и не OVERRIDE по записанному проценту:
// у процедурного шаблона (замена SIM, ремонт) оцениваемых полей нет вовсе, записанный
// процент законно пуст, и OVERRIDE провалился бы обратно в живой расчёт.
resultRecorded 'Итог зафиксирован' = DATA BOOLEAN (Filling);

// По каждому пункту шаблона, ВКЛЮЧАЯ пустые: сам факт «поле было в шаблоне на момент
// проверки» — то, чем поле, добавленное позже, отсекается от старой проверки.
recordedInTemplate    = DATA BOOLEAN (Filling, Field);
recordedItemScore     = DATA NUMERIC[18,4] (Filling, Field);
recordedItemMax       = DATA NUMERIC[18,4] (Filling, Field);
recordedNonconformity = DATA BOOLEAN (Filling, Field);

recordedScore              = DATA NUMERIC[18,4] (Filling);
recordedMax                = DATA NUMERIC[18,4] (Filling);
recordedPercent            = DATA NUMERIC[6,2] (Filling);
// hasScored и threshold пишутся вместе с итогом, хотя баллом не являются: первое решает,
// показывать ли процент вообще (resultSummary), второе уезжает в телефон отдельным ключом
// (FillReadApi.threshold). Без них снятие «Учитывать в оценке» или правка порога всё ещё
// меняли бы вид уже проведённой проверки.
recordedHasScored          = DATA INTEGER (Filling);
recordedThreshold          = DATA NUMERIC[5,2] (Filling);
recordedLevel              = DATA VerdictLevel (Filling);
recordedPassed             = DATA BOOLEAN (Filling);
recordedCountNonconformity = DATA INTEGER (Filling);
recordedCountCriticalFail  = DATA INTEGER (Filling);

// Состав проверки: у завершённой — записанный, у активной — текущий шаблон. Этим фильтром
// (а не «template(f) = template(e)») ходят все, кто показывает СОСТАВ: бланк, печать,
// apiExecutionFields, счётчики прогресса.
inFilling (Filling e, Field f) =
    IF resultRecorded(e) THEN recordedInTemplate(e, f) ELSE (TRUE IF template(f) = template(e));
inFilling (Filling e, Section s) = GROUP SUM 1 IF inFilling(e, Field f) AND section(f) = s;

// table-typed fields hold their value as rows (FillRow); the row module plugs the
// "has at least one filled row" answer in here.
tableAnswered = ABSTRACT BOOLEAN (Filling, Field);

answered (Filling e, Field f) =
    optionValue(e, f) OR numberValue(e, f) OR textValue(e, f)
    OR boolValue(e, f) OR dateValue(e, f) OR refValue(e, f) OR refName(e, f)
    OR countPhoto(e, f) OR tableAnswered(e, f);

notApplicable (Filling e, Field f) = notApplicable(optionValue(e, f));
// A norm is a bound, not a requirement: a bound that was never set cannot be violated.
// Written as negated comparisons on purpose — an unset bound yields NULL, NOT NULL is true,
// so a one-sided norm works and a field with no norms at all is in norm by definition.
// (Written the old way as `value >= minNorm AND value <= maxNorm`, both cases collapsed to
// NULL and every answered value came back as a non-conformity.)
inNorm (Filling e, Field f) = NOT (numberValue(e, f) < minNorm(f)) AND NOT (numberValue(e, f) > maxNorm(f));
liveNonconformity (Filling e, Field f) =
    nonconformity(optionValue(e, f))
    OR (type(f) = FieldType.number AND numberValue(e, f) AND NOT inNorm(e, f));
// Замечание завершённой проверки — записанное: снятие отметки «Несоответствие» у варианта
// (общий справочник!) больше не уменьшает число замечаний в сводах за прошлые периоды и не
// закрывает корректирующую, которую перепроверка подтвердила (CorrectiveRecheck.recheckFailed).
nonconformity (Filling e, Field f) =
    IF resultRecorded(e) THEN recordedNonconformity(e, f) ELSE liveNonconformity(e, f);

// --- required evidence on a non-conformity ---
needsPhoto (Filling e, Field f) = nonconformity(e, f) AND requirePhoto(f) AND NOT countPhoto(e, f);
needsComment (Filling e, Field f) = nonconformity(e, f) AND requireComment(f) AND NOT comment(e, f);
needsEvidence 'Нужно свидетельство' (Filling e, Field f) = needsPhoto(e, f) OR needsComment(e, f);
missingEvidence (Filling e) = GROUP SUM 1 IF needsEvidence(e, Field f);
// с фильтром по шаблону, как missingRequired: ответы — DATA, и осиротевшее значение
// поля, выведенного из шаблона, не должно считаться замечанием этой проверки
liveCountNonconformity (Filling e) =
    GROUP SUM 1 IF liveNonconformity(e, Field f) AND template(f) = template(e);
countNonconformity 'Замечаний' (Filling e) =
    IF resultRecorded(e) THEN recordedCountNonconformity(e) ELSE liveCountNonconformity(e);

// --- прошлая проверка (#36778) ---
// Прошлое заполнение: тот же объект и тот же шаблон, завершено и не позже текущего.
// «Не позже», а не просто «не текущее»: у завершённой проверки прошлым должно
// оставаться то, что было прошлым в момент её проведения, даже когда объект уже
// успели проверить снова. Здесь, а не в API: #36718 (десктопный бланк) понадобится
// то же понятие, и второе объявление разъехалось бы на этой самой оговорке.
//
// Семейство редакций, а не тот же шаблон (#37174): новая редакция чек-листа — отдельный
// шаблон, и по «тому же шаблону» первая проверка по ней осталась бы без прошлой. Сравнение
// с прошлым разом — про один и тот же чек-лист, а не про одну и ту же его редакцию.
prevFilling (Filling f) = GROUP LAST Filling p ORDER dateTime(p), p
    WHERE finished(p) AND p != f AND NOT dateTime(p) > dateTime(f)
      AND checkObject(task(p)) = checkObject(task(f))
      AND family(template(p)) = family(template(f))
    MATERIALIZED;

// Пометка «в прошлый раз здесь было замечание» по пункту бланка. Пункт прошлой проверки
// ищется по КОДУ поля: в другой редакции чек-листа это ДРУГОЙ объект поля, а вопрос тот же
// (#37174). Поля, добавленного после прошлой проверки, там нет — не будет и пометки.
prevNonconformity (Filling e, Field f) =
    nonconformity(prevFilling(e), field(template(prevFilling(e)), code(f)));

// Последняя завершённая проверка объекта, шаблон любой — «что было здесь в прошлый
// раз» задаётся местом, а не задачей (вход с карточки объекта).
lastFinishedFilling = GROUP LAST Filling p ORDER dateTime(p), p
    WHERE finished(p) BY checkObject(task(p)) MATERIALIZED;
missingRequired (Filling e) = GROUP SUM 1 IF required(Field f) AND template(f) = template(e) AND NOT answered(e, f);

// --- scoring (scored fields only) ---
// The score a field earns in this filling. ABSTRACT for the same reason as maxScore(Field):
// the arithmetic belongs to the per-mechanic modules, the core only applies the gates that
// are common to all of them — the field is scored, it was answered, and it is not N/A.
// plain CASE (OVERRIDE), for the same reason as maxScore(Field) — see the note there
score = ABSTRACT CASE NUMERIC[18,4] (Filling, Field);

// Живая ветка замкнута сама на себя (liveItemScore -> liveTotalScore -> livePercent ->
// liveVerdictLevel -> livePassed): если бы она читала публичные имена, получился бы цикл
// «публичное -> живое -> публичное», и сервер не стартовал бы.
liveItemScore (Filling e, Field f) =
    score(e, f) IF scored(f) AND answered(e, f) AND NOT notApplicable(e, f);
liveItemMax (Filling e, Field f) =
    maxScore(f) IF scored(f) AND answered(e, f) AND NOT notApplicable(e, f);

itemScore 'Балл' (Filling e, Field f) =
    IF resultRecorded(e) THEN recordedItemScore(e, f) ELSE liveItemScore(e, f);
itemMax (Filling e, Field f) =
    IF resultRecorded(e) THEN recordedItemMax(e, f) ELSE liveItemMax(e, f);
// Максимум пункта для глаз — в бумажном бланке это колонка «Норма» рядом с «Фактом».
// itemMax для этого не годится: у активной проверки он пуст, пока пункт не отвечен, а
// проверяющему «из скольких» нужно видеть до ответа. У завершённой — записанный.
maxPoints 'Макс. балл' (Filling e, Field f) =
    IF resultRecorded(e) THEN recordedItemMax(e, f) ELSE (maxScore(f) IF scored(f) AND e IS Filling);

// Ноль — это результат, а не его отсутствие. GROUP SUM копит через (+), а (+) при нулевом
// результате отдаёт NULL — документированная семантика платформы, не сбой. Из-за неё бланк,
// где КАЖДЫЙ оцениваемый пункт отвечен худшим вариантом, показывал пустую оценку вместо
// 0 %: молчал ровно тот случай, ради которого контроль и заводят.
//
// Ноль подставляется ТОЛЬКО когда есть что считать, то есть когда непуст максимум. У
// процедурного шаблона (замена SIM, ремонт) оцениваемых полей нет вовсе, liveTotalMax
// пуст — и оценка остаётся пустой; это условие приёмки, а не побочный эффект. Максимум
// поэтому и объявлен выше балла: балл на него смотрит.
liveTotalMax (Filling e) = GROUP SUM liveItemMax(e, Field f);
liveTotalScore (Filling e) = OVERRIDE (GROUP SUM liveItemScore(e, Field f)), (0 IF liveTotalMax(e));
totalMax (Filling e) = IF resultRecorded(e) THEN recordedMax(e) ELSE liveTotalMax(e);
totalScore (Filling e) = IF resultRecorded(e) THEN recordedScore(e) ELSE liveTotalScore(e);

// Счётчик, а не флаг, — как и было: имя читается как условие, но значение наружу уходит
// числом (scoring_check сверяет его с числом полей). У ветвей IF общий класс обязателен,
// поэтому записанное — тоже INTEGER.
liveHasScored (Filling e) = GROUP SUM 1 IF scored(Field f) AND template(f) = template(e);
hasScored (Filling e) = IF resultRecorded(e) THEN recordedHasScored(e) ELSE liveHasScored(e);

livePercent (Filling e) = NUMERIC[6,2](100 * liveTotalScore(e) / liveTotalMax(e));
// MATERIALIZED остаётся: процент читают своды и главная, и читают его куда чаще, чем он
// меняется. Выражение в скобках намеренно — иначе опция прилипла бы к ветке ELSE.
percent 'Оценка, %' (Filling e) =
    (IF resultRecorded(e) THEN recordedPercent(e) ELSE livePercent(e)) MATERIALIZED;

// Section subtotals: reuse itemScore / itemMax (they already carry the scoring gates —
// scored, answered, not N/A) and just regroup by the field's section. A procedural
// template with no scored fields yields NULL — the form stays intact.
sectionMax 'Максимум раздела' (Filling e, Section s) = GROUP SUM itemMax(e, Field f) BY section(f);
// Тот же ноль, что и у итога, но в два шага: GROUP ... BY нельзя поставить операндом
// выражения («BY clause in GROUP operator cannot be used in expressions»), поэтому сумма
// выносится отдельным свойством, а подстановка нуля живёт в публичном имени. Гейт — снова
// максимум раздела: раздел без оцениваемых отвеченных полей остаётся без подытога, и
// телефон, который отбирает разделы по sectionMax (FillReadApi), его по-прежнему не рисует.
sumSectionScore (Filling e, Section s) = GROUP SUM itemScore(e, Field f) BY section(f);
sectionScore 'Балл раздела' (Filling e, Section s) = OVERRIDE sumSectionScore(e, s), (0 IF sectionMax(e, s));
sectionPercent 'Оценка раздела, %' (Filling e, Section s) = NUMERIC[6,2](100 * sectionScore(e, s) / sectionMax(e, s));

sectionSummary 'Балл раздела' (Filling e, Section s) =
    ISTRING[60]((CONCAT ' — ', numericString(sectionScore(e, s)) + ' из ' + numericString(sectionMax(e, s)), numericString(sectionPercent(e, s)) + '%')) CHARWIDTH 20;

liveCountCriticalFail (Filling e) =
    GROUP SUM 1 IF critical(Field f) AND liveNonconformity(e, f) AND template(f) = template(e);
countCriticalFail (Filling e) =
    IF resultRecorded(e) THEN recordedCountCriticalFail(e) ELSE liveCountCriticalFail(e);

liveThreshold (Filling e) = passThreshold(template(e));
threshold (Filling e) = IF resultRecorded(e) THEN recordedThreshold(e) ELSE liveThreshold(e);

// The grade this filling lands on: the highest level of the template's scale whose lower
// bound it reaches. Templates without a scale keep the single-threshold behaviour below.
liveVerdictLevel (Filling e) = levelByScale(verdictScale(template(e)), livePercent(e));
// Уровень записан ссылкой, а не именем: переименование уровня — исправление опечатки и
// должно доезжать до старых проверок, как и названия полей.
verdictLevel (Filling e) = IF resultRecorded(e) THEN recordedLevel(e) ELSE liveVerdictLevel(e);
nameLevel 'Оценка' (Filling e) = name(verdictLevel(e));
rgbColorLevel (Filling e) = rgbColor(verdictLevel(e));

livePassed (Filling e) = e IS Filling AND NOT liveCountCriticalFail(e)
    AND (IF verdictScale(template(e))
            THEN passed(liveVerdictLevel(e))
            ELSE (NOT liveThreshold(e) OR livePercent(e) >= liveThreshold(e)));
passed 'Пройдено' (Filling e) = IF resultRecorded(e) THEN recordedPassed(e) ELSE livePassed(e);
// Критичный провал — поверх всего. Прежний OVERRIDE начинался с уровня шкалы, и при
// подключённой шкале подпись всегда бралась оттуда: проверка с проваленным критичным
// пунктом на 77,78 % читалась «Удовлетворительно», и проверяющий уходил с ощущением
// сданной проверки — та же подпись уезжала в печать, в своды и на телефон. passed при
// этом был пуст с самого начала (livePassed открывается с NOT countCriticalFail), он
// просто не доезжал до подписи.
//
// Вариант «IF NOT passed THEN Не пройдено» не годится: он стёр бы и незачётные уровни
// шкалы — «Неудовлетворительно» это слово заказчика, а не наше. Свойство одно, поэтому
// исправление доезжает сразу везде: карточка, телефон (FillReadApi.verdict), печать,
// resultSummary, отчёты.
nameVerdict 'Вердикт' (Filling e) = OVERRIDE ('Не пройдено' IF countCriticalFail(e)), nameLevel(e),
                                    (IF passed(e) THEN 'Пройдено' ELSE 'Не пройдено');
// Фон вердикта — по тому же правилу: при критичном провале цвет провала, иначе цвет
// уровня. Отдельным именем, потому что rgbColorLevel — это цвет УРОВНЯ, и там, где
// показывают именно уровень, он остаётся собой.
rgbColorVerdict (Filling e) = OVERRIDE (rgb(TaskColor.dangerSubtle) IF countCriticalFail(e)), rgbColorLevel(e);
percentString (Filling e) = numericString(percent(e)) + '%';

// --- outcome + progress ---
resolution 'Исход' = DATA Resolution (Filling);
// подпись исхода, а не код: код — контракт с телефоном, и его отдаёт сама code(Resolution)
// в FillReadApi. Выбор из списка сохраняется — это композиция через ссылку, запись уходит
// в resolution(e), как у nameType(Field).
nameResolution 'Исход' (Filling e) = name(resolution(e));
// По составу проверки, а не по текущему шаблону: поле, добавленное после завершения, не
// должно превращать «отвечено 12 из 12» в «12 из 13».
answeredCount (Filling e) = GROUP SUM 1 IF answered(e, Field f) AND inFilling(e, f);
totalFields (Filling e) = GROUP SUM 1 IF inFilling(e, Field f);

// Чем бланк уже занят (Execution.filled): ответ по пункту, комментарий к пункту или
// выбранный исход. Отвечает на вопрос «можно ли стереть это заполнение вместе с возвратом
// задачи в пул», поэтому комментарий тут наравне с ответом: человек мог не ответить, но
// написать, почему. Состав — тот же inFilling, что и у прогресса: пункт, выбывший из
// шаблона после завершения, бланк живым не делает.
filled(Filling e) += TRUE IF answeredCount(e) OR resolution(e)
                             OR (GROUP SUM 1 IF comment(e, Field f) AND inFilling(e, f));

resultSummary(Filling e) += ISTRING[100]((CONCAT ' — ', (percentString(e) IF hasScored(e)), (nameVerdict(e) IF hasScored(e)), (caption(resolution(e)) IF resolution(e))));

// По ЗАПИСАННОМУ итогу, а не по passed(e). succeeded читают сессионные события — автозакрытие
// задачи (Execution) и «устранено» у корректирующей (Corrective), — и платформа материализует
// его инкремент-хинтом. passed — это IF по resultRecorded, и в SQL хинта попадали ОБЕ ветви,
// живая — со всем расчётом баллов (score по механикам, шкала, порог, критичные пункты):
// INSERT ... SELECT на 2,02 МБ при лимите queryLengthLimit в 2 МБ. Удаление корректирующей
// задачи и рождение выполнения с завершением одним APPLY падали с TOO LONG QUERY (уборка
// корректирующей и сценарий I в ticket36987_check). У завершённой проверки записанный итог
// есть всегда: его пишет событие recordResult ниже на любую запись state плюс бэкфилл в
// onStarted, а обработку, читающую recordedPassed, платформа ставит после пишущей — по
// зависимости данных. Живой расчёт остаётся незавершённому бланку, где его и смотрят.
succeeded(Filling e) += finished(e) AND recordedPassed(e)
    AND (NOT resolution(e) OR resolution(e) = Resolution.done OR resolution(e) = Resolution.doneWithIssues);

// --- фиксация итога при завершении ---
// Присваивания в форме «<- expr IF cond», а не «WHERE»: IF-форма сбрасывает записи по всем
// остальным полям в NULL, и это здесь нужно. Заполнение можно вернуть на доработку (#37157)
// и завершить снова — при повторной записи хвост по полям, выбывшим из шаблона, обязан
// исчезнуть, а не остаться от прошлого завершения.
recordResult (Filling e) {
    recordedInTemplate(e, Field f)    <- TRUE IF template(f) = template(e);
    recordedItemScore(e, Field f)     <- liveItemScore(e, f) IF template(f) = template(e);
    recordedItemMax(e, Field f)       <- liveItemMax(e, f) IF template(f) = template(e);
    recordedNonconformity(e, Field f) <- liveNonconformity(e, f) IF template(f) = template(e);

    recordedScore(e)              <- liveTotalScore(e);
    recordedMax(e)                <- liveTotalMax(e);
    recordedPercent(e)            <- livePercent(e);
    recordedHasScored(e)          <- liveHasScored(e);
    recordedThreshold(e)          <- liveThreshold(e);
    recordedLevel(e)              <- liveVerdictLevel(e);
    recordedPassed(e)             <- livePassed(e);
    recordedCountNonconformity(e) <- liveCountNonconformity(e);
    recordedCountCriticalFail(e)  <- liveCountCriticalFail(e);
    // последним: до этой строки публичные имена ещё отдают живой расчёт, и любая запись
    // выше читалась бы уже через записанное
    resultRecorded(e)             <- TRUE;
}

// Событием по переходу состояния, а НЕ реализацией onFinish, хотя шов рядом и он же
// «единственная точка завершения» для АРМ и ручки телефона. «Завершённая проверка имеет
// записанный итог» — инвариант данных, и держать его должно то, что срабатывает на любую
// запись state: demo- и тест-скрипты ставят ExecutionState.finished напрямую, мимо
// finishExecution, и такое заполнение осталось бы «живым» до ближайшего перезапуска.
//
// Порядок с onFinish безопасен в обе стороны: createCorrective (Corrective.onFinish) идёт
// раньше и читает ещё живые несоответствия — ровно те, что событие затем и запишет.
WHEN LOCAL SETCHANGED(state(Filling e)) AND finished(e) DO
    recordResult(e);

// Возврат на доработку (#37157) снимает фиксацию: незавершённая проверка снова считается
// по текущим настройкам, балл во время заполнения живой. Сами записи не чистим — повторное
// завершение перепишет их целиком.
WHEN LOCAL SETCHANGED(state(Filling e)) AND NOT finished(e) AND e IS Filling DO
    resultRecorded(e) <- NULL;

// Проверки, проведённые до выкатки, один раз получают итог по текущему расчёту — то, что
// правки шаблонов уже переписали, не восстановить. Приём тот же, что у перекраски
// приоритетов в StoreTaskInitial: после первого прохода условие перестаёт выполняться, и
// повторные старты ничего не делают. Проход построчный, потому что recordResult работает по
// одному заполнению; на базе с тысячами проверок первый старт займёт заметное время — но
// ровно один раз.
onStarted () + {
    FOR finished(Filling e) AND NOT resultRecorded(e) DO
        recordResult(e);
}

// Разовая починка уже зафиксированных итогов. Проверки, завершённые ДО этой выкладки,
// записали пустой балл и пустой процент там, где набрано ровно ноль, — тем же (+)-нулём,
// что исправлен выше. RECALCULATE тут не поможет: percent у завершённой проверки читает
// не расчёт, а запись. Пересчитывать записи целиком нельзя — записанный итог на то и
// записан, чтобы не переезжать вслед за нынешними настройками шаблона (#37172), — поэтому
// правятся ровно те три записи и ровно там, где максимум есть, а процента нет: пустой
// процент при непустом максимуме и означает «набрано ноль».
//
// Самоограничение то же, что у соседей: после первого прохода recordedPercent = 0, и
// условие NOT recordedPercent больше не выполняется. Порядок строк важен — уровень и балл
// смотрят на ещё пустой процент, поэтому процент пишется последним.
onStarted () + {
    recordedLevel(Filling e)   <- levelByScale(verdictScale(template(e)), NUMERIC[6,2](0))
                                  WHERE resultRecorded(e) AND recordedMax(e) AND NOT recordedPercent(e);
    recordedScore(Filling e)   <- 0 WHERE resultRecorded(e) AND recordedMax(e) AND NOT recordedPercent(e);
    recordedPercent(Filling e) <- 0 WHERE resultRecorded(e) AND recordedMax(e) AND NOT recordedPercent(e);
}

// --- finish validation ---
CONSTRAINT SETCHANGED(state(Filling e)) AND finished(e) AND missingRequired(e)
    MESSAGE 'Перед завершением заполните обязательные поля';
CONSTRAINT SETCHANGED(state(Filling e)) AND finished(e) AND missingEvidence(e)
    MESSAGE 'Перед завершением добавьте обязательное фото/комментарий по каждому несоответствию';
CONSTRAINT SETCHANGED(state(Filling e)) AND finished(e) AND resolutionRequired(template(e)) AND NOT resolution(e)
    MESSAGE 'Перед завершением укажите исход';

// Те же три условия для десктопной кнопки «Завершить» — спрашиваются ДО перевода
// состояния, разбор в Execution.finishBlocked. Реализация ABSTRACT отбирается по классу
// параметра, и все три выражения объявлены на Filling (missing* — агрегаты по Filling,
// template/resolution — тоже), так что IS-гвард не нужен: у констрейнта SimpleExecution
// он стоит потому, что событие — своя область параметров, где класс не выводится.
// CONCAT, а не OVERRIDE: перечислить ВСЁ недостающее сразу. Констрейнты срабатывают по
// одному, и человек, у которого не хватает и обязательного поля, и фото, узнавал бы об
// этом в два захода. CONCAT пропускает NULL вместе со своим разделителем, так что
// выполненные условия в текст не попадают. Порядок — в котором эти дыры удобно закрывать.
finishBlocked(Filling e) += ISTRING[250]((CONCAT '\n',
    ('Перед завершением заполните обязательные поля' IF missingRequired(e)),
    ('Перед завершением добавьте обязательное фото/комментарий по каждому несоответствию' IF missingEvidence(e)),
    ('Перед завершением укажите исход' IF resolutionRequired(template(e)) AND NOT resolution(e))));

// --- option answers must belong to the field's own option set ---
nameOptionValue 'Ответ' (Filling e, Field f) = name(optionValue(e, f));
// SETCHANGED, а не по состоянию — та же грабля, что у канала ниже (#36841): по состоянию
// смена «Наборов вариантов» у поля с ответами блокировала APPLY конструктора (проверено
// на стенде: CHECKED BY на APPLY ничего не сбрасывает, он лишь фильтрует кандидатов в
// выпадашке ответа на бланке — потому и остаётся). Гвард судит НОВЫЙ выбор; старый ответ
// остаётся документом: вариант прежнего набора жив, показ и балл идут по нему.
CONSTRAINT SETCHANGED(optionValue(Filling e, Field f)) AND NOT optionSet(optionValue(e, f)) = optionSet(f)
    CHECKED BY optionValue[Filling, Field]
    MESSAGE 'Выбранный вариант не относится к набору поля';

// --- ref answers must belong to the field's channel (#36841) ---
// SETCHANGED, а не по состоянию: гвард судит НОВЫЙ выбор, а не пересуживает старые
// акты — иначе смена канала у поля, по которому уже есть ответы, блокировала APPLY
// конструктора (поймано на стенде при переключении канала на 'item'). Старый ответ
// остаётся документом: ссылка прежнего канала плюс снимок, показ идёт по снимку.
CONSTRAINT SETCHANGED(refValue(Filling e, Field f)) AND NOT kind(refValue(e, f)) = refKind(f)
    MESSAGE 'Выбранный предмет не относится к каналу поля';

// --- единая колонка «Ответ» ---
// ABSTRACT CASE по типу поля, как maxScore(Field): представление ответа — точка
// расширения типа. Новый тип поля регистрирует свой показ сам (реализацией +=),
// карточка и акт не правятся. Табличный тип подключается в FillRow.
answer 'Ответ' = ABSTRACT CASE ISTRING[500] (Filling, Field);
answer(Filling e, Field f) += WHEN type(f) = FieldType.scale OR type(f) = FieldType.choice THEN nameOptionValue(e, f);
answer(Filling e, Field f) += WHEN type(f) = FieldType.number OR type(f) = FieldType.score THEN
    ISTRING[500]((CONCAT ' ', numericString(numberValue(e, f)), unit(f)) IF numberValue(e, f));
answer(Filling e, Field f) += WHEN type(f) = FieldType.boolean THEN
    ISTRING[500](IF boolValue(e, f) = TTRUE THEN 'Да' ELSE ('Нет' IF boolValue(e, f) = TFALSE));
answer(Filling e, Field f) += WHEN type(f) = FieldType.text OR type(f) = FieldType.longtext OR type(f) = FieldType.scan THEN textValue(e, f);
answer(Filling e, Field f) += WHEN type(f) = FieldType.date THEN ISTRING[500](dateValue(e, f));
// снимок-первым (#36841), как в акте: ответом остаётся текст на момент заполнения
answer(Filling e, Field f) += WHEN type(f) = FieldType.objectref THEN ISTRING[500](nameRefValue(e, f));

// --- подсветка карточки ---
backgroundNonconformity (Filling e, Field f) = rgb(TaskColor.dangerSubtle) IF nonconformity(e, f);
backgroundEvidence (Filling e, Field f) = rgb(TaskColor.warningSubtle) IF needsEvidence(e, f);

// --- фото пункта: просмотр И приложение с десктопа ---
// Приложить снимок из АРМ, а не только с телефона: обязательное фото-поле и «фото при
// несоответствии» (needsPhoto) иначе не закрыть — «Завершить» отказывает верно, а снять
// отказ на десктопе нечем, и такой шаблон не завершается в принципе.
//
// Индекс — тем же выражением, что у ручки телефона (FillWriteApi.apiSetFieldPhoto): от
// ПОСЛЕДНЕГО существующего, а не от countPhoto. Индексы не уплотняются (#36946), и
// «countPhoto + 1» после удаления из середины затёр бы уже лежащий снимок.
//
// INPUT из кнопки формы допустим именно здесь: файловые классы (и COLOR) вводятся
// отдельным диалогом, а не редактором ячейки, — для остальных built-in классов это
// была бы ошибка времени выполнения.
addPhoto 'Добавить' (Filling e, Field f) {
    INPUT img = IMAGEFILE DO
        photo(e, f, (OVERRIDE lastPhotoIndex(e, f), 0) + 1) <- img;
}

// поштучно и без уплотнения — зеркало apiDeleteFieldPhoto
deletePhoto 'Удалить' (Filling e, Field f, INTEGER i) {
    photo(e, f, i) <- NULL;
}

// Строки диалога — фактические индексы снимков: после удаления по индексу (#36946)
// индексы НЕ уплотняются, поэтому «от 1 до countPhoto» потерял бы снимки за дырой.
// Правка — только у незавершённого заполнения: завершённая проверка это документ.
FORM fillingPhotos 'Фото'
    OBJECTS e = Filling PANEL, f = Field PANEL
    PROPERTIES READONLY name(f), comment(e, f)
    PROPERTIES addPhoto(e, f) SHOWIF NOT finished(e)
    OBJECTS i = INTEGER
    PROPERTIES READONLY photo(e, f, i)
    PROPERTIES deletePhoto(e, f, i) SHOWIF NOT finished(e) TOOLBAR
    FILTERS photo(e, f, i)
;

DESIGN fillingPhotos {
    OBJECTS {
        NEW head {
            horizontal = TRUE;
            alignment = STRETCH;
            MOVE PROPERTY(name(f)) { fill = 1; }
            MOVE PROPERTY(addPhoto(e, f));
        }
        MOVE PROPERTY(comment(e, f));
        MOVE BOX(i) {
            caption = '';
            fill = 1;
            PROPERTY(photo(e, f, i)) { valueHeight = 240; valueWidth = 320; }
        }
    }
}

// Открывается и при нуле снимков, пока бланк не завершён: «Добавить» живёт внутри этого
// диалога, и прежнее условие countPhoto делало первый снимок недостижимым с десктопа.
// У завершённой проверки пустой диалог по-прежнему не открывается — показывать нечего.
showPhotos 'Фото' (Filling e, Field f) {
    IF countPhoto(e, f) OR NOT finished(e) THEN
        SHOW fillingPhotos OBJECTS e = e, f = f;
}

// ===== desktop review/fill form (ARM). The mobile Flutter client uses FillReadApi/FillWriteApi. =====
// Структура бланка: дерево «раздел -> пункты». Разделы — группирующие строки с
// подытогом, а не текстовая колонка в каждом пункте. Свойства раздела ложатся в
// первые колонки пунктов (№ / Пункт / Норма) — эти три колонки видимы в обоих
// режимах, поэтому выравнивание строк разделов от режима не зависит.
//
// Два явных режима по SHOWIF finished(e): завершённое заполнение читается одной
// колонкой «Ответ» (READONLY), активное правится типовыми DATA-колонками. Ввод
// СОЗНАТЕЛЬНО не свёрнут в одну колонку с ON CHANGE-диспетчером по типу: у такого
// диспетчера клиент не знает редактор до похода на сервер — каждый клик получает
// секундную «загрузку» (а штатный обход OPTIMISTICASYNC работает только через
// ACTION+, которое падает NPE mapTable на парсинге из-за INPUT по хранимым
// свойствам). Типовые колонки платформа редактирует асинхронно: список вариантов
// и редакторы открываются мгновенно, сервер ходит один раз — на запись ответа.
FORM filling 'Заполнение'
    OBJECTS e = Filling PANEL
    PROPERTIES(e) nameObject READONLY, nameTemplate READONLY,
                  dateTime READONLY, nameExecutor READONLY,
                  percent READONLY, nameVerdict READONLY BACKGROUND rgbColorVerdict(e),
                  nameResolution READONLYIF finished(e),
                  nameState READONLY
    PROPERTIES(e) finish SHOWIF NOT finished(e)

    TREE check sec = Section, fld = Field
    PROPERTIES(sec) READONLY index, name
    PROPERTIES sectionSummary(e, sec) READONLY
    // по составу проверки, а не по текущему шаблону: у завершённой — те разделы и поля,
    // что были в шаблоне на момент проверки
    FILTERS inFilling(e, sec)
    ORDERS index(sec)

    PROPERTIES(fld) READONLY index, name BACKGROUND backgroundNonconformity(e, fld), norm
    PROPERTIES answer(e, fld) READONLY SHOWIF finished(e) BACKGROUND backgroundNonconformity(e, fld),
               nameOptionValue(e, fld) SHOWIF NOT finished(e),
               numberValue(e, fld) SHOWIF NOT finished(e),
               textValue(e, fld) SHOWIF NOT finished(e),
               boolValue(e, fld) SHOWIF NOT finished(e),
               dateValue(e, fld) SHOWIF NOT finished(e),
               // предмет поля-ссылки (#36841): снимок-первым, поэтому READONLY — правится
               // выбором на телефоне, а не текстом в гриде поверх снимка. В просмотре его
               // показывает колонка «Ответ», так что здесь — только режим правки
               nameRefValue(e, fld) READONLY SHOWIF NOT finished(e),
               comment(e, fld) READONLYIF finished(e),
               countPhoto(e, fld) ON CHANGE showPhotos(e, fld),
               needsEvidence(e, fld) READONLY BACKGROUND backgroundEvidence(e, fld),
               itemScore(e, fld) READONLY, maxPoints(e, fld) READONLY
    FILTERS section(fld) = sec AND inFilling(e, fld)
    ORDERS index(fld)

    EDIT Filling OBJECT e

    // EXPAND адресует группу полным идентификатором «форма.группа» (formGroupObjectID),
    // даже из событий самой формы — голое `sec` не парсится
    EVENTS ON INIT { EXPAND ALL TOP filling.sec; }
;

DESIGN filling {
    OBJECTS {
        NEW header {
            horizontal = TRUE;
            alignment = STRETCH;
            NEW info {
                fill = 1;
                MOVE PROPERTY(nameObject(e));
                MOVE PROPERTY(nameTemplate(e));
                NEW infoLine {
                    horizontal = TRUE;
                    MOVE PROPERTY(nameExecutor(e));
                    MOVE PROPERTY(dateTime(e));
                    MOVE PROPERTY(nameState(e));
                }
            }
            NEW score {
                MOVE PROPERTY(percent(e)) { fontSize = 22; }
                MOVE PROPERTY(nameVerdict(e));
                MOVE PROPERTY(nameResolution(e));
                MOVE PROPERTY(finish(e));
            }
        }
        MOVE BOX(TREE check) { caption = 'Бланк'; fill = 1; }
    }
}

// open the filling fill form from the task's executions grid
EXTEND FORM task
    PROPERTIES(e) NEWSESSION EDIT
;
