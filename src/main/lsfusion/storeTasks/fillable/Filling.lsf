MODULE Filling;

// Заполнение шаблона целиком — свод четырёх модулей, разложенных сверху вниз: ответы
// (FillingValue), живой расчёт оценки (FillingScore), зафиксированный итог и публичные имена
// (FillingResult), десктоп заполнения (FillingForm). Модули и хосты, которым нужно заполнение,
// требуют этот модуль; нижнему слою достаточно своей части.
REQUIRE FillingValue, FillingScore, FillingResult, FillingForm;

NAMESPACE StoreTask;
