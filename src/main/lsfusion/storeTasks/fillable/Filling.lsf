MODULE Filling;

// FieldType — FieldType.number/scale/…; StoreTaskCore — checkObject(task(e)); StoreTaskForms —
// карточка task, которую модуль расширяет (транзитивному REQUIRE не доверять)
REQUIRE Execution, Template, Field, FillOption, Resolution, CheckAsset, VerdictScale, RefValue,
        StoreTaskNumberUtils, StoreTaskColor, FieldType, StoreTaskCore, StoreTaskForms;

NAMESPACE StoreTask;

// A filling of a template — the unified execution. A checklist inspection, a SIM swap,
// a repair are all fillings, differing only by their template's fields. Values are held
// as properties over (Filling, Field), typed by the field's FieldType.
CLASS Filling 'Заполнение' : Execution;
template = DATA Template (Filling);
nameTemplate 'Шаблон' (Filling e) = name(template(e));

// --- field values ---
optionValue = DATA Option (Filling, Field);
numberValue 'Значение' = DATA NUMERIC[14,4] (Filling, Field);
textValue 'Текст' = DATA ISTRING[500] (Filling, Field);
boolValue 'Да/Нет' = DATA TBOOLEAN (Filling, Field);
dateValue 'Дата' = DATA DATE (Filling, Field);
// Значение поля-ссылки (#36841): любой предмет справочника, а не только объект проверки —
// канал задаёт refKind(Field), объект проверки остаётся каналом 'object' по умолчанию.
// Рядом снимок текста на момент заполнения, тем же приёмом, что subjectName у строк:
// заполнение — документ, и увольнение сотрудника или переименование товара не должны
// менять акт задним числом. Снимок и есть свободный ввод: текст без ссылки.
refValue = DATA RefValue (Filling, Field);
refName 'Предмет' = DATA ISTRING[150] (Filling, Field);
nameRefValue 'Предмет' (Filling e, Field f) = OVERRIDE refName(e, f), name(refValue(e, f));
// Photos are keyed by an extra index, so a field holds 0..N of them: one shot rarely
// covers a whole display case, and an inspector who can attach only one ends up choosing
// which non-conformity to document. The index is 1-based and assigned by the API; it is
// NOT dense — удаление снимка по индексу (apiDeleteFieldPhoto) оставляет дыру.
photo 'Фото' = DATA IMAGEFILE (Filling, Field, INTEGER);
countPhoto 'Фото, шт.' (Filling e, Field f) = GROUP SUM 1 IF photo(e, f, INTEGER i);
lastPhotoIndex (Filling e, Field f) = GROUP MAX INTEGER i IF photo(e, f, i);
// «Первый снимок» для десктопной и печатной форм — минимальный СУЩЕСТВУЮЩИЙ индекс, а
// не единица: после удаления первого кадра (#36946) индексы не уплотняются, и жёсткое
// photo(e, f, 1) оставляло бы ячейку пустой при countPhoto = 2.
firstPhotoIndex (Filling e, Field f) = GROUP MIN INTEGER i IF photo(e, f, i);
firstPhoto (Filling e, Field f) = photo(e, f, firstPhotoIndex(e, f));
// Фактические индексы снимков через запятую («1,3»): после удаления по индексу
// оставшиеся индексы НЕ уплотняются, так что «от 1 до countPhoto» — неправда, и
// клиент, который так итерирует, потеряет снимки за дырой (#36778, просмотр).
photoIndexes (Filling e, Field f) = GROUP CONCAT STRING(INTEGER i) IF photo(e, f, i), ',' ORDER i;
comment 'Комментарий' = DATA ISTRING[500] (Filling, Field) CHARWIDTH 25;

// table-typed fields hold their value as rows (FillRow); the row module plugs the
// "has at least one filled row" answer in here.
tableAnswered = ABSTRACT BOOLEAN (Filling, Field);

answered (Filling e, Field f) =
    optionValue(e, f) OR numberValue(e, f) OR textValue(e, f)
    OR boolValue(e, f) OR dateValue(e, f) OR refValue(e, f) OR refName(e, f)
    OR countPhoto(e, f) OR tableAnswered(e, f);

notApplicable (Filling e, Field f) = notApplicable(optionValue(e, f));
// A norm is a bound, not a requirement: a bound that was never set cannot be violated.
// Written as negated comparisons on purpose — an unset bound yields NULL, NOT NULL is true,
// so a one-sided norm works and a field with no norms at all is in norm by definition.
// (Written the old way as `value >= minNorm AND value <= maxNorm`, both cases collapsed to
// NULL and every answered value came back as a non-conformity.)
inNorm (Filling e, Field f) = NOT (numberValue(e, f) < minNorm(f)) AND NOT (numberValue(e, f) > maxNorm(f));
nonconformity (Filling e, Field f) =
    nonconformity(optionValue(e, f))
    OR (type(f) = FieldType.number AND numberValue(e, f) AND NOT inNorm(e, f));

// --- required evidence on a non-conformity ---
needsPhoto (Filling e, Field f) = nonconformity(e, f) AND requirePhoto(f) AND NOT countPhoto(e, f);
needsComment (Filling e, Field f) = nonconformity(e, f) AND requireComment(f) AND NOT comment(e, f);
needsEvidence 'Нужно свидетельство' (Filling e, Field f) = needsPhoto(e, f) OR needsComment(e, f);
missingEvidence (Filling e) = GROUP SUM 1 IF needsEvidence(e, Field f);
// с фильтром по шаблону, как missingRequired: ответы — DATA, и осиротевшее значение
// поля, выведенного из шаблона, не должно считаться замечанием этой проверки
countNonconformity 'Замечаний' (Filling e) =
    GROUP SUM 1 IF nonconformity(e, Field f) AND template(f) = template(e);

// --- прошлая проверка (#36778) ---
// Прошлое заполнение: тот же объект и тот же шаблон, завершено и не позже текущего.
// «Не позже», а не просто «не текущее»: у завершённой проверки прошлым должно
// оставаться то, что было прошлым в момент её проведения, даже когда объект уже
// успели проверить снова. Здесь, а не в API: #36718 (десктопный бланк) понадобится
// то же понятие, и второе объявление разъехалось бы на этой самой оговорке.
prevFilling (Filling f) = GROUP LAST Filling p ORDER dateTime(p), p
    WHERE finished(p) AND p != f AND NOT dateTime(p) > dateTime(f)
      AND checkObject(task(p)) = checkObject(task(f)) AND template(p) = template(f)
    MATERIALIZED;

// Последняя завершённая проверка объекта, шаблон любой — «что было здесь в прошлый
// раз» задаётся местом, а не задачей (вход с карточки объекта).
lastFinishedFilling = GROUP LAST Filling p ORDER dateTime(p), p
    WHERE finished(p) BY checkObject(task(p)) MATERIALIZED;
missingRequired (Filling e) = GROUP SUM 1 IF required(Field f) AND template(f) = template(e) AND NOT answered(e, f);

// --- scoring (scored fields only) ---
// The score a field earns in this filling. ABSTRACT for the same reason as maxScore(Field):
// the arithmetic belongs to the per-mechanic modules, the core only applies the gates that
// are common to all of them — the field is scored, it was answered, and it is not N/A.
// plain CASE (OVERRIDE), for the same reason as maxScore(Field) — see the note there
score = ABSTRACT CASE NUMERIC[18,4] (Filling, Field);

itemScore 'Балл' (Filling e, Field f) =
    score(e, f) IF scored(f) AND answered(e, f) AND NOT notApplicable(e, f);
itemMax (Filling e, Field f) =
    maxScore(f) IF scored(f) AND answered(e, f) AND NOT notApplicable(e, f);

totalScore (Filling e) = GROUP SUM itemScore(e, Field f);
totalMax (Filling e) = GROUP SUM itemMax(e, Field f);
hasScored (Filling e) = GROUP SUM 1 IF scored(Field f) AND template(f) = template(e);
percent 'Оценка, %' (Filling e) = NUMERIC[6,2](100 * totalScore(e) / totalMax(e)) MATERIALIZED;

// Section subtotals: reuse itemScore / itemMax (they already carry the scoring gates —
// scored, answered, not N/A) and just regroup by the field's section. A procedural
// template with no scored fields yields NULL — the form stays intact.
sectionScore 'Балл раздела' (Filling e, Section s) = GROUP SUM itemScore(e, Field f) BY section(f);
sectionMax 'Максимум раздела' (Filling e, Section s) = GROUP SUM itemMax(e, Field f) BY section(f);
sectionPercent 'Оценка раздела, %' (Filling e, Section s) = NUMERIC[6,2](100 * sectionScore(e, s) / sectionMax(e, s));

sectionSummary 'Балл раздела' (Filling e, Section s) =
    ISTRING[60]((CONCAT ' — ', numericString(sectionScore(e, s)) + ' из ' + numericString(sectionMax(e, s)), numericString(sectionPercent(e, s)) + '%')) CHARWIDTH 20;

countCriticalFail (Filling e) = GROUP SUM 1 IF critical(Field f) AND nonconformity(e, f) AND template(f) = template(e);
threshold (Filling e) = passThreshold(template(e));

// The grade this filling lands on: the highest level of the template's scale whose lower
// bound it reaches. Templates without a scale keep the single-threshold behaviour below.
verdictLevel (Filling e) = levelByScale(verdictScale(template(e)), percent(e));
nameLevel 'Оценка' (Filling e) = name(verdictLevel(e));
rgbColorLevel (Filling e) = rgbColor(verdictLevel(e));

passed 'Пройдено' (Filling e) = e IS Filling AND NOT countCriticalFail(e)
    AND (IF verdictScale(template(e))
            THEN passed(verdictLevel(e))
            ELSE (NOT threshold(e) OR percent(e) >= threshold(e)));
nameVerdict 'Вердикт' (Filling e) = OVERRIDE nameLevel(e), (IF passed(e) THEN 'Пройдено' ELSE 'Не пройдено');
percentString (Filling e) = numericString(percent(e)) + '%';

// --- outcome + progress ---
resolution 'Исход' = DATA Resolution (Filling);
nameResolution 'Исход' (Filling e) = code(resolution(e));
answeredCount (Filling e) = GROUP SUM 1 IF answered(e, Field f) AND template(f) = template(e);
totalFields (Filling e) = GROUP SUM 1 IF template(Field f) = template(e);

resultSummary(Filling e) += ISTRING[100]((CONCAT ' — ', (percentString(e) IF hasScored(e)), (nameVerdict(e) IF hasScored(e)), (caption(resolution(e)) IF resolution(e))));

succeeded(Filling e) += finished(e) AND passed(e)
    AND (NOT resolution(e) OR resolution(e) = Resolution.done OR resolution(e) = Resolution.doneWithIssues);

// --- finish validation ---
CONSTRAINT SETCHANGED(state(Filling e)) AND finished(e) AND missingRequired(e)
    MESSAGE 'Перед завершением заполните обязательные поля';
CONSTRAINT SETCHANGED(state(Filling e)) AND finished(e) AND missingEvidence(e)
    MESSAGE 'Перед завершением добавьте обязательное фото/комментарий по каждому несоответствию';
CONSTRAINT SETCHANGED(state(Filling e)) AND finished(e) AND resolutionRequired(template(e)) AND NOT resolution(e)
    MESSAGE 'Перед завершением укажите исход';

// --- option answers must belong to the field's own option set ---
nameOptionValue 'Ответ' (Filling e, Field f) = name(optionValue(e, f));
// SETCHANGED, а не по состоянию — та же грабля, что у канала ниже (#36841): по состоянию
// смена «Наборов вариантов» у поля с ответами блокировала APPLY конструктора (проверено
// на стенде: CHECKED BY на APPLY ничего не сбрасывает, он лишь фильтрует кандидатов в
// выпадашке ответа на бланке — потому и остаётся). Гвард судит НОВЫЙ выбор; старый ответ
// остаётся документом: вариант прежнего набора жив, показ и балл идут по нему.
CONSTRAINT SETCHANGED(optionValue(Filling e, Field f)) AND NOT optionSet(optionValue(e, f)) = optionSet(f)
    CHECKED BY optionValue[Filling, Field]
    MESSAGE 'Выбранный вариант не относится к набору поля';

// --- ref answers must belong to the field's channel (#36841) ---
// SETCHANGED, а не по состоянию: гвард судит НОВЫЙ выбор, а не пересуживает старые
// акты — иначе смена канала у поля, по которому уже есть ответы, блокировала APPLY
// конструктора (поймано на стенде при переключении канала на 'item'). Старый ответ
// остаётся документом: ссылка прежнего канала плюс снимок, показ идёт по снимку.
CONSTRAINT SETCHANGED(refValue(Filling e, Field f)) AND NOT kind(refValue(e, f)) = refKind(f)
    MESSAGE 'Выбранный предмет не относится к каналу поля';

// --- единая колонка «Ответ» ---
// ABSTRACT CASE по типу поля, как maxScore(Field): представление ответа — точка
// расширения типа. Новый тип поля регистрирует свой показ сам (реализацией +=),
// карточка и акт не правятся. Табличный тип подключается в FillRow.
answer 'Ответ' = ABSTRACT CASE ISTRING[500] (Filling, Field);
answer(Filling e, Field f) += WHEN type(f) = FieldType.scale OR type(f) = FieldType.choice THEN nameOptionValue(e, f);
answer(Filling e, Field f) += WHEN type(f) = FieldType.number OR type(f) = FieldType.score THEN
    ISTRING[500]((CONCAT ' ', numericString(numberValue(e, f)), unit(f)) IF numberValue(e, f));
answer(Filling e, Field f) += WHEN type(f) = FieldType.boolean THEN
    ISTRING[500](IF boolValue(e, f) = TTRUE THEN 'Да' ELSE ('Нет' IF boolValue(e, f) = TFALSE));
answer(Filling e, Field f) += WHEN type(f) = FieldType.text OR type(f) = FieldType.longtext OR type(f) = FieldType.scan THEN textValue(e, f);
answer(Filling e, Field f) += WHEN type(f) = FieldType.date THEN ISTRING[500](dateValue(e, f));
// снимок-первым (#36841), как в акте: ответом остаётся текст на момент заполнения
answer(Filling e, Field f) += WHEN type(f) = FieldType.objectref THEN ISTRING[500](nameRefValue(e, f));

// --- подсветка карточки ---
backgroundNonconformity (Filling e, Field f) = rgb(TaskColor.dangerSubtle) IF nonconformity(e, f);
backgroundEvidence (Filling e, Field f) = rgb(TaskColor.warningSubtle) IF needsEvidence(e, f);

// --- фото пункта: просмотр, а не только счётчик ---
// Строки диалога — фактические индексы снимков: после удаления по индексу (#36946)
// индексы НЕ уплотняются, поэтому «от 1 до countPhoto» потерял бы снимки за дырой.
FORM fillingPhotos 'Фото'
    OBJECTS e = Filling PANEL, f = Field PANEL
    PROPERTIES READONLY name(f), comment(e, f)
    OBJECTS i = INTEGER
    PROPERTIES READONLY photo(e, f, i)
    FILTERS photo(e, f, i)
;

DESIGN fillingPhotos {
    OBJECTS {
        MOVE BOX(i) {
            caption = '';
            fill = 1;
            PROPERTY(photo(e, f, i)) { valueHeight = 240; valueWidth = 320; }
        }
    }
}

showPhotos 'Фото' (Filling e, Field f) {
    IF countPhoto(e, f) THEN
        SHOW fillingPhotos OBJECTS e = e, f = f;
}

// ===== desktop review/fill form (ARM). The mobile Flutter client uses FillApi. =====
// Структура бланка: дерево «раздел -> пункты». Разделы — группирующие строки с
// подытогом, а не текстовая колонка в каждом пункте. Свойства раздела ложатся в
// первые колонки пунктов (№ / Пункт / Норма) — эти три колонки видимы в обоих
// режимах, поэтому выравнивание строк разделов от режима не зависит.
//
// Два явных режима по SHOWIF finished(e): завершённое заполнение читается одной
// колонкой «Ответ» (READONLY), активное правится типовыми DATA-колонками. Ввод
// СОЗНАТЕЛЬНО не свёрнут в одну колонку с ON CHANGE-диспетчером по типу: у такого
// диспетчера клиент не знает редактор до похода на сервер — каждый клик получает
// секундную «загрузку» (а штатный обход OPTIMISTICASYNC работает только через
// ACTION+, которое падает NPE mapTable на парсинге из-за INPUT по хранимым
// свойствам). Типовые колонки платформа редактирует асинхронно: список вариантов
// и редакторы открываются мгновенно, сервер ходит один раз — на запись ответа.
FORM filling 'Заполнение'
    OBJECTS e = Filling PANEL
    PROPERTIES(e) nameObject READONLY, nameTemplate READONLY,
                  dateTime READONLY, nameExecutor READONLY,
                  percent READONLY, nameVerdict READONLY BACKGROUND rgbColorLevel(e),
                  nameResolution READONLYIF finished(e),
                  nameState READONLY
    PROPERTIES(e) finish SHOWIF NOT finished(e)

    TREE check sec = Section, fld = Field
    PROPERTIES(sec) READONLY index, name
    PROPERTIES sectionSummary(e, sec) READONLY
    FILTERS template(sec) = template(e)
    ORDERS index(sec)

    PROPERTIES(fld) READONLY index, name BACKGROUND backgroundNonconformity(e, fld), norm
    PROPERTIES answer(e, fld) READONLY SHOWIF finished(e) BACKGROUND backgroundNonconformity(e, fld),
               nameOptionValue(e, fld) SHOWIF NOT finished(e),
               numberValue(e, fld) SHOWIF NOT finished(e),
               textValue(e, fld) SHOWIF NOT finished(e),
               boolValue(e, fld) SHOWIF NOT finished(e),
               dateValue(e, fld) SHOWIF NOT finished(e),
               // предмет поля-ссылки (#36841): снимок-первым, поэтому READONLY — правится
               // выбором на телефоне, а не текстом в гриде поверх снимка. В просмотре его
               // показывает колонка «Ответ», так что здесь — только режим правки
               nameRefValue(e, fld) READONLY SHOWIF NOT finished(e),
               comment(e, fld) READONLYIF finished(e),
               countPhoto(e, fld) ON CHANGE showPhotos(e, fld),
               needsEvidence(e, fld) READONLY BACKGROUND backgroundEvidence(e, fld),
               itemScore(e, fld) READONLY
    FILTERS section(fld) = sec
    ORDERS index(fld)

    EDIT Filling OBJECT e

    // EXPAND адресует группу полным идентификатором «форма.группа» (formGroupObjectID),
    // даже из событий самой формы — голое `sec` не парсится
    EVENTS ON INIT { EXPAND ALL TOP filling.sec; }
;

DESIGN filling {
    OBJECTS {
        NEW header {
            horizontal = TRUE;
            alignment = STRETCH;
            NEW info {
                fill = 1;
                MOVE PROPERTY(nameObject(e));
                MOVE PROPERTY(nameTemplate(e));
                NEW infoLine {
                    horizontal = TRUE;
                    MOVE PROPERTY(nameExecutor(e));
                    MOVE PROPERTY(dateTime(e));
                    MOVE PROPERTY(nameState(e));
                }
            }
            NEW score {
                MOVE PROPERTY(percent(e)) { fontSize = 22; }
                MOVE PROPERTY(nameVerdict(e));
                MOVE PROPERTY(nameResolution(e));
                MOVE PROPERTY(finish(e));
            }
        }
        MOVE BOX(TREE check) { caption = 'Бланк'; fill = 1; }
    }
}

// open the filling fill form from the task's executions grid
EXTEND FORM task
    PROPERTIES(e) NEWSESSION EDIT
;
