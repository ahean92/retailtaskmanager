MODULE CorrectiveAction;

REQUIRE Filling, Employee;

NAMESPACE StoreTask;

// A follow-up action to fix a non-conformity found by a filling (checklist/procedure).
CLASS CorrectiveAction 'Корректирующее действие';

filling = DATA Filling (CorrectiveAction) NONULL DELETE;
field = DATA Field (CorrectiveAction);
nameField 'Поле' (CorrectiveAction a) = name(field(a));
nameObject 'Объект' (CorrectiveAction a) = nameObject(task(filling(a)));

description 'Что устранить' = DATA ISTRING[500] (CorrectiveAction) CHARWIDTH 30;
responsible 'Ответственный' = DATA Employee (CorrectiveAction);
nameResponsible 'Ответственный' (CorrectiveAction a) = name(responsible(a));
deadline 'Срок' = DATA DATE (CorrectiveAction);

created 'Создано' = DATA DATETIME (CorrectiveAction);
created(CorrectiveAction a) <- currentDateTime() WHEN SET(a IS CorrectiveAction);

done 'Выполнено' = DATA BOOLEAN (CorrectiveAction);
doneDate 'Дата выполнения' = DATA DATE (CorrectiveAction);
WHEN LOCAL CHANGED(done(CorrectiveAction a)) AND done(a) AND NOT CHANGED(doneDate(a)) DO doneDate(a) <- currentDate();
WHEN LOCAL CHANGED(done(CorrectiveAction a)) AND NOT done(a) DO doneDate(a) <- NULL;
opened (CorrectiveAction a) = a IS CorrectiveAction AND NOT done(a);

// generation from a filling's non-conformities
existsAction (Filling e, Field f) = GROUP SUM 1 IF filling(CorrectiveAction a) = e AND field(a) = f;
countAction 'Корректирующих действий' (Filling e) = GROUP SUM 1 IF filling(CorrectiveAction a) = e;

generateActions 'Создать корректирующие действия' (Filling e) {
    FOR nonconformity(e, Field f) AND template(f) = template(e) AND NOT existsAction(e, f) NEW a = CorrectiveAction DO {
        filling(a) <- e;
        field(a) <- f;
        description(a) <- name(f);
    }
}

FORM correctiveAction 'Корректирующее действие'
    OBJECTS a = CorrectiveAction PANEL
    PROPERTIES(a) nameObject READONLY, nameField READONLY, description,
                  nameResponsible, deadline, done, doneDate READONLY, created READONLY

    EDIT CorrectiveAction OBJECT a
;

DESIGN correctiveAction {
    OBJECTS {
        NEW header {
            alignment = STRETCH;
            MOVE PROPERTY(nameObject(a));
            MOVE PROPERTY(nameField(a));
            MOVE PROPERTY(description(a)) { charWidth = 50; }
            NEW row {
                horizontal = TRUE;
                MOVE PROPERTY(nameResponsible(a));
                MOVE PROPERTY(deadline(a));
                MOVE PROPERTY(done(a));
                MOVE PROPERTY(doneDate(a));
            }
        }
    }
}

FORM correctiveActions 'Корректирующие действия'
    OBJECTS a = CorrectiveAction
    PROPERTIES(a) READONLY nameObject, nameField, description, nameResponsible, deadline, done, doneDate
    PROPERTIES(a) NEWSESSION NEW, EDIT, DELETE

    FILTERGROUP status
        FILTER 'Открытые' opened(a) 'F8' DEFAULT
        FILTER 'Выполненные' done(a) 'F7'

    ORDERS deadline(a)

    LIST CorrectiveAction OBJECT a
;

NAVIGATOR {
    operations {
        NEW correctiveActions;
    }
}

// on the filling form: a generate button + the corrective actions list
EXTEND FORM filling
    PROPERTIES(e) generateActions, countAction READONLY

    OBJECTS ca = CorrectiveAction
    PROPERTIES(ca) READONLY nameField
    PROPERTIES(ca) description, nameResponsible, deadline, done
    FILTERS filling(ca) = e
;

DESIGN filling {
    OBJECTS {
        NEW corrective {
            caption = 'Корректирующие действия';
            alignment = STRETCH;
            NEW correctiveTop {
                horizontal = TRUE;
                MOVE PROPERTY(countAction(e));
                MOVE PROPERTY(generateActions(e));
            }
            MOVE BOX(ca) { caption = ''; fill = 1; }
        }
    }
}
