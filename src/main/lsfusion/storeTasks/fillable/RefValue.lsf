MODULE RefValue;

REQUIRE StoreTaskSettings, CheckObject;

NAMESPACE StoreTask;

// «Предмет», а не «предмет строки»: с #36841 тот же класс стоит и за скалярным
// полем-ссылкой (refValue у Filling), к строкам таблиц он больше не привязан.
CLASS ABSTRACT RefValue 'Предмет';
id '{ID}' = ABSTRACT ISTRING[50] (RefValue) CHARWIDTH 15;
name '{Name}' = ABSTRACT ISTRING[150] (RefValue) CHARWIDTH 25;
kind = ABSTRACT STRING[30] (RefValue);

refValue (STRING[30] kind, ISTRING[50] id) = GROUP MAX RefValue v IF kind(v) = kind AND id(v) = id;

available = ABSTRACT BOOLEAN (RefValue, CheckObject);

// Выбывший предмет (#36841): уволенный сотрудник, снятый с продажи товар. Кандидатом не
// предлагается (гейт в apiRowSubjects), но НЕ канал: kind у выбывшего остаётся, чтобы
// старые ответы продолжали резолвиться и не спотыкались о констрейнт канала — акт с
// уволенным сотрудником должен открываться, а не блокировать APPLY.
retired = ABSTRACT BOOLEAN (RefValue);

// ===== Штрихкоды (#37192) =====
// У товара штрихкодов несколько (штука, упаковка), у сотрудника и объекта их нет вовсе,
// поэтому в RefValue штрихкод — не поле, а два шва рядом с refValue(kind, id) выше.
// barcodes — все штрихкоды предмета строкой через запятую: телефон возит их в кэше
// кандидатов бланка и ищет по ним без связи. refValueByBarcode — предмет канала по
// штрихкоду: серверный поиск (apiRowSubjects) и скан у полки. ABSTRACT CASE, а не голый
// ABSTRACT: параметров-классов у него нет, диспетчеризовать по сигнатуре нечем, а
// реализация у каждого канала своя — ветка WHEN по kind. Артефакт реализует канал 'item'
// своим ручным справочником (SubjectItem); ERP-хост подключает свои штрихкоды
// мостиком в собственной логике, не здесь.
barcodes = ABSTRACT ISTRING[500] (RefValue);
refValueByBarcode = ABSTRACT CASE RefValue (STRING[30], ISTRING[50]);

// Номер предмета в канале по алфавиту (PARTITION SUM 1 ORDER — канонический row_number,
// тот же приём, что aiObjectRank в AiTools). Нужен предзагрузке subjects в
// apiExecutionBundle (#37637): она обязана обходиться БЕЗ доступности (available у
// ERP-хоста разворачивается в прайсы и остатки по всему каталогу), а потолок «первые
// N канала по алфавиту» без номера не вырезать.
subjectNo (RefValue v) = PARTITION SUM 1 IF id(v) AND NOT retired(v) ORDER name(v), v BY kind(v);

// Объект проверки — сам канал 'object' (#36841): прежняя «Ссылка на объект» у скалярного
// поля становится одним из каналов справочника, и ссылка на соседний объект никуда не
// девается. available для этого канала намеренно не реализуется: фильтра нет — канал
// показывает весь каталог, как поле и вело себя.
EXTEND CLASS CheckObject : RefValue;
id[RefValue] (CheckObject o) += ISTRING[50](id[CheckObject](o));
name[RefValue] (CheckObject o) += name[CheckObject](o);
kind (CheckObject o) += 'object';
