MODULE ChecklistTask;

// StoreTaskType — TaskType/taskType (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, FormTask, StoreTaskType;

NAMESPACE StoreTask;

// The checklist task type is a code-level plugin instance (not free user data),
// so it is seeded here and referenced by id. Its payload and execution are the
// unified template/filling engine (see FormTask): a checklist is simply a task
// type whose template has scored (scale/number) fields.
loadDefaultData () + {
    IF NOT taskType('checklist') THEN
        NEW t = TaskType {
            name(t) <- 'Проверка по чек-листу';
            id(t) <- 'checklist';
        }
}

checklistTaskType () = taskType('checklist');
