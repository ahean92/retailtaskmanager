MODULE ChecklistTask;

// StoreTaskType — TaskType/taskType; StoreTaskSettings — seedRequiredData (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, FormTask, StoreTaskType, StoreTaskSettings;

NAMESPACE StoreTask;

// The checklist task type is a code-level plugin instance (not free user data),
// so it is seeded here and referenced by id. Its payload and execution are the
// unified template/filling engine (see FormTask): a checklist is simply a task
// type whose template has scored (scale/number) fields.
seedRequiredData () + {
    IF NOT taskType(r'checklist') THEN
        NEW t = TaskType {
            name(t) <- 'Проверка по чек-листу';
            id(t) <- r'checklist';
        }
}

checklistTaskType () = taskType(r'checklist');
usesTemplate (TaskType tt) += WHEN tt = checklistTaskType() THEN TRUE;
