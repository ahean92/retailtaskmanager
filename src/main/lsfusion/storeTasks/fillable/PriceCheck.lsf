MODULE PriceCheck;

// StoreTaskType — TaskType/taskType; StoreTaskSettings — seedRequiredData (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskType, StoreTaskSettings;

NAMESPACE StoreTask;

// Task type: price-tag check. On the unified engine its execution is a Filling over a
// template whose single `table` field ("lines") holds item / system price / shelf price
// rows. This module only seeds the type; payload/execution is template-driven (see
// usesTemplate below).
seedRequiredData () + {
    IF NOT taskType(r'pricing') THEN
        NEW t = TaskType { name(t) <- 'Проверка ценников'; id(t) <- r'pricing'; }
}
pricingTaskType () = taskType(r'pricing');
usesTemplate (TaskType tt) += WHEN tt = pricingTaskType() THEN TRUE;
