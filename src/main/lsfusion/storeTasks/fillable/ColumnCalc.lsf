MODULE ColumnCalc;

// Filling — prevFilling; Field — familyField (пункт семейства редакций, #37174);
// TemplateClone — шов copyColumn, в который модуль складывает копирование СВОИХ настроек
// колонки (транзитивному REQUIRE не доверять)
REQUIRE Column, FillRow, Field, Filling, TemplateClone;

NAMESPACE StoreTask;

calcKind 'Расчёт' = DATA STRING[20] (Column);
operandA 'Операнд A (колонка)' = DATA STRING[50] (Column);
operandB 'Операнд B (колонка)' = DATA STRING[50] (Column);
constA 'Константа A' = DATA NUMERIC[18,4] (Column);
constB 'Константа B' = DATA NUMERIC[18,4] (Column);
totalMode 'Итог по колонке' = DATA STRING[10] (Column);

siblingColumn (Column c, STRING[50] col) = column(tableField(c), col);
operandValue (FillRow r, Column c, STRING[50] col, NUMERIC[18,4] const) =
    IF col THEN cellNumber(r, siblingColumn(c, col)) ELSE const;
opA (FillRow r, Column c) = operandValue(r, c, operandA(c), constA(c));
opB (FillRow r, Column c) = operandValue(r, c, operandB(c), constB(c));

calcCell (FillRow r, Column c) += WHEN calcKind(c) = 'product' THEN NUMERIC[18,4](opA(r, c) * opB(r, c));
calcCell (FillRow r, Column c) += WHEN calcKind(c) = 'diff' THEN NUMERIC[18,4](opA(r, c) - opB(r, c));
calcCell (FillRow r, Column c) += WHEN calcKind(c) = 'sum' THEN NUMERIC[18,4](opA(r, c) + opB(r, c));

// Строка прошлой проверки по тому же предмету. Поле сравнивается ПУНКТОМ семейства, а не
// объектом (#37174): прошлая проверка может быть по прежней редакции чек-листа, где то же
// табличное поле — другой объект, и «показание в прошлый раз» иначе пропадало бы на первой
// же проверке после смены редакции.
prevRow (FillRow r) = GROUP MAX FillRow p IF filling(p) = prevFilling(filling(r))
    AND familyField(tableField(p)) = familyField(tableField(r)) AND subject(p) = subject(r);
readingColumn (Column c) = siblingColumn(c, operandA(c));
// Колонка в прошлой строке — по той же причине по коду: column(tableField(prevRow), код)
consumption (FillRow r, Column c) =
    cellNumber(r, readingColumn(c))
    - cellNumber(prevRow(r), column(tableField(prevRow(r)), code(readingColumn(c))));
calcCell (FillRow r, Column c) += WHEN calcKind(c) = 'reading' THEN NUMERIC[18,4](consumption(r, c));
calcCell (FillRow r, Column c) += WHEN calcKind(c) = 'readingCost' THEN NUMERIC[18,4](consumption(r, c) * constB(c));

// Ноль — результат, а не пустота: GROUP SUM копит через (+), и при нулевой сумме отдаёт
// NULL, поэтому итог колонки, все значения которой нулевые, выходил пустым (то же явление,
// что у оценки бланка — Filling.liveTotalScore). Ноль подставляется, только когда в колонке
// есть хоть одна ячейка со ЗНАЧЕНИЕМ — гейт по cellValue, а не по cellFilled: у
// колонки-расчёта своих введённых ячеек нет вовсе, и гейт по заполненности оставил бы её
// нулевой итог пустым.
columnSum (Filling e, Column c) = OVERRIDE
    (GROUP SUM cellValue(FillRow r, c) IF filling(r) = e AND tableField(r) = tableField(c)),
    (0 IF (GROUP SUM 1 IF cellValue(FillRow p, c) AND filling(p) = e AND tableField(p) = tableField(c)));
columnCount (Filling e, Column c) = GROUP SUM 1 IF filling(FillRow r) = e AND tableField(r) = tableField(c) AND cellFilled(r, c);
columnAvg (Filling e, Column c) = columnSum(e, c) / columnCount(e, c);
columnTotal (Filling e, Column c) = CASE
    WHEN totalMode(c) = 'sum' THEN columnSum(e, c)
    WHEN totalMode(c) = 'avg' THEN columnAvg(e, c)
    WHEN totalMode(c) = 'count' THEN columnCount(e, c);

// Расчёт колонки при клонировании шаблона (TemplateClone). Здесь, а не в общем списке
// присваиваний: свойства объявлены тут, и правило копирования обязано жить рядом с ними —
// иначе следующая колонка-расчёт молча потеряется в копии.
// Операнды — коды соседних колонок, а коды при клонировании сохраняются, так что в копии
// расчёт указывает на копии тех же соседок и переносится как есть.
copyColumn (Column f, Column t) + {
    calcKind(t)  <- calcKind(f);
    operandA(t)  <- operandA(f);
    operandB(t)  <- operandB(f);
    constA(t)    <- constA(f);
    constB(t)    <- constB(f);
    totalMode(t) <- totalMode(f);
}
