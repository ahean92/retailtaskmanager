MODULE FillRow;

// FieldType — FieldType.table (транзитивному REQUIRE не доверять)
REQUIRE Filling, Column, RefValue, FieldType;

NAMESPACE StoreTask;

// A row of a `table`-typed field inside a filling. Cells are typed values captured
// per (FillRow, Column), mirroring the scalar (Filling, Field) value slots.
CLASS FillRow 'Строка';
filling = DATA Filling (FillRow) NONULL DELETE;
tableField = DATA Field (FillRow);
index '№' (FillRow r) = PARTITION SUM 1 ORDER r BY filling(r), tableField(r) CHARWIDTH 4;

subject = DATA RefValue (FillRow);
subjectName 'Предмет' = DATA ISTRING[150] (FillRow);
name 'Предмет' (FillRow r) = OVERRIDE subjectName(r), name(subject(r));
subjectId (FillRow r) = id(subject(r));

rowKey = DATA STRING[36] (FillRow);
row = GROUP AGGR FillRow r BY filling(r), rowKey(r);

// cell values (MVP: number / text / option; date/bool/ref can follow)
cellNumber 'Значение' = DATA NUMERIC[14,3] (FillRow, Column);
cellText 'Текст' = DATA ISTRING[250] (FillRow, Column);
cellOption = DATA Option (FillRow, Column);
nameCellOption 'Вариант' (FillRow r, Column c) = name(cellOption(r, c));

calcCell = ABSTRACT CASE NUMERIC[18,4] (FillRow, Column);
cellValue (FillRow r, Column c) = OVERRIDE cellNumber(r, c), calcCell(r, c);

cellFilled (FillRow r, Column c) = cellNumber(r, c) OR cellText(r, c) OR cellOption(r, c);
// same shape as inNorm(Filling, Field) — an unset bound cannot be violated
cellInNorm (FillRow r, Column c) = NOT (cellValue(r, c) < minNorm(c)) AND NOT (cellValue(r, c) > maxNorm(c));

// a row counts as filled once any of its editable cells has a value
rowFilled (FillRow r) = GROUP SUM 1 IF cellFilled(r, Column c) AND tableField(c) = tableField(r) AND NOT readonly(c);

// table-field aggregates over a filling
countRow (Filling e, Field f) = GROUP SUM 1 IF filling(FillRow r) = e AND tableField(r) = f;
countFilledRow (Filling e, Field f) = GROUP SUM 1 IF filling(FillRow r) = e AND tableField(r) = f AND rowFilled(r);

// plug into Filling.answered (declared ABSTRACT there): a table field is answered
// once it has at least one filled row.
tableAnswered (Filling e, Field f) += TRUE IF type(f) = FieldType.table AND countFilledRow(e, f);

answer(Filling e, Field f) += WHEN type(f) = FieldType.table THEN ISTRING[500]('Строк: ' + STRING[10](countFilledRow(e, f)));
