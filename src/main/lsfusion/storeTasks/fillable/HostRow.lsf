MODULE HostRow;

// StoreTaskCore — task/checkObject (транзитивному REQUIRE не доверять)
REQUIRE FillRow, Field, FieldType, FormTask, RefValue, StoreTaskCore;

NAMESPACE StoreTask;

fillRows ABSTRACT LIST (Filling, Field);

hostRowExists (Filling e, Field f, RefValue v) =
    GROUP SUM 1 IF filling(FillRow r) = e AND tableField(r) = f AND subject(r) = v;

availableAny (CheckObject o, STRING[30] kind) =
    GROUP SUM 1 IF available(RefValue v, o) AND kind(v) = kind;

// Первый эшелон кандидатов канала (#36841, #36943): доступные на объекте, а если хост
// фильтра по каналу не дал ни одного — весь канал. Живёт здесь, а не в ручке, потому что
// условие обязано быть ОДНИМ у apiRowSubjects и агрегата apiExecutionBundle: разъехавшись,
// пикер «+ позиция» и предзагрузка кандидатов стали бы показывать разные списки.
echelon (RefValue v, CheckObject o) = available(v, o) OR NOT availableAny(o, kind(v));

expandHostRows (Filling e) {
    FOR template(Field f) = template(e) AND type(f) = FieldType.table AND rowSource(f) = 'host' DO
        fillRows(e, f);
}
WHEN SET(Filling e IS Filling) DO expandHostRows(e);

offSystem 'Внесистемная' (FillRow r) =
    rowSource(tableField(r)) = 'host' AND subject(r)
    AND NOT available(subject(r), checkObject(task(filling(r))));
