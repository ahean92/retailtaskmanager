MODULE FormTask;

// Execution — за executionKind, доопределяемым ниже (транзитивному REQUIRE не доверять)
// Также StoreTaskStatus — taskStatus; StoreTaskType — taskType; StoreTaskForms — карточка task
// и список tasks, которые модуль расширяет (фильтр по шаблону); StoreTaskSettings —
// seedRequiredData (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskForms, Execution, Filling, Template, StoreTaskStatus, StoreTaskType, StoreTaskSettings;

NAMESPACE StoreTask;

// The generic "procedure/form" task type. Like the checklist type it is a code-level
// plugin instance; its payload is a Template, and its execution is a Filling.
seedRequiredData () + {
    IF NOT taskType('form') THEN
        NEW t = TaskType {
            name(t) <- 'Процедура';
            id(t) <- 'form';
        }
}

formTaskType () = taskType('form');
isFormTask (Task t) = type(t) = formTaskType();

// Any template-driven task type runs on the unified filling engine: the generic
// procedure ('form'), the checklist ('checklist'), the stock recount ('recount') and
// the price check ('pricing') — the last two use a `table` field. Keeping the set here
// (by type id, no module dependency) lets the shared template payload + Filling
// creation serve every type.
// Declared on the TYPE: a creation preset must answer «does this type need a template»
// before any task exists (#36713). The Task version is a composition over its type.
usesTemplate (TaskType tt) = tt = taskType('form') OR tt = taskType('checklist')
    OR tt = taskType('recount') OR tt = taskType('pricing');
usesTemplate (Task t) = usesTemplate(type(t));

// payload: which template a template-driven task uses
template = DATA Template (Task);
nameTemplate 'Шаблон' (Task t) = name(template(t));

// task card subtitle for template-driven tasks (NULL for other types)
mobileSubtitle(Task t) += ISTRING[100](nameTemplate(t));

// Шаблонные типы открываются бланком (#36872) — тем же предикатом usesTemplate, по
// которому этот модуль создаёт Filling и по которому пресет требует шаблон.
executionKind(TaskType tt) += ISTRING[10]('fill' IF usesTemplate(tt));

CONSTRAINT template(Task t) AND NOT usesTemplate(t)
    MESSAGE 'Шаблон можно задать только для задач «Процедура» и «Проверка по чек-листу»';

// create the Filling when execution starts (any template-driven task)
startExecution(Task t) + {
    IF usesTemplate(t) AND template(t) THEN {
        NEW f = Filling {
            task(f) <- t;
            template(f) <- template(t);
        }
        status(t) <- taskStatus('in progress');
        autoStatus(t) <- TRUE;
    }
}

EXTEND FORM task
    PROPERTIES(t) nameTemplate SHOWIF usesTemplate(t)
;

DESIGN task {
    object {
        MOVE PROPERTY(nameTemplate(t));
    }
}

// Фильтр списка задач по шаблону — семейством, а не редакцией: задача хранит конкретную
// редакцию (#37174), а ищут в списке по чек-листу целиком, и точное сравнение молча прятало
// бы задачи прежних редакций. Тот же предикат, что у фильтра шаблона в отчётах
// (ScorecardReport.matchTemplate). Селектор ложится в ленту фильтров списка рядом с
// объектом и типом (перенос — PulseForm, home), условия канбан наследует зеркалом
// [FILTER tasks.t](tk).
templateFilter = DATA LOCAL Template ();
nameTemplateFilter 'Шаблон' () = name(templateFilter());

// Отдельное действие, а не инлайн в ON CHANGE: форма tasks уже имеет объект t (Task),
// и t шаблонного диалога внутри её обработчика давал бы неоднозначность имён
changeTemplateFilter () {
    DIALOG templates OBJECTS t = templateFilter() INPUT NULL DO { templateFilter() <- t; }
}

EXTEND FORM tasks
    PROPERTIES nameTemplateFilter() ON CHANGE changeTemplateFilter()
    FILTERS NOT templateFilter() OR family(template(t)) = family(templateFilter())
;
