MODULE FormTask;

REQUIRE StoreTaskCore, Filling, Template;

NAMESPACE StoreTask;

// The generic "procedure/form" task type. Like the checklist type it is a code-level
// plugin instance; its payload is a Template, and its execution is a Filling.
loadDefaultData () + {
    IF NOT taskType('form') THEN
        NEW t = TaskType {
            name(t) <- 'Процедура';
            id(t) <- 'form';
        }
}

formTaskType () = taskType('form');
isFormTask (Task t) = type(t) = formTaskType();

// Any template-driven task type runs on the unified filling engine: the generic
// procedure ('form'), the checklist ('checklist'), the stock recount ('recount') and
// the price check ('pricing') — the last two use a `table` field. Keeping the set here
// (by type id, no module dependency) lets the shared template payload + Filling
// creation serve every type.
// Declared on the TYPE: a creation preset must answer «does this type need a template»
// before any task exists (#36713). The Task version is a composition over its type.
usesTemplate (TaskType tt) = tt = taskType('form') OR tt = taskType('checklist')
    OR tt = taskType('recount') OR tt = taskType('pricing');
usesTemplate (Task t) = usesTemplate(type(t));

// payload: which template a template-driven task uses
template = DATA Template (Task);
nameTemplate 'Шаблон' (Task t) = name(template(t));

// task card subtitle for template-driven tasks (NULL for other types)
mobileSubtitle(Task t) += ISTRING[100](nameTemplate(t));

CONSTRAINT template(Task t) AND NOT usesTemplate(t)
    MESSAGE 'Шаблон можно задать только для задач «Процедура» и «Проверка по чек-листу»';

// create the Filling when execution starts (any template-driven task)
startExecution(Task t) + {
    IF usesTemplate(t) AND template(t) THEN {
        NEW f = Filling {
            task(f) <- t;
            template(f) <- template(t);
        }
        status(t) <- taskStatus('in progress');
    }
}

EXTEND FORM task
    PROPERTIES(t) nameTemplate SHOWIF usesTemplate(t)
;

DESIGN task {
    object {
        MOVE PROPERTY(nameTemplate(t));
    }
}
