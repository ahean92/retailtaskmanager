MODULE Field;

REQUIRE Template, FieldType, FillOption, StoreTaskNumberUtils;

NAMESPACE StoreTask;

// A single field of a template. Addressed by a stable `code` within its template.
CLASS Field 'Поле';
section = DATA Section (Field) NONULL DELETE;
template 'Шаблон' (Field f) = template(section(f));
nameSection 'Раздел' (Field f) = name(section(f));
sectionIndex 'Разд.' (Field f) = index(section(f));
index '№' (Field f) = PARTITION SUM 1 ORDER f BY section(f) CHARWIDTH 4;

code '{Code}' = DATA STRING[50] (Field);
field = GROUP AGGR Field f BY template(f), code(f);

name 'Название' = DATA ISTRING[250] (Field) IN id CHARWIDTH 40;
hint 'Подсказка' = DATA ISTRING[500] (Field) CHARWIDTH 30;

type = DATA FieldType (Field);
typeCode 'Тип' (Field f) = code(type(f));
// what the constructor shows: a composition through the link, so the cell still offers the
// type picker and writes type(f) — but displays its caption instead of an internal id
nameType 'Тип' (Field f) = name(type(f));

// config
optionSet 'Варианты' = DATA OptionSet (Field);
nameOptionSet 'Варианты' (Field f) = name(optionSet(f));
unit 'Ед.' = DATA STRING[20] (Field);
minNorm 'Норма от' = DATA NUMERIC[14,4] (Field);
maxNorm 'Норма до' = DATA NUMERIC[14,4] (Field);
maxLen 'Макс. длина' = DATA INTEGER (Field);

subjectKind 'Канал справочника' = DATA STRING[30] (Field);
rowSource 'Источник строк' = DATA STRING[10] (Field);
allowManual 'Ручное добавление' = DATA BOOLEAN (Field);
allowFreeSubject 'Свободный предмет' = DATA BOOLEAN (Field);
uniqueSubject 'Уникальный предмет' = DATA BOOLEAN (Field);

// Канал справочника поля с учётом умолчания (#36841): objectref без заданного канала —
// прежняя ссылка на объект проверки, поэтому 'object', а не пусто. У таблиц умолчания
// нет: пустой канал = строки без предмета. Всё, что отвечает кандидатами или принимает
// ссылку (apiRowSubjects, apiSetField), обязано ходить сюда, а не в subjectKind напрямую.
refKind (Field f) = OVERRIDE subjectKind(f), ('object' IF type(f) = FieldType.objectref);

// Норма как текст бланка («от 2 до 6 °C»): карточка заполнения и акт показывают границы
// одной колонкой; односторонняя норма отображается той стороной, которая задана.
norm 'Норма' (Field f) = ISTRING[100]((CONCAT ' ', 'от ' + numericString(minNorm(f)), 'до ' + numericString(maxNorm(f)), unit(f))) CHARWIDTH 12;

// cross-cutting flags
required 'Обязательное' = DATA BOOLEAN (Field);
requirePhoto 'Фото при несоотв.' = DATA BOOLEAN (Field);
requireComment 'Коммент. при несоотв.' = DATA BOOLEAN (Field);
critical 'Критичное' = DATA BOOLEAN (Field);
weight 'Вес' = DATA NUMERIC[8,2] (Field);
WHEN LOCAL SET(Field f IS Field) AND NOT CHANGED(weight(f)) DO weight(f) <- 1;

// input step of a `score` field: 0.5 lets an inspector put "6.5 out of 7". A hint for the
// input control, not a stored constraint — see ScoreByValue for what the server does check.
step 'Шаг' = DATA NUMERIC[8,2] (Field);

// scoring is opt-in: only fields explicitly marked (and of a scorable type) contribute
// to the percentage. A procedure form (SIM swap) leaves this off — no spurious percent.
scoreable 'Учитывать в оценке' = DATA BOOLEAN (Field);

// Maximum score attainable on a field. ABSTRACT on purpose: every scoring mechanic is its
// own module registering its own rule (ScoreByNorm / ScoreByOption / ScoreByValue), so the
// core holds no arithmetic and knows no field types. Having a rule is what makes a field
// scorable — hence `scored` below reads it instead of listing types, and a mechanic added
// later needs no edit here.
//
// Plain CASE, i.e. OVERRIDE: NOT exclusive. EXCLUSIVE proves mutual exclusion from the
// parameter CLASSES, not from the WHEN conditions — every rule here has the same signature
// (Field) and differs only by the value of type(f), so EXCLUSIVE rejects them all at startup
// as a signature intersection. One rule per FieldType therefore stays a convention: if two
// modules ever claim one type, the later-loaded one silently wins.
//
// NUMERIC[18,4] is not arbitrary: it is the widest implementation any mechanic produces
// (an option's score[10,2] times the field's weight[8,2]). An implementation must fit
// within the abstract's value class — there is no implicit cast — so declaring it narrower
// rejects ScoreByOption at startup.
maxScore = ABSTRACT CASE NUMERIC[18,4] (Field);

scored (Field f) = scoreable(f) AND maxScore(f) > 0;

countField 'Полей' (Section s) = GROUP SUM 1 IF section(Field f) = s;

// --- constructor: sections and their fields on the template edit form ---
EXTEND FORM template
    OBJECTS sec = Section
    PROPERTIES(sec) index READONLY, name, countField
    PROPERTIES(sec) NEW, DELETE
    FILTERS template(sec) = t
    ORDERS index(sec)

    OBJECTS fld = Field
    PROPERTIES(fld) index READONLY, code, name, nameType, nameOptionSet, unit,
                    minNorm, maxNorm, step, required, requirePhoto, requireComment,
                    critical, scoreable, weight, hint,
                    subjectKind SHOWIF (type(fld) = FieldType.table OR type(fld) = FieldType.objectref),
                    rowSource SHOWIF type(fld) = FieldType.table,
                    allowManual SHOWIF type(fld) = FieldType.table,
                    allowFreeSubject SHOWIF (type(fld) = FieldType.table OR type(fld) = FieldType.objectref),
                    uniqueSubject SHOWIF type(fld) = FieldType.table
    PROPERTIES(fld) NEW, DELETE
    FILTERS section(fld) = sec
    ORDERS index(fld)
;

DESIGN template {
    structure {
        horizontal = TRUE;
        MOVE BOX(sec) { caption = 'Разделы'; fill = 1; }
        MOVE BOX(fld) { caption = 'Поля'; fill = 2; }
    }
}
