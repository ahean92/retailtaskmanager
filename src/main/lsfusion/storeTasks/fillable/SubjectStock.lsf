MODULE SubjectStock;

// StoreTaskCore — task/checkObject; Filling — Filling; FillRow — FillRow/rowKey/subjectName;
// Field — subjectKind; RefValue — available; StoreTaskSettings — папка catalogs
// (транзитивному REQUIRE не доверять)
REQUIRE SubjectItem, HostRow, StoreTaskCore, Filling, FillRow, Field, RefValue, StoreTaskSettings;

NAMESPACE StoreTask;

// Опция хоста, в StoreTaskLib не входит (#36943): остатки объекта по каналу 'item' как
// пользовательский справочник — отсюда строки табличного поля от хоста (rowSource =
// 'host') и признак available для поля-ссылки. Артефакт даёт канал, хост решает, чем его
// наполнить: настоящие остатки из ERP — своей реализацией available/fillRows без этого
// модуля; ручной справочник — этой строкой REQUIRE (так делают StoreTaskStandalone и
// StoreTaskMite).

stockItem 'В остатках' = DATA BOOLEAN (SubjectItem, CheckObject);
available (SubjectItem s, CheckObject o) += stockItem(s, o);

fillRows (Filling e, Field f) + {
    FOR subjectKind(f) = 'item' AND stockItem(SubjectItem s, checkObject(task(e))) AND NOT hostRowExists(e, f, s)
        NEW r = FillRow DO {
        filling(r) <- e;
        tableField(r) <- f;
        rowKey(r) <- 'stk' + STRING[19](LONG(r));
        subject(r) <- s;
        subjectName(r) <- name(s);
    }
}

countStock 'Позиций в остатках' (CheckObject o) = GROUP SUM 1 IF stockItem(SubjectItem s, o);

FORM subjectStocks 'Остатки по объектам'
    OBJECTS o = CheckObject
    PROPERTIES(o) READONLY id, name, countStock
    ORDERS name(o)

    OBJECTS s = SubjectItem
    PROPERTIES(s) READONLY itemId, itemName
    PROPERTIES stockItem(s, o)
    ORDERS itemName(s)
;

DESIGN subjectStocks {
    OBJECTS {
        NEW body {
            horizontal = TRUE;
            fill = 1;
            MOVE BOX(o) { caption = 'Объекты'; fill = 1; }
            MOVE BOX(s) { caption = 'Позиции — отметьте, что в остатках'; fill = 1; }
        }
    }
}

NAVIGATOR {
    catalogs {
        NEW subjectStocks;
    }
}
