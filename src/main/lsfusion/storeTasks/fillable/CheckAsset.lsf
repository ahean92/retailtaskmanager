MODULE CheckAsset;

REQUIRE CheckObject;

NAMESPACE StoreTask;

// A thin generic inspected/serviced object (a device, a fridge, ...). Deliberately
// attribute-light: its own name plus wherever it physically sits. Bridges into
// CheckObject so tasks can target it directly. (Named CheckAsset — Accounting owns Asset.)
CLASS CheckAsset 'Объект' : CheckObject;

assetName '{Name}' = DATA ISTRING[150] (CheckAsset) IN id CHARWIDTH 25;

// Where the asset is. Abstract on purpose: the host decides what a place is — in ERP
// it is an Inventory location, see erp/CheckAssetLocation. Kept as a separate abstract
// rather than reading address(CheckObject) of a parent, which would make the inherited
// abstract self-referential.
addressAsset 'Адрес' = ABSTRACT ISTRING[250] (CheckAsset);

// Coordinates follow the address seam exactly: the host decides whether an asset has
// its own coordinates or inherits them from wherever it sits (in ERP — from the store,
// see erp/CheckAssetLocation).
latitudeAsset 'Широта' = ABSTRACT DOUBLE (CheckAsset);
longitudeAsset 'Долгота' = ABSTRACT DOUBLE (CheckAsset);

assetId '{ID}' = DATA ISTRING[30] (CheckAsset) IN id CHARWIDTH 10;
checkAsset (ISTRING[30] c) = GROUP MAX CheckAsset a IF assetId(a) = c;

// implement the abstract CheckObject attributes
id (CheckAsset a) += assetId(a);
name (CheckAsset a) += assetName(a);
address (CheckAsset a) += addressAsset(a);
latitude (CheckAsset a) += latitudeAsset(a);
longitude (CheckAsset a) += longitudeAsset(a);

// --- catalog ---
// The address column is the host's business (addressAsset is abstract), so it is added
// there — see StoreTaskStandalone.
FORM checkAssets 'Объекты проверки'
    OBJECTS a = CheckAsset
    PROPERTIES(a) assetId, assetName
    PROPERTIES(a) NEW, DELETE

    LIST CheckAsset OBJECT a
;

NAVIGATOR {
    catalogs {
        NEW checkAssets;
    }
}
