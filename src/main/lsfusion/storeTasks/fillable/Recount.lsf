MODULE Recount;

// StoreTaskType — TaskType/taskType; StoreTaskSettings — seedRequiredData (транзитивному REQUIRE не доверять)
REQUIRE StoreTaskCore, StoreTaskType, StoreTaskSettings;

NAMESPACE StoreTask;

// Task type: stock recount. On the unified engine its execution is a Filling over a
// template whose single `table` field ("positions") holds the counted rows. This
// module only seeds the type; the payload/execution is template-driven (see
// usesTemplate below).
seedRequiredData () + {
    IF NOT taskType(r'recount') THEN
        NEW t = TaskType { name(t) <- 'Пересчёт остатков'; id(t) <- r'recount'; }
}
recountTaskType () = taskType(r'recount');
usesTemplate (TaskType tt) += WHEN tt = recountTaskType() THEN TRUE;
