MODULE Recount;

REQUIRE StoreTaskCore;

NAMESPACE StoreTask;

// Task type: stock recount. On the unified engine its execution is a Filling over a
// template whose single `table` field ("positions") holds the counted rows. This
// module only seeds the type; the payload/execution is template-driven (see
// FormTask.usesTemplate — 'recount' is included there).
loadDefaultData () + {
    IF NOT taskType('recount') THEN
        NEW t = TaskType { name(t) <- 'Пересчёт остатков'; id(t) <- 'recount'; }
}
recountTaskType () = taskType('recount');
