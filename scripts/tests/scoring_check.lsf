    n() <- n() + 1;
    IF NOT StoreTask.sectionScore(eW(), secW1()) = 2.5 THEN fails() <- CONCAT '\n', fails(), 'I.sectionScore(первый): ожидалось 2.5 (5 × 0.5), получено ' + (OVERRIDE STRING(StoreTask.sectionScore(eW(), secW1())), 'NULL');
    n() <- n() + 1;
    IF NOT StoreTask.sectionMax(eW(), secW2()) = 15 THEN fails() <- CONCAT '\n', fails(), 'I.sectionMax(второй): ожидалось 15 (10 × 1.5), получено ' + (OVERRIDE STRING(StoreTask.sectionMax(eW(), secW2())), 'NULL');

    StoreTask.weight(secW1()) <- NULL;
    StoreTask.weight(secW2()) <- NULL;
    n() <- n() + 1;
    IF NOT StoreTask.totalScore(eW()) = 15 THEN fails() <- CONCAT '\n', fails(), 'I.totalScore без весов: ожидалось 15 (простая сумма), получено ' + (OVERRIDE STRING(StoreTask.totalScore(eW())), 'NULL');
    n() <- n() + 1;
    IF NOT StoreTask.percent(eW()) = 75.00 THEN fails() <- CONCAT '\n', fails(), 'I.percent без весов: ожидалось 75.00, получено ' + (OVERRIDE STRING(StoreTask.percent(eW())), 'NULL');
    n() <- n() + 1;
    IF StoreTask.weighted(eW()) THEN fails() <- CONCAT '\n', fails(), 'I.weighted без весов: ожидалось NULL';
}

IF NOT stop() THEN {
    // ----- F. завершение: обязательное поле блокирует APPLY -----
    // возвращаемся к состоянию A (замечаний нет), но обязательный текст пуст
    StoreTask.optionValue(e(), f1()) <- oGood();
    StoreTask.optionValue(e(), f2()) <- oGood();
    StoreTask.numberValue(e(), f3()) <- 4;
    StoreTask.numberValue(e(), f4()) <- 100;
    StoreTask.numberValue(e(), f5()) <- 5;
    StoreTask.boolValue(e(), f6()) <- TTRUE;
    StoreTask.numberValue(e(), f7()) <- 7;
    StoreTask.optionValue(e(), f8()) <- oYes();
    StoreTask.textValue(e(), f9()) <- NULL;
    StoreTask.verdictScale(tpl()) <- NULL;

    n() <- n() + 1;
    IF StoreTask.missingEvidence(e()) THEN fails() <- CONCAT '\n', fails(), 'F.missingEvidence: ожидалось NULL, получено ' + STRING(StoreTask.missingEvidence(e()));
    n() <- n() + 1;
    IF NOT StoreTask.missingRequired(e()) = 1 THEN fails() <- CONCAT '\n', fails(), 'F.missingRequired: ожидалось 1, получено ' + (OVERRIDE STRING(StoreTask.missingRequired(e())), 'NULL');

    StoreTask.state(e()) <- StoreTask.ExecutionState.finished;
    APPLY NESTED LOCAL;
    n() <- n() + 1;
    IF NOT System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'F.finish: APPLY прошёл, хотя обязательное поле пусто — констрейнт не сработал; синтетика применена, снимет финальная уборка';
    } ELSE {
        n() <- n() + 1;
        IF NOT (System.applyMessage() LIKE r'%обязательные поля%') THEN fails() <- CONCAT '\n', fails(), 'F.finish: отказ не тот — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
    }
    CANCEL NESTED LOCAL;
} ELSE {
    fails() <- CONCAT '\n', fails(), 'F пропущен: ранее выполнен stop — обязательное поле не проверялось';
}

ownCorr(StoreTask.Task x) <- TRUE WHERE ownTask(StoreTask.task(StoreTask.sourceFilling(x)));
dataOk() <- TRUE;
DELETE StoreTask.TaskHistory h WHERE ownTask(StoreTask.task(h)) OR ownCorr(StoreTask.task(h));
APPLY NESTED LOCAL;
IF System.canceled() THEN {
    fails() <- CONCAT '\n', fails(), 'уборка: APPLY историй не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
    CANCEL NESTED LOCAL;
    dataOk() <- NULL;
}
DELETE StoreTask.Task x WHERE ownCorr(x);
APPLY NESTED LOCAL;
IF System.canceled() THEN {
    fails() <- CONCAT '\n', fails(), 'уборка: APPLY корректирующих не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
    CANCEL NESTED LOCAL;
    dataOk() <- NULL;
}
DELETE StoreTask.FillRow r WHERE ownTask(StoreTask.task(StoreTask.filling(r)));
APPLY NESTED LOCAL;
IF System.canceled() THEN {
    fails() <- CONCAT '\n', fails(), 'уборка: APPLY строк не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
    CANCEL NESTED LOCAL;
    dataOk() <- NULL;
}
DELETE StoreTask.Execution z WHERE ownTask(StoreTask.task(z));
APPLY NESTED LOCAL;
IF System.canceled() THEN {
    fails() <- CONCAT '\n', fails(), 'уборка: APPLY выполнений не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
    CANCEL NESTED LOCAL;
    dataOk() <- NULL;
}
DELETE StoreTask.Task x WHERE ownTask(x);
APPLY NESTED LOCAL;
IF System.canceled() THEN {
    fails() <- CONCAT '\n', fails(), 'уборка: APPLY задач не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
    CANCEL NESTED LOCAL;
    dataOk() <- NULL;
}
IF dataOk() THEN {
    DELETE StoreTask.Field f WHERE ownTpl(StoreTask.template(StoreTask.section(f)));
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY полей не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
        dataOk() <- NULL;
    }
}
IF dataOk() THEN {
    DELETE StoreTask.Section s WHERE ownTpl(StoreTask.template(s));
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY разделов не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
        dataOk() <- NULL;
    }
}
IF dataOk() THEN {
    DELETE StoreTask.Template x WHERE ownTpl(x);
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY шаблонов не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
        dataOk() <- NULL;
    }
}
IF dataOk() THEN {
    DELETE StoreTask.Option o WHERE ownOs(StoreTask.optionSet(o));
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY вариантов не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
        dataOk() <- NULL;
    }
}
IF dataOk() THEN {
    DELETE StoreTask.OptionSet x WHERE ownOs(x);
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY наборов вариантов не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
        dataOk() <- NULL;
    }
}
IF dataOk() THEN {
    DELETE StoreTask.VerdictScale x WHERE ownVs(x);
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY шкал не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
    }
}
IF dataOk() THEN {
    DELETE StoreTask.CheckAsset x WHERE ownCa(x);
    APPLY NESTED LOCAL;
    IF System.canceled() THEN {
        fails() <- CONCAT '\n', fails(), 'уборка: APPLY объектов не прошёл — ' + (OVERRIDE STRING(System.applyMessage()), 'NULL');
        CANCEL NESTED LOCAL;
    }
}

n() <- n() + 1;
NEWSESSION NESTED LOCAL {
    FOR ownTask(StoreTask.Task rt) AND rt IS StoreTask.Task DO fails() <- CONCAT '\n', fails(), 'остаток: задача ' + (OVERRIDE StoreTask.name(rt), '?');
    FOR ownCorr(StoreTask.Task rc) AND rc IS StoreTask.Task DO fails() <- CONCAT '\n', fails(), 'остаток: корректирующая ' + (OVERRIDE StoreTask.name(rc), '?');
    FOR ownTpl(StoreTask.Template rp) AND rp IS StoreTask.Template DO fails() <- CONCAT '\n', fails(), 'остаток: шаблон ' + (OVERRIDE StoreTask.code(rp), '?');
    FOR ownOs(StoreTask.OptionSet ro) AND ro IS StoreTask.OptionSet DO fails() <- CONCAT '\n', fails(), 'остаток: набор вариантов ' + (OVERRIDE StoreTask.name(ro), '?');
    FOR ownVs(StoreTask.VerdictScale rv) AND rv IS StoreTask.VerdictScale DO fails() <- CONCAT '\n', fails(), 'остаток: шкала ' + (OVERRIDE StoreTask.name(rv), '?');
    FOR ownCa(StoreTask.CheckAsset ra) AND ra IS StoreTask.CheckAsset DO fails() <- CONCAT '\n', fails(), 'остаток: объект ' + (OVERRIDE StoreTask.assetId(ra), '?');
}

EXPORT JSON FROM ok = NOT fails(), checks = n(), failures = fails();
