MODULE CoreOnlyHost;

// Приёмочный хост для run-core-only-host.ps1: берёт ТОЛЬКО ядро подсистемы. Если сервер
// с этим верхним модулем стартует, значит StoreTaskCoreLib не тянет за собой ни главную
// телефона, ни каналы уведомлений, ни AI — их пакеты остаются по-настоящему отключаемыми.
// Исполнителей и объектов у такого хоста нет, и не надо: абстракции без реализаций
// сервер поднимает.
REQUIRE StoreTaskCoreLib;

NAMESPACE StoreTask;
