// ===== #37637: предзагрузка subjects бандла без доступности; первые N канала — TOP =====
// Прогон — POST тела на /eval/action (из корня retailtaskmanager):
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/tests/ticket37637_check.lsf http://localhost:7671/eval/action
// Свои позиции (коды ITM37637-*) заводятся в сессии запроса и не применяются: без APPLY
// сессия eval исчезает вместе с ними. Первые N считаются по всему каналу, поэтому
// ожидания верны только на базе без своих позиций — на новой базе набора (run-server-suite.ps1).
//
// Проверяется действие, которым живёт потолок предзагрузки subjects в apiExecutionBundle
// (RefValue.pickFirstSubjects), — а не переписанная копия условия.
// Ответ — JSON: ok / checks / failures.

LOCAL fails = STRING ();
LOCAL n = INTEGER ();
LOCAL capTwo = TEXT ();
LOCAL coded = INTEGER ();
LOCAL noId = INTEGER ();
LOCAL objPicked = INTEGER ();
LOCAL itemsWithObj = INTEGER ();
LOCAL objFirst = BOOLEAN ();

NEW ia = StoreTask.SubjectItem { StoreTask.itemId(ia) <- 'ITM37637-A'; StoreTask.itemName(ia) <- 'Бета'; }
NEW ib = StoreTask.SubjectItem { StoreTask.itemId(ib) <- 'ITM37637-B'; StoreTask.itemName(ib) <- 'Альфа'; }
NEW ic = StoreTask.SubjectItem { StoreTask.itemId(ic) <- 'ITM37637-C'; StoreTask.itemName(ic) <- 'Вышка'; }
NEW inoid = StoreTask.SubjectItem { StoreTask.itemName(inoid) <- 'Без кода'; }

n() <- 4;
// потолок предзагрузки: «первые 2 канала» — ровно Альфа и Бета
// (коды расставлены НЕ по алфавиту — проверяет, что ключ именно name, а не id)
StoreTask.pickFirstSubjects('item', 2);
capTwo() <- GROUP CONCAT StoreTask.itemId(StoreTask.SubjectItem s) IF StoreTask.pickedSubject(s), ';' ORDER StoreTask.itemName(s), s;
IF NOT capTwo() = 'ITM37637-B;ITM37637-A' THEN fails() <- CONCAT '\n', fails(), 'первые два: ' + (OVERRIDE capTwo(), 'NULL');

// с запасом по лимиту: все три с кодом, а позиция без бизнес-ключа — нет (то же правило,
// что в WHERE предзагрузки)
StoreTask.pickedSubject(StoreTask.RefValue v) <- NULL;
StoreTask.pickFirstSubjects('item', 10);
coded() <- GROUP SUM 1 IF StoreTask.pickedSubject(StoreTask.SubjectItem s) AND StoreTask.itemId(s) LIKE 'ITM37637-%';
IF NOT coded() = 3 THEN fails() <- CONCAT '\n', fails(), 'своих с кодом отмечено: ' + (OVERRIDE STRING(coded()), 'NULL');
noId() <- GROUP SUM 1 IF StoreTask.pickedSubject(StoreTask.SubjectItem s) AND StoreTask.itemName(s) = 'Без кода';
IF noId() THEN fails() <- CONCAT '\n', fails(), 'позиция без кода попала в кандидаты';

// канал 'object' считается своим счётом: первый — первый объект по имени, товары не задеты.
// Канал — по kind, а не классом параметра: класс в GROUP только разрешает имя и выборку не
// сужает, «CheckObject o» прошёл бы по всем предметам (сотрудникам и товарам тоже)
StoreTask.pickedSubject(StoreTask.RefValue v) <- NULL;
StoreTask.pickFirstSubjects('object', 1);
objPicked() <- GROUP SUM 1 IF StoreTask.pickedSubject(StoreTask.RefValue v) AND StoreTask.kind(v) = 'object';
itemsWithObj() <- GROUP SUM 1 IF StoreTask.pickedSubject(StoreTask.RefValue v) AND StoreTask.kind(v) = 'item';
objFirst() <- TRUE IF StoreTask.name[StoreTask.RefValue](GROUP MAX StoreTask.RefValue v IF StoreTask.pickedSubject(v) AND StoreTask.kind(v) = 'object')
    = (GROUP MIN StoreTask.name[StoreTask.RefValue](StoreTask.RefValue w) IF StoreTask.kind(w) = 'object' AND StoreTask.id[StoreTask.RefValue](w) AND NOT StoreTask.retired(w));
IF NOT (objPicked() = 1 AND NOT itemsWithObj() AND objFirst()) THEN
    fails() <- CONCAT '\n', fails(), 'канал объектов: отмечено ' + (OVERRIDE STRING(objPicked()), 'NULL')
        + ', товаров ' + (OVERRIDE STRING(itemsWithObj()), '0') + ', первый по имени ' + (IF objFirst() THEN 'да' ELSE 'нет');

EXPORT JSON FROM ok = NOT fails(), checks = n(), failures = fails(), capTwo = capTwo(), coded = coded();
