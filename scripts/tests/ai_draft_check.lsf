StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ проверить по бланку","templateCode":"ZZZDRAFT"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiTemplate() = tpl() THEN fails() <- CONCAT '\n', fails(), 'G.template: бланк должен остаться, получено ' + (OVERRIDE STRING(StoreTask.name(StoreTask.aiTemplate())), 'NULL');
n() <- n() + 1;
IF NOT StoreTask.usesTemplate(StoreTask.aiType()) THEN fails() <- CONCAT '\n', fails(), 'G.type: под бланк нужен бланочный тип, получен ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiType())), 'NULL');

// ===================== H. срок в прошлом — сбрасывается с замечанием =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
