n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'error' THEN fails() <- CONCAT '\n', fails(), 'I.outcome: ожидалось error, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');

// ===================== J. сервис ответил не JSON-ом =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
