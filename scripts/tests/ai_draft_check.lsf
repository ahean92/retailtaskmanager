StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ убрать коробки';
StoreTask.aiResponse() <- r'{"outcome":"clarify","clarificationQuestion":"В каком магазине выполнить задачу?","taskName":"ZZZ убрать коробки","typeId":"issue","objectId":"ZZZOBJ1"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'ok' THEN fails() <- CONCAT '\n', fails(), 'L.outcome: черновик собран, вопрос модели надо отбросить — ожидалось ok, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');
n() <- n() + 1;
IF StoreTask.aiClarification() THEN fails() <- CONCAT '\n', fails(), 'L.clarification: вопроса быть не должно, получен ' + STRING(StoreTask.aiClarification());

// ===================== M. модель не выделила название — им становится сам запрос =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ вымыть витрину до вечера';
StoreTask.aiRequestObject() <- o1();
StoreTask.aiResponse() <- r'{"outcome":"ok","typeId":"issue"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiTaskName() = 'ZZZ вымыть витрину до вечера' THEN fails() <- CONCAT '\n', fails(), 'M.taskName: ожидался текст запроса, получено ' + (OVERRIDE STRING(StoreTask.aiTaskName()), 'NULL');

// ===================== N. исполнитель по подсказке, которой нет в справочнике =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ поручить кому-нибудь';
StoreTask.aiRequestObject() <- o1();
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ поручить","typeId":"issue","performerHint":"ZZZНетТакогоЧеловека"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'clarify' THEN fails() <- CONCAT '\n', fails(), 'N.outcome: ожидалось clarify, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');
n() <- n() + 1;
IF StoreTask.aiPerformer() THEN fails() <- CONCAT '\n', fails(), 'N.performer: человека выдумывать нельзя, выбран ' + (OVERRIDE STRING(StoreTask.name(StoreTask.aiPerformer())), 'NULL');

// ============ O. опорные случаи подбора (те же, что у сервиса) ============
n() <- n() + 1;
IF NOT StoreTask.matchHint('Иванову', 'Иванов Сергей Петрович') THEN fails() <- CONCAT '\n', fails(), 'O1. фамилия в дательном падеже находит запись: ожидалось совпадение';
n() <- n() + 1;
IF StoreTask.matchHint('Иванову', 'Иваненко Пётр') THEN fails() <- CONCAT '\n', fails(), 'O2. однофамилец не подтягивается: совпадения быть не должно';
n() <- n() + 1;
IF NOT StoreTask.matchHint('магазин на Ленина', 'Санта на Ленина') THEN fails() <- CONCAT '\n', fails(), 'O3. магазин назван улицей: ожидалось совпадение';
n() <- n() + 1;
IF StoreTask.matchHint('магазин на Ленина', 'Санта Уручье') THEN fails() <- CONCAT '\n', fails(), 'O4. чужой магазин не совпадает: совпадения быть не должно';
n() <- n() + 1;
IF NOT StoreTask.matchHint('204', 'С - 204 г. Минск') THEN fails() <- CONCAT '\n', fails(), 'O5. магазин назван номером: ожидалось совпадение';
n() <- n() + 1;
IF NOT StoreTask.matchHint('Берёзка', 'Березка на Мира') THEN fails() <- CONCAT '\n', fails(), 'O6. ё в подсказке не мешает: ожидалось совпадение';
n() <- n() + 1;
IF NOT StoreTask.matchHint('Березка', 'Берёзка на Мира') THEN fails() <- CONCAT '\n', fails(), 'O7. ё в справочнике не мешает: ожидалось совпадение';
n() <- n() + 1;
IF NOT StoreTask.matchHint('проверка выкладки', 'Проверка выкладки Pepsi') THEN fails() <- CONCAT '\n', fails(), 'O8. бланк по началу названия: ожидалось совпадение';
n() <- n() + 1;
IF StoreTask.matchHint('Артема', 'Артем Кузнецов') THEN fails() <- CONCAT '\n', fails(), 'O9. короткое склонение — известное расхождение с сервисом: совпадения быть не должно';

EXPORT JSON FROM ok = NOT fails(), checks = n(), failures = fails();
