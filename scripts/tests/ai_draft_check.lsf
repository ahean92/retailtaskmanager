// ============ P. чем можно заменить тип черновика (typeOption) ============
// Список типов для карточки на телефоне отбирает не ручка, а это свойство, и правило у
// него то же, что у aiApplyRules: бланк живёт только на бланочном типе. Черновики —
// синтетические записи журнала: свойство читает из них ровно одно поле, бланк.
NEW r = StoreTask.AiRequest {
    rTpl() <- r; StoreTask.dialogId(r) <- 'ZZZDRAFT-TPL'; StoreTask.step(r) <- 1;
    StoreTask.template(r) <- tpl();
}
NEW r = StoreTask.AiRequest {
    rNoTpl() <- r; StoreTask.dialogId(r) <- 'ZZZDRAFT-NOTPL'; StoreTask.step(r) <- 1;
}

n() <- n() + 1;
IF NOT StoreTask.typeOption(rTpl(), StoreTask.taskType('form')) THEN fails() <- CONCAT '\n', fails(), 'P1. черновик с бланком: «Процедура» должна предлагаться';
n() <- n() + 1;
IF StoreTask.typeOption(rTpl(), StoreTask.taskType('issue')) THEN fails() <- CONCAT '\n', fails(), 'P2. черновик с бланком: «Поручение» предлагать нельзя — бланк на нём не живёт';
n() <- n() + 1;
IF NOT StoreTask.typeOption(rNoTpl(), StoreTask.taskType('issue')) THEN fails() <- CONCAT '\n', fails(), 'P3. черновик без бланка: «Поручение» должно предлагаться';
n() <- n() + 1;
IF StoreTask.typeOption(rNoTpl(), StoreTask.taskType('form')) THEN fails() <- CONCAT '\n', fails(), 'P4. черновик без бланка: «Процедуру» предлагать нельзя — её нечем выполнять';

