StoreTask.aiResponse() <- r'{"outcome":"error","errorCode":"llmTimeout","error":"модель не ответила за 60 с"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiErrorCode() = 'llmTimeout' THEN fails() <- CONCAT '\n', fails(), 'K.errorCode: ожидался код сервиса llmTimeout, получено ' + (OVERRIDE StoreTask.aiErrorCode(), 'NULL');
n() <- n() + 1;
IF StoreTask.aiObject() THEN fails() <- CONCAT '\n', fails(), 'K.object: при ошибке сервиса разбор сущностей не выполняется, а объект выбран';

