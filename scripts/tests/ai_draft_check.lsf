// ===== Автотест разбора ответа AI-сервиса =====
//   scripts/tests/run-ai-draft-check.ps1           — один вызов, отчёт, код возврата
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/tests/ai_draft_check.lsf http://192.168.42.28:8888/eval/action
//
// Проверяет ВТОРУЮ половину постановки задачи текстом — ту, что после сервиса:
// aiParseResponse (разбор плоского JSON) и aiResolve (превращение id и подсказок в
// сущности системы, правила подсистемы поверх выбора модели, исход одним словом).
// Сам сервис не зовётся: ответ модели подставляется в aiResponse() руками — иначе тест
// проверял бы погоду (живая LLM недетерминирована), а не код. Первую половину — отбор
// кандидатов и клиент модели — проверяет pytest в ai-service/tests.
//
// Синтетика — три объекта и шаблон с префиксом ZZZ, как в scoring_check: префикс нужен,
// чтобы подсказки теста не поймали настоящие магазины стенда, а настоящие названия не
// поймались подсказками. Ничего не применяется: без APPLY сессия eval исчезает вместе
// со всей синтетикой, и стенд остаётся нетронутым.
//
// Исполнителя синтетикой не завести — TaskPerformer абстрактный, его реализует хост.
// Поэтому по исполнителю проверяются ветки, которым справочник не нужен: подсказка, не
// нашедшая никого, и «модель не назвала — сервер не выдумывает».
//
// Ответ — JSON: ok (TRUE = всё сошлось), checks (сколько проверок), failures (по строке
// на расхождение: что ожидалось и что получено).

LOCAL fails = STRING();
LOCAL n = INTEGER();
LOCAL o1 = StoreTask.CheckObject();
LOCAL o2 = StoreTask.CheckObject();
LOCAL o3 = StoreTask.CheckObject();
LOCAL tpl = StoreTask.Template();

n() <- 0;

// ----- синтетика -----
NEW a = StoreTask.CheckAsset {
    o1() <- a; StoreTask.assetId(a) <- 'ZZZOBJ1'; StoreTask.assetName(a) <- 'ZZZУручье';
}
NEW a = StoreTask.CheckAsset {
    o2() <- a; StoreTask.assetId(a) <- 'ZZZOBJ2'; StoreTask.assetName(a) <- 'ZZZЛенина первый';
}
NEW a = StoreTask.CheckAsset {
    o3() <- a; StoreTask.assetId(a) <- 'ZZZOBJ3'; StoreTask.assetName(a) <- 'ZZZЛенина второй';
}
NEW x = StoreTask.Template {
    tpl() <- x; StoreTask.code(x) <- 'ZZZDRAFT'; StoreTask.name(x) <- 'ZZZ бланк автотеста';
    StoreTask.active(x) <- TRUE;
}

// ===================== A. модель назвала всё идентификаторами =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ проверить витрину';
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ проверить витрину","typeId":"issue","objectId":"ZZZOBJ1"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'ok' THEN fails() <- CONCAT '\n', fails(), 'A.outcome: ожидалось ok, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');
n() <- n() + 1;
IF NOT StoreTask.aiObject() = o1() THEN fails() <- CONCAT '\n', fails(), 'A.object: ожидался ZZZOBJ1, получен ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiObject())), 'NULL');
n() <- n() + 1;
IF NOT StoreTask.aiType() = StoreTask.taskType('issue') THEN fails() <- CONCAT '\n', fails(), 'A.type: ожидался issue, получен ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiType())), 'NULL');
n() <- n() + 1;
IF NOT StoreTask.aiTaskName() = 'ZZZ проверить витрину' THEN fails() <- CONCAT '\n', fails(), 'A.taskName: получено ' + (OVERRIDE STRING(StoreTask.aiTaskName()), 'NULL');

// ===================== B. объект не назван — берётся тот, где стоит телефон =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ навести порядок';
StoreTask.aiRequestObject() <- o2();
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ навести порядок","typeId":"issue"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiObject() = o2() THEN fails() <- CONCAT '\n', fails(), 'B.object: ожидался объект телефона ZZZOBJ2, получен ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiObject())), 'NULL');
n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'ok' THEN fails() <- CONCAT '\n', fails(), 'B.outcome: ожидалось ok, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');

// ===================== C. магазин назван в тексте — он старше того, где стоит телефон =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'убрать вещи в ZZZУручье';
StoreTask.aiRequestObject() <- o2();
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"убрать вещи","typeId":"issue"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiObject() = o1() THEN fails() <- CONCAT '\n', fails(), 'C.object: названный в тексте ZZZOBJ1 старше объекта телефона, получен ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiObject())), 'NULL');

// ===================== D. подсказка объекта не нашла никого — вопрос =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
