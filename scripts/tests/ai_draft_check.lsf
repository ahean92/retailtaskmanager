StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ протереть полки';
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ протереть полки","typeId":"issue","objectHint":"ZZZНетТакогоМагазина"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'clarify' THEN fails() <- CONCAT '\n', fails(), 'D.outcome: ожидалось clarify, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');
n() <- n() + 1;
IF NOT (StoreTask.aiClarification() LIKE '%не найден%') THEN fails() <- CONCAT '\n', fails(), 'D.clarification: ожидался вопрос про ненайденный объект, получено ' + (OVERRIDE STRING(StoreTask.aiClarification()), 'NULL');

// ===================== E. подсказка объекта нашла двоих — вопрос со списком =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ протереть полки';
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ протереть полки","typeId":"issue","objectHint":"ZZZЛенина"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiClarifyKind() = 'object' THEN fails() <- CONCAT '\n', fails(), 'E.clarifyKind: ожидалось object, получено ' + (OVERRIDE StoreTask.aiClarifyKind(), 'NULL');
n() <- n() + 1;
IF StoreTask.aiObject() THEN fails() <- CONCAT '\n', fails(), 'E.object: при двух подходящих объект выбирать нельзя, выбран ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiObject())), 'NULL');

// ===================== E2. подсказка нашла двоих, а человек стоит на одном из них — берётся он =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ протереть полки';
StoreTask.aiRequestObject() <- o2();
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ протереть полки","typeId":"issue","objectHint":"ZZZЛенина"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF NOT StoreTask.aiObject() = o2() THEN fails() <- CONCAT '\n', fails(), 'E2.object: ожидался объект телефона ZZZOBJ2 из подходящих, получен ' + (OVERRIDE STRING(StoreTask.id(StoreTask.aiObject())), 'NULL');
n() <- n() + 1;
IF NOT StoreTask.aiOutcome() = 'ok' THEN fails() <- CONCAT '\n', fails(), 'E2.outcome: ожидалось ok, получено ' + (OVERRIDE StoreTask.aiOutcome(), 'NULL');

// ===================== F. бланк выбран кодом, а тип небланочный — бланк отброшен с замечанием =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
StoreTask.aiPhotoRequired() <- NULL; StoreTask.aiDescription() <- NULL; StoreTask.aiConfidence() <- NULL; StoreTask.aiQuestion() <- NULL; StoreTask.aiServiceModel() <- NULL; StoreTask.aiLlmMillis() <- NULL;
StoreTask.aiRaw() <- NULL; StoreTask.aiServiceError() <- NULL; StoreTask.aiServiceErrorCode() <- NULL; StoreTask.aiType() <- NULL; StoreTask.aiObject() <- NULL; StoreTask.aiPerformer() <- NULL;
StoreTask.aiTemplate() <- NULL; StoreTask.aiPriority() <- NULL; StoreTask.aiClarification() <- NULL; StoreTask.aiClarifyKind() <- NULL; StoreTask.aiClarifyHint() <- NULL; StoreTask.aiWarning() <- NULL;
StoreTask.aiError() <- NULL; StoreTask.aiErrorCode() <- NULL; StoreTask.aiRequestObject() <- NULL;
StoreTask.aiRequestText() <- 'ZZZ проверить по бланку';
StoreTask.aiRequestObject() <- o1();
StoreTask.aiResponse() <- r'{"outcome":"ok","taskName":"ZZZ проверить по бланку","typeId":"issue","templateCode":"ZZZDRAFT"}';
StoreTask.aiParseResponse();
StoreTask.aiResolve();

n() <- n() + 1;
IF StoreTask.aiTemplate() THEN fails() <- CONCAT '\n', fails(), 'F.template: бланк неприменим к небланочному типу и должен быть отброшен, остался ' + (OVERRIDE STRING(StoreTask.name(StoreTask.aiTemplate())), 'NULL');
n() <- n() + 1;
IF NOT (StoreTask.aiWarning() LIKE '%неприменим%') THEN fails() <- CONCAT '\n', fails(), 'F.warning: ожидалось замечание про неприменимый бланк, получено ' + (OVERRIDE STRING(StoreTask.aiWarning()), 'NULL');

// ===================== G. бланк выбран кодом без типа — тип становится бланочным =====================
StoreTask.aiOutcome() <- NULL; StoreTask.aiTaskName() <- NULL; StoreTask.aiTypeId() <- NULL; StoreTask.aiTypeHint() <- NULL; StoreTask.aiObjectId() <- NULL; StoreTask.aiObjectHint() <- NULL;
StoreTask.aiPerformerId() <- NULL; StoreTask.aiPerformerHint() <- NULL; StoreTask.aiTemplateCode() <- NULL; StoreTask.aiTemplateHint() <- NULL; StoreTask.aiPriorityId() <- NULL; StoreTask.aiDeadline() <- NULL;
