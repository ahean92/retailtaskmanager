n() <- n() + 1;
IF StoreTask.aiDeadline() THEN fails() <- CONCAT '\n', fails(), 'H.deadline: прошедший срок должен быть сброшен, остался ' + STRING(StoreTask.aiDeadline());
n() <- n() + 1;
IF NOT (StoreTask.aiWarning() LIKE '%уже прошёл%') THEN fails() <- CONCAT '\n', fails(), 'H.warning: ожидалось замечание про прошедший срок, получено ' + (OVERRIDE STRING(StoreTask.aiWarning()), 'NULL');

