// ===== #36835, возврат по приёмке 10.09: даты словами и архивный исполнитель =====
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/tests/ticket36835_return_check.lsf http://localhost:8888/eval/action
// Данных не меняет: архивное и действующее подразделения, две роли, ответственные по ним и
// своя задача ZZZ36835-T рождаются в сессии, а единственный APPLY обязан сорваться на
// констрейнте «нельзя назначить на архивного» — и потому ничего из заведённого в базу не
// попадает. Если он НЕ сорвался, заведённое тут же удаляется.
// Нужен хост с подразделениями TaskUnit (StoreTaskStandalone) и хотя бы один объект с кодом.
//
// Ожидание:
//   APPLY отменён, сообщение содержит «в архиве»                — п. 4, констрейнт
//   personArchived пусто                                       — п. 4, person() пропускает архивного
//   anyPersonArchived = 'ZZZ 36835 архивный',
//   cardArchived = 'ZZZ 36835 архивный (в архиве)'             — карточка объекта показывает с пометкой
//   personLive = 'ZZZ 36835 действующий'                       — а действующего отдаёт
//   даты словами: «ДД.ММ.ГГГГ» и «ДД.ММ.ГГГГ ЧЧ:ММ»            — п. 2, формат
// Пункты 1 (пункт «Исполнители» в навигаторе) и 3 (история «Взял на себя» / «Снял с себя» /
// «Снято автором») проверяются руками в бэк-офисе: Справочники → Исполнители; карточка
// задачи → «Взять на себя» / «Снять с себя» → вкладка «История».
// Ответ — JSON: ok / checks / failures.

LOCAL fails = STRING ();
LOCAL n = INTEGER ();
LOCAL obj = StoreTask.CheckObject ();
LOCAL failed = BOOLEAN ();
LOCAL msg = TEXT ();
LOCAL personArchived = TEXT ();
LOCAL anyPersonArchived = TEXT ();
LOCAL cardArchived = TEXT ();
LOCAL personLive = TEXT ();

obj() <- GROUP MAX StoreTask.CheckObject x IF StoreTask.id(x);

NEW a = StoreTask.TaskUnit {
    StoreTask.unitId(a) <- 'ZZZ36835-ARCH';
    StoreTask.unitName(a) <- 'ZZZ 36835 архивный';
    StoreTask.unitArchived(a) <- TRUE;
}
NEW b = StoreTask.TaskUnit {
    StoreTask.unitId(b) <- 'ZZZ36835-LIVE';
    StoreTask.unitName(b) <- 'ZZZ 36835 действующий';
}
NEW ra = StoreTask.ObjectRole { StoreTask.id(ra) <- 'ZZZ36835-A'; StoreTask.name(ra) <- 'ZZZ 36835 роль (архивный)'; }
NEW rl = StoreTask.ObjectRole { StoreTask.id(rl) <- 'ZZZ36835-L'; StoreTask.name(rl) <- 'ZZZ 36835 роль (действующий)'; }
StoreTask.responsibleData(obj(), StoreTask.objectRole('ZZZ36835-A')) <- StoreTask.taskUnit('ZZZ36835-ARCH');
StoreTask.responsibleData(obj(), StoreTask.objectRole('ZZZ36835-L')) <- StoreTask.taskUnit('ZZZ36835-LIVE');

// назначение на архивного: APPLY обязан сорваться
NEW t = StoreTask.Task {
    StoreTask.id(t) <- 'ZZZ36835-T';
    StoreTask.name(t) <- 'ZZZ 36835 назначение на архивного';
    StoreTask.type(t) <- StoreTask.issueTaskType();
    StoreTask.checkObject(t) <- obj();
    StoreTask.assignedTo(t) <- StoreTask.taskUnit('ZZZ36835-ARCH');
}

personArchived() <- StoreTask.name(StoreTask.person(obj(), StoreTask.objectRole('ZZZ36835-A')));
anyPersonArchived() <- StoreTask.name(StoreTask.anyPerson(obj(), StoreTask.objectRole('ZZZ36835-A')));
cardArchived() <- StoreTask.namePerson(obj(), StoreTask.objectRole('ZZZ36835-A'));
personLive() <- StoreTask.name(StoreTask.person(obj(), StoreTask.objectRole('ZZZ36835-L')));

APPLY NESTED LOCAL;
failed() <- System.canceled();
msg() <- System.applyMessage();
IF NOT failed() THEN {
    DELETE StoreTask.Task x WHERE StoreTask.id(x) = 'ZZZ36835-T';
    DELETE StoreTask.ObjectRole x WHERE StoreTask.id(x) = 'ZZZ36835-A' OR StoreTask.id(x) = 'ZZZ36835-L';
    DELETE StoreTask.TaskUnit x WHERE StoreTask.unitId(x) = 'ZZZ36835-ARCH' OR StoreTask.unitId(x) = 'ZZZ36835-LIVE';
    APPLY NESTED LOCAL;
}

n() <- 6;
IF NOT failed() THEN fails() <- CONCAT '\n', fails(), 'назначение на архивное подразделение прошло; синтетика удалена';
ELSE IF NOT msg() LIKE '%в архиве%' THEN fails() <- CONCAT '\n', fails(), 'отказ не тот: ' + (OVERRIDE msg(), 'NULL');
IF personArchived() THEN fails() <- CONCAT '\n', fails(), 'person() отдал архивного: ' + personArchived();
IF NOT anyPersonArchived() = 'ZZZ 36835 архивный' THEN
    fails() <- CONCAT '\n', fails(), 'anyPerson: ' + (OVERRIDE anyPersonArchived(), 'NULL');
IF NOT cardArchived() = 'ZZZ 36835 архивный (в архиве)' THEN
    fails() <- CONCAT '\n', fails(), 'карточка объекта: ' + (OVERRIDE cardArchived(), 'NULL');
IF NOT personLive() = 'ZZZ 36835 действующий' THEN
    fails() <- CONCAT '\n', fails(), 'действующий: ' + (OVERRIDE personLive(), 'NULL');
IF NOT (regexPatternMatch(StoreTask.dateText(currentDate()), r'^\d{2}\.\d{2}\.\d{4}$')
        AND regexPatternMatch(StoreTask.dateTimeText(currentDateTime()), r'^\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}$')) THEN
    fails() <- CONCAT '\n', fails(), 'дата словами: ' + (OVERRIDE StoreTask.dateTimeText(currentDateTime()), 'NULL');

EXPORT JSON FROM ok = NOT fails(), checks = n(), failures = fails(), msg = msg();
