// ===== Канбан: условия фильтров доски = условия списка задач =====
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/tests/kanban_filter_check.lsf http://localhost:7671/eval/action
// Проверяет предикаты inObjectFilter/inTypeFilter/inTemplateFilter (StoreTaskForms/
// FormTask): на v6/6.2 доска tk не наследует фильтры списка зеркалом [FILTER tasks.t]
// (конструкция 7.0), поэтому те же предикаты применены к объекту доски явно. Здесь
// проверяется их семантика: пустой фильтр пропускает все задачи, выбранный — отбирает
// свои, шаблонный — по семейству, а не редакции; селекторы ленты (Чьи задачи, Актуальность,
// флажки, Источник) — ровно условие своего варианта на всех задачах. Синтетика ZZZKB, ничего не
// применяется: без APPLY сессия eval исчезает вместе со всей синтетикой.

LOCAL n = INTEGER ();
LOCAL fails = STRING ();
LOCAL oa = StoreTask.CheckObject ();
LOCAL ob = StoreTask.CheckObject ();
LOCAL tt1 = StoreTask.TaskType ();
LOCAL tt2 = StoreTask.TaskType ();
LOCAL tpl = StoreTask.Template ();
LOCAL cnt = INTEGER ();

n() <- 0;

NEW x = StoreTask.CheckAsset { oa() <- x; StoreTask.assetId(x) <- 'ZZZKB1'; StoreTask.assetName(x) <- 'ZZZKB объект A'; }
NEW x = StoreTask.CheckAsset { ob() <- x; StoreTask.assetId(x) <- 'ZZZKB2'; StoreTask.assetName(x) <- 'ZZZKB объект B'; }
NEW x = StoreTask.TaskType { tt1() <- x; StoreTask.id(x) <- 'zzzkb1'; StoreTask.name(x) <- 'ZZZKB тип 1'; }
NEW x = StoreTask.TaskType { tt2() <- x; StoreTask.id(x) <- 'zzzkb2'; StoreTask.name(x) <- 'ZZZKB тип 2'; }
// family задаём явно: дефолт «семейство = сам шаблон» ставит локальное событие, а в
// eval-сессии оно выполняется в точках жизни сессии, не в момент NEW
NEW x = StoreTask.Template {
    tpl() <- x; StoreTask.code(x) <- 'ZZZKB'; StoreTask.name(x) <- 'ZZZKB бланк';
    StoreTask.active(x) <- TRUE; StoreTask.family(x) <- x;
}
NEW x = StoreTask.Task {
    StoreTask.name(x) <- 'ZZZKB задача A';
    StoreTask.checkObject(x) <- oa();
    StoreTask.type(x) <- tt1();
    StoreTask.template(x) <- tpl();
}
NEW x = StoreTask.Task {
    StoreTask.name(x) <- 'ZZZKB задача B';
    StoreTask.checkObject(x) <- ob();
    StoreTask.type(x) <- tt2();
}

// ===================== R1. пустые фильтры пропускают обе задачи =====================
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inObjectFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 2 THEN fails() <- CONCAT '\n', fails(), 'R1.object: пустой фильтр объекта должен пропускать обе задачи, прошло ' + STRING(cnt());
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inTypeFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 2 THEN fails() <- CONCAT '\n', fails(), 'R1.type: пустой фильтр типа должен пропускать обе задачи, прошло ' + STRING(cnt());
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inTemplateFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 2 THEN fails() <- CONCAT '\n', fails(), 'R1.template: пустой фильтр шаблона должен пропускать обе задачи, прошло ' + STRING(cnt());

// ===================== R2. фильтр по объекту — только задача этого объекта =====================
StoreTask.objectFilter() <- oa();
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inObjectFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 1 THEN fails() <- CONCAT '\n', fails(), 'R2.object: фильтр по объекту A должен оставлять одну задачу, осталось ' + STRING(cnt());
StoreTask.objectFilter() <- NULL;

// ===================== R3. фильтр по типу — только задача этого типа =====================
StoreTask.typeFilter() <- tt1();
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inTypeFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 1 THEN fails() <- CONCAT '\n', fails(), 'R3.type: фильтр по типу 1 должен оставлять одну задачу, осталось ' + STRING(cnt());
StoreTask.typeFilter() <- NULL;

// ===================== R4. фильтр по шаблону — задача с шаблоном; без шаблона скрыта =====================
StoreTask.templateFilter() <- tpl();
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inTemplateFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 1 THEN fails() <- CONCAT '\n', fails(), 'R4.template: фильтр по шаблону должен оставлять задачу A (с шаблоном), задача B без шаблона — скрыта; осталось ' + STRING(cnt());
StoreTask.templateFilter() <- NULL;
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inTemplateFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 2 THEN fails() <- CONCAT '\n', fails(), 'R4.reset: сброс фильтра шаблона должен вернуть обе задачи, прошло ' + STRING(cnt());

// ===================== R5. шаблонный фильтр — по семейству, а не редакции =====================
// вторая редакция того же семейства (код равен коду семейства — констрейнт редакций)
// и задача на ней: фильтр по первой редакции обязан показывать обе задачи с шаблонами
LOCAL tpl2 = StoreTask.Template ();
NEW x = StoreTask.Template {
    tpl2() <- x; StoreTask.code(x) <- 'ZZZKB'; StoreTask.name(x) <- 'ZZZKB бланк, ред. 2';
    StoreTask.active(x) <- TRUE; StoreTask.family(x) <- tpl();
}
NEW x = StoreTask.Task {
    StoreTask.name(x) <- 'ZZZKB задача C';
    StoreTask.checkObject(x) <- ob();
    StoreTask.type(x) <- tt1();
    StoreTask.template(x) <- tpl2();
}
StoreTask.templateFilter() <- tpl();
cnt() <- OVERRIDE (GROUP SUM 1 IF StoreTask.inTemplateFilter(StoreTask.Task t) AND StoreTask.name(t) LIKE r'ZZZKB%'), 0;
n() <- n() + 1;
IF NOT cnt() = 2 THEN fails() <- CONCAT '\n', fails(), 'R5.family: фильтр по редакции должен находить задачи обоих редакций семейства (A и C), осталось ' + STRING(cnt());
StoreTask.templateFilter() <- NULL;


LOCAL bad = INTEGER ();
StoreTask.activeFilter() <- NULL;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inActiveFilter(t) AND NOT (t IS StoreTask.Task)) OR ((t IS StoreTask.Task) AND NOT StoreTask.inActiveFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.none: «Актуальность» пустая — это «Все» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.activeFilter() <- StoreTask.TaskActiveFilter.actual;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inActiveFilter(t) AND NOT (StoreTask.actual(t))) OR ((StoreTask.actual(t)) AND NOT StoreTask.inActiveFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.actual: «Актуальные» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.activeFilter() <- NULL;
StoreTask.activeFilter() <- StoreTask.TaskActiveFilter.opened;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inActiveFilter(t) AND NOT (StoreTask.opened(t))) OR ((StoreTask.opened(t)) AND NOT StoreTask.inActiveFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.opened: «Открытые» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.activeFilter() <- NULL;
StoreTask.activeFilter() <- StoreTask.TaskActiveFilter.closed;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inActiveFilter(t) AND NOT (StoreTask.closed(t))) OR ((StoreTask.closed(t)) AND NOT StoreTask.inActiveFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.closed: «Закрытые» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.activeFilter() <- NULL;
StoreTask.activeFilter() <- StoreTask.TaskActiveFilter.all;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inActiveFilter(t) AND NOT (t IS StoreTask.Task)) OR ((t IS StoreTask.Task) AND NOT StoreTask.inActiveFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.all: «Все» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.activeFilter() <- NULL;
StoreTask.myFilter() <- NULL;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inMyFilter(t) AND NOT (t IS StoreTask.Task)) OR ((t IS StoreTask.Task) AND NOT StoreTask.inMyFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.myNone: пустой «Чьи задачи» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.myFilter() <- StoreTask.TaskMyFilter.mine;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inMyFilter(t) AND NOT (StoreTask.author(t) = StoreTask.currentPerformer())) OR ((StoreTask.author(t) = StoreTask.currentPerformer()) AND NOT StoreTask.inMyFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.mine: «Мои задачи» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.myFilter() <- NULL;
StoreTask.myFilter() <- StoreTask.TaskMyFilter.assigned;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inMyFilter(t) AND NOT (StoreTask.assignedTo(t, currentUser()))) OR ((StoreTask.assignedTo(t, currentUser())) AND NOT StoreTask.inMyFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.assigned: «Назначенные мне» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.myFilter() <- NULL;
StoreTask.myFilter() <- StoreTask.TaskMyFilter.free;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inMyFilter(t) AND NOT (StoreTask.canTake(t, currentUser()))) OR ((StoreTask.canTake(t, currentUser())) AND NOT StoreTask.inMyFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.free: «Свободные в моей команде» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.myFilter() <- NULL;
StoreTask.myFilter() <- StoreTask.TaskMyFilter.decide;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inMyFilter(t) AND NOT (StoreTask.canDecide(t, currentUser()))) OR ((StoreTask.canDecide(t, currentUser())) AND NOT StoreTask.inMyFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.decide: «Ждут моего решения» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.myFilter() <- NULL;
StoreTask.unplannedFilter() <- TRUE;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inUnplannedFilter(t) AND NOT (StoreTask.unplanned(t))) OR ((StoreTask.unplanned(t)) AND NOT StoreTask.inUnplannedFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.unplanned: «Внеплановые» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.unplannedFilter() <- NULL;
StoreTask.performerInactiveFilter() <- TRUE;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inPerformerInactiveFilter(t) AND NOT (StoreTask.performerInactive(t))) OR ((StoreTask.performerInactive(t)) AND NOT StoreTask.inPerformerInactiveFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.inactive: «Исполнитель неактивен» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.performerInactiveFilter() <- NULL;
StoreTask.workPlaceFilter() <- TRUE;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inWorkPlaceFilter(t) AND NOT (StoreTask.offSite(t))) OR ((StoreTask.offSite(t)) AND NOT StoreTask.inWorkPlaceFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.workPlace: «Не на объекте» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.workPlaceFilter() <- NULL;
StoreTask.objectCategoryFilter() <- TRUE;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inObjectCategoryFilter(t) AND NOT (StoreTask.category(StoreTask.checkObject(t)))) OR ((StoreTask.category(StoreTask.checkObject(t))) AND NOT StoreTask.inObjectCategoryFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.category: «Категория задана» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.objectCategoryFilter() <- NULL;
StoreTask.sourceFilter() <- NULL;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inSourceFilter(t) AND NOT (t IS StoreTask.Task)) OR ((t IS StoreTask.Task) AND NOT StoreTask.inSourceFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.sourceNone: пустой «Источник» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.sourceFilter() <- StoreTask.TaskSourceFilter.auto;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inSourceFilter(t) AND NOT (StoreTask.rule(t))) OR ((StoreTask.rule(t)) AND NOT StoreTask.inSourceFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.auto: «Авто-создана» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.sourceFilter() <- NULL;
StoreTask.sourceFilter() <- StoreTask.TaskSourceFilter.manual;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND ((StoreTask.inSourceFilter(t) AND NOT (t IS StoreTask.Task AND NOT StoreTask.rule(t))) OR ((t IS StoreTask.Task AND NOT StoreTask.rule(t)) AND NOT StoreTask.inSourceFilter(t)))), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R6.manual: «Заведены вручную» расходится с условием варианта у ' + STRING(bad()) + ' задач';
StoreTask.sourceFilter() <- NULL;

FOR StoreTask.taskFilter(StoreTask.HomeMetric m) DO {
    StoreTask.tileFilter() <- StoreTask.taskFilter(m);
    StoreTask.tileMineOnly() <- StoreTask.mineOnly(m);
    StoreTask.tileTaskType() <- StoreTask.metricTaskType(m);
    bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND (StoreTask.inTileFilter(t) XOR (
        (StoreTask.taskFilter(m) = StoreTask.HomeTaskFilter.acceptance AND StoreTask.onAcceptance(t)
            AND (NOT StoreTask.mineOnly(m) OR (StoreTask.canDecide(t, currentUser()) AND StoreTask.participant(t, currentUser()))))
        OR (((StoreTask.taskFilter(m) = StoreTask.HomeTaskFilter.open AND StoreTask.opened(t))
                OR (StoreTask.taskFilter(m) = StoreTask.HomeTaskFilter.today AND StoreTask.opened(t) AND StoreTask.dueTodayTask(t)
                    AND (NOT StoreTask.metricTaskType(m) OR StoreTask.type(t) = StoreTask.metricTaskType(m)))
                OR (StoreTask.taskFilter(m) = StoreTask.HomeTaskFilter.overdue AND StoreTask.opened(t) AND StoreTask.overdueTask(t)))
            AND (NOT StoreTask.mineOnly(m) OR StoreTask.mine(t, currentUser())))))), 0;
    IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R7.' + StoreTask.name(m) + ': переход с плитки расходится с условием показателя у ' + STRING(bad()) + ' задач';
}
StoreTask.tileFilter() <- NULL; StoreTask.tileMineOnly() <- NULL; StoreTask.tileTaskType() <- NULL;
n() <- n() + 1;
bad() <- OVERRIDE (GROUP SUM 1 IF StoreTask.Task t IS StoreTask.Task AND NOT StoreTask.inTileFilter(t)), 0;
n() <- n() + 1;
IF NOT bad() = 0 THEN fails() <- CONCAT '\n', fails(), 'R7.none: без перехода с плитки скрыто ' + STRING(bad()) + ' задач';

EXPORT JSON FROM ok = NOT fails(), checks = n(), failures = fails();
