// ===== Демо-promo, шаг 11: прогон гипотезы weigh-recount и разбор находок =====
// Запускает «Прогнать назревшие гипотезы» (то же, что регламент раз в 15 минут):
// прогон версии -> находки -> заявки -> задачи «Пересчёт весового остатка» со строками
// моста. Повторный прогон скрипта в те же сутки НЕ плодит вторую задачу (дедуп по
// ключу «дата прогона + магазин»).
// Прогон: bash scripts/demo/mcp-eval.sh scripts/demo/demo_promo_11_weigh_run.lsf

// сброс nextRun — чтобы повторный прогон скрипта (пересев/репетиция) снова запустил
// гипотезу, а не ждал сутки; регламент делает то же самое по своему расписанию
FOR StoreTask.Hypothesis h IF StoreTask.code[StoreTask.Hypothesis](h) = 'weigh-recount' DO
    StoreTask.nextRun(h) <- NULL;

StoreTask.runDue();

// явный APPLY обязателен: канал /7/mcp без него не коммитит
APPLY NESTED LOCAL;

LOCAL diagRun = TEXT ();
FOR StoreTask.HypothesisRun r IF StoreTask.code[StoreTask.Hypothesis](StoreTask.hypothesis(r)) = 'weigh-recount'
    ORDER StoreTask.started[StoreTask.HypothesisRun](r) DO
    diagRun() <- CONCAT '\n', diagRun(),
        'прогон ', STRING(StoreTask.started[StoreTask.HypothesisRun](r)),
        ' находок=', STRING(StoreTask.count(r)),
        ' ошибок=', (IF StoreTask.error[StoreTask.HypothesisRun](r) THEN 'ЕСТЬ' ELSE 'нет'),
        ' период=', StoreTask.period(r);

LOCAL diagFind = TEXT ();
FOR StoreTask.HypothesisResult f IF StoreTask.code[StoreTask.Hypothesis](StoreTask.hypothesis(StoreTask.run(f))) = 'weigh-recount'
    ORDER StoreTask.code(f) DO
    diagFind() <- CONCAT '\n', diagFind(),
        StoreTask.code(f), ' | ', StoreTask.name(f),
        ' | позиций=', STRING(StoreTask.countRows(f));

LOCAL diagTask = TEXT ();
FOR StoreTask.Task t IF StoreTask.template[StoreTask.Task](t) = StoreTask.template('weigh-recount')
    ORDER StoreTask.id[StoreTask.Task](t) DO
    diagTask() <- CONCAT '\n', diagTask(),
        StoreTask.id[StoreTask.Task](t), ' «', StoreTask.name[StoreTask.Task](t), '» объект=',
        StoreTask.id[StoreTask.CheckObject](StoreTask.checkObject[StoreTask.Task](t)),
        ' исполнитель=', (GROUP MAX Authentication.login(StoreTask.TaskPerformer p) IF p = StoreTask.assignedTo[StoreTask.Task](t)),
        ' позиций задания=', STRING(StoreTask.countRowItem(t)),
        ' статус=', StoreTask.id[StoreTask.TaskStatus](StoreTask.status[StoreTask.Task](t));

EXPORT JSON FROM
    runs = (diagRun()),
    findings = (diagFind()),
    tasks = (diagTask()),
    requests = (GROUP SUM 1 IF StoreTask.TaskRequest q AND StoreTask.source(q) = 'hypothesis'
        AND StoreTask.kind(q) = 'weigh-recount');
