// Пароли «по логину» для учётных записей демо-набора «Уручьё» (зав.маги магазинов 3 и 8).
// Внимание: меняет пароли СУЩЕСТВУЮЩИХ учёток стенда — запускать только осознанно.
// exp.uruch уже получает пароль при создании (demo_uruche_base.lsf).
// Прогон: bash scripts/demo/mcp-eval.sh scripts/demo/demo_uruche_passwords.lsf

setSHA256Password((GROUP MAX CustomUser u IF Authentication.login(u) = 'user61'), 'user61');
setSHA256Password((GROUP MAX CustomUser u IF Authentication.login(u) = 'user77'), 'user77');

APPLY;
EXPORT JSON FROM
    failed = canceled(),
    msg = applyMessage(),
    users = (GROUP CONCAT Authentication.login(u), ' ;; ' ORDER Authentication.login(u)
        WHERE u IS CustomUser
            AND (Authentication.login(u) = 'user61' OR Authentication.login(u) = 'user77' OR Authentication.login(u) = 'exp.uruch')
            AND sha256Password[CustomUser](u));
