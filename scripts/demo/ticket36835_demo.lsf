// ===== #36835: подразделения, иерархия и взятие задачи — демо-набор для стенда =====
// Прогон — POST тела скрипта на /eval/action работающего сервера (из корня retailtaskmanager):
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/ticket36835_demo.lsf http://192.168.42.28:8888/eval/action
// Подробности про обёртку в run() и права — в шапке testdata.lsf; грабли агрегатной
// сборки (квалификация StoreTask.*, отставший нумератор задач) разобраны в шапке
// ticket36751_demo.lsf и учтены здесь так же: имена квалифицированы, id заданы явно.
// /eval/action молча отвечает 200 с пустым телом даже на ошибку компиляции, поэтому
// в конце EXPORT с диагностикой — пустой ответ означает «не скомпилилось».
// Проверка видимости — отдельным read-only скриптом scripts/tests/ticket36835_check.lsf.
//
// Двухуровневая оргструктура ровно из тикета (справочник «Подразделения», ядро):
//   URU  Магазин Уручье
//     └ URU-CLEAN  Отдел клининга Уручье    ← sosedi.tech1
//         └ URU-FLOOR Полотёры Уручье       ← demo.user1
//   MAL  Магазин Малиновка
//     └ MAL-CLEAN  Отдел клининга Малиновка ← demo.user2   (сосед, видеть НЕ должен)
//
// Что после этого должно получиться — это и есть приёмка тикета:
//   DEMO36835-1 (на отдел клининга Уручье) — видна sosedi.tech1 и demo.user1, НЕ видна demo.user2;
//   DEMO36835-2 (на магазин Уручье)        — видна sosedi.tech1 и demo.user1;
//   DEMO36835-3 (на полотёров)             — видна ТОЛЬКО demo.user1.
// Идемпотентно: всё заводится по коду и только если ещё не заведено.

// --- подразделения ---
IF NOT StoreTask.taskUnit('URU') THEN
    NEW u = StoreTask.TaskUnit {
        StoreTask.unitId(u) <- 'URU';
        StoreTask.unitName(u) <- 'Магазин Уручье (демо 36835)';
    }
IF NOT StoreTask.taskUnit('URU-CLEAN') THEN
    NEW u = StoreTask.TaskUnit {
        StoreTask.unitId(u) <- 'URU-CLEAN';
        StoreTask.unitName(u) <- 'Отдел клининга Уручье (демо 36835)';
    }
IF NOT StoreTask.taskUnit('URU-FLOOR') THEN
    NEW u = StoreTask.TaskUnit {
        StoreTask.unitId(u) <- 'URU-FLOOR';
        StoreTask.unitName(u) <- 'Полотёры Уручье (демо 36835)';
    }
IF NOT StoreTask.taskUnit('MAL') THEN
    NEW u = StoreTask.TaskUnit {
        StoreTask.unitId(u) <- 'MAL';
        StoreTask.unitName(u) <- 'Магазин Малиновка (демо 36835)';
    }
IF NOT StoreTask.taskUnit('MAL-CLEAN') THEN
    NEW u = StoreTask.TaskUnit {
        StoreTask.unitId(u) <- 'MAL-CLEAN';
        StoreTask.unitName(u) <- 'Отдел клининга Малиновка (демо 36835)';
    }

// --- иерархия: кто в кого входит ---
StoreTask.parentUnit(StoreTask.taskUnit('URU-CLEAN')) <- StoreTask.taskUnit('URU');
StoreTask.parentUnit(StoreTask.taskUnit('URU-FLOOR')) <- StoreTask.taskUnit('URU-CLEAN');
StoreTask.parentUnit(StoreTask.taskUnit('MAL-CLEAN')) <- StoreTask.taskUnit('MAL');

// --- состав (только прямой: полотёры входят в клининг иерархией, а не списком) ---
// admin в состав НЕ годится: у mite-хоста исполнитель — Employee, а учётка admin
// с сотрудником не связана (apiCurrentUser отвечает notPerformer). Видеть задачи такой
// член подразделения будет, а взять — нет, currentPerformer() у него пустой.
StoreTask.member(StoreTask.taskUnit('URU-CLEAN'), (GROUP MAX CustomUser a1 IF login(a1) = 'sosedi.tech1')) <- TRUE;
StoreTask.member(StoreTask.taskUnit('URU-FLOOR'), (GROUP MAX CustomUser a2 IF login(a2) = 'demo.user1')) <- TRUE;
StoreTask.member(StoreTask.taskUnit('MAL-CLEAN'), (GROUP MAX CustomUser a3 IF login(a3) = 'demo.user2')) <- TRUE;

// --- задачи на подразделения ---
IF NOT (GROUP MAX StoreTask.Task z1 IF StoreTask.id(z1) = 'DEMO36835-1') THEN
    NEW t = StoreTask.Task {
        StoreTask.id(t) <- 'DEMO36835-1';
        StoreTask.name(t) <- '36835: витрина — отдел клининга';
        StoreTask.type(t) <- StoreTask.taskType('checklist');
        StoreTask.assignedTo(t) <- StoreTask.taskUnit('URU-CLEAN');
        StoreTask.deadline(t) <- currentDate();
    }
IF NOT (GROUP MAX StoreTask.Task z2 IF StoreTask.id(z2) = 'DEMO36835-2') THEN
    NEW t = StoreTask.Task {
        StoreTask.id(t) <- 'DEMO36835-2';
        StoreTask.name(t) <- '36835: приёмка — весь магазин';
        StoreTask.type(t) <- StoreTask.taskType('checklist');
        StoreTask.assignedTo(t) <- StoreTask.taskUnit('URU');
        StoreTask.deadline(t) <- currentDate();
    }
IF NOT (GROUP MAX StoreTask.Task z3 IF StoreTask.id(z3) = 'DEMO36835-3') THEN
    NEW t = StoreTask.Task {
        StoreTask.id(t) <- 'DEMO36835-3';
        StoreTask.name(t) <- '36835: полы — полотёры';
        StoreTask.type(t) <- StoreTask.taskType('checklist');
        StoreTask.assignedTo(t) <- StoreTask.taskUnit('URU-FLOOR');
        StoreTask.deadline(t) <- currentDate();
    }

// Объект — существующий на стенде (SOS-103, «Соседи» в Уручье): задача без объекта
// невидима всем, кто работает по геопривязке, — гео-гейт apiTasks сверяет checkObject
// с выбранной точкой, и NULL не совпадает ни с чем. Присваивание безусловное, чтобы
// починить и уже заведённые демо-задачи.
StoreTask.checkObject(StoreTask.Task t) <- StoreTask.checkObject('SOS-103') WHERE StoreTask.id(t) LIKE 'DEMO36835%';

// --- бланк (#36836): демо-задачам нужен настоящий шаблон ---
// Без него задача типа checklist — заглушка: startExecution не создаёт Filling
// (FormTask требует template), apiExecutionFields отвечает [], и офлайн-сценарий
// «начал заполнять — задачу перехватили — ответы доехали» не показать. Шаблон
// нарочно без обязательных полей и без resolutionRequired: приёмка взятия не должна
// спотыкаться о валидацию завершения.
IF NOT StoreTask.optionSetByName('Чистота (демо 36835)') THEN
    NEW s = StoreTask.OptionSet {
        StoreTask.name(s) <- 'Чистота (демо 36835)';
        NEW o = StoreTask.Option { StoreTask.optionSet(o) <- s; StoreTask.code(o) <- 'ok';    StoreTask.name(o) <- 'Чисто';  StoreTask.score(o) <- 1; }
        NEW o = StoreTask.Option { StoreTask.optionSet(o) <- s; StoreTask.code(o) <- 'dirty'; StoreTask.name(o) <- 'Грязно'; StoreTask.score(o) <- 0; StoreTask.nonconformity(o) <- TRUE; }
    }
IF NOT StoreTask.template('DEMO36835') THEN
    NEW t = StoreTask.Template {
        StoreTask.code(t) <- 'DEMO36835';
        StoreTask.name(t) <- 'Уборка (демо 36835)';
        StoreTask.note(t) <- 'Бланк демо-задач взятия: одно поле шкалы и заметка';
        NEW sec = StoreTask.Section {
            StoreTask.template(sec) <- t; StoreTask.name(sec) <- 'Зал';
            NEW f = StoreTask.Field { StoreTask.section(f) <- sec; StoreTask.code(f) <- 'clean';
                StoreTask.name(f) <- 'Чистота зала';
                StoreTask.type(f) <- StoreTask.FieldType.scale;
                StoreTask.optionSet(f) <- StoreTask.optionSetByName('Чистота (демо 36835)');
                StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- sec; StoreTask.code(f) <- 'note';
                StoreTask.name(f) <- 'Заметка';
                StoreTask.type(f) <- StoreTask.FieldType.text; }
        }
    }
// безусловно, как checkObject выше: чинит и уже заведённые демо-задачи
StoreTask.template(StoreTask.Task t) <- StoreTask.template('DEMO36835') WHERE StoreTask.id(t) LIKE 'DEMO36835%';

APPLY;
// Диагностика скоупится по демо-набору: нефильтрованные счётчики маскируют молчаливый
// no-op (member по GROUP MAX от несуществующего логина ничего не пишет). Ожидание:
// units=5, withParent=3, members=3, tasks=3, withoutObject=0, withoutTemplate=0,
// templateFields=2 и все три has*=true.
EXPORT JSON FROM
    failed = canceled(),
    msg = applyMessage(),
    units = (GROUP SUM 1 IF StoreTask.unitName(StoreTask.TaskUnit u) LIKE '%(демо 36835)'),
    withParent = (GROUP SUM 1 IF StoreTask.parentUnit(StoreTask.TaskUnit u) AND StoreTask.unitName(u) LIKE '%(демо 36835)'),
    members = (GROUP SUM 1 IF StoreTask.member(StoreTask.TaskUnit u, CustomUser c) AND StoreTask.unitName(u) LIKE '%(демо 36835)'),
    tasks = (GROUP SUM 1 IF StoreTask.id(StoreTask.Task t) LIKE 'DEMO36835%'),
    withoutObject = (GROUP SUM 1 IF StoreTask.id(StoreTask.Task t) LIKE 'DEMO36835%' AND NOT StoreTask.checkObject(t)),
    withoutTemplate = (GROUP SUM 1 IF StoreTask.id(StoreTask.Task t) LIKE 'DEMO36835%' AND NOT StoreTask.template(t)),
    templateFields = (GROUP SUM 1 IF StoreTask.template(StoreTask.Field f) = StoreTask.template('DEMO36835')),
    hasTech1 = (GROUP MAX TRUE IF login(CustomUser c1) = 'sosedi.tech1'),
    hasUser1 = (GROUP MAX TRUE IF login(CustomUser c2) = 'demo.user1'),
    hasUser2 = (GROUP MAX TRUE IF login(CustomUser c3) = 'demo.user2');
