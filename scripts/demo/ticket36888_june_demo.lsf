LOCAL tpl = StoreTask.Template();
LOCAL obj = StoreTask.CheckAsset();

IF NOT StoreTask.objectDimension('city') THEN NEW d = StoreTask.ObjectDimension { StoreTask.id(d) <- 'city'; StoreTask.name(d) <- 'Город'; }
IF NOT StoreTask.objectDimension('format') THEN NEW d = StoreTask.ObjectDimension { StoreTask.id(d) <- 'format'; StoreTask.name(d) <- 'Формат'; }

IF NOT StoreTask.templateByName('Проверка категории РЫБА — июнь 2026') THEN
    NEW t = StoreTask.Template {
        StoreTask.name(t) <- 'Проверка категории РЫБА — июнь 2026';
        StoreTask.passThreshold(t) <- 80;
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Внешний вид торгово-технологического оборудования с рыбной продукцией.';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r08'; StoreTask.name(f) <- 'чистота стекол'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r09'; StoreTask.name(f) <- 'отсутствие намерзаний, наледи'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r10'; StoreTask.name(f) <- 'отсутствие загрязнений от остатков продукции (чешуя, лом, крошка и др.)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r11'; StoreTask.name(f) <- 'целостность емкостей, крышек'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r12'; StoreTask.name(f) <- 'исправность оборудования на момент проверки'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Выкладка рыбы и рыбной продукции (соответствие фактической выкладки прорисованным планограммам по категориям, объем и представленность в оборудовании, эстетика размещения).';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r13'; StoreTask.name(f) <- 'рыба мороженная вес/фас + рыба охлажденная (соблюдение регламента накрытия, ассортимент, правильность выкладки).'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 7; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r14'; StoreTask.name(f) <- 'фасованные рыбные снеки'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r15'; StoreTask.name(f) <- 'консервы рыбные'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r16'; StoreTask.name(f) <- 'п/ф, морепродукты, крабовые палочки вес/фас'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r17'; StoreTask.name(f) <- 'пресервы+витрина с готовой продукцией+копчение СП (ассортимент, наполнение емкостей, внешний вид продукции)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 7; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r18'; StoreTask.name(f) <- 'салаты'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Проверка наличия стикеров о стоимости отвеса на продукцию с нестандартным весом (Поставновление № 703, п. 46';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r19'; StoreTask.name(f) <- 'наличие товарных ярлыков и стикеров о стоимости отвеса (на весовой, упакованной в ТО рыбе и рыбной продукции)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 3; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r20'; StoreTask.name(f) <- 'наличие стикера о стоимости каждого индивидуального отвеса на фасованной рыбе с нестандартным весом.'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 5; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r21'; StoreTask.name(f) <- 'соответствие стикера о стоимости отвеса с фактическим весом/стоимостью (на упакованной в ТО рыбной продукции)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 5; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Проверка качества рыбной продукции.';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r22'; StoreTask.name(f) <- 'визуальный осмотр, запах'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r23'; StoreTask.name(f) <- 'отсутствие продукции с частичной/полной потерей товарного вида (усыхание, окисление, потемнение и др.)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 5; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r24'; StoreTask.name(f) <- 'отсутствие в продаже товаров с граневыми сроками годности, подлежащих уценке'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r25'; StoreTask.name(f) <- 'отсутствие в продаже товаров с истекшими сроками годности'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 7; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r26'; StoreTask.name(f) <- 'отсутствие развакуума, заснеженности'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r27'; StoreTask.name(f) <- 'соблюдение товарного соседства в оборудовании ТЗ'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r28'; StoreTask.name(f) <- 'Правильность выполнения регламентов, инструкций и прочих документов при работе с категорией "Рыба"'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 5; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Соблюдение требований по ведению журналов при работе с категорией "Рыба".';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r29'; StoreTask.name(f) <- 'наличие в ТЗ папки "Информация для покупателей"'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r30'; StoreTask.name(f) <- 'наличие товарных ярлыков на весовую рыбу с/м, морепродукты, пф'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 5; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r31'; StoreTask.name(f) <- 'наличие качественных удостоверений на рыбу с/м'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r32'; StoreTask.name(f) <- 'наличие качественных удостоверений на морепродукты вес'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r33'; StoreTask.name(f) <- 'наличие качественных удостоверений на ПФ рыбные вес'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r34'; StoreTask.name(f) <- 'соответствие данных товарных ярлыков с данными в КУ'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 3; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r35'; StoreTask.name(f) <- 'наличие журнала "Подготовка рыбы мороженной к продаже", актуальность дат и подписи'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r36'; StoreTask.name(f) <- 'температура в помещении предпродажной подготовки рыбы'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r37'; StoreTask.name(f) <- 'количество кг. (д.б. целые тарные места или блоки)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Проверка соответствия цен.';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r38'; StoreTask.name(f) <- 'актуальность ценников, соответсттвие ЦЕННИК=товар'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r39'; StoreTask.name(f) <- 'соответствие цена на "большом" ценнике с ценой на "малом"'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r40'; StoreTask.name(f) <- 'отсутствие задвоенности цен на 1 sku.'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Проверка наличия товаров ТОП, ТПЦ,текущих акций в категории Рыба.';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r41'; StoreTask.name(f) <- 'ТОП'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r42'; StoreTask.name(f) <- 'ТПЦ'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r43'; StoreTask.name(f) <- 'АКЦИИ: РД, СБ, АДЦ, СШ и др.'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 10; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r44'; StoreTask.name(f) <- 'наличие в торговом зале актуальных рекламных материалов.'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 1; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
        NEW s = StoreTask.Section { StoreTask.template(s) <- t; StoreTask.name(s) <- 'Проверка условий хранения и запаса рыбы и рыбной продукции.';
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r45'; StoreTask.name(f) <- 'товарное соседство (готовое/сырое)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r46'; StoreTask.name(f) <- 'наличие зоны брака с оформленными актами'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
            NEW f = StoreTask.Field { StoreTask.section(f) <- s; StoreTask.code(f) <- 'r47'; StoreTask.name(f) <- 'соблюдение правил хранения подготовленной рыбы с/м (чистые, промаркированные емкости; наличие крышек и ярлыков с упаковки)'; StoreTask.type(f) <- StoreTask.FieldType.score; StoreTask.weight(f) <- 2; StoreTask.step(f) <- 0.5; StoreTask.scoreable(f) <- TRUE; }
        }
    }

tpl() <- StoreTask.templateByName('Проверка категории РЫБА — июнь 2026');

    IF NOT StoreTask.checkAsset('DEMO36888-001') THEN
        NEW ca = StoreTask.CheckAsset { StoreTask.assetId(ca) <- 'DEMO36888-001'; StoreTask.assetName(ca) <- 'Объект 001'; }
    obj() <- StoreTask.checkAsset('DEMO36888-001');
    IF NOT StoreTask.assetAddress(obj()) THEN StoreTask.assetAddress(obj()) <- 'Город 01, ул. Демонстрационная, 1';
    IF NOT StoreTask.dimensionData(obj(), StoreTask.objectDimension('format')) THEN StoreTask.dimensionData(obj(), StoreTask.objectDimension('format')) <- 'Формат 1';
    IF NOT StoreTask.dimensionData(obj(), StoreTask.objectDimension('city')) THEN StoreTask.dimensionData(obj(), StoreTask.objectDimension('city')) <- 'Город 01';
    IF NOT (GROUP MAX StoreTask.Filling e2 IF StoreTask.template(e2) = tpl() AND StoreTask.checkObject(StoreTask.task(e2)) = obj() AND toDate(StoreTask.dateTime(e2)) = 2026_06_01) THEN
    NEW tk = StoreTask.Task {
        StoreTask.checkObject(tk) <- obj(); StoreTask.type(tk) <- StoreTask.checklistTaskType(); StoreTask.template(tk) <- tpl();
        NEW e = StoreTask.Filling {
            StoreTask.task(e) <- tk; StoreTask.template(e) <- tpl(); StoreTask.dateTime(e) <- toDateTime(2026_06_01);
            StoreTask.numberValue(e, StoreTask.Field fl) <- StoreTask.weight(fl) WHERE StoreTask.template(fl) = tpl();
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r13')) <- 5.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r16')) <- 1;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r17')) <- 6;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r20')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r21')) <- 4;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r26')) <- 0.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r31')) <- 0.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r32')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r33')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r34')) <- 1;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r38')) <- 1;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r39')) <- 1.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r40')) <- 0.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r43')) <- 8.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r47')) <- 1.5;
            StoreTask.state(e) <- StoreTask.ExecutionState.finished;
