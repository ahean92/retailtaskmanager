            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r15')) <- 0.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r16')) <- 1.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r17')) <- 3.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r18')) <- 1.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r23')) <- 4.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r27')) <- 0.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r31')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r32')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r33')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r34')) <- 0;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r38')) <- 1.5;
            StoreTask.numberValue(e, StoreTask.field(tpl(), 'r41')) <- 1;
            StoreTask.state(e) <- StoreTask.ExecutionState.finished;
        }
    }

APPLY;

EXPORT JSON FROM
    failed = canceled(),
    msg = (OVERRIDE applyMessage(), ''),
    sections = (OVERRIDE (GROUP SUM 1 IF StoreTask.template(StoreTask.Section s2) = StoreTask.templateByName('Проверка категории РЫБА — июнь 2026')), 0),
    fields = (OVERRIDE (GROUP SUM 1 IF StoreTask.template(StoreTask.Field f2) = StoreTask.templateByName('Проверка категории РЫБА — июнь 2026')), 0),
    weightSum = (OVERRIDE (GROUP SUM StoreTask.weight(StoreTask.Field f3) IF StoreTask.template(f3) = StoreTask.templateByName('Проверка категории РЫБА — июнь 2026')), 0),
    assets = (OVERRIDE (GROUP SUM 1 IF StoreTask.assetId(StoreTask.CheckAsset a1) LIKE 'DEMO36888-%'), 0),
    withCity = (OVERRIDE (GROUP SUM 1 IF StoreTask.dimensionData(StoreTask.CheckAsset a2, StoreTask.objectDimension('city')) AND StoreTask.assetId(a2) LIKE 'DEMO36888-%'), 0),
    withFormat = (OVERRIDE (GROUP SUM 1 IF StoreTask.dimensionData(StoreTask.CheckAsset a3, StoreTask.objectDimension('format')) AND StoreTask.assetId(a3) LIKE 'DEMO36888-%'), 0),
    fillings = (OVERRIDE (GROUP SUM 1 IF StoreTask.template(StoreTask.Filling e3) = StoreTask.templateByName('Проверка категории РЫБА — июнь 2026')), 0),
    deducted = (OVERRIDE (GROUP SUM StoreTask.deductScore(StoreTask.Filling e4, StoreTask.Field f4) IF StoreTask.template(e4) = StoreTask.templateByName('Проверка категории РЫБА — июнь 2026') AND StoreTask.template(f4) = StoreTask.templateByName('Проверка категории РЫБА — июнь 2026')), 0);
