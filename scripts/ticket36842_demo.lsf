StoreTask.finish((GROUP MAX StoreTask.SimpleExecution e2 IF StoreTask.task(e2) = StoreTask.task('DEMO36842-1')
    AND NOT StoreTask.finished(e2)));

// Задача снова открыта — см. шапку: закрытую телефон не показывает вовсе.
StoreTask.status(StoreTask.task('DEMO36842-1')) <- StoreTask.taskStatus('in progress');
APPLY;

// Диагностика скоупится по демо-набору. Ожидание: tasks=2, withObject=2, withAuthor=2,
// problemFiles=3 (два у первой, один у второй), resultFiles=1, executions=1,
// finishedExecutions=1, opened=2 — и пустой msg.
EXPORT JSON FROM
    failed = canceled(),
    msg = applyMessage(),
    tasks = (GROUP SUM 1 IF StoreTask.id(StoreTask.Task t) LIKE 'DEMO36842%'),
    withObject = (GROUP SUM 1 IF StoreTask.checkObject(StoreTask.Task t) AND StoreTask.id(t) LIKE 'DEMO36842%'),
    withAuthor = (GROUP SUM 1 IF StoreTask.author(StoreTask.Task t) AND StoreTask.id(t) LIKE 'DEMO36842%'),
    opened = (GROUP SUM 1 IF StoreTask.opened(StoreTask.Task t) AND StoreTask.id(t) LIKE 'DEMO36842%'),
    problemFiles = (GROUP SUM 1 IF NOT StoreTask.execution(StoreTask.TaskFile f) AND StoreTask.id(StoreTask.task(f)) LIKE 'DEMO36842%'),
    resultFiles = (GROUP SUM 1 IF StoreTask.execution(StoreTask.TaskFile f) AND StoreTask.id(StoreTask.task(f)) LIKE 'DEMO36842%'),
    executions = (GROUP SUM 1 IF StoreTask.id(StoreTask.task(StoreTask.Execution e)) LIKE 'DEMO36842%'),
    finishedExecutions = (GROUP SUM 1 IF StoreTask.finished(StoreTask.Execution e) AND StoreTask.id(StoreTask.task(e)) LIKE 'DEMO36842%');
