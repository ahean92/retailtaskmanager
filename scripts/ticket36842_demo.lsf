            , 'base64');
        StoreTask.name(f) <- 'Плафон над стеллажом';
        StoreTask.extension(f) <- 'png';
    }
}
APPLY;

// --- «стало»: выполнение с фотографией результата ---
// Создаётся и завершается только один раз: finish зеркалит фото в файлы задачи
// (execution(TaskFile) — по нему карточка и отличает «стало» от «было») и переносит
// комментарий в ленту.
IF NOT (GROUP SUM 1 IF StoreTask.task(StoreTask.SimpleExecution e1) = StoreTask.task('DEMO36842-1')) THEN
    NEW e = StoreTask.SimpleExecution {
        StoreTask.task(e) <- StoreTask.task('DEMO36842-1');
        StoreTask.executor(e) <- StoreTask.performer((GROUP MAX CustomUser u3 IF login(u3) = 'sosedi.tech1'));
        // индекс снимка: с #36872 фото выполнения 0..N, и первый — первый
        StoreTask.photo(e, 1) <- IMAGEFILE(decode(
          'iVBORw0KGgoAAAANSUhEUgAAAeAAAAFACAIAAADrqjgsAAAIM0lEQVR42u3UsQnAMBAEQfXfmhPjRAU4cRkKHCsT3AUDX8DwBzuu'
