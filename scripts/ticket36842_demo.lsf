// ===== #36842: карточка задачи — демо-набор для стенда =====
// Прогон — POST тела скрипта на /eval/action работающего сервера (из корня retailtaskmanager):
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/ticket36842_demo.lsf http://192.168.42.28:8888/eval/action
// Про обёртку, права и грабли агрегатной сборки — шапки testdata.lsf и ticket36751_demo.lsf;
// имена квалифицированы (StoreTask.*), id задаются явно, скрипт идемпотентен.
// /eval/action молча отвечает 200 с пустым телом даже на ошибку компиляции, поэтому в
// конце EXPORT с диагностикой — пустой ответ означает «не скомпилилось».
//
// Что должно получиться (это и есть приёмка #36842 на стенде):
//   DEMO36842-1 «Мусор у витрины» — поручение с ОПИСАНИЕМ (в базе HTML, телефону —
//     чистый текст), фотографией проблемы и текстовым файлом-регламентом; плюс
//     ЗАВЕРШЁННОЕ выполнение с фотографией результата: на карточке видно «было» и
//     «стало» порознь и подписанными.
//   DEMO36842-2 «Разбитый плафон» — то же без выполнения: «было» есть, «стало» ещё нет.
//
// Задача-1 после завершения выполнения возвращается в «В работе» НАРОЧНО: событие
// Execution.lsf закрывает задачу, когда все выполнения успешны, а закрытую задачу
// apiTasks на телефон не отдаёт вовсе (WHERE opened) — и показывать «было/стало» стало
// бы негде. На стенде это ровно тот момент, который приёмка и разглядывает.
//
// Автор — sosedi.admin (директор ставит поручение), исполнитель — sosedi.tech1 (открывает
// его на телефоне); объект — SOS-103 («Соседи» в Уручье), как у демо-набора #36835.
//
// Организация у исполнителя и у объекта обязана совпадать: mite-хост это проверяет
// констрейнтом (StoreTaskMite: «Исполнитель и объект задачи принадлежат разным
// организациям»), а все точки на стенде принадлежат «Соседям» — поэтому и учётки
// соседские, а не demo.user1 из Демо-организации.

// --- поручение с описанием и фотографией проблемы ---
IF NOT (GROUP MAX StoreTask.Task z1 IF StoreTask.id(z1) = 'DEMO36842-1') THEN
    NEW t = StoreTask.Task {
        StoreTask.id(t) <- 'DEMO36842-1';
        StoreTask.name(t) <- '36842: мусор у витрины';
        StoreTask.type(t) <- StoreTask.taskType('issue');
        // РАЗМЕТКА нарочно: описание в базе — RICHTEXT, и телефон обязан показать
        // текст, а не теги (StoreTaskCore.plainFromHtml)
        StoreTask.description(t) <- RICHTEXT('<p>Убрать <b>мусор</b> у витрины справа от входа.</p><p>Протереть стекло &amp; проверить подсветку.</p>');
        StoreTask.deadline(t) <- sum(currentDate(), 1);
    }
IF NOT (GROUP MAX StoreTask.Task z2 IF StoreTask.id(z2) = 'DEMO36842-2') THEN
    NEW t = StoreTask.Task {
        StoreTask.id(t) <- 'DEMO36842-2';
        StoreTask.name(t) <- '36842: разбит плафон в зале';
        StoreTask.type(t) <- StoreTask.taskType('issue');
        StoreTask.description(t) <- RICHTEXT('<p>Разбит плафон над третьим стеллажом — осколки убраны, нужна замена.</p>');
        StoreTask.deadline(t) <- sum(currentDate(), 2);
    }

// Безусловно (чинит и уже заведённые): объект, исполнитель, автор, приоритет.
// Автор — не тот, кто запускает скрипт: «кто поставил» на карточке должно читаться
// как поручение от человека, а не от admin.
StoreTask.checkObject(StoreTask.Task t) <- StoreTask.checkObject('SOS-103') WHERE StoreTask.id(t) LIKE 'DEMO36842%';
StoreTask.assignedTo(StoreTask.Task t) <- StoreTask.performer((GROUP MAX CustomUser u1 IF login(u1) = 'sosedi.tech1')) WHERE StoreTask.id(t) LIKE 'DEMO36842%';
StoreTask.author(StoreTask.Task t) <- StoreTask.performer((GROUP MAX CustomUser u2 IF login(u2) = 'sosedi.admin')) WHERE StoreTask.id(t) LIKE 'DEMO36842%';
StoreTask.priority(StoreTask.Task t) <- StoreTask.taskPriority('high') WHERE StoreTask.id(t) = 'DEMO36842-1';

APPLY;

// --- «было»: снимок проблемы и файл-регламент ---
// Отдельной сессией после APPLY: событие defineTaskCommentsFiles цепляет новый файл к
// автосозданному пустому комментарию, и делать это в сессии создания задачи незачем.
