// ===== #36835: проверка видимости — READ-ONLY, ничего не меняет =====
//   curl -u admin: -H "Content-Type: text/plain; charset=utf-8" \
//        --data-binary @scripts/ticket36835_check.lsf http://192.168.42.28:8888/eval/action
// Отдаёт по каждой демо-задаче: на кого назначена, кто взял и кому она видна.
// Ожидание приёмки (после ticket36835_demo.lsf):
//   DEMO36835-1  tech1=true  user1=true  user2=null
//   DEMO36835-2  tech1=true  user1=true  user2=null
//   DEMO36835-3  tech1=null  user1=true  user2=null
// user2 (соседний магазин) не должен видеть ни одной; tech1 не должен видеть задачу
// полотёров — он в клининге, а полотёры входят в него, не наоборот.

LOCAL uTech = CustomUser();
LOCAL uOne = CustomUser();
LOCAL uTwo = CustomUser();
uTech() <- (GROUP MAX CustomUser a IF login(a) = 'sosedi.tech1');
uOne() <- (GROUP MAX CustomUser b IF login(b) = 'demo.user1');
uTwo() <- (GROUP MAX CustomUser c IF login(c) = 'demo.user2');

EXPORT JSON FROM
    task = StoreTask.id(StoreTask.Task t),
    unit = StoreTask.nameAssignedTo(t),
    takenBy = StoreTask.nameTakenBy(t),
    tech1 = StoreTask.assignedTo(t, uTech()),
    user1 = StoreTask.assignedTo(t, uOne()),
    user2 = StoreTask.assignedTo(t, uTwo()),
    canTakeUser1 = StoreTask.canTake(t, uOne())
    WHERE StoreTask.id(t) LIKE 'DEMO36835%'
    ORDER StoreTask.id(t);
